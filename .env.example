# Backend database selection priority:
# DATABASE_URL -> POSTGRES_URL -> POSTGRES_URL_NON_POOLING -> DATABASE_URL_NEON -> DATABASE_URL_SUPABASE -> DATABASE_URL_COCKROACH -> DATABASE_URL_AIVEN -> DATABASE_URL_RAILWAY

# Recommended primary database for this repo: Neon Postgres
DATABASE_URL_NEON=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/portfolio?sslmode=require

# Alternative if you want bundled platform features such as Auth/Storage/Admin UI:
# DATABASE_URL_SUPABASE=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require

# Backend CORS for local dev and deployed static frontends
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,https://donttalk.vercel.app,https://donttalk.netlify.app,https://donttalk.pages.dev

# Optional frontend build override when a static host cannot autodetect the API origin
# API_BASE_URL=https://donttalk-api-production.up.railway.app

# HuggingFace token for server-side ESM-2 scoring proxy (/api/esm2/score)
# Get a free token at https://huggingface.co/settings/tokens
# Without this, the endpoint returns 503 and the frontend falls back to BLOSUM62.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Auto-sync of protein/gene sequences
# On startup the API always upserts a default set (UniProt + Ensembl) into sequence_library.
# After startup it refreshes every SEQUENCE_REFRESH_SECONDS (default 86400 = 24h). Set to 0 to disable.
# SEQUENCE_REFRESH_SECONDS=86400

# Shared secret required by sync endpoints (POST /api/sequences/sync, etc.) when set.
# Use this to gate external cron jobs (GitHub Actions, Railway cron, cron-job.org) that call
#   curl -X POST "$API/api/sequences/sync" -H "X-Sync-Secret: $SYNC_SECRET" -H "Content-Type: application/json" -d '{}'
# SYNC_SECRET=change-me

# AI chatbot (/api/chat) — fallback chain: Gemini → DeepSeek → OpenRouter
# Only one key is needed; the system tries each in order.
# GEMINI_API_KEY=AIza...         # https://aistudio.google.com/app/apikey
# DEEPSEEK_API_KEY=sk-...        # https://platform.deepseek.com/api_keys
# OPENROUTER_API_KEY=sk-or-...   # https://openrouter.ai/keys