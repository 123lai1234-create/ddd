# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
# dist  -- tracked for Vercel static deploy (2026-06-12, keep tracked)
tmp
out-tsc
*.tsbuildinfo

# pagefind search index (generated by astro build)
/pagefind
**/pagefind/

# secrets / local env — never commit
.env
.env.*
!.env.example
.envrc
/.secrets/

# platform / agent metadata (rebuildable)
/.mavis/
/.opencode/
/.netlify/
/.wrangler/
/.vercel/
/.replit/

# Python cruft
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.python-version
.venv/
.vercel_python_packages/
artifacts/pip_install.log

# ML model artifacts
*.pt
*.pth
*.onnx

# Dogfood QA scratch space
/dogfood-donttalk/

# Astro build scratch
astro/__extract_bodies.py
astro/_nav.json
astro/.netlify/

# Astro lyrics-alignment experiments (scratch)
astro/scripts/_align_*.txt
astro/scripts/align_lyrics.py
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

