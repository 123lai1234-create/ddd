# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
# astro/dist/ IS tracked for Vercel static deploy (2026-07-31 fix after 404):
# Vercel Hobby auto-deploy + framework:null cache is broken; we ship
# prebuilt dist in git so Vercel doesn't need to run npm install / build
# itself. See vercel.json buildCommand:null.
tmp
out-tsc
*.tsbuildinfo

# pagefind search index (generated by astro build)
/pagefind
**/pagefind/

# secrets / local env — never commit
.env
.env.*
!.env.example
.envrc
/.secrets/

# platform / agent metadata (rebuildable)
/.mavis/
/.opencode/
/.netlify/
/.wrangler/
/.vercel/
/.replit/

# Python cruft
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.python-version
.venv/
.vercel_python_packages/
artifacts/pip_install.log

# ML model artifacts
*.pt
*.pth
*.onnx

# Dogfood QA scratch space
/dogfood-donttalk/

# Replit-pushed monorepo (separate project, NOT part of ddd)
/dontalk-import/

# Astro build scratch
astro/__extract_bodies.py
astro/_nav.json
astro/.netlify/

# mavis / playwright browser debug stash
.tmp/
.tmp*

# Astro lyrics-alignment experiments (scratch)
astro/scripts/_align_*.txt
astro/scripts/align_lyrics.py
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Archived legacy projects (Phase 2 cleanup 2026-07-23)
/api.disabled/
/api.disabled/**
/dontalk-redirect/
/donttalk-redirect/**

# chat-bot is a separate sub-repo with its own .git/ (carried over from clone).
# Its files are NOT part of ddd. Ignore the whole tree to prevent accidental
# commits leaking donttalk-scraper source into this repo.
/chat-bot/
/chat-bot/**

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

.vercel
.vercel_python_packages/
.netlify/
.wrangler/
.railway/
.env
.env*.local
.hftoken
.env*
.trash-nested-git/
