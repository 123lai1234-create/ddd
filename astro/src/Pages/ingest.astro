---
import Base from '../layouts/Base.astro';
const bodyHtml = "\n    <div data-site-nav></div>\n\n    <section class=\"ig-hero\">\n        <h1>🛰 Ingest Console</h1>\n        <p>從來源網站抓取資料，寫入後台 PostgreSQL。蛋白質 → UniProt；基因 → Ensembl；股票 / ETF → TWSE + Yahoo；期貨 → TAIFEX + Yahoo。</p>\n        <div class=\"ig-warn\">⚠ 此頁為管理後台。所有操作需先填 X-Sync-Secret（只有擁有者知道）。Secret 僅存在此瀏覽器的 sessionStorage。</div>\n    </section>\n\n    <div class=\"ig-wrap\">\n        <div class=\"ig-card\" style=\"grid-column:1 / -1\">\n            <h2>🔑 Sync Secret</h2>\n            <div class=\"ig-secret-row\">\n                <input id=\"igSecret\" type=\"password\" placeholder=\"X-Sync-Secret（擁有者填入）\" autocomplete=\"off\">\n                <button class=\"ig-btn secondary\" style=\"width:auto;padding:10px 18px\" onclick=\"saveSecret()\">記住</button>\n                <button class=\"ig-btn secondary\" style=\"width:auto;padding:10px 18px\" onclick=\"clearSecret()\">清除</button>\n            </div>\n            <div class=\"ig-hint\">本欄位僅存在當前瀏覽器分頁，關閉即失效。不會送到前端日誌。</div>\n        </div>\n\n        <div class=\"ig-card\">\n            <h2>🧬 蛋白質 / 基因序列</h2>\n            <div class=\"ig-field\">\n                <label>Protein Query（UniProt 關鍵字）</label>\n                <input id=\"igPQuery\" type=\"text\" value=\"kinase\">\n            </div>\n            <div class=\"ig-field\">\n                <label>Gene Symbols（逗號分隔）</label>\n                <input id=\"igGenes\" type=\"text\" value=\"TP53, BRCA1, EGFR, APOE\">\n            </div>\n            <div class=\"ig-field\">\n                <label>Species（Ensembl species 名稱）</label>\n                <input id=\"igSpecies\" type=\"text\" value=\"homo_sapiens\">\n            </div>\n            <div class=\"ig-field\">\n                <label>Limit（每類最多筆數 1–8）</label>\n                <input id=\"igLimit\" type=\"number\" value=\"4\" min=\"1\" max=\"8\">\n            </div>\n            <button class=\"ig-btn\" onclick=\"syncSequences()\">▶ 抓取並寫入 DB</button>\n            <div class=\"ig-status\" id=\"igSeqStatus\"></div>\n            <div class=\"ig-mini\"><span>UniProt REST</span><span>Ensembl REST</span><span>upsert by (source, source_id)</span></div>\n        </div>\n\n        <div class=\"ig-card\">\n            <h2>📈 股票 / ETF / 期貨</h2>\n            <div class=\"ig-field\">\n                <label>Stock Symbols（TWSE 代號，逗號分隔）</label>\n                <input id=\"igStocks\" type=\"text\" value=\"2330, 2317, 2609\">\n            </div>\n            <div class=\"ig-field\">\n                <label>ETF Symbols（TWSE 代號）</label>\n                <input id=\"igEtfs\" type=\"text\" value=\"0050, 0056, 006208\">\n            </div>\n            <div class=\"ig-field\">\n                <label>Futures Symbols（Yahoo 格式 e.g. ES=F）</label>\n                <input id=\"igFutures\" type=\"text\" value=\"ES=F, NQ=F, TX=F\">\n            </div>\n            <div class=\"ig-field\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px\">\n                <div>\n                    <label>TWSE 月數（1–12）</label>\n                    <input id=\"igMonths\" type=\"number\" value=\"3\" min=\"1\" max=\"12\">\n                </div>\n                <div>\n                    <label>Yahoo Range</label>\n                    <select id=\"igRange\">\n                        <option value=\"1mo\">1mo</option>\n                        <option value=\"3mo\" selected>3mo</option>\n                        <option value=\"6mo\">6mo</option>\n                        <option value=\"1y\">1y</option>\n                        <option value=\"2y\">2y</option>\n                        <option value=\"5y\">5y</option>\n                    </select>\n                </div>\n            </div>\n            <button class=\"ig-btn\" onclick=\"syncMarket()\">▶ 抓取並寫入 DB</button>\n            <div class=\"ig-status\" id=\"igMktStatus\"></div>\n            <div class=\"ig-mini\"><span>TWSE exchangeReport</span><span>Yahoo Finance chart</span><span>TAIFEX fut reports</span></div>\n        </div>\n\n        <div class=\"ig-card ig-result\">\n            <h2>📦 Last Response</h2>\n            <pre id=\"igOut\">尚無回應。點擊任一「抓取並寫入 DB」開始。</pre>\n        </div>\n    </div>\n\n    <div data-site-footer></div>\n    <button class=\"scroll-top\" aria-label=\"返回頂部\">↑</button>\n\n    <script>\n        const SKEY = 'ingest_sync_secret';\n        const secretEl = document.getElementById('igSecret');\n        secretEl.value = sessionStorage.getItem(SKEY) || '';\n\n        function saveSecret() { sessionStorage.setItem(SKEY, secretEl.value || ''); setStatus('igSeqStatus', '✓ Secret saved for this session', 'ok'); }\n        function clearSecret() { sessionStorage.removeItem(SKEY); secretEl.value = ''; setStatus('igSeqStatus', '✓ Cleared', 'ok'); }\n        window.saveSecret = saveSecret; window.clearSecret = clearSecret;\n\n        function setStatus(id, msg, cls) {\n            const el = document.getElementById(id); el.textContent = msg; el.className = 'ig-status' + (cls ? ' ' + cls : '');\n        }\n        function showOut(data) { document.getElementById('igOut').textContent = typeof data === 'string' ? data : JSON.stringify(data, null, 2); }\n        function splitCsv(v) { return String(v || '').split(',').map(s => s.trim()).filter(Boolean); }\n\n        async function apiBase() {\n            try {\n                if (typeof resolvePortfolioApiBase === 'function') {\n                    const b = await resolvePortfolioApiBase(); if (b) return b;\n                }\n            } catch(e) {}\n            return (window.APP_CONFIG?.API_BASE_URL || '').replace(/\\/+$/, '');\n        }\n\n        async function post(path, body) {\n            const base = await apiBase();\n            const secret = secretEl.value.trim();\n            if (!secret) throw new Error('X-Sync-Secret 未填');\n            const res = await fetch(base + path, {\n                method: 'POST',\n                headers: {'Content-Type': 'application/json', 'X-Sync-Secret': secret},\n                body: JSON.stringify(body)\n            });\n            const text = await res.text();\n            let data; try { data = JSON.parse(text); } catch { data = text; }\n            if (!res.ok) { const msg = data?.detail || res.statusText; throw new Error(`HTTP ${res.status}: ${msg}`); }\n            return data;\n        }\n\n        async function syncSequences() {\n            const btn = event.target; btn.disabled = true;\n            setStatus('igSeqStatus', '⏳ 抓取中…');\n            try {\n                const data = await post('/api/sequences/sync', {\n                    protein_query: document.getElementById('igPQuery').value.trim(),\n                    gene_symbols: splitCsv(document.getElementById('igGenes').value),\n                    species: document.getElementById('igSpecies').value.trim(),\n                    limit: Number(document.getElementById('igLimit').value) || 4,\n                });\n                const n = (data.stored?.protein || 0) + (data.stored?.gene || 0);\n                setStatus('igSeqStatus', `✓ 寫入 ${n} 筆（蛋白 ${data.stored?.protein || 0} · 基因 ${data.stored?.gene || 0}）`, 'ok');\n                showOut(data);\n            } catch (err) {\n                setStatus('igSeqStatus', `✗ ${err.message}`, 'err');\n                showOut(err.message);\n            } finally { btn.disabled = false; }\n        }\n        window.syncSequences = syncSequences;\n\n        async function syncMarket() {\n            const btn = event.target; btn.disabled = true;\n            setStatus('igMktStatus', '⏳ 抓取中…');\n            try {\n                const data = await post('/api/market/sync', {\n                    stock_symbols: splitCsv(document.getElementById('igStocks').value),\n                    etf_symbols: splitCsv(document.getElementById('igEtfs').value),\n                    futures_symbols: splitCsv(document.getElementById('igFutures').value),\n                    twse_months: Number(document.getElementById('igMonths').value) || 3,\n                    yahoo_range: document.getElementById('igRange').value,\n                });\n                const s = data.stored || {};\n                const total = Object.values(s).reduce((a,b) => a + (b.bars || 0), 0);\n                setStatus('igMktStatus', `✓ 寫入 ${total} 筆 bars（stock ${s.stock?.bars||0} · etf ${s.etf?.bars||0} · fut ${s.futures?.bars||0}）`, 'ok');\n                showOut(data);\n            } catch (err) {\n                setStatus('igMktStatus', `✗ ${err.message}`, 'err');\n                showOut(err.message);\n            } finally { btn.disabled = false; }\n        }\n        window.syncMarket = syncMarket;\n    </script>\n";
const headInline = "";
---
<Base
    title="資料抓取 · Ingest Console"
    description="後台資料抓取：蛋白質 / 基因序列 (UniProt / Ensembl)、股票 / ETF / 期貨 (TWSE / Yahoo / TAIFEX)，直接 upsert 到 PostgreSQL。需 X-Sync-Secret。"
    bodyPage="ingest"
    pageStyles={[]}
    pageScripts={[]}
    headInline={headInline}
>
    <Fragment set:html={bodyHtml} />
</Base>
