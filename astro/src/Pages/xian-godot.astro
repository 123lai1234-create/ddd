---
import Base from '../layouts/Base.astro';
---
<Base
  title="仙境傳說 — 仙俠 RPG"
  description="純程序生成畫面的 Godot 4 回合制 RPG，在瀏覽器直接遊玩。"
  ogTag="Game"
  bodyPage="game"
>
  <div class="game-shell">
    <div class="game-frame-wrap">
      <iframe
        id="game-frame"
        src="/games/xian-godot/"
        title="仙境傳說"
        allowfullscreen
        loading="lazy"
      ></iframe>
      <div class="overlay" id="overlay">
        <button id="play-btn" aria-label="開始遊戲">▶ 點擊開始</button>
      </div>
    </div>
    <div class="controls">
      <span>↑↓←→ 移動</span>
      <span>Z / Enter 確認</span>
      <span>X / Esc 取消・選單</span>
      <button id="fs-btn" title="全螢幕">⛶</button>
    </div>
  </div>
</Base>

<style>
  :root { --game-w: 480px; --game-h: 854px; }

  .game-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    background: #0c0418;
    gap: 0.6rem;
    padding: 1rem;
  }

  .game-frame-wrap {
    position: relative;
    width: min(var(--game-w), 100vw);
    aspect-ratio: 480 / 854;
    border: 1px solid #7a5c1e88;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 0 40px #7a5c1e22;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0c041899;
    backdrop-filter: blur(2px);
    transition: opacity 0.3s;
  }
  .overlay.hidden { opacity: 0; pointer-events: none; }

  #play-btn {
    padding: 0.7rem 2rem;
    font-size: 1.1rem;
    background: #7a5c1e;
    color: #ffd700;
    border: 1px solid #ffd70066;
    border-radius: 4px;
    cursor: pointer;
    letter-spacing: 0.1em;
    transition: background 0.2s;
  }
  #play-btn:hover { background: #9a7828; }

  .controls {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 0.78rem;
    color: #c8a06099;
    font-family: monospace;
  }
  .controls span::before { content: "·  "; }

  #fs-btn {
    background: none;
    border: 1px solid #7a5c1e66;
    color: #c8a060;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
  }
  #fs-btn:hover { border-color: #ffd700; color: #ffd700; }
</style>

<script>
  const overlay = document.getElementById('overlay')!;
  const btn     = document.getElementById('play-btn')!;
  const frame   = document.getElementById('game-frame') as HTMLIFrameElement;
  const fsBtn   = document.getElementById('fs-btn')!;
  const wrap    = frame.closest('.game-frame-wrap') as HTMLElement;

  btn.addEventListener('click', () => {
    overlay.classList.add('hidden');
    frame.focus();
  });

  fsBtn.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      wrap.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen();
    }
  });

  // Focus game on click anywhere in frame area
  wrap.addEventListener('click', () => {
    if (overlay.classList.contains('hidden')) frame.focus();
  });
</script>
