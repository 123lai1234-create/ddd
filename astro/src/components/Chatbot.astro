---
/**
 * Chatbot.astro — site-wide AI assistant floating widget.
 * Kawaii 2D avatar + chat panel, drag-to-move, mouse-tracking tilt,
 * local knowledge base + /api/chat fallback. No 3D, no Three.js.
 *
 * Used by `Base.astro` so every page has it.
 */
---

<!-- 元嬰不說 kawaii 人偶按鈕（可拖曳 + 滑鼠追蹤 + 飄浮 + 輕眨眼） -->
<div id="chatbot-anchor" aria-label="元嬰不說（可拖曳）" role="button" tabindex="0">
  <div class="kawaii-stage" id="kawaii-stage">
    <img class="kawaii-img" src="/img/q-avatar.png" alt="元嬰不說頭像" draggable="false" />
    <span class="char-drag-hint" aria-hidden="true">✥ 拖曳</span>
  </div>

  <div id="chatbot-panel">
    <div class="chatbot-header">
      <div class="chatbot-title">
        <span class="chatbot-status-dot"></span>
        <h4>元嬰不說</h4>
      </div>
      <div class="chatbot-actions">
        <button class="chatbot-reset" aria-label="重新開始" title="重新開始對話">↻</button>
        <button class="chatbot-close" aria-label="關閉">✕</button>
      </div>
    </div>
    <div id="chatbot-messages">
      <div class="chat-msg chat-bot">
        你好！我是元嬰不說，<strong>不說</strong> 的作品集助手 🤖<br/>
        可以問我關於他的學經歷、技術專長、或是作品集內容。
      </div>
      <div class="chat-suggestions" id="chat-suggestions">
        <button class="chat-chip" data-q="你的背景是什麼？">🎓 背景學歷</button>
        <button class="chat-chip" data-q="你會哪些技術？">💻 技術專長</button>
        <button class="chat-chip" data-q="推薦蛋白質 AI 作品">🧬 蛋白質 AI</button>
        <button class="chat-chip" data-q="如何聯絡你？">📧 聯絡方式</button>
      </div>
    </div>
    <div class="chatbot-input-row">
      <input id="chatbot-input" type="text" placeholder="輸入訊息..." autocomplete="off" />
      <button id="chatbot-send" aria-label="送出">➤</button>
    </div>
  </div>
</div>

<style is:global>
  /* === Floating kawaii character anchor === */
  #chatbot-anchor {
    position: fixed;
    bottom: 90px;
    right: 24px;
    z-index: 500;
    width: 80px;
    height: 80px;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.45));
    transition: filter 0.25s;
    will-change: transform;
  }
  #chatbot-anchor:hover {
    filter: drop-shadow(0 8px 22px rgba(88, 215, 255, 0.45));
  }
  #chatbot-anchor:active { cursor: grabbing; }
  #chatbot-anchor.dragging {
    cursor: grabbing;
    filter: drop-shadow(0 12px 28px rgba(88, 215, 255, 0.6));
  }
  #chatbot-anchor:focus-visible {
    outline: 2px solid #58d7ff;
    outline-offset: 6px;
    border-radius: 12px;
  }

  .kawaii-stage {
    width: 100%;
    height: 100%;
    position: relative;
    transform-origin: 50% 50%;
    transition: transform 0.18s ease-out;
  }

  .kawaii-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
    animation: kawaii-float 3.2s ease-in-out infinite;
    transform-origin: 50% 50%;
    border-radius: 50%;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Floating bobbing animation */
  @keyframes kawaii-float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50%      { transform: translateY(-4px) rotate(2deg); }
  }

  .char-drag-hint {
    position: absolute;
    top: -10px;
    right: -10px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 10px;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
    white-space: nowrap;
  }
  #chatbot-anchor:hover .char-drag-hint {
    opacity: 1;
    transform: scale(1);
  }
  #chatbot-anchor.dragging .char-drag-hint { opacity: 0; }
</style>

<script is:inline>
(function() {
    const SYSTEM = `你是「元嬰不說」，這個作品集網站的 AI 助手，自我介紹時請用「元嬰不說」這個名字，不要寫「(AI 助手)」之類的標籤或簽名。「不說」是 persona 的一部分——keep it short、安靜、沉穩，該講的還是要講清楚。作者是一位擁有電資工程與生物醫學雙碩士的跨域工程師（JT Lai）。
專長：ESM-2 蛋白質語言模型、ProteinMPNN、Bayesian Optimization（BoTorch/qLogEI）、REINFORCE RL、FastAPI、Astro、NGS 分析（RNA-seq/WGS/scRNA）、PostgreSQL、台股市場資料平台。
請用繁體中文回答，保持專業友善、沉穩簡潔，回答不超過 200 字。只回答與作品集相關的問題。回覆中不要出現 <think> 之類的內部推理標籤。`;

    // Local knowledge base — works even when /api/chat is unreachable
    const KB = [
        {
            keys: ['背景', '學歷', '碩士', '經歷', '介紹', 'about', '履歷', 'bio'],
            reply: '我是 JT Lai，擁有電資工程（北科電子所）與生物醫學（陽明交大解剖細胞生物所）雙碩士背景。\n\n研究主題涵蓋蛋白質 AI 設計、基因體分析與量化交易，現在專注於把研究做成可操作的 AI 平台。\n\n👉 詳細看 /about 頁面',
        },
        {
            keys: ['技術', '會什麼', 'skill', '專長', 'stack', '語言'],
            reply: '主要技術棧：\n\n• **AI/ML**：PyTorch、ESM-2、ProteinMPNN、BoTorch、REINFORCE\n• **後端**：FastAPI、Python、PostgreSQL、Neon、psycopg\n• **前端**：Astro、React、TypeScript、Chart.js\n• **NGS**：RNA-seq、WGS、scRNA-seq 流程\n• **資料平台**：TWSE、Yahoo Finance、FinMind\n\n👉 看 /works 看實際作品',
        },
        {
            keys: ['蛋白質', 'mpnn', 'esm', 'protein', 'rosetta'],
            reply: '蛋白質 AI 是核心專長，涵蓋：\n\n• **ESM-2**：蛋白質語言模型 embedding\n• **ProteinMPNN**：序列設計\n• **BoTorch / qLogEI**：Bayesian Optimization 主動學習\n• **REINFORCE**：序列微調\n• **3D 結構預覽** + **Rosetta** 簡化評分\n\n👉 /protein-mpnn 直接玩互動工作台\n👉 /report 看完整技術報告',
        },
        {
            keys: ['基因', 'gene', 'ngs', '定序', 'crispr'],
            reply: '基因體領域的兩個主要作品：\n\n• **Gene AI 平台** (/gene-ai)：序列資料庫、RAG 文件搜尋、啟動子設計、CRISPR 導引排序、變異效應評估\n• **NGS 工作站** (/ngs)：實驗設計計算器、定序深度估算、QC 到功能分析\n\n背後串接 UniProt、Ensembl、PubMed、OpenAlex 等公開 API。',
        },
        {
            keys: ['論文', '研究', 'thesis', '量化', '遺傳'],
            reply: '碩士論文主題：以 48 檔 ETF50 股票池重建 PPTS × GAPPTS 遺傳演算法。\n\n比較族群演化過程、逐檔回測表現，並用 GA + 量化指標做策略驗證。\n\n👉 /thesis 看完整論文頁面',
        },
        {
            keys: ['作品', '作品集', 'project', '作品總覽', 'portfolio'],
            reply: '主要作品分類：\n\n🧬 **Protein**：蛋白質 AI 設計系統、ProteinMPNN 互動工作台\n🔬 **Genomics**：基因 AI 平台、NGS 工作站\n📖 **Research**：遺傳演算法論文、技術部落格\n💼 **Other**：面試準備手冊、作品總覽\n\n👉 /works 一覽所有作品',
        },
        {
            keys: ['聯絡', 'email', 'mail', '合作', 'contact'],
            reply: '📧 主要聯絡方式在 /about 頁面底部。\n\nGitHub: github.com/123lai1234-create\nHuggingFace: huggingface.co/Donttalk123\n\n面試或合作邀約都可以直接寫信。',
        },
        {
            keys: ['demo', '範例', '相似度', '互動'],
            reply: '首頁就有兩個即時 demo：\n\n1. **ESM-2 相似度計算**：輸入兩段蛋白質序列，看 embedding 之間的 cosine similarity\n2. **GitHub 開源活動**：自動抓 repo、stars、followers 統計\n\n往下捲就能玩。',
        },
        {
            keys: ['你好', 'hi', 'hello', '嗨', '哈囉'],
            reply: '你好！👋 試試點下面的快速問題，或直接問我有關 JT 的背景、技術、作品集的任何問題。',
        },
    ];

    function findLocalReply(q) {
        const lower = q.toLowerCase();
        for (const item of KB) {
            if (item.keys.some((k) => lower.includes(k.toLowerCase()))) {
                return item.reply;
            }
        }
        return null;
    }

    function stripThink(s) {
        return String(s == null ? '' : s)
            .replace(/<think>[\s\S]*?<\/think>/gi, '')
            .replace(/<thinking>[\s\S]*?<\/thinking>/gi, '')
            .trim();
    }

    let history = [];
    let busy = false;

    const anchor = document.getElementById('chatbot-anchor');
    if (!anchor) return; // component not on this page

    const stage  = document.getElementById('kawaii-stage');
    const panel  = document.getElementById('chatbot-panel');
    const close  = document.querySelector('.chatbot-close');
    const reset  = document.querySelector('.chatbot-reset');
    const msgs   = document.getElementById('chatbot-messages');
    const input  = document.getElementById('chatbot-input');
    const send   = document.getElementById('chatbot-send');
    const chips  = document.querySelectorAll('.chat-chip');

    /* ── Open / close panel ───────────────────────────────────────── */
    function openPanel() {
        anchor.classList.add('panel-open');
        setTimeout(() => input?.focus(), 200);
    }
    function closePanel() {
        anchor.classList.remove('panel-open');
    }
    function isPanelOpen() { return anchor.classList.contains('panel-open'); }

    /* ── Drag-to-move the character anywhere on screen ───────────── */
    let dragging = false;
    let dragPointerId = null;
    let dragOffset = { x: 0, y: 0 };
    let didDrag = false;

    function isInsideAnchor(e) {
        const r = anchor.getBoundingClientRect();
        return e.clientX >= r.left && e.clientX <= r.right
            && e.clientY >= r.top  && e.clientY <= r.bottom;
    }

    function onPointerDown(e) {
        if (e.target.closest('#chatbot-panel')) return;
        if (e.button !== undefined && e.button !== 0) return;
        if (!isInsideAnchor(e)) return;
        dragging = true;
        didDrag = false;
        dragPointerId = e.pointerId;
        const rect = anchor.getBoundingClientRect();
        dragOffset.x = e.clientX - rect.left;
        dragOffset.y = e.clientY - rect.top;
        anchor.style.bottom = 'auto';
        anchor.style.right = 'auto';
        anchor.style.left = `${rect.left}px`;
        anchor.style.top = `${rect.top}px`;
        anchor.classList.add('dragging');
        try { anchor.setPointerCapture(e.pointerId); } catch (_) {}
        e.preventDefault();
    }

    function onPointerMove(e) {
        if (!dragging || e.pointerId !== dragPointerId) return;
        const newLeft = e.clientX - dragOffset.x;
        const newTop  = e.clientY - dragOffset.y;
        const maxX = window.innerWidth - anchor.offsetWidth;
        const maxY = window.innerHeight - anchor.offsetHeight;
        const x = Math.max(0, Math.min(newLeft, maxX));
        const y = Math.max(0, Math.min(newTop, maxY));
        anchor.style.left = `${x}px`;
        anchor.style.top = `${y}px`;
        didDrag = true;
    }

    function onPointerUp(e) {
        if (!dragging) return;
        if (e.pointerId !== dragPointerId) return;
        const moved = didDrag;
        dragging = false;
        dragPointerId = null;
        anchor.classList.remove('dragging');
        try {
            const rect = anchor.getBoundingClientRect();
            localStorage.setItem('chatbot_anchor_pos', JSON.stringify({
                left: rect.left, top: rect.top,
            }));
        } catch (_) {}
        if (!moved) {
            if (isPanelOpen()) closePanel();
            else openPanel();
        }
    }

    document.addEventListener('pointerdown', onPointerDown, { capture: true });
    document.addEventListener('pointermove', onPointerMove, { capture: true });
    document.addEventListener('pointerup', onPointerUp, { capture: true });
    document.addEventListener('pointercancel', () => {
        if (!dragging) return;
        dragging = false;
        dragPointerId = null;
        anchor.classList.remove('dragging');
    }, { capture: true });

    anchor.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            isPanelOpen() ? closePanel() : openPanel();
        }
    });

    close?.addEventListener('click', (e) => { e.stopPropagation(); closePanel(); });
    reset?.addEventListener('click', (e) => {
        e.stopPropagation();
        history = [];
        msgs.innerHTML = '';
        addMsg('bot', '對話已重置。問我任何問題吧！');
        showChips();
    });

    send.addEventListener('click', submit);
    input.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(); }
    });

    chips.forEach((c) => {
        c.addEventListener('click', () => {
            input.value = c.dataset.q;
            submit();
        });
    });

    try {
        const saved = JSON.parse(localStorage.getItem('chatbot_anchor_pos') || 'null');
        if (saved && typeof saved.left === 'number' && typeof saved.top === 'number') {
            anchor.style.bottom = 'auto';
            anchor.style.right = 'auto';
            anchor.style.left = `${saved.left}px`;
            anchor.style.top = `${saved.top}px`;
        }
    } catch (_) {}

    async function submit() {
        const text = input.value.trim();
        if (!text || busy) return;
        input.value = '';
        addMsg('user', text);
        history.push({ role: 'user', content: text });
        hideChips();
        setBusy(true);

        let reply = null;
        try {
            const apiBase = (typeof window.APP_CONFIG_UTILS?.resolveApiBase === 'function')
                ? await window.APP_CONFIG_UTILS.resolveApiBase({ cacheKey: 'chatbot' })
                : '';
            const endpoint = apiBase ? `${apiBase}/api/chat` : '/api/chat';
            const res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ system: SYSTEM, messages: history.slice(-10) }),
                signal: AbortSignal.timeout(20000),
            });
            if (res.ok) {
                const data = await res.json();
                reply = data.reply ?? data.content?.[0]?.text ?? null;
                if (reply) history.push({ role: 'assistant', content: stripThink(reply) });
            }
        } catch (_) {}

        if (!reply) {
            const local = findLocalReply(text);
            if (local) {
                reply = local + '\n\n_(本機離線回覆，AI 模型目前未連線)_';
            } else {
                reply = `目前 AI 模型暫時無法連線，也沒有對應到本機知識庫。\n\n你問的「${text}」可以試著換個關鍵字（例如：背景、技術、作品、聯絡）。`;
            }
        }

        addMsg('bot', reply, true);
        setBusy(false);
    }

    function hideChips() {
        const wrap = document.getElementById('chat-suggestions');
        if (wrap) wrap.style.display = 'none';
    }

    function showChips() {
        const wrap = document.getElementById('chat-suggestions');
        if (wrap) wrap.style.display = '';
    }

    function addMsg(role, text, allowMarkdown = false) {
        const d = document.createElement('div');
        d.className = `chat-msg chat-${role}`;
        if (allowMarkdown) {
            d.innerHTML = escapeHtml(text)
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
                .replace(/\n/g, '<br/>');
        } else {
            d.textContent = text;
        }
        msgs.appendChild(d);
        msgs.scrollTop = msgs.scrollHeight;
    }

    function escapeHtml(s) {
        return String(s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function setBusy(v) {
        busy = v; send.disabled = v; input.disabled = v;
        document.getElementById('chat-typing')?.remove();
        if (v) {
            const t = document.createElement('div');
            t.id = 'chat-typing';
            t.className = 'chat-msg chat-bot chat-typing';
            t.innerHTML = '<span></span><span></span><span></span>';
            msgs.appendChild(t);
            msgs.scrollTop = msgs.scrollHeight;
        }
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isPanelOpen()) {
            closePanel();
        }
    });

    /* ── Mouse tracking: tilt image slightly toward cursor ───── */
    if (stage) {
        const maxYaw = 18;   // degrees
        const maxPitch = 12;
        let targetYaw = 0, targetPitch = 0;
        let currentYaw = 0, currentPitch = 0;
        let rafId = null;

        function trackPointer(clientX, clientY) {
            if (dragging || anchor.classList.contains('panel-open')) {
                targetYaw = 0;
                targetPitch = 0;
                return;
            }
            const r = anchor.getBoundingClientRect();
            const cx = r.left + r.width / 2;
            const cy = r.top + r.height / 2;
            const dx = (clientX - cx) / (window.innerWidth / 2);
            const dy = (clientY - cy) / (window.innerHeight / 2);
            targetYaw   = Math.max(-1, Math.min(1, dx)) * maxYaw;
            targetPitch = Math.max(-1, Math.min(1, -dy)) * maxPitch;
        }

        function tick() {
            currentYaw   += (targetYaw   - currentYaw)   * 0.12;
            currentPitch += (targetPitch - currentPitch) * 0.12;
            stage.style.transform = `rotateY(${currentYaw}deg) rotateX(${currentPitch}deg)`;
            rafId = requestAnimationFrame(tick);
        }

        window.addEventListener('pointermove', (e) => {
            trackPointer(e.clientX, e.clientY);
        }, { passive: true });

        if (!rafId) tick();
    }
})();
</script>
