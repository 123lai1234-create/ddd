---
/**
 * Chatbot.astro — site-wide AI assistant floating widget.
 * Includes the 3D chibi character, chat panel, drag-to-move,
 * mouse-tracking, and the local knowledge base + /api/chat fallback.
 *
 * Used by `Base.astro` so every page has it.
 */
---

<!-- AI 助手 3D 人偶按鈕（可拖曳 + 滑鼠 3D 追蹤） -->
<div id="chatbot-anchor" aria-label="AI 助手（可拖曳）" role="button" tabindex="0">
  <div class="char-3d" id="chatbot-3d">
    <canvas id="char-canvas" aria-hidden="true"></canvas>
    <span class="char-drag-hint" aria-hidden="true">✥ 拖曳</span>
  </div>

  <div id="chatbot-panel">
    <div class="chatbot-header">
      <div class="chatbot-title">
        <span class="chatbot-status-dot"></span>
        <h4>AI 助手</h4>
      </div>
      <div class="chatbot-actions">
        <button class="chatbot-reset" aria-label="重新開始" title="重新開始對話">↻</button>
        <button class="chatbot-close" aria-label="關閉">✕</button>
      </div>
    </div>
    <div id="chatbot-messages">
      <div class="chat-msg chat-bot">
        你好！我是 JT 的作品集助手 🤖<br/>
        可以問我關於他的學經歷、技術專長、或是作品集內容。
      </div>
      <div class="chat-suggestions" id="chat-suggestions">
        <button class="chat-chip" data-q="你的背景是什麼？">🎓 背景學歷</button>
        <button class="chat-chip" data-q="你會哪些技術？">💻 技術專長</button>
        <button class="chat-chip" data-q="推薦蛋白質 AI 作品">🧬 蛋白質 AI</button>
        <button class="chat-chip" data-q="如何聯絡你？">📧 聯絡方式</button>
      </div>
    </div>
    <div class="chatbot-input-row">
      <input id="chatbot-input" type="text" placeholder="輸入訊息..." autocomplete="off" />
      <button id="chatbot-send" aria-label="送出">➤</button>
    </div>
  </div>
</div>

<style is:global>
  /* === Floating 3D character anchor === */
  #chatbot-anchor {
    position: fixed;
    bottom: 90px;
    right: 24px;
    z-index: 500;
    width: 80px;
    height: 80px;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.45));
    transition: filter 0.25s;
    will-change: transform;
  }
  #chatbot-anchor:hover {
    filter: drop-shadow(0 8px 22px rgba(88, 215, 255, 0.45));
  }
  #chatbot-anchor:active { cursor: grabbing; }
  #chatbot-anchor.dragging {
    cursor: grabbing;
    filter: drop-shadow(0 12px 28px rgba(88, 215, 255, 0.6));
  }
  #chatbot-anchor:focus-visible {
    outline: 2px solid #58d7ff;
    outline-offset: 6px;
    border-radius: 12px;
  }

  .char-3d {
    width: 100%;
    height: 100%;
    position: relative;
  }
  #char-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .char-drag-hint {
    position: absolute;
    top: -10px;
    right: -10px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 10px;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
    white-space: nowrap;
  }
  #chatbot-anchor:hover .char-drag-hint {
    opacity: 1;
    transform: scale(1);
  }
  #chatbot-anchor.dragging .char-drag-hint { opacity: 0; }
</style>

<script is:inline>
(function() {
    const SYSTEM = `你是這個作品集網站的 AI 助手。作者是一位擁有電資工程與生物醫學雙碩士的跨域工程師（JT Lai）。
專長：ESM-2 蛋白質語言模型、ProteinMPNN、Bayesian Optimization（BoTorch/qLogEI）、REINFORCE RL、FastAPI、Astro、NGS 分析（RNA-seq/WGS/scRNA）、PostgreSQL、台股市場資料平台。
請用繁體中文回答，保持專業友善，回答不超過 200 字。只回答與作品集相關的問題。`;

    // Local knowledge base — works even when /api/chat is unreachable
    const KB = [
        {
            keys: ['背景', '學歷', '碩士', '經歷', '介紹', 'about', '履歷', 'bio'],
            reply: '我是 JT Lai，擁有電資工程（北科電子所）與生物醫學（陽明交大解剖細胞生物所）雙碩士背景。\n\n研究主題涵蓋蛋白質 AI 設計、基因體分析與量化交易，現在專注於把研究做成可操作的 AI 平台。\n\n👉 詳細看 /about 頁面',
        },
        {
            keys: ['技術', '會什麼', 'skill', '專長', 'stack', '語言'],
            reply: '主要技術棧：\n\n• **AI/ML**：PyTorch、ESM-2、ProteinMPNN、BoTorch、REINFORCE\n• **後端**：FastAPI、Python、PostgreSQL、Neon、psycopg\n• **前端**：Astro、React、TypeScript、Chart.js\n• **NGS**：RNA-seq、WGS、scRNA-seq 流程\n• **資料平台**：TWSE、Yahoo Finance、FinMind\n\n👉 看 /works 看實際作品',
        },
        {
            keys: ['蛋白質', 'mpnn', 'esm', 'protein', 'rosetta'],
            reply: '蛋白質 AI 是核心專長，涵蓋：\n\n• **ESM-2**：蛋白質語言模型 embedding\n• **ProteinMPNN**：序列設計\n• **BoTorch / qLogEI**：Bayesian Optimization 主動學習\n• **REINFORCE**：序列微調\n• **3D 結構預覽** + **Rosetta** 簡化評分\n\n👉 /protein-mpnn 直接玩互動工作台\n👉 /report 看完整技術報告',
        },
        {
            keys: ['基因', 'gene', 'ngs', '定序', 'crispr'],
            reply: '基因體領域的兩個主要作品：\n\n• **Gene AI 平台** (/gene-ai)：序列資料庫、RAG 文件搜尋、啟動子設計、CRISPR 導引排序、變異效應評估\n• **NGS 工作站** (/ngs)：實驗設計計算器、定序深度估算、QC 到功能分析\n\n背後串接 UniProt、Ensembl、PubMed、OpenAlex 等公開 API。',
        },
        {
            keys: ['論文', '研究', 'thesis', '量化', '遺傳'],
            reply: '碩士論文主題：以 48 檔 ETF50 股票池重建 PPTS × GAPPTS 遺傳演算法。\n\n比較族群演化過程、逐檔回測表現，並用 GA + 量化指標做策略驗證。\n\n👉 /thesis 看完整論文頁面',
        },
        {
            keys: ['作品', '作品集', 'project', '作品總覽', 'portfolio'],
            reply: '主要作品分類：\n\n🧬 **Protein**：蛋白質 AI 設計系統、ProteinMPNN 互動工作台\n🔬 **Genomics**：基因 AI 平台、NGS 工作站\n📖 **Research**：遺傳演算法論文、技術部落格\n💼 **Other**：面試準備手冊、作品總覽\n\n👉 /works 一覽所有作品',
        },
        {
            keys: ['聯絡', 'email', 'mail', '合作', 'contact'],
            reply: '📧 主要聯絡方式在 /about 頁面底部。\n\nGitHub: github.com/123lai1234-create\nHuggingFace: huggingface.co/Donttalk123\n\n面試或合作邀約都可以直接寫信。',
        },
        {
            keys: ['demo', '範例', '相似度', '互動'],
            reply: '首頁就有兩個即時 demo：\n\n1. **ESM-2 相似度計算**：輸入兩段蛋白質序列，看 embedding 之間的 cosine similarity\n2. **GitHub 開源活動**：自動抓 repo、stars、followers 統計\n\n往下捲就能玩。',
        },
        {
            keys: ['你好', 'hi', 'hello', '嗨', '哈囉'],
            reply: '你好！👋 試試點下面的快速問題，或直接問我有關 JT 的背景、技術、作品集的任何問題。',
        },
    ];

    function findLocalReply(q) {
        const lower = q.toLowerCase();
        for (const item of KB) {
            if (item.keys.some((k) => lower.includes(k.toLowerCase()))) {
                return item.reply;
            }
        }
        return null;
    }

    let history = [];
    let busy = false;

    const anchor = document.getElementById('chatbot-anchor');
    if (!anchor) return; // component not on this page

    const avatar = document.getElementById('chatbot-3d');
    const panel  = document.getElementById('chatbot-panel');
    const close  = document.querySelector('.chatbot-close');
    const reset  = document.querySelector('.chatbot-reset');
    const msgs   = document.getElementById('chatbot-messages');
    const input  = document.getElementById('chatbot-input');
    const send   = document.getElementById('chatbot-send');
    const chips  = document.querySelectorAll('.chat-chip');

    /* ── Open / close panel ───────────────────────────────────────── */
    function openPanel() {
        anchor.classList.add('panel-open');
        setTimeout(() => input?.focus(), 200);
    }
    function closePanel() {
        anchor.classList.remove('panel-open');
    }
    function isPanelOpen() { return anchor.classList.contains('panel-open'); }

    /* ── Drag-to-move the character anywhere on screen ─────────────
       Use document-level listeners in CAPTURE phase so we always receive
       pointer events even if Three.js canvas / SVG / etc. consumes them. */
    let dragging = false;
    let dragPointerId = null;
    let dragOffset = { x: 0, y: 0 };
    let didDrag = false;

    function isInsideAnchor(e) {
        // Hit-test against the anchor's bounding rect, not relying on event target
        const r = anchor.getBoundingClientRect();
        return e.clientX >= r.left && e.clientX <= r.right
            && e.clientY >= r.top  && e.clientY <= r.bottom;
    }

    function onPointerDown(e) {
        if (e.target.closest('#chatbot-panel')) return;
        if (e.button !== undefined && e.button !== 0) return;
        if (!isInsideAnchor(e)) return;
        dragging = true;
        didDrag = false;
        dragPointerId = e.pointerId;
        const rect = anchor.getBoundingClientRect();
        dragOffset.x = e.clientX - rect.left;
        dragOffset.y = e.clientY - rect.top;
        anchor.style.bottom = 'auto';
        anchor.style.right = 'auto';
        anchor.style.left = `${rect.left}px`;
        anchor.style.top = `${rect.top}px`;
        anchor.classList.add('dragging');
        try { anchor.setPointerCapture(e.pointerId); } catch (_) {}
        e.preventDefault();
    }

    function onPointerMove(e) {
        if (!dragging || e.pointerId !== dragPointerId) return;
        const newLeft = e.clientX - dragOffset.x;
        const newTop  = e.clientY - dragOffset.y;
        const maxX = window.innerWidth - anchor.offsetWidth;
        const maxY = window.innerHeight - anchor.offsetHeight;
        const x = Math.max(0, Math.min(newLeft, maxX));
        const y = Math.max(0, Math.min(newTop, maxY));
        anchor.style.left = `${x}px`;
        anchor.style.top = `${y}px`;
        didDrag = true;
    }

    function onPointerUp(e) {
        if (!dragging) return;
        if (e.pointerId !== dragPointerId) return;
        const moved = didDrag;
        dragging = false;
        dragPointerId = null;
        anchor.classList.remove('dragging');
        try {
            const rect = anchor.getBoundingClientRect();
            localStorage.setItem('chatbot_anchor_pos', JSON.stringify({
                left: rect.left, top: rect.top,
            }));
        } catch (_) {}
        if (!moved) {
            if (isPanelOpen()) closePanel();
            else openPanel();
        }
    }

    document.addEventListener('pointerdown', onPointerDown, { capture: true });
    document.addEventListener('pointermove', onPointerMove, { capture: true });
    document.addEventListener('pointerup', onPointerUp, { capture: true });
    document.addEventListener('pointercancel', () => {
        if (!dragging) return;
        dragging = false;
        dragPointerId = null;
        anchor.classList.remove('dragging');
    }, { capture: true });

    anchor.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            isPanelOpen() ? closePanel() : openPanel();
        }
    });

    close?.addEventListener('click', (e) => { e.stopPropagation(); closePanel(); });
    reset?.addEventListener('click', (e) => {
        e.stopPropagation();
        history = [];
        msgs.innerHTML = '';
        addMsg('bot', '對話已重置。問我任何問題吧！');
        showChips();
    });

    send.addEventListener('click', submit);
    input.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(); }
    });

    chips.forEach((c) => {
        c.addEventListener('click', () => {
            input.value = c.dataset.q;
            submit();
        });
    });

    try {
        const saved = JSON.parse(localStorage.getItem('chatbot_anchor_pos') || 'null');
        if (saved && typeof saved.left === 'number' && typeof saved.top === 'number') {
            anchor.style.bottom = 'auto';
            anchor.style.right = 'auto';
            anchor.style.left = `${saved.left}px`;
            anchor.style.top = `${saved.top}px`;
        }
    } catch (_) {}

    async function submit() {
        const text = input.value.trim();
        if (!text || busy) return;
        input.value = '';
        addMsg('user', text);
        history.push({ role: 'user', content: text });
        hideChips();
        setBusy(true);

        let reply = null;
        try {
            const apiBase = (typeof window.APP_CONFIG_UTILS?.resolveApiBase === 'function')
                ? await window.APP_CONFIG_UTILS.resolveApiBase({ cacheKey: 'chatbot' })
                : '';
            const endpoint = apiBase ? `${apiBase}/api/chat` : '/api/chat';
            const res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ system: SYSTEM, messages: history.slice(-10) }),
                signal: AbortSignal.timeout(20000),
            });
            if (res.ok) {
                const data = await res.json();
                reply = data.reply ?? data.content?.[0]?.text ?? null;
                if (reply) history.push({ role: 'assistant', content: reply });
            }
        } catch (_) {}

        if (!reply) {
            const local = findLocalReply(text);
            if (local) {
                reply = local + '\n\n_(本機離線回覆，AI 模型目前未連線)_';
            } else {
                reply = `目前 AI 模型暫時無法連線，也沒有對應到本機知識庫。\n\n你問的「${text}」可以試著換個關鍵字（例如：背景、技術、作品、聯絡）。`;
            }
        }

        addMsg('bot', reply, true);
        setBusy(false);
    }

    function hideChips() {
        const wrap = document.getElementById('chat-suggestions');
        if (wrap) wrap.style.display = 'none';
    }

    function showChips() {
        const wrap = document.getElementById('chat-suggestions');
        if (wrap) wrap.style.display = '';
    }

    function addMsg(role, text, allowMarkdown = false) {
        const d = document.createElement('div');
        d.className = `chat-msg chat-${role}`;
        if (allowMarkdown) {
            d.innerHTML = escapeHtml(text)
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
                .replace(/\n/g, '<br/>');
        } else {
            d.textContent = text;
        }
        msgs.appendChild(d);
        msgs.scrollTop = msgs.scrollHeight;
    }

    function escapeHtml(s) {
        return String(s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function setBusy(v) {
        busy = v; send.disabled = v; input.disabled = v;
        document.getElementById('chat-typing')?.remove();
        if (v) {
            const t = document.createElement('div');
            t.id = 'chat-typing';
            t.className = 'chat-msg chat-bot chat-typing';
            t.innerHTML = '<span></span><span></span><span></span>';
            msgs.appendChild(t);
            msgs.scrollTop = msgs.scrollHeight;
        }
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isPanelOpen()) {
            closePanel();
        }
    });

    /* === 3D mouse-tracking via Three.js === */
    (async () => {
        let THREE;
        try {
            THREE = await import('https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js');
        } catch (e) {
            console.warn('[3D char] Three.js failed to load', e);
            return;
        }

        const canvas = document.getElementById('char-canvas');
        if (!canvas) return;

        const renderer = new THREE.WebGLRenderer({
            canvas, alpha: true, antialias: true, premultipliedAlpha: true,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        const size = 96;
        renderer.setSize(size, size, false);

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
        camera.position.set(0, -0.5, 9);
        camera.lookAt(0, -0.4, 0);

        const ambient = new THREE.AmbientLight(0xffffff, 0.45);
        scene.add(ambient);

        const keyLight = new THREE.DirectionalLight(0xfff5e0, 1.3);
        keyLight.position.set(2.5, 3, 3);
        scene.add(keyLight);

        const rimLight = new THREE.DirectionalLight(0xa0c8ff, 0.8);
        rimLight.position.set(-2.5, 1, -1);
        scene.add(rimLight);

        const backLight = new THREE.DirectionalLight(0xffe0c0, 0.5);
        backLight.position.set(0, 1, -3);
        scene.add(backLight);

        const fillLight = new THREE.DirectionalLight(0xfff0e0, 0.4);
        fillLight.position.set(0, 0.5, 4);
        scene.add(fillLight);

        const char = new THREE.Group();
        scene.add(char);

        const headPivot = new THREE.Group();
        headPivot.position.set(0, 0.5, 0);
        char.add(headPivot);

        // === Gradients via Canvas textures ===
        function makeSkinTexture() {
            // 柴犬毛色：橘黃漸層，腹部/嘴邊白色區
            const c = document.createElement('canvas');
            c.width = 512; c.height = 512;
            const ctx = c.getContext('2d');
            // 底色橘黃漸層
            const grad = ctx.createRadialGradient(256, 220, 40, 256, 256, 320);
            grad.addColorStop(0, '#ffc888');
            grad.addColorStop(0.5, '#f0a050');
            grad.addColorStop(1, '#c87830');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 512, 512);
            // 腹部白色區 (下半部)
            const bellyGrad = ctx.createRadialGradient(256, 460, 80, 256, 460, 250);
            bellyGrad.addColorStop(0, '#ffffff');
            bellyGrad.addColorStop(0.5, 'rgba(255,255,255,0.6)');
            bellyGrad.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.fillStyle = bellyGrad;
            ctx.fillRect(0, 300, 512, 212);
            // 嘴邊白色 (下巴)
            const muzzleGrad = ctx.createRadialGradient(256, 410, 30, 256, 410, 150);
            muzzleGrad.addColorStop(0, '#ffffff');
            muzzleGrad.addColorStop(0.6, 'rgba(255,255,255,0.5)');
            muzzleGrad.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.fillStyle = muzzleGrad;
            ctx.fillRect(160, 350, 192, 162);
            // 額頭高光
            ctx.globalCompositeOperation = 'screen';
            const hl = ctx.createRadialGradient(200, 180, 10, 200, 180, 140);
            hl.addColorStop(0, 'rgba(255,255,255,0.25)');
            hl.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.fillStyle = hl;
            ctx.fillRect(0, 0, 512, 512);
            ctx.globalCompositeOperation = 'source-over';
            const tex = new THREE.CanvasTexture(c);
            tex.colorSpace = THREE.SRGBColorSpace;
            return tex;
        }
        const skinTex = makeSkinTexture();

        function makeHairTexture() {
            const c = document.createElement('canvas');
            c.width = 512; c.height = 512;
            const ctx = c.getContext('2d');
            const grad = ctx.createLinearGradient(0, 0, 0, 512);
            grad.addColorStop(0, '#3a2820');
            grad.addColorStop(0.5, '#1a0f0a');
            grad.addColorStop(1, '#0a0604');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 512, 512);
            ctx.globalCompositeOperation = 'screen';
            for (let i = 0; i < 8; i++) {
                ctx.fillStyle = `rgba(${150 + Math.random()*50}, ${100 + Math.random()*40}, 80, ${0.15 + Math.random()*0.15})`;
                ctx.fillRect(Math.random() * 512, Math.random() * 200, 4 + Math.random() * 8, 200 + Math.random() * 200);
            }
            ctx.globalCompositeOperation = 'source-over';
            const tex = new THREE.CanvasTexture(c);
            tex.colorSpace = THREE.SRGBColorSpace;
            return tex;
        }
        const hairTex = makeHairTexture();

        // 柴犬全身毛色 — 橘黃 + 白色腹部（跟 skinTex 相同，腹部比例不同）
        function makeBodyTexture() {
            const c = document.createElement('canvas');
            c.width = 512; c.height = 512;
            const ctx = c.getContext('2d');
            const grad = ctx.createRadialGradient(256, 220, 40, 256, 256, 320);
            grad.addColorStop(0, '#ffc888');
            grad.addColorStop(0.5, '#f0a050');
            grad.addColorStop(1, '#c87830');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 512, 512);
            // 腹部白色更明顯
            const bellyGrad = ctx.createRadialGradient(256, 400, 60, 256, 400, 280);
            bellyGrad.addColorStop(0, '#ffffff');
            bellyGrad.addColorStop(0.6, 'rgba(255,255,255,0.7)');
            bellyGrad.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.fillStyle = bellyGrad;
            ctx.fillRect(0, 220, 512, 292);
            ctx.globalCompositeOperation = 'source-over';
            const tex = new THREE.CanvasTexture(c);
            tex.colorSpace = THREE.SRGBColorSpace;
            return tex;
        }
        const bodyTex = makeBodyTexture();

        const skinMat = new THREE.MeshStandardMaterial({ map: skinTex, roughness: 0.45, metalness: 0.0 });
        const hairMat = new THREE.MeshStandardMaterial({ map: hairTex, roughness: 0.65, metalness: 0.0 });
        const bodyMat = new THREE.MeshStandardMaterial({ map: bodyTex, roughness: 0.55, metalness: 0.0 });

        // === 柴犬幾何 — 乾淨重寫 ===
        const furMat = skinMat;
        const whiteMat = new THREE.MeshStandardMaterial({
            color: 0xfffaf0, roughness: 0.55,
        });
        const darkFurMat = new THREE.MeshStandardMaterial({
            color: 0xc87830, roughness: 0.7,
        });

        // HEAD — 球體，半徑 1.0
        const head = new THREE.Mesh(new THREE.SphereGeometry(1.0, 64, 48), furMat);
        headPivot.add(head);

        // 白嘴邊 (muzzle) — 小球往前
        const muzzle = new THREE.Mesh(new THREE.SphereGeometry(0.5, 32, 24), whiteMat);
        muzzle.position.set(0, -0.30, 0.70);
        muzzle.scale.set(1.1, 0.85, 0.95);
        headPivot.add(muzzle);

        // 兩側臉頰 (jowls)
        const jowlGeom = new THREE.SphereGeometry(0.30, 24, 18);
        const jowlL = new THREE.Mesh(jowlGeom, furMat);
        jowlL.position.set(-0.78, -0.15, 0.45);
        jowlL.scale.set(0.95, 0.85, 0.7);
        headPivot.add(jowlL);
        const jowlR = jowlL.clone();
        jowlR.position.x = 0.78;
        headPivot.add(jowlR);

        // === EARS — 小三角形豎耳 ===
        const earGeom = new THREE.ConeGeometry(0.22, 0.55, 4);
        const earMat = new THREE.MeshStandardMaterial({
            color: 0xd87838, roughness: 0.7,
        });
        const earL = new THREE.Mesh(earGeom, earMat);
        earL.position.set(-0.62, 0.85, 0.0);
        earL.rotation.z = 0.20;
        earL.rotation.x = -0.10;
        headPivot.add(earL);
        const earR = earL.clone();
        earR.position.x = 0.62;
        earR.rotation.z = -0.20;
        headPivot.add(earR);

        // 耳朵內側 (粉紅)
        const earInnerGeom = new THREE.ConeGeometry(0.14, 0.42, 4);
        const earInnerMat = new THREE.MeshStandardMaterial({
            color: 0xffb098, roughness: 0.5,
        });
        const earInnerL = new THREE.Mesh(earInnerGeom, earInnerMat);
        earInnerL.position.set(-0.58, 0.85, 0.05);
        earInnerL.rotation.z = 0.20;
        earInnerL.rotation.x = -0.10;
        headPivot.add(earInnerL);
        const earInnerR = earInnerL.clone();
        earInnerR.position.x = 0.58;
        earInnerR.rotation.z = -0.20;
        headPivot.add(earInnerR);

        // === 額頭白色斑紋 (Urajiro) ===
        const urajiroForehead = new THREE.Mesh(new THREE.SphereGeometry(0.45, 24, 18), whiteMat);
        urajiroForehead.position.set(0, 0.30, 0.75);
        urajiroForehead.scale.set(1.3, 0.40, 0.5);
        headPivot.add(urajiroForehead);

        // === 兩塊深橘眉毛斑 ===
        const browGeom = new THREE.SphereGeometry(0.18, 20, 16);
        const browL = new THREE.Mesh(browGeom, darkFurMat);
        browL.position.set(-0.32, 0.32, 0.90);
        browL.scale.set(0.85, 0.55, 0.4);
        headPivot.add(browL);
        const browR = browL.clone();
        browR.position.x = 0.32;
        headPivot.add(browR);

        // === EYES — 黑豆眼 ===
        const eyeWhiteMat = new THREE.MeshStandardMaterial({
            color: 0xffffff, roughness: 0.15,
        });
        const eyeGeom = new THREE.SphereGeometry(0.18, 24, 20);
        const eyeL = new THREE.Mesh(eyeGeom, eyeWhiteMat);
        eyeL.position.set(-0.28, 0.12, 0.92);
        eyeL.scale.set(1.0, 1.05, 0.5);
        headPivot.add(eyeL);
        const eyeR = eyeL.clone();
        eyeR.position.x = 0.28;
        headPivot.add(eyeR);

        const pupilMat = new THREE.MeshStandardMaterial({
            color: 0x0a0604, roughness: 0.05, metalness: 0.7,
        });
        const pupilGeom = new THREE.SphereGeometry(0.16, 24, 20);
        const pupilL = new THREE.Mesh(pupilGeom, pupilMat);
        pupilL.position.set(-0.28, 0.12, 1.02);
        pupilL.scale.set(1.0, 1.05, 0.5);
        headPivot.add(pupilL);
        const pupilR = pupilL.clone();
        pupilR.position.x = 0.28;
        headPivot.add(pupilR);

        const shineGeom = new THREE.SphereGeometry(0.035, 12, 10);
        const shineMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
        const shineL = new THREE.Mesh(shineGeom, shineMat);
        shineL.position.set(-0.22, 0.17, 1.10);
        headPivot.add(shineL);
        const shineR = shineL.clone();
        shineR.position.x = 0.22;
        headPivot.add(shineR);

        // === NOSE — 黑色大鼻子 ===
        const nose = new THREE.Mesh(
            new THREE.SphereGeometry(0.13, 20, 16),
            new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.4 }),
        );
        nose.position.set(0, -0.10, 0.98);
        nose.scale.set(1.1, 0.85, 0.6);
        headPivot.add(nose);

        // === MOUTH — 張嘴吐舌 ===
        const mouthOpen = new THREE.Mesh(
            new THREE.SphereGeometry(0.20, 20, 14),
            new THREE.MeshStandardMaterial({ color: 0x1a0a0a, roughness: 0.4 }),
        );
        mouthOpen.position.set(0, -0.42, 0.85);
        mouthOpen.scale.set(1.3, 0.7, 0.4);
        headPivot.add(mouthOpen);

        const tongue = new THREE.Mesh(
            new THREE.SphereGeometry(0.13, 16, 12),
            new THREE.MeshStandardMaterial({
                color: 0xff7090, roughness: 0.4,
                emissive: 0xff8fa3, emissiveIntensity: 0.3,
            }),
        );
        tongue.position.set(0, -0.55, 0.88);
        tongue.scale.set(1.4, 0.7, 0.5);
        headPivot.add(tongue);

        // === 柴犬身體 (圓滾滾、有四隻腳、露出白色腹部) ===
        const body = new THREE.Mesh(new THREE.SphereGeometry(1.0, 32, 24), bodyMat);
        body.position.set(0, -1.55, 0);
        body.scale.set(1.4, 0.85, 1.1); // 寬圓身體
        char.add(body);

        // 身體白色腹部 (Urajiro)
        const bellyMat = new THREE.MeshStandardMaterial({ color: 0xfffaf0, roughness: 0.55 });
        const bellyGeom = new THREE.SphereGeometry(0.85, 24, 18);
        const belly = new THREE.Mesh(bellyGeom, bellyMat);
        belly.position.set(0, -1.55, 0.35);
        belly.scale.set(1.1, 0.8, 0.6);
        char.add(belly);

        // === 四隻腳 (短腿，柴犬特色) ===
        const pawMat = new THREE.MeshStandardMaterial({
            color: 0xfffaf0, roughness: 0.55, // 白色腳掌
        });
        const pawGeom = new THREE.SphereGeometry(0.18, 16, 12);

        // 兩隻前腳
        const frontPawL = new THREE.Mesh(pawGeom, pawMat);
        frontPawL.position.set(-0.55, -2.10, 0.45);
        frontPawL.scale.set(1.0, 0.8, 1.2);
        char.add(frontPawL);
        const frontPawR = frontPawL.clone();
        frontPawR.position.x = 0.55;
        char.add(frontPawR);

        // 兩隻後腳 (略小，因為看不到)
        const backPawL = new THREE.Mesh(pawGeom, pawMat);
        backPawL.position.set(-0.65, -2.00, -0.40);
        backPawL.scale.set(0.9, 0.7, 1.0);
        char.add(backPawL);
        const backPawR = backPawL.clone();
        backPawR.position.x = 0.65;
        char.add(backPawR);

        // 蓬鬆尾巴 (柴犬招牌捲尾)
        const tailMat = new THREE.MeshStandardMaterial({
            color: 0xf0a050, roughness: 0.7,
        });
        const tailGeom = new THREE.SphereGeometry(0.25, 20, 16);
        const tail = new THREE.Mesh(tailGeom, tailMat);
        tail.position.set(0, -1.20, -1.10);
        tail.scale.set(1.2, 0.9, 1.0);
        tail.rotation.x = -0.4; // 微微翹起
        char.add(tail);

        // 尾巴尖端白毛
        const tailTipGeom = new THREE.SphereGeometry(0.16, 16, 12);
        const tailTip = new THREE.Mesh(tailTipGeom, bellyMat);
        tailTip.position.set(0, -0.90, -1.30);
        char.add(tailTip);

        // === 兩隻前腳的指頭 (白色肉球) ===
        const toeGeom = new THREE.SphereGeometry(0.06, 12, 8);
        for (const side of [-1, 1]) {
            for (let i = 0; i < 3; i++) {
                const toe = new THREE.Mesh(toeGeom, bellyMat);
                toe.position.set(side * (0.45 + i * 0.08), -2.18, 0.55);
                toe.scale.set(0.8, 0.5, 0.9);
                char.add(toe);
            }
        }

        // MOUSE TRACKING
        const targetRot = { x: 0, y: 0 };
        const currentRot = { x: 0, y: 0 };
        const maxYaw = THREE.MathUtils.degToRad(45);
        const maxPitch = THREE.MathUtils.degToRad(28);

        function onPointerMove(e) {
            if (dragging) return;
            const rect = canvas.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = (e.clientX - cx) / (rect.width / 2);
            const dy = (e.clientY - cy) / (rect.height / 2);
            targetRot.y = THREE.MathUtils.clamp(dx, -1, 1) * maxYaw;
            targetRot.x = THREE.MathUtils.clamp(-dy, -1, 1) * maxPitch;
        }
        window.addEventListener('pointermove', onPointerMove, { passive: true });

        function onResize() {
            const rect = canvas.getBoundingClientRect();
            renderer.setSize(rect.width, rect.height, false);
            camera.aspect = rect.width / rect.height;
            camera.updateProjectionMatrix();
        }
        window.addEventListener('resize', onResize);
        onResize();

        let blinkTimer = 0;
        let nextBlink = 2 + Math.random() * 3;
        let isBlinking = false;
        let blinkProgress = 0;

        function animate(time) {
            time *= 0.001;
            currentRot.x += (targetRot.x - currentRot.x) * 0.12;
            currentRot.y += (targetRot.y - currentRot.y) * 0.12;
            headPivot.rotation.y = currentRot.y;
            headPivot.rotation.x = currentRot.x * 0.85;

            if (!dragging && !anchor.classList.contains('panel-open')) {
                char.position.y = Math.sin(time * 1.4) * 0.05;
                char.rotation.y = Math.sin(time * 0.6) * 0.04;
            } else {
                char.position.y *= 0.9;
            }

            blinkTimer += 1 / 60;
            if (!isBlinking && blinkTimer > nextBlink) {
                isBlinking = true;
                blinkProgress = 0;
            }
            if (isBlinking) {
                blinkProgress += 0.18;
                const scale = Math.max(0.05, 1 - Math.sin(blinkProgress * Math.PI));
                eyeL.scale.y = scale;
                eyeR.scale.y = scale;
                pupilL.scale.y = scale;
                pupilR.scale.y = scale;
                shineBigL.visible = scale > 0.5;
                shineBigR.visible = scale > 0.5;
                if (blinkProgress >= 1) {
                    isBlinking = false;
                    blinkTimer = 0;
                    nextBlink = 2.5 + Math.random() * 3.5;
                }
            }

            renderer.render(scene, camera);
            requestAnimationFrame(animate);
        }
        requestAnimationFrame(animate);

        window.__chatbot3d = { scene, camera, char, headPivot };
    })();
})();
</script>
