---
// Immersive Background Component for Astro — with random video background
---

<div class="immersive-bg" id="immersive-bg">
    <video
        id="bg-video"
        class="bg-video"
        autoplay
        muted
        loop
        playsinline
    >
        <source id="video-source" type="video/mp4" />
    </video>
    <div class="bg-overlay"></div>
</div>

<style>
    .immersive-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background: #08060e;
    }

    .bg-video {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: auto;
        min-height: 100%;
        object-fit: cover;
        object-position: center top;
        transform: translateY(0);
        pointer-events: none;
    }

    .bg-overlay {
        position: absolute;
        inset: 0;
        background: rgba(8, 6, 14, 0.25);
        pointer-events: none;
    }

    .particle {
        position: absolute;
        width: 2px;
        height: 2px;
        background: radial-gradient(circle, rgba(255,255,255,0.8), rgba(255,255,255,0));
        border-radius: 50%;
        pointer-events: none;
        animation: float 20s infinite ease-in-out;
    }

    @keyframes float {
        0%, 100% { 
            transform: translateY(0) translateX(0) scale(1); 
            opacity: 0; 
        }
        10% { opacity: 1; }
        50% { opacity: 0.8; }
        90% { opacity: 0; }
    }
</style>

<script>
    class ImmersiveBackground {
        constructor() {
            this.container = document.getElementById('immersive-bg');
            this.video = document.getElementById('bg-video');
            this.particles = [];
            this.init();
        }

        init() {
            this.createParticles();
            this.setupEventListeners();
            this.setupVideo();
        }

        setupVideo() {
            if (!this.video) return;
            
            // Random video selection
            const videos = [
                '179f1b00-2727-47ec-81d3-591d8405c762_watermarked.mp4',
                '314d4f6d-a33c-4ae9-98be-278f186e8b69_watermarked.mp4',
                '5ae42f29-5a34-41e9-a27c-6631b45dd16a_watermarked.mp4',
                '6b95a3b8-no-watermark_watermarked.mp4',
                'a0288e4b-f7ee-4e17-b24c-5d7d0f0a514f_watermarked.mp4',
                'bb49c6e0-0a76-4bc7-9e69-11f1737b4461_watermarked.mp4',
                'ca1772e9-acb6-496e-9a58-8a86f29e890a_watermarked.mp4',
                'cd66d66a-3dbb-4ed4-bd24-4a05add4b914_watermarked.mp4'
            ];
            
            const randomVideo = videos[Math.floor(Math.random() * videos.length)];
            const source = document.getElementById('video-source');
            if (source) {
                source.src = '/videos/' + randomVideo;
            }
            
            this.video.play().catch(() => {
                this.video.style.display = 'none';
            });
        }

        createParticles() {
            if (!this.container) return;
            
            const particleCount = Math.min(80, Math.floor(window.innerWidth / 15));

            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                
                const size = Math.random() * 3 + 1;
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.animationDuration = (Math.random() * 10 + 15) + 's';
                particle.style.animationDelay = Math.random() * 5 + 's';
                
                this.container.appendChild(particle);
                this.particles.push(particle);
            }
        }

        setupEventListeners() {
            window.addEventListener('resize', () => this.handleResize());
        }

        handleResize() {
            const newParticleCount = Math.min(80, Math.floor(window.innerWidth / 15));
            if (newParticleCount !== this.particles.length) {
                this.particles.forEach(p => p.remove());
                this.particles = [];
                this.createParticles();
            }
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            new ImmersiveBackground();
        });
    } else {
        new ImmersiveBackground();
    }
</script>
