---
---

<div class="immersive-bg" id="immersive-bg">
    <video class="immersive-video" id="bgVideo" autoplay muted loop playsinline>
        <source id="bgSource" src="/bg1.mp4" type="video/mp4">
    </video>
    <div class="vignette-overlay"></div>
    <div class="content-scrim"></div>
</div>

<style>
    .immersive-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background: #08060e;
        pointer-events: none;
    }

    .immersive-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 1;
        z-index: -1;
        image-rendering: high-quality;
        /* 切除左側浮水印區域 (約 90px) */
        clip-path: inset(0 0 0 90px);
    }

    .vignette-overlay {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(ellipse at center, transparent 60%, rgba(8,6,14,0.15) 100%);
    }

    /* 內容遮罩 - 保持透明讓背景影片可見 */
    .content-scrim {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: transparent;
    }

    .particle {
        position: absolute;
        width: 2px;
        height: 2px;
        background: radial-gradient(circle, rgba(255,255,255,0.8), rgba(255,255,255,0));
        border-radius: 50%;
        pointer-events: none;
        animation: float 20s infinite ease-in-out;
    }

    @keyframes float {
        0%, 100% { 
            transform: translateY(0) translateX(0) scale(1); 
            opacity: 0; 
        }
        10% { opacity: 1; }
        50% { opacity: 0.8; }
        90% { opacity: 0; }
    }
</style>

<script>
    const videos = [
        '/bg1.mp4', '/bg2.mp4', '/bg3.mp4', '/bg4.mp4', '/bg5.mp4',
        '/bg6.mp4', '/bg7.mp4', '/bg8.mp4', '/bg9.mp4', '/bg10.mp4',
        '/bg11.mp4', '/bg12.mp4', '/bg13.mp4', '/bg14.mp4', '/bg15.mp4',
        '/350f54bf-9466-4b56-b740-bc1cfd1cfb1.mp4',
        '/6354a061-40a3-4783-90c6-ae8d1fb24ff7.mp4',
        '/97eb4e11-5e1b-4e4c-b59b-b1ceada17ee1.mp4',
        '/9c52e0cd-3149-41bf-a352-dc6b0a057d4d.mp4',
        '/a59aa81d-8d61-42d1-bd95-7153bfc50a91.mp4',
        '/a9283c1d-a6d5-40e3-a89a-85cf7f2546e9.mp4',
        '/cd66d6a-3dbb-4ed4-bd24-4a05add4b914.mp4',
        '/f5ea057b-3d35-4cad-83d6-fbf5223cce47.mp4'
    ];
    let currentIndex = Math.floor(Math.random() * videos.length);
    let lastIndex = currentIndex;

    function getRandomVideo() {
        while (currentIndex === lastIndex && videos.length > 1) {
            currentIndex = Math.floor(Math.random() * videos.length);
        }
        lastIndex = currentIndex;
        return videos[currentIndex];
    }

    function switchVideo() {
        const video = document.getElementById('bgVideo');
        const source = document.getElementById('bgSource');
        if (!video || !source) return;
        const newVideo = getRandomVideo();
        source.src = newVideo;
        video.load();
    }

    class ImmersiveBackground {
        constructor() {
            this.container = document.getElementById('immersive-bg');
            this.particles = [];
            this.init();
        }

        init() {
            this.createParticles();
            this.setupEventListeners();
            setInterval(() => {
                const video = document.getElementById('bgVideo');
                if (video && !video.paused) {
                    switchVideo();
                }
            }, 15000);
        }

        createParticles() {
            if (!this.container) return;
            const particleCount = Math.min(80, Math.floor(window.innerWidth / 15));
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                const size = Math.random() * 3 + 1;
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.animationDuration = (Math.random() * 10 + 15) + 's';
                particle.style.animationDelay = Math.random() * 5 + 's';
                this.container.appendChild(particle);
                this.particles.push(particle);
            }
        }

        setupEventListeners() {
            window.addEventListener('resize', () => this.handleResize());
        }

        handleResize() {
            const newParticleCount = Math.min(80, Math.floor(window.innerWidth / 15));
            if (newParticleCount !== this.particles.length) {
                this.particles.forEach(p => p.remove());
                this.particles = [];
                this.createParticles();
            }
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            new ImmersiveBackground();
        });
    } else {
        new ImmersiveBackground();
    }
</script>