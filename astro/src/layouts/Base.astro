---
// import Analytics from '@vercel/analytics/astro'; // 暫時關閉：Vercel dashboard 未啟用 Web Analytics，script 永遠 404
import Chatbot from '../components/Chatbot.astro';
// ImmersiveBackground removed — was causing clutter (video bg + particles + WebGL shader stacked)


const SITE = 'https://donttalk.vercel.app';

// Build-time cache buster for pageScripts. Astro 6 exposes BUILD_TIMESTAMP;
// fallback to Date.now() still changes on every build, which is all we need.
// Astro 定義 `BUILD_TIMESTAMP` 在 `astro:env` / import.meta.env 都拿得到，
// 這裡用 typeof 防呆避免舊版 Astro 報 undefined。
const BUILD_STAMP: string = import.meta.env.BUILD_TIMESTAMP
    ? String(import.meta.env.BUILD_TIMESTAMP)
    : String(Date.now());

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogTag?: string;
    bodyPage?: string;
    pageStyles?: string[];
    pageScripts?: string[];
    headInline?: string;
    /** Override page type for Schema.org (defaults to 'WebPage'). Use 'ProfilePage' for /, 'Article' for blog posts. */
    schemaType?: string;
    /** Disable the global Person+WebSite JSON-LD (e.g. for legal pages that shouldn't assert identity). */
    noPersonSchema?: boolean;
}

const {
    title,
    description = '',
    ogImage,
    ogTag = '',
    bodyPage,
    pageStyles = [],
    pageScripts = [],
    headInline = '',
    schemaType = 'WebPage',
    noPersonSchema = false,
} = Astro.props;

const ogImageUrl = ogImage
    // 動態 /og endpoint 在 prebuilt deploy 下指向 catchall Node function 一直 404，
    // 改用靜態 /og-image.svg（含 chibi）當 fallback。需要客製 og 的頁面可傳 ogImage prop 覆寫。
    ?? `${SITE}/og-image.svg`;

// Canonical: strip query strings & hash, force trailing-slash consistency via Astro.site.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE).toString();

// Person + WebSite JSON-LD (site-wide identity graph for AI crawlers).
const personSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': `${SITE}#person`,
            name: '不說',
            url: SITE,
            image: `${SITE}/og-default.png`,
            sameAs: [
                'https://github.com/123lai1234-create',
                'https://huggingface.co/Donttalk123',
            ],
            jobTitle: '全端工程師 / 生醫研究者',
            description: '電資工程與生物醫學雙碩士，整合蛋白質 AI 設計、基因分析、NGS 流程與互動平台開發的全端跨域工程師。',
            knowsAbout: [
                'Protein Language Model', 'ESM-2', 'ProteinMPNN',
                'Bayesian Optimization', 'BoTorch', 'REINFORCE',
                'NGS Analysis', 'RNA-seq', 'WGS', 'scRNA-seq',
                'FastAPI', 'Astro', 'PostgreSQL', 'Python', 'TypeScript',
            ],
            alumniOf: [
                { '@type': 'EducationalOrganization', name: '國立臺北科技大學 電子工程研究所' },
                { '@type': 'EducationalOrganization', name: '國立陽明交通大學 解剖學及細胞生物學研究所' },
            ],
        },
        {
            '@type': 'WebSite',
            '@id': `${SITE}#website`,
            url: SITE,
            name: '不說 Portfolio',
            inLanguage: 'zh-TW',
            author: { '@id': `${SITE}#person` },
            potentialAction: {
                '@type': 'SearchAction',
                target: `${SITE}/?q={search_term_string}`,
                'query-input': 'required name=search_term_string',
            },
        },
        {
            '@type': 'WebPage',
            '@id': `${canonicalURL}#webpage`,
            url: canonicalURL,
            name: title,
            description: description,
            inLanguage: 'zh-TW',
            isPartOf: { '@id': `${SITE}#website` },
            about: { '@id': `${SITE}#person` },
            additionalType: schemaType,
        },
    ],
};
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
      try { if (!document.referrer || document.referrer.indexOf(location.host) === -1) { window.scrollTo(0, 0); } } catch(_) { window.scrollTo(0, 0); }
      /*  Fix: JS injects inline opacity:0 transform on .sc-section, override reveal CSS. Clear inline styles + watch for re-injection.  */
      setTimeout(function() {
        var props = ['opacity','transform','translate','rotate','scale'];
        function clearInline(el) { props.forEach(function(p) { el.style.removeProperty(p); }); }
        document.querySelectorAll('.sc-section.reveal.visible').forEach(clearInline);
        var obs = new MutationObserver(function(muts) {
          muts.forEach(function(m) {
            if (m.type === 'attributes' && m.target.classList && m.target.classList.contains('visible') && m.target.classList.contains('sc-section')) { clearInline(m.target); }
          });
        });
        document.querySelectorAll('.sc-section').forEach(function(el) { obs.observe(el, {attributes:true}); });
        setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 800);
      }, 200);
      // Chart guard with real data
      function tryBuildCharts() {
        if (typeof Chart === 'undefined') { setTimeout(tryBuildCharts, 100); return; }
        setTimeout(function() {
          Chart.defaults.color = '#94a59f';
          Chart.defaults.font.family = "'Inter', sans-serif";
          var gc = 'rgba(151,190,181,0.08)';
          function build(id, cfg) { var c = document.getElementById(id); if (c && !Chart.getChart(c) && c.offsetParent) { try { new Chart(c, cfg); } catch(e){} } }
          build('chartLesion', { type: 'line', data: { labels: ['Day 7','Day 14','Day 21','Day 28'], datasets: [
            { label: 'Co', data: [38.026,20.238,10.957,6.868], borderColor: '#7bf0be', backgroundColor: 'rgba(123,240,190,.12)', pointBackgroundColor: '#7bf0be', tension: .3, fill: true, borderWidth: 2, pointRadius: 5 },
            { label: 'TBI', data: [30.472,26.654,16.534,10.681], borderColor: '#ff8392', backgroundColor: 'rgba(255,131,146,.08)', pointBackgroundColor: '#ff8392', tension: .3, fill: true, borderWidth: 2, pointRadius: 5, borderDash: [5,4] }
          ]}, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: true, position: 'top', labels: { color: '#94a59f', font: { size: 11 }, usePointStyle: true, padding: 12, boxWidth: 8 } }, tooltip: { backgroundColor: 'rgba(15,24,33,0.95)', titleColor: '#7bf0be', bodyColor: '#e9f0ec', borderColor: 'rgba(123,240,190,0.3)', borderWidth: 1, padding: 10, cornerRadius: 6, displayColors: true } }, scales: { x: { grid: { color: gc }, ticks: { color: '#5a716b' } }, y: { grid: { color: gc }, ticks: { color: '#5a716b' } } } } });
          build('chartAngio', { type: 'line', data: { labels: ['Day 1','Day 3','Day 5','Day 7'], datasets: [
            { label: '50k', data: [250,400,900,2500], borderColor: '#7bf0be', pointBackgroundColor: '#7bf0be', tension: .3, fill: false, borderWidth: 2, pointRadius: 5 },
            { label: '100k', data: [300,600,1200,3200], borderColor: '#58d7ff', pointBackgroundColor: '#58d7ff', tension: .3, fill: false, borderWidth: 2, pointRadius: 5 },
            { label: '250k', data: [400,800,1800,5500], borderColor: '#ffbc72', pointBackgroundColor: '#ffbc72', tension: .3, fill: false, borderWidth: 2, pointRadius: 5 }
          ]}, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: true, position: 'top', labels: { color: '#94a59f', font: { size: 11 }, usePointStyle: true, padding: 12, boxWidth: 8 } }, tooltip: { backgroundColor: 'rgba(15,24,33,0.95)', titleColor: '#7bf0be', bodyColor: '#e9f0ec', borderColor: 'rgba(123,240,190,0.3)', borderWidth: 1, padding: 10, cornerRadius: 6, displayColors: true } }, scales: { x: { grid: { color: gc }, ticks: { color: '#5a716b' } }, y: { grid: { color: gc }, ticks: { color: '#5a716b' } } } } });
          build('chartDiff', { type: 'bar', data: { labels: ['A','B','C','D','E'], datasets: [
            { label: 'NeuN+', data: [22,34,18,41,28], backgroundColor: 'rgba(88,215,255,.75)' },
            { label: 'GFAP+', data: [35,28,42,22,38], backgroundColor: 'rgba(181,156,255,.75)' },
            { label: 'Olig2+', data: [18,22,15,20,14], backgroundColor: 'rgba(255,188,114,.75)' },
            { label: 'Undiff', data: [25,16,25,17,20], backgroundColor: 'rgba(107,115,153,.5)' }
          ]}, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: true, position: 'top', labels: { color: '#94a59f', font: { size: 11 }, usePointStyle: true, padding: 12, boxWidth: 8 } }, tooltip: { backgroundColor: 'rgba(15,24,33,0.95)', titleColor: '#7bf0be', bodyColor: '#e9f0ec', borderColor: 'rgba(123,240,190,0.3)', borderWidth: 1, padding: 10, cornerRadius: 6, displayColors: true } }, scales: { x: { stacked: true, grid: { color: gc }, ticks: { color: '#5a716b' } }, y: { stacked: true, grid: { color: gc }, ticks: { color: '#5a716b' }, max: 100 } } } });
          build('chartSurvival', { type: 'line', data: { labels: ['1hr','6hr','D1','D3','D7','D14'], datasets: [
            { label: 'Cell Sheet', data: [96,91,84,76,68,61], borderColor: '#7bf0be', backgroundColor: 'rgba(123,240,190,.12)', pointBackgroundColor: '#7bf0be', tension: .3, fill: true, borderWidth: 2 },
            { label: 'Inj', data: [82,64,48,35,26,19], borderColor: '#ff8392', backgroundColor: 'rgba(255,131,146,.08)', pointBackgroundColor: '#ff8392', tension: .3, fill: true, borderWidth: 2, borderDash: [5,4] }
          ]}, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: true, position: 'top', labels: { color: '#94a59f', font: { size: 11 }, usePointStyle: true, padding: 12, boxWidth: 8 } }, tooltip: { backgroundColor: 'rgba(15,24,33,0.95)', titleColor: '#7bf0be', bodyColor: '#e9f0ec', borderColor: 'rgba(123,240,190,0.3)', borderWidth: 1, padding: 10, cornerRadius: 6, displayColors: true } }, scales: { x: { grid: { color: gc }, ticks: { color: '#5a716b' } }, y: { grid: { color: gc }, ticks: { color: '#5a716b' }, min: 0, max: 100 } } } });
          build('chartBehav', { type: 'line', data: { labels: ['W1','W2','W3','W4','W6','W8'], datasets: [
            { label: 'Cell Sheet', data: [58,48,37,28,21,16], borderColor: '#7bf0be', pointBackgroundColor: '#7bf0be', tension: .35, fill: false, borderWidth: 2 },
            { label: 'MSC', data: [60,52,43,35,29,24], borderColor: '#58d7ff', pointBackgroundColor: '#58d7ff', tension: .35, fill: false, borderWidth: 2 },
            { label: 'Sham', data: [18,14,12,11,10,10], borderColor: '#b59cff', pointBackgroundColor: '#b59cff', tension: .35, fill: false, borderWidth: 1.5, borderDash: [3,3] },
            { label: 'TBI', data: [62,58,55,52,50,48], borderColor: '#6b7399', pointBackgroundColor: '#6b7399', tension: .35, fill: false, borderWidth: 1.5, borderDash: [5,4] }
          ]}, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: true, position: 'top', labels: { color: '#94a59f', font: { size: 11 }, usePointStyle: true, padding: 12, boxWidth: 8 } }, tooltip: { backgroundColor: 'rgba(15,24,33,0.95)', titleColor: '#7bf0be', bodyColor: '#e9f0ec', borderColor: 'rgba(123,240,190,0.3)', borderWidth: 1, padding: 10, cornerRadius: 6, displayColors: true } }, scales: { x: { grid: { color: gc }, ticks: { color: '#5a716b' } }, y: { reverse: true, min: 8, max: 70, grid: { color: gc }, ticks: { color: '#5a716b' } } } } });
          // Wire up chart tab/button click handlers
          function wireLesion() {
            var data = { volume: { co: [38.026,20.238,10.957,6.868], tbi: [30.472,26.654,16.534,10.681], unit: 'mm3' }, area: { co: [6.5,3.469,1.67,2.29], tbi: [6.92,5.487,3.67,2.65], unit: 'mm2' }, depth: { co: [1.574,0.951,0.670,1.230], tbi: [2.114,1.358,1.248,1.290], unit: 'mm' }, width: { co: [4.496,4.332,3.988,2.520], tbi: [3.834,4.479,3.677,2.940], unit: 'mm' } };
            var labels = ['Day 7','Day 14','Day 21','Day 28'];
            document.querySelectorAll('.sc-mtbtn[data-metric]').forEach(function(btn) {
              btn.addEventListener('click', function() {
                document.querySelectorAll('.sc-mtbtn[data-metric]').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                var c = document.getElementById('chartLesion');
                var old = Chart.getChart(c); if (old) old.destroy();
                var d = data[btn.dataset.metric];
                new Chart(c, { type: 'line', data: { labels: labels, datasets: [
                  { label: 'Co', data: d.co, borderColor: '#7bf0be', backgroundColor: 'rgba(123,240,190,.12)', pointBackgroundColor: '#7bf0be', tension: .3, fill: true, borderWidth: 2, pointRadius: 5 },
                  { label: 'TBI', data: d.tbi, borderColor: '#ff8392', backgroundColor: 'rgba(255,131,146,.08)', pointBackgroundColor: '#ff8392', tension: .3, fill: true, borderWidth: 2, pointRadius: 5, borderDash: [5,4] }
                ]}, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: true, position: 'top', labels: { color: '#94a59f', font: { size: 11 }, usePointStyle: true, padding: 12, boxWidth: 8 } }, tooltip: { backgroundColor: 'rgba(15,24,33,0.95)', titleColor: '#7bf0be', bodyColor: '#e9f0ec', borderColor: 'rgba(123,240,190,0.3)', borderWidth: 1, padding: 10, cornerRadius: 6, displayColors: true } }, scales: { x: { grid: { color: gc }, ticks: { color: '#5a716b' } }, y: { grid: { color: gc }, ticks: { color: '#5a716b' } } } } });
              });
            });
          }
          function wireAngio() {
            var data = { '0': { '50k': [250,400,900,2500], '100k': [300,600,1200,3200], '250k': [400,800,1800,5500] }, '1': { '50k': [350,700,1800,4500], '100k': [500,900,2500,6000], '250k': [600,1100,3500,8000] }, '10': { '50k': [400,900,2200,5800], '100k': [700,1400,3800,7500], '250k': [900,2000,6000,9800] } };
            var labels = ['Day 1','Day 3','Day 5','Day 7'];
            document.querySelectorAll('[data-ang]').forEach(function(btn) {
              btn.addEventListener('click', function() {
                document.querySelectorAll('[data-ang]').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                var c = document.getElementById('chartAngio');
                var old = Chart.getChart(c); if (old) old.destroy();
                var d = data[btn.dataset.ang];
                new Chart(c, { type: 'line', data: { labels: labels, datasets: [
                  { label: '50k', data: d['50k'], borderColor: '#7bf0be', pointBackgroundColor: '#7bf0be', tension: .3, fill: false, borderWidth: 2, pointRadius: 5 },
                  { label: '100k', data: d['100k'], borderColor: '#58d7ff', pointBackgroundColor: '#58d7ff', tension: .3, fill: false, borderWidth: 2, pointRadius: 5 },
                  { label: '250k', data: d['250k'], borderColor: '#ffbc72', pointBackgroundColor: '#ffbc72', tension: .3, fill: false, borderWidth: 2, pointRadius: 5 }
                ]}, options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: true, position: 'top', labels: { color: '#94a59f', font: { size: 11 }, usePointStyle: true, padding: 12, boxWidth: 8 } }, tooltip: { backgroundColor: 'rgba(15,24,33,0.95)', titleColor: '#7bf0be', bodyColor: '#e9f0ec', borderColor: 'rgba(123,240,190,0.3)', borderWidth: 1, padding: 10, cornerRadius: 6, displayColors: true } }, scales: { x: { grid: { color: gc }, ticks: { color: '#5a716b' } }, y: { grid: { color: gc }, ticks: { color: '#5a716b' } } } } });
              });
            });
          }
          function wireTabs() {
            document.querySelectorAll('.sc-tab').forEach(function(btn) {
              btn.addEventListener('click', function() {
                document.querySelectorAll('.sc-tab').forEach(function(b) { b.classList.remove('active'); });
                document.querySelectorAll('.sc-chart-panel').forEach(function(p) { p.classList.remove('active'); });
                btn.classList.add('active');
                document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
              });
            });
          }
          setTimeout(function() { wireLesion(); wireAngio(); wireTabs(); }, 1700);
        }, 1500);
      }
      tryBuildCharts();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImageUrl} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="不說 Portfolio" />
        <meta property="og:locale" content="zh_TW" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="zh-TW" href={canonicalURL} />
        <link rel="alternate" hreflang="x-default" href={canonicalURL} />
        <meta name="author" content="不說" />
            <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
            <meta name="googlebot" content="index, follow" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#08060e" />
    <script is:inline>
      // 註冊新版 SW，舊 cache 會在新 SW activate 時自動清掉
      // （sw.js 的 activate handler 會刪除所有非 CACHE_NAME 的 cache）
      // 2026-10-13: bump ?v= → 強制瀏覽器抓 sw.js v11（補回 offline.html +
      // CACHE_VERSION v11）以修 console "FetchEvent resulted in a network
      // error response" 警告（v10 引用但 offline.html 不存在 → 導航
      // fallback resolve undefined）
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js?v=20261013').catch(() => {});
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.cn" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.cn/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.cn/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <link rel="stylesheet" href="/styles/shared.css" />
    <link rel="stylesheet" href="/styles/polish.css" />
    <link rel="stylesheet" href="/styles/dynamic.css" />
    {pageStyles.map((href) => <link rel="stylesheet" href={href} />)}
    <!-- Sentry error monitoring (set SENTRY_DSN env var to activate) -->
    <script is:inline>
    if (typeof __SENTRY_DSN__ !== 'undefined' && __SENTRY_DSN__) {
      import('https://browser.sentry-cdn.com/8.0.0/bundle.tracing.min.js').then(() => {
        Sentry.init({ dsn: __SENTRY_DSN__, tracesSampleRate: 0.1,
          integrations: [Sentry.browserTracingIntegration()],
          environment: location.hostname === 'localhost' ? 'development' : 'production',
        });
      }).catch(() => {});
    }
    </script>
    <script src="/scripts/theme-randomizer.js" defer></script>
    <!-- <script is:inline src="/scripts/shader-bg.js" defer></script> -->
    <script src="/scripts/admin-mode.js" defer></script>
    <script is:inline src="/scripts/site-shell-config.js" defer></script>
    <script is:inline src="/scripts/nav.js" defer></script>
    <script src="/scripts/app-config.js" defer></script>
    <script is:inline src="/scripts/dynamic-features.js" defer></script>
    <!-- <script is:inline src="/scripts/immersive-experience.js" defer></script> -->
    <Fragment set:html={headInline} />
    <!-- Console noise filter (Immersive Translate / Chrome extension errors that don't impact our app) -->
    <script is:inline>
    (function() {
      var isExtNoise = function(args) {
        try {
          var s = '';
          for (var i = 0; i < args.length; i++) {
            var a = args[i];
            s += (a && a.stack) ? a.stack : String(a == null ? a : a);
            if (s.length > 800) { s = s.slice(0, 800); break; }
          }
          return /content_main\.js|content_guard\.js|immersive[- ]?translate|chrome-extension:|moz-extension:/.test(s);
        } catch (_) { return false; }
      };
      var origErr = console.error, origWarn = console.warn;
      console.error = function() { if (isExtNoise(arguments)) return; return origErr.apply(console, arguments); };
      console.warn  = function() { if (isExtNoise(arguments)) return; return origWarn.apply(console, arguments); };
      window.addEventListener('error', function(e) {
        var src = (e && e.filename) || '', msg = (e && e.message) || '';
        if (/content_main\.js|content_guard\.js|chrome-extension:|moz-extension:/.test(src) ||
            /classList|reading 'classList'/.test(msg)) {
          e.stopImmediatePropagation(); e.preventDefault();
        }
      }, true);
      window.addEventListener('unhandledrejection', function(e) {
        var r = e && e.reason, s = r && (r.stack || r.message) || String(r);
        if (/content_main\.js|content_guard\.js|chrome-extension:|moz-extension:/.test(s)) {
          e.stopImmediatePropagation(); e.preventDefault();
        }
      });
    })();
    </script>
    {!noPersonSchema && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personSchema)}
            is:inline
        />
    )}
</head>
<body data-page={bodyPage}>
    <slot />
    {pageScripts.includes('/scripts/index-charts.js') && (
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" defer></script>
    )}
    {/* pageScripts 全部自動附 build stamp。沒有這段的話，/scripts/*.js 沒有
        cache buster，瀏覽器與 CDN 會長期 serve 舊檔 —— 改完 JS 部署上去，
        回訪的使用者還是看到舊行為（2026-10-21 diving 海況不見就是這個）。
        已自帶 ?v= 的（music.astro 手動 bump 版）用 & 接在後面，兩者都保留。 */}
    {pageScripts.map((src) => (
        <script src={`${src}${src.includes('?') ? '&' : '?'}v=${BUILD_STAMP}`}></script>
    ))}
    {/* <Analytics /> */}

    <!-- ── Search modal (Pagefind) ── -->
    <div id="pf-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:10vh">
      <div style="background:var(--bg,#0d1117);border:1px solid var(--border,rgba(255,255,255,.1));border-radius:14px;width:min(640px,90vw);max-height:70vh;overflow:hidden;display:flex;flex-direction:column">
        <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--border,rgba(255,255,255,.08))">
          <span style="color:var(--muted,#8b949e);font-size:1.1rem">🔍</span>
          <input id="pf-input" placeholder="搜尋頁面內容…" autocomplete="off" spellcheck="false"
            style="flex:1;background:none;border:none;outline:none;font-size:1rem;color:var(--text,#e6edf3);font-family:inherit" />
          <kbd style="font-size:.75rem;color:var(--muted,#8b949e);border:1px solid var(--border,rgba(255,255,255,.12));border-radius:4px;padding:2px 6px">Esc</kbd>
        </div>
        <div id="pf-results" style="overflow-y:auto;padding:8px 0;flex:1"></div>
      </div>
    </div>
    <!-- Search trigger button (bottom-right) - 簡單放大鏡 -->
    <button id="pf-btn" title="搜尋 (Ctrl+K)" aria-label="搜尋"
      style="position:fixed;bottom:24px;right:24px;z-index:400;background:linear-gradient(135deg,#58d7ff,#7bf0be);border:none;border-radius:50%;width:56px;height:56px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .2s,box-shadow .2s;box-shadow:0 4px 16px rgba(88,215,255,.35);overflow:visible"
      onmouseover="this.style.transform='scale(1.12)';this.style.boxShadow='0 6px 24px rgba(88,215,255,.55)'"
      onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 16px rgba(88,215,255,.35)'">
      <svg id="search-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
           style="width:26px;height:26px;display:block">
        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="#0a1116" stroke-width="2.2"/>
        <line x1="15.5" y1="15.5" x2="20.5" y2="20.5" stroke="#0a1116" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
    <style>
      @keyframes bounce-gentle {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
      }
      #pf-btn:hover #search-icon {
        animation: wiggle 0.5s ease-in-out;
      }
      @keyframes wiggle {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-8deg); }
        75% { transform: rotate(8deg); }
      }
    </style>
    <script is:inline>
    (function() {
      const modal  = document.getElementById('pf-modal');
      const input  = document.getElementById('pf-input');
      const results= document.getElementById('pf-results');
      const btn    = document.getElementById('pf-btn');
      let pf = null, debounce = null;

      async function openModal() {
        modal.style.display = 'flex';
        input.focus();
        if (!pf) {
          try {
            pf = await import('/pagefind/pagefind.js');
            await pf.init();
          } catch(e) { results.innerHTML = '<p style="padding:16px 20px;color:#8b949e;font-size:.85rem">搜尋索引尚未建立（需要先 build）。</p>'; pf = null; }
        }
      }
      function closeModal() { modal.style.display = 'none'; input.value = ''; results.innerHTML = ''; }

      async function doSearch(q) {
        if (!pf || !q.trim()) { results.innerHTML = ''; return; }
        const sr = await pf.search(q);
        const items = await Promise.all(sr.results.slice(0, 8).map(r => r.data()));
        results.innerHTML = items.length
          ? items.map(d => `<a href="${d.url}" style="display:block;padding:10px 18px;text-decoration:none;color:var(--text,#e6edf3);border-bottom:1px solid var(--border,rgba(255,255,255,.05));transition:background .1s" onmouseover="this.style.background='rgba(255,255,255,.04)'" onmouseout="this.style.background=''">
              <div style="font-size:.9rem;font-weight:600;margin-bottom:3px">${d.meta?.title || d.url}</div>
              <div style="font-size:.78rem;color:#8b949e">${d.excerpt}</div>
            </a>`).join('')
          : '<p style="padding:16px 20px;color:#8b949e;font-size:.85rem">找不到結果。</p>';
      }

      btn.addEventListener('click', openModal);
      modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openModal(); }
        if (e.key === 'Escape') closeModal();
      });
      input.addEventListener('input', () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => doSearch(input.value), 250);
      });
    })();
    </script>

    <!-- Site-wide 3D chatbot assistant -->
    <Chatbot />
</body>
</html>
