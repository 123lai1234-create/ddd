---
// NOTE: Vercel Analytics removed — the `<Analytics />` web component hard-loads
// `/_vercel/insights/script.js` which only exists on Vercel deployments and
// spammed the console on Netlify. Re-add with a host-conditional wrapper if
// analytics are needed on both hosts.
import ImmersiveBackground from '../components/ImmersiveBackground.astro';

const SITE = 'https://dontalk.vercel.app';

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogTag?: string;
    bodyPage?: string;
    pageStyles?: string[];
    pageScripts?: string[];
    headInline?: string;
    noImmersive?: boolean;
    /** Override page type for Schema.org (defaults to 'WebPage'). Use 'ProfilePage' for /, 'Article' for blog posts. */
    schemaType?: string;
    /** Disable the global Person+WebSite JSON-LD (e.g. for legal pages that shouldn't assert identity). */
    noPersonSchema?: boolean;
}

const {
    title,
    description = '',
    ogImage,
    ogTag = '',
    bodyPage,
    pageStyles = [],
    pageScripts = [],
    headInline = '',
    noImmersive = false,
    schemaType = 'WebPage',
    noPersonSchema = false,
} = Astro.props;

const ogImageUrl = ogImage
    ?? `${SITE}/og?t=${encodeURIComponent(title)}&s=${encodeURIComponent(description || 'JT Lai 作品集')}&tag=${encodeURIComponent(ogTag)}`;

// Canonical: strip query strings & hash, force trailing-slash consistency via Astro.site.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE).toString();

// Person + WebSite JSON-LD (site-wide identity graph for AI crawlers).
const personSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': `${SITE}#person`,
            name: 'JT Lai',
            url: SITE,
            image: `${SITE}/og-default.png`,
            sameAs: [
                'https://github.com/123lai1234-create',
                'https://huggingface.co/Donttalk123',
            ],
            jobTitle: '全端工程師 / 生醫研究者',
            description: '電資工程與生物醫學雙碩士，整合蛋白質 AI 設計、基因分析、NGS 流程與互動平台開發的全端跨域工程師。',
            knowsAbout: [
                'Protein Language Model', 'ESM-2', 'ProteinMPNN',
                'Bayesian Optimization', 'BoTorch', 'REINFORCE',
                'NGS Analysis', 'RNA-seq', 'WGS', 'scRNA-seq',
                'FastAPI', 'Astro', 'PostgreSQL', 'Python', 'TypeScript',
            ],
            alumniOf: [
                { '@type': 'EducationalOrganization', name: '國立臺北科技大學 電子工程研究所' },
                { '@type': 'EducationalOrganization', name: '國立陽明交通大學 解剖學及細胞生物學研究所' },
            ],
        },
        {
            '@type': 'WebSite',
            '@id': `${SITE}#website`,
            url: SITE,
            name: 'JT Lai Portfolio',
            inLanguage: 'zh-TW',
            author: { '@id': `${SITE}#person` },
            potentialAction: {
                '@type': 'SearchAction',
                target: `${SITE}/?q={search_term_string}`,
                'query-input': 'required name=search_term_string',
            },
        },
        {
            '@type': 'WebPage',
            '@id': `${canonicalURL}#webpage`,
            url: canonicalURL,
            name: title,
            description: description,
            inLanguage: 'zh-TW',
            isPartOf: { '@id': `${SITE}#website` },
            about: { '@id': `${SITE}#person` },
            additionalType: schemaType,
        },
    ],
};
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js-reveal');</script>
    <!--
      Native IntersectionObserver fallback for `.reveal` fade-in.
      Runs in addition to nav.js's local observer, so the page works
      even if nav.js fails to load (network/CDN issue) — content stays
      visible instead of getting stuck at opacity:0.
    -->
    <script is:inline>
      (function() {
        function bootReveal() {
          var els = document.querySelectorAll('.reveal:not(.visible)');
          if (!els.length) return;
          if (typeof IntersectionObserver === 'undefined') {
            els.forEach(function(el) { el.classList.add('visible'); });
            return;
          }
          var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.04 });
          els.forEach(function(el) { io.observe(el); });
          // Hard fallback: anything still hidden after 1.5s gets shown.
          setTimeout(function() {
            document.querySelectorAll('.reveal:not(.visible)').forEach(function(el) {
              el.classList.add('visible');
            });
          }, 1500);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bootReveal);
        } else {
          bootReveal();
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="JT Lai Portfolio" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="zh-TW" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <meta name="author" content="JT Lai" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧬</text></svg>" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#08060e" />
    <script is:inline>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;1,14..32,300;1,14..32,400;1,14..32,500;1,14..32,600;1,14..32,700;1,14..32,800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300;0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,800;1,14..32,300;1,14..32,400;1,14..32,500;1,14..32,600;1,14..32,700;1,14..32,800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap" rel="stylesheet" /></noscript>
    <link rel="stylesheet" href="/styles/shared.css" />
    <link rel="stylesheet" href="/styles/polish.css" />
    {!noImmersive && <link rel="stylesheet" href="/styles/dynamic.css" />}
    {!noImmersive && <link rel="stylesheet" href="/styles/immersive-experience.css" />}
    {pageStyles.map((href) => <link rel="stylesheet" href={href} />)}
    <!-- Sentry error monitoring (set SENTRY_DSN env var to activate) -->
    <script is:inline>
    if (typeof __SENTRY_DSN__ !== 'undefined' && __SENTRY_DSN__) {
      import('https://browser.sentry-cdn.com/8.0.0/bundle.tracing.min.js').then(() => {
        Sentry.init({ dsn: __SENTRY_DSN__, tracesSampleRate: 0.1,
          integrations: [Sentry.browserTracingIntegration()],
          environment: location.hostname === 'localhost' ? 'development' : 'production',
        });
      }).catch(() => {});
    }
    </script>
    <script is:inline src="/scripts/theme-randomizer.js"></script>
    {!noImmersive && <script is:inline src="/scripts/shader-bg.js" defer></script>}
    <script is:inline src="/scripts/admin-mode.js"></script>
    <script is:inline src="/scripts/site-shell-config.js" defer></script>
    <script is:inline src="/scripts/nav.js" defer></script>
    <script is:inline src="/scripts/app-config.js" defer></script>
    {!noImmersive && <script is:inline src="/scripts/dynamic-features.js" defer></script>}
    {!noImmersive && <script is:inline src="/scripts/immersive-experience.js" defer></script>}
    <Fragment set:html={headInline} />
    {!noPersonSchema && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personSchema)}
            is:inline
        />
    )}
</head>
<body data-page={bodyPage}>
    {!noImmersive && <ImmersiveBackground />}
    <slot />
    {pageScripts.map((src) => <script is:inline src={src}></script>)}

    <!-- ── Search modal (Pagefind) ── -->
    <div id="pf-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:10vh">
      <div style="background:var(--bg,#0d1117);border:1px solid var(--border,rgba(255,255,255,.1));border-radius:14px;width:min(640px,90vw);max-height:70vh;overflow:hidden;display:flex;flex-direction:column">
        <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--border,rgba(255,255,255,.08))">
          <span style="color:var(--muted,#8b949e);font-size:1.1rem">🔍</span>
          <input id="pf-input" placeholder="搜尋頁面內容…" autocomplete="off" spellcheck="false"
            style="flex:1;background:none;border:none;outline:none;font-size:1rem;color:var(--text,#e6edf3);font-family:inherit" />
          <kbd style="font-size:.75rem;color:var(--muted,#8b949e);border:1px solid var(--border,rgba(255,255,255,.12));border-radius:4px;padding:2px 6px">Esc</kbd>
        </div>
        <div id="pf-results" style="overflow-y:auto;padding:8px 0;flex:1"></div>
      </div>
    </div>
    <!-- Search trigger button (bottom-right) -->
    <button id="pf-btn" title="搜尋 (Ctrl+K)" aria-label="搜尋"
      style="position:fixed;bottom:24px;right:24px;z-index:500;background:var(--surface,rgba(255,255,255,.06));border:1px solid var(--border,rgba(255,255,255,.12));border-radius:50%;width:44px;height:44px;font-size:1.1rem;cursor:pointer;color:var(--muted,#8b949e);display:flex;align-items:center;justify-content:center;transition:all .15s;box-shadow:0 4px 16px rgba(0,0,0,.3)">🔍</button>
    <script is:inline>
    (function() {
      const modal  = document.getElementById('pf-modal');
      const input  = document.getElementById('pf-input');
      const results= document.getElementById('pf-results');
      const btn    = document.getElementById('pf-btn');
      let pf = null, debounce = null;

      async function openModal() {
        modal.style.display = 'flex';
        input.focus();
        if (!pf) {
          try {
            pf = await import('/pagefind/pagefind.js');
            await pf.init();
          } catch(e) { results.innerHTML = '<p style="padding:16px 20px;color:#8b949e;font-size:.85rem">搜尋索引尚未建立（需要先 build）。</p>'; pf = null; }
        }
      }
      function closeModal() { modal.style.display = 'none'; input.value = ''; results.innerHTML = ''; }

      async function doSearch(q) {
        if (!pf || !q.trim()) { results.innerHTML = ''; return; }
        const sr = await pf.search(q);
        const items = await Promise.all(sr.results.slice(0, 8).map(r => r.data()));
        results.innerHTML = items.length
          ? items.map(d => `<a href="${d.url}" style="display:block;padding:10px 18px;text-decoration:none;color:var(--text,#e6edf3);border-bottom:1px solid var(--border,rgba(255,255,255,.05));transition:background .1s" onmouseover="this.style.background='rgba(255,255,255,.04)'" onmouseout="this.style.background=''">
              <div style="font-size:.9rem;font-weight:600;margin-bottom:3px">${d.meta?.title || d.url}</div>
              <div style="font-size:.78rem;color:#8b949e">${d.excerpt}</div>
            </a>`).join('')
          : '<p style="padding:16px 20px;color:#8b949e;font-size:.85rem">找不到結果。</p>';
      }

      btn.addEventListener('click', openModal);
      modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openModal(); }
        if (e.key === 'Escape') closeModal();
      });
      input.addEventListener('input', () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => doSearch(input.value), 250);
      });
    })();
    </script>
</body>
</html>
