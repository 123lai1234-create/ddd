---
import Analytics from '@vercel/analytics/astro';
import ImmersiveBackground from '../components/ImmersiveBackground.astro';

const SITE = 'https://donttalk.vercel.app';

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogTag?: string;
    bodyPage?: string;
    pageStyles?: string[];
    pageScripts?: string[];
    headInline?: string;
    /** Override page type for Schema.org (defaults to 'WebPage'). Use 'ProfilePage' for /, 'Article' for blog posts. */
    schemaType?: string;
    /** Disable the global Person+WebSite JSON-LD (e.g. for legal pages that shouldn't assert identity). */
    noPersonSchema?: boolean;
}

const {
    title,
    description = '',
    ogImage,
    ogTag = '',
    bodyPage,
    pageStyles = [],
    pageScripts = [],
    headInline = '',
    schemaType = 'WebPage',
    noPersonSchema = false,
} = Astro.props;

const ogImageUrl = ogImage
    ?? `${SITE}/og?t=${encodeURIComponent(title)}&s=${encodeURIComponent(description || 'JT Lai 作品集')}&tag=${encodeURIComponent(ogTag)}`;

// Canonical: strip query strings & hash, force trailing-slash consistency via Astro.site.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE).toString();

// Person + WebSite JSON-LD (site-wide identity graph for AI crawlers).
const personSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': `${SITE}#person`,
            name: 'JT Lai',
            url: SITE,
            image: `${SITE}/og-default.png`,
            sameAs: [
                'https://github.com/123lai1234-create',
                'https://huggingface.co/Donttalk123',
            ],
            jobTitle: '全端工程師 / 生醫研究者',
            description: '電資工程與生物醫學雙碩士，整合蛋白質 AI 設計、基因分析、NGS 流程與互動平台開發的全端跨域工程師。',
            knowsAbout: [
                'Protein Language Model', 'ESM-2', 'ProteinMPNN',
                'Bayesian Optimization', 'BoTorch', 'REINFORCE',
                'NGS Analysis', 'RNA-seq', 'WGS', 'scRNA-seq',
                'FastAPI', 'Astro', 'PostgreSQL', 'Python', 'TypeScript',
            ],
            alumniOf: [
                { '@type': 'EducationalOrganization', name: '國立臺北科技大學 電子工程研究所' },
                { '@type': 'EducationalOrganization', name: '國立陽明交通大學 解剖學及細胞生物學研究所' },
            ],
        },
        {
            '@type': 'WebSite',
            '@id': `${SITE}#website`,
            url: SITE,
            name: 'JT Lai Portfolio',
            inLanguage: 'zh-TW',
            author: { '@id': `${SITE}#person` },
            potentialAction: {
                '@type': 'SearchAction',
                target: `${SITE}/?q={search_term_string}`,
                'query-input': 'required name=search_term_string',
            },
        },
        {
            '@type': 'WebPage',
            '@id': `${canonicalURL}#webpage`,
            url: canonicalURL,
            name: title,
            description: description,
            inLanguage: 'zh-TW',
            isPartOf: { '@id': `${SITE}#website` },
            about: { '@id': `${SITE}#person` },
            additionalType: schemaType,
        },
    ],
};
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js-reveal');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImageUrl} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:site_name" content="JT Lai Portfolio" />
        <meta property="og:locale" content="zh_TW" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang="zh-TW" href={canonicalURL} />
        <link rel="alternate" hreflang="x-default" href={canonicalURL} />
        <meta name="author" content="JT Lai" />
            <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
            <meta name="googlebot" content="index, follow" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧬</text></svg>" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#08060e" />
    <script is:inline>
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.cn" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.cn/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.cn/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <link rel="stylesheet" href="/styles/shared.css" />
    <link rel="stylesheet" href="/styles/polish.css" />
    <link rel="stylesheet" href="/styles/dynamic.css" />
    <link rel="stylesheet" href="/styles/immersive-experience.css" />
    {pageStyles.map((href) => <link rel="stylesheet" href={href} />)}
    <!-- Sentry error monitoring (set SENTRY_DSN env var to activate) -->
    <script is:inline>
    if (typeof __SENTRY_DSN__ !== 'undefined' && __SENTRY_DSN__) {
      import('https://browser.sentry-cdn.com/8.0.0/bundle.tracing.min.js').then(() => {
        Sentry.init({ dsn: __SENTRY_DSN__, tracesSampleRate: 0.1,
          integrations: [Sentry.browserTracingIntegration()],
          environment: location.hostname === 'localhost' ? 'development' : 'production',
        });
      }).catch(() => {});
    }
    </script>
    <script is:inline src="/scripts/theme-randomizer.js"></script>
    <script is:inline src="/scripts/shader-bg.js" defer></script>
    <script is:inline src="/scripts/admin-mode.js"></script>
    <script is:inline src="/scripts/site-shell-config.js" defer></script>
    <script is:inline src="/scripts/nav.js" defer></script>
    <script is:inline src="/scripts/app-config.js" defer></script>
    <script is:inline src="/scripts/dynamic-features.js" defer></script>
    <script is:inline src="/scripts/immersive-experience.js" defer></script>
    <Fragment set:html={headInline} />
    <!-- Console noise filter (Immersive Translate / Chrome extension errors that don't impact our app) -->
    <script is:inline>
    (function() {
      var isExtNoise = function(args) {
        try {
          var s = '';
          for (var i = 0; i < args.length; i++) {
            var a = args[i];
            s += (a && a.stack) ? a.stack : String(a == null ? a : a);
            if (s.length > 800) { s = s.slice(0, 800); break; }
          }
          return /content_main\.js|content_guard\.js|immersive[- ]?translate|chrome-extension:|moz-extension:/.test(s);
        } catch (_) { return false; }
      };
      var origErr = console.error, origWarn = console.warn;
      console.error = function() { if (isExtNoise(arguments)) return; return origErr.apply(console, arguments); };
      console.warn  = function() { if (isExtNoise(arguments)) return; return origWarn.apply(console, arguments); };
      window.addEventListener('error', function(e) {
        var src = (e && e.filename) || '', msg = (e && e.message) || '';
        if (/content_main\.js|content_guard\.js|chrome-extension:|moz-extension:/.test(src) ||
            /classList|reading 'classList'/.test(msg)) {
          e.stopImmediatePropagation(); e.preventDefault();
        }
      }, true);
      window.addEventListener('unhandledrejection', function(e) {
        var r = e && e.reason, s = r && (r.stack || r.message) || String(r);
        if (/content_main\.js|content_guard\.js|chrome-extension:|moz-extension:/.test(s)) {
          e.stopImmediatePropagation(); e.preventDefault();
        }
      });
    })();
    </script>
    {!noPersonSchema && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personSchema)}
            is:inline
        />
    )}
</head>
<body data-page={bodyPage}>
    <ImmersiveBackground />
    <slot />
    {pageScripts.includes('/scripts/index-charts.js') && (
        <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    )}
    {pageScripts.map((src) => <script is:inline src={src}></script>)}
    <Analytics />

    <!-- ── Search modal (Pagefind) ── -->
    <div id="pf-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);align-items:flex-start;justify-content:center;padding-top:10vh">
      <div style="background:var(--bg,#0d1117);border:1px solid var(--border,rgba(255,255,255,.1));border-radius:14px;width:min(640px,90vw);max-height:70vh;overflow:hidden;display:flex;flex-direction:column">
        <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--border,rgba(255,255,255,.08))">
          <span style="color:var(--muted,#8b949e);font-size:1.1rem">🔍</span>
          <input id="pf-input" placeholder="搜尋頁面內容…" autocomplete="off" spellcheck="false"
            style="flex:1;background:none;border:none;outline:none;font-size:1rem;color:var(--text,#e6edf3);font-family:inherit" />
          <kbd style="font-size:.75rem;color:var(--muted,#8b949e);border:1px solid var(--border,rgba(255,255,255,.12));border-radius:4px;padding:2px 6px">Esc</kbd>
        </div>
        <div id="pf-results" style="overflow-y:auto;padding:8px 0;flex:1"></div>
      </div>
    </div>
    <!-- Search trigger button (bottom-right) - Q版人偶 -->
    <button id="pf-btn" title="搜尋 (Ctrl+K)" aria-label="搜尋"
      style="position:fixed;bottom:24px;right:24px;z-index:500;background:transparent;border:none;border-radius:50%;width:60px;height:60px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .2s,filter .2s;filter:drop-shadow(0 4px 12px rgba(0,0,0,.4));overflow:visible"
      onmouseover="this.style.transform='scale(1.15)';this.style.filter='drop-shadow(0 8px 20px rgba(88,215,255,.4))'"
      onmouseout="this.style.transform='scale(1)';this.style.filter='drop-shadow(0 4px 12px rgba(0,0,0,.4))'">
      <svg id="search-avatar" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-label="AI 助手"
           style="width:100%;height:100%;animation:bounce-gentle 3s ease-in-out infinite;display:block">
        <defs>
          <linearGradient id="pfav-g" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#a78bfa"/>
            <stop offset="100%" stop-color="#22d3ee"/>
          </linearGradient>
          <radialGradient id="pfav-c" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fde68a"/>
            <stop offset="100%" stop-color="#fbbf24"/>
          </radialGradient>
        </defs>
        <!-- head -->
        <circle cx="50" cy="50" r="36" fill="url(#pfav-g)" stroke="#fff" stroke-width="2.5" stroke-opacity="0.9"/>
        <!-- eyes (closed-arc ^ ^) -->
        <path d="M 36 47 Q 40 41 44 47" stroke="#1a1a2e" stroke-width="2.8" fill="none" stroke-linecap="round"/>
        <path d="M 56 47 Q 60 41 64 47" stroke="#1a1a2e" stroke-width="2.8" fill="none" stroke-linecap="round"/>
        <!-- mouth -->
        <path d="M 44 58 Q 50 64 56 58" stroke="#1a1a2e" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <!-- cheeks -->
        <ellipse cx="34" cy="56" rx="4" ry="2.5" fill="#fb7185" opacity="0.55"/>
        <ellipse cx="66" cy="56" rx="4" ry="2.5" fill="#fb7185" opacity="0.55"/>
        <!-- antenna -->
        <line x1="50" y1="14" x2="50" y2="8" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
        <circle cx="50" cy="6" r="3" fill="url(#pfav-c)"/>
        <!-- magnifying glass (held to the side) -->
        <circle cx="80" cy="78" r="10" fill="rgba(255,255,255,0.18)" stroke="#fff" stroke-width="3"/>
        <line x1="87" y1="85" x2="94" y2="92" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
      </svg>
    </button>
    <style>
      @keyframes bounce-gentle {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
      }
      #pf-btn:hover #search-avatar {
        animation: wiggle 0.5s ease-in-out;
      }
      @keyframes wiggle {
        0%, 100% { transform: rotate(0deg); }
        25% { transform: rotate(-8deg); }
        75% { transform: rotate(8deg); }
      }
    </style>
    <script is:inline>
    (function() {
      const modal  = document.getElementById('pf-modal');
      const input  = document.getElementById('pf-input');
      const results= document.getElementById('pf-results');
      const btn    = document.getElementById('pf-btn');
      let pf = null, debounce = null;

      async function openModal() {
        modal.style.display = 'flex';
        input.focus();
        if (!pf) {
          try {
            pf = await import('/pagefind/pagefind.js');
            await pf.init();
          } catch(e) { results.innerHTML = '<p style="padding:16px 20px;color:#8b949e;font-size:.85rem">搜尋索引尚未建立（需要先 build）。</p>'; pf = null; }
        }
      }
      function closeModal() { modal.style.display = 'none'; input.value = ''; results.innerHTML = ''; }

      async function doSearch(q) {
        if (!pf || !q.trim()) { results.innerHTML = ''; return; }
        const sr = await pf.search(q);
        const items = await Promise.all(sr.results.slice(0, 8).map(r => r.data()));
        results.innerHTML = items.length
          ? items.map(d => `<a href="${d.url}" style="display:block;padding:10px 18px;text-decoration:none;color:var(--text,#e6edf3);border-bottom:1px solid var(--border,rgba(255,255,255,.05));transition:background .1s" onmouseover="this.style.background='rgba(255,255,255,.04)'" onmouseout="this.style.background=''">
              <div style="font-size:.9rem;font-weight:600;margin-bottom:3px">${d.meta?.title || d.url}</div>
              <div style="font-size:.78rem;color:#8b949e">${d.excerpt}</div>
            </a>`).join('')
          : '<p style="padding:16px 20px;color:#8b949e;font-size:.85rem">找不到結果。</p>';
      }

      btn.addEventListener('click', openModal);
      modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openModal(); }
        if (e.key === 'Escape') closeModal();
      });
      input.addEventListener('input', () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => doSearch(input.value), 250);
      });
    })();
    </script>
</body>
</html>
