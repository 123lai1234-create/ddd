---
import Base from '../layouts/Base.astro';

const MODEL_URL = '/models/mascot-3d.glb';
// 真實數據 —— 由 scripts/sync-mascot-stats.mjs 直接解析 public/models/mascot-3d.glb 得出，不要手填。
// 解析結果：116,292 tris / 13 materials / 386,504 bytes
// 大小用截尾（0.3 MB）；改用另一種請加 --round 後重跑。
const STAT_TRIS = '116 K';
const STAT_MATS = '13';
const STAT_SIZE = '0.3 MB';
---

<Base
    title="3D Mascot | 元嬰不說 真 3D 互動模型"
    description="元嬰不說 chibi mascot — 真 3D 模型，可用滑鼠旋轉縮放。"
    bodyPage="index"
    pageStyles={["/styles/index.css"]}
    pageScripts={["/scripts/app-config.js"]}
    headInline={`<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>`}
>
    <div class="mascot-3d-page">
        <header class="mascot-3d-head">
            <h1>🧒 元嬰不說 · 真 3D 模型</h1>
            <p class="subtitle">
                亂黑髮、白 T 恤、紅色寬褲、腰間綁著格紋襯衫的 2 頭身 chibi ——
                跟右下角那隻浮動立繪是<b>同一個角色</b>。滑鼠拖曳可以旋轉、滾輪縮放。
            </p>
        </header>

        <!-- model-viewer 需要「父容器有明確高度」，這裡是整頁能不能看到模型的關鍵 -->
        <div class="mascot-3d-stage" id="stage">
            <model-viewer
                id="chibiViewer"
                src={MODEL_URL}
                alt="元嬰不說 chibi mascot 真 3D 模型"
                camera-orbit="0deg 82deg 4.4m"
                camera-target="0m 0.9m 0.2m"
                camera-controls
                field-of-view="30deg"
                shadow-intensity="0.7"
                shadow-softness="0.85"
                exposure="0.85"
                interaction-prompt="auto"
                interaction-prompt-style="wiggle"
                touch-action="pan-y"
                ar-modes="none"
            >
                <div slot="progress-bar" class="mascot-3d-progress" aria-hidden="true"></div>
            </model-viewer>
            <div class="mascot-3d-floor" aria-hidden="true"></div>
            <p class="mascot-3d-loading" id="mvLoading">載入 3D 模型中…</p>
        </div>

        <div class="stats-row">
            <div><div class="num">{STAT_TRIS}</div><div class="lbl">三角面</div></div>
            <div><div class="num">{STAT_MATS}</div><div class="lbl">材質區</div></div>
            <div><div class="num">{STAT_SIZE}</div><div class="lbl">GLB 大小</div></div>
            <div><div class="num">4.5</div><div class="lbl">Blender LTS</div></div>
        </div>

        <p class="mascot-3d-hint">
            💡 這顆是<b>從零手工建</b>的：沒有 AI 重建、沒有任何貼圖，
            幾何全部在 <b>Blender 4.5 LTS</b> 裡用參數化曲面組成，
            每個部位一個<b>純色材質</b>，所以顏色不會跑掉、也不會有貼圖鋸齒。
            拖曳 = 旋轉，滾輪 = 縮放。
        </p>

        <div class="mascot-3d-info">
            <h3>為什麼不給 AI 重建，要一個部位一個部位自己建？</h3>
            <p>
                試過 <b>TripoSR</b>、<b>Hunyuan3D</b>、<b>Meshy</b>：把 2D chibi 設定圖餵進去，
                出來的都是「胖嘟嘟的 blob」，完全不像小朋友。所以改成
                <b>照設定圖手動建模</b> —— 把參考圖上的尺寸一個一個量下來，寫成參數。
            </p>
            <ul>
                <li>頭顱是<b>超橢圓截面</b>逐層堆疊（15 層）出來的，不是球體縮放</li>
                <li>眼睛是<b>貼在臉上再往外鼓起</b>的曲面片：眼白 → 虹膜 → 瞳孔 → 高光，
                    再加一條<b>坐在眼白上的睫毛上緣</b> —— 少了那條黑線，眼睛會變成蟲眼</li>
                <li>頭髮是<b>一整片參數化殼層</b>加上 <b>30 幾片貝茲曲線掃出的髮片</b>：
                    髮片是沿著二次曲線掃出、末端收尖的葉片，不是錐體
                    （錐體會變成一排鯊魚鰭），額前那 8 片再平貼在額頭上</li>
                <li>格紋腰結是<b>頂點色</b>不是節點貼圖：程序化節點貼圖在 glTF 匯出時會直接消失，
                    變成一片白圍裙</li>
                <li>全部用<b>純色材質</b>、不貼任何 texture，匯出開 <b>Draco</b> 壓縮</li>
            </ul>
            <p>
                這顆跟首頁那隻浮動立繪是<b>同一個設計稿</b>（<code>astro/public/images/chibi-hero.png</code>），
                尺寸與配色都是從那張圖上量出來的。
            </p>
            <p class="mascot-3d-foot">
                腳本原始檔：<code>D:\project\blender\chibi_build.py</code>；
                量測腳本：<code>D:\project\blender\measure_hero.py</code>。<br />
                預覽圖：<code>out/preview_front.png</code>、<code>out/preview_three_quarter.png</code>、
                <code>out/preview_side.png</code>、<code>out/preview_back.png</code>。
            </p>
        </div>
    </div>

    <script is:inline>
    (function () {
        const viewer = document.getElementById('chibiViewer');
        const loading = document.getElementById('mvLoading');
        if (!viewer) return;

        const done = () => {
            if (loading) {
                loading.textContent = '';
                loading.hidden = true;
            }
        };
        const fail = () => {
            if (loading) {
                loading.textContent = '3D 模型載入失敗（' + (viewer.getAttribute('src') || 'unknown') + '）';
                loading.hidden = false;
                loading.classList.add('is-error');
            }
        };

        viewer.addEventListener('load', done);
        viewer.addEventListener('error', fail);
    })();
    </script>
</Base>

<style>
    .mascot-3d-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
    }

    .mascot-3d-head h1 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        letter-spacing: -0.02em;
    }

    .mascot-3d-head .subtitle {
        margin: 0;
        color: var(--muted, #8b949e);
        font-size: 0.95rem;
        line-height: 1.7;
    }

    /* 關鍵：model-viewer 是 height:100%，父容器必須給「明確高度」，
       否則 auto height 會讓 percentage 解析為 0 → 整隻模型看不到。 */
    .mascot-3d-stage {
        position: relative;
        width: 100%;
        height: clamp(360px, 68vh, 680px);
        margin: 1.75rem 0;
        border-radius: 18px;
        overflow: hidden;
        isolation: isolate;
        border: 1px solid rgba(88, 215, 255, 0.16);
        background:
            radial-gradient(120% 90% at 50% 16%, rgba(88, 215, 255, 0.14), transparent 62%),
            linear-gradient(180deg, #101a24 0%, #08060e 100%);
        box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
    }

    model-viewer {
        display: block;
        width: 100%;
        height: 100%;
        background: transparent;
        --poster-color: transparent;
    }

    .mascot-3d-floor {
        position: absolute;
        left: 50%;
        bottom: 7%;
        width: 58%;
        height: 9%;
        transform: translateX(-50%);
        background: radial-gradient(ellipse at center, rgba(123, 240, 190, 0.24), rgba(123, 240, 190, 0) 70%);
        filter: blur(6px);
        pointer-events: none;
    }

    .mascot-3d-loading {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        color: var(--muted, #8b949e);
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        pointer-events: none;
        transition: opacity 0.4s;
    }

    .mascot-3d-loading[hidden] {
        display: none;
    }

    .mascot-3d-loading.is-error {
        color: #ff8392;
    }

    .mascot-3d-progress {
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #58d7ff, #7bf0be);
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform 0.3s;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.75rem;
        margin: 1.25rem 0;
    }

    .stats-row > div {
        padding: 0.9rem 0.75rem;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
    }

    .stats-row .num {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 1.25rem;
        font-weight: 700;
        color: #7bf0be;
    }

    .stats-row .lbl {
        margin-top: 0.25rem;
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        color: var(--muted, #8b949e);
    }

    .mascot-3d-hint {
        margin: 1.5rem 0 0;
        padding: 1rem 1.15rem;
        font-size: 0.9rem;
        line-height: 1.85;
        color: var(--text, #e9f0ec);
        border: 1px solid rgba(123, 240, 190, 0.22);
        border-radius: 12px;
        background: rgba(123, 240, 190, 0.05);
    }

    .mascot-3d-info {
        margin-top: 1.75rem;
        font-size: 0.92rem;
        line-height: 1.9;
        color: var(--text, #e9f0ec);
    }

    .mascot-3d-info h3 {
        margin: 0 0 0.75rem;
        font-size: 1.05rem;
        color: #58d7ff;
    }

    .mascot-3d-info ul {
        margin: 0 0 1rem;
        padding-left: 1.5em;
    }

    .mascot-3d-info code {
        padding: 0.1em 0.4em;
        border-radius: 5px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.85em;
        background: rgba(255, 255, 255, 0.07);
    }

    .mascot-3d-foot {
        font-size: 0.85em;
        opacity: 0.78;
    }
</style>