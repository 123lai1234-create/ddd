---
import Base from '../layouts/Base.astro';

const MODEL_URL = '/models/mascot-3d.glb';
// 真實數據 —— 由 scripts/sync-mascot-stats.mjs 直接解析 public/models/mascot-3d.glb 得出，不要手填。
// 解析結果：190,876 tris / 1 materials / 6,269,268 bytes
// 大小用截尾（5.9 MB）；改用另一種請加 --round 後重跑。
const STAT_TRIS = '191 K';
const STAT_MATS = '1';
const STAT_SIZE = '5.9 MB';
---

<Base
    title="3D Mascot | 香菇柯基 真 3D 互動模型"
    description="香菇柯基 mascot — 真 3D 模型，可用滑鼠旋轉縮放。"
    bodyPage="index"
    pageStyles={["/styles/index.css"]}
    pageScripts={["/scripts/app-config.js"]}
    headInline={`<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>`}
>
    <div class="mascot-3d-page">
        <header class="mascot-3d-head">
            <h1>🍄 香菇柯基 · 真 3D 模型</h1>
            <p class="subtitle">
                棕色香菇帽、米白身體、黃白柯基臉、舉手揮手的香菇狗 ——
                跟右下角那張香菇柯基照片是<b>同一個角色</b>，3D 版是用那張照片經 3DValley 免費生成的。滑鼠拖曳可以旋轉、滾輪縮放。
            </p>
        </header>

        <!-- model-viewer 需要「父容器有明確高度」，這裡是整頁能不能看到模型的關鍵 -->
        <div class="mascot-3d-stage" id="stage">
            <model-viewer
                id="chibiViewer"
                src={MODEL_URL}
                alt="香菇柯基 mascot 真 3D 模型"
                camera-orbit="0deg 82deg 2.8m"
                camera-target="0m 0m 0m"
                camera-controls
                field-of-view="30deg"
                shadow-intensity="0.7"
                shadow-softness="0.85"
                exposure="0.85"
                interaction-prompt="auto"
                interaction-prompt-style="wiggle"
                touch-action="pan-y"
                ar-modes="none"
            >
                <div slot="progress-bar" class="mascot-3d-progress" aria-hidden="true"></div>
            </model-viewer>
            <div class="mascot-3d-floor" aria-hidden="true"></div>
            <p class="mascot-3d-loading" id="mvLoading">載入 3D 模型中…</p>
        </div>

        <div class="stats-row">
            <div><div class="num">{STAT_TRIS}</div><div class="lbl">三角面</div></div>
            <div><div class="num">{STAT_MATS}</div><div class="lbl">材質區</div></div>
            <div><div class="num">{STAT_SIZE}</div><div class="lbl">GLB 大小</div></div>
            <div><div class="num">TRELLIS.2</div><div class="lbl">生成引擎</div></div>
        </div>

        <p class="mascot-3d-hint">
            💡 這顆是<b>用照片生成的</b>：把香菇柯基照片上傳到 3DValley，
            以 <b>TRELLIS.2 Standard</b> 免費生成，背面菇帽滲進照片背景的天空藍，
            已在貼圖裡轉成棕色（三輪修正，第三輪後只剩邊緣極淡的灰痕）。
            拖曳 = 旋轉，滾輪 = 縮放。
        </p>

        <div class="mascot-3d-info">
            <h3>這顆香菇狗是怎麼做的？</h3>
            <p>
                把使用者給的香菇柯基照片上傳到 3DValley，以 <b>TRELLIS.2 Standard</b> 免費生成，
                全程免登入、免付費，64 秒生出 190,876 個三角面、1 個材質、2 張 2048 貼圖。
                單張照片轉 3D 的背面只能由模型推測，但這顆正背面都完整成形。
            </p>
            <ul>
                <li>香菇帽是<b>棕色圓頂</b>，生成時背面滲進照片背景的天空藍，已在貼圖裡三輪修正成棕色</li>
                <li>柯基臉是<b>黃白臉</b>：中間白條、黑鼻子、張嘴吐舌頭，跟照片一樣</li>
                <li>左手<b>舉起來</b>，白手掌朝前；右側有橘色腿部斑塊</li>
                <li>身體是<b>米白連身裝</b>，模型以原點為中心、高約 1 公尺</li>
            </ul>
            <p>
                這顆跟右下角那張香菇柯基照片是<b>同一個角色</b>（<code>astro/public/images/chibi-hero.png</code> 就是那張照片，
                背面圖則是這顆 3D 模型的背面渲染）。
            </p>
        </div>
    </div>

    <script is:inline>
    (function () {
        const viewer = document.getElementById('chibiViewer');
        const loading = document.getElementById('mvLoading');
        if (!viewer) return;

        const done = () => {
            if (loading) {
                loading.textContent = '';
                loading.hidden = true;
            }
        };
        const fail = () => {
            if (loading) {
                loading.textContent = '3D 模型載入失敗（' + (viewer.getAttribute('src') || 'unknown') + '）';
                loading.hidden = false;
                loading.classList.add('is-error');
            }
        };

        viewer.addEventListener('load', done);
        viewer.addEventListener('error', fail);
    })();
    </script>
</Base>

<style>
    .mascot-3d-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 4rem;
    }

    .mascot-3d-head h1 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        letter-spacing: -0.02em;
    }

    .mascot-3d-head .subtitle {
        margin: 0;
        color: var(--muted, #8b949e);
        font-size: 0.95rem;
        line-height: 1.7;
    }

    /* 關鍵：model-viewer 是 height:100%，父容器必須給「明確高度」，
       否則 auto height 會讓 percentage 解析為 0 → 整隻模型看不到。 */
    .mascot-3d-stage {
        position: relative;
        width: 100%;
        height: clamp(360px, 68vh, 680px);
        margin: 1.75rem 0;
        border-radius: 18px;
        overflow: hidden;
        isolation: isolate;
        border: 1px solid rgba(88, 215, 255, 0.16);
        background:
            radial-gradient(120% 90% at 50% 16%, rgba(88, 215, 255, 0.14), transparent 62%),
            linear-gradient(180deg, #101a24 0%, #08060e 100%);
        box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
    }

    model-viewer {
        display: block;
        width: 100%;
        height: 100%;
        background: transparent;
        --poster-color: transparent;
    }

    .mascot-3d-floor {
        position: absolute;
        left: 50%;
        bottom: 7%;
        width: 58%;
        height: 9%;
        transform: translateX(-50%);
        background: radial-gradient(ellipse at center, rgba(123, 240, 190, 0.24), rgba(123, 240, 190, 0) 70%);
        filter: blur(6px);
        pointer-events: none;
    }

    .mascot-3d-loading {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        color: var(--muted, #8b949e);
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        pointer-events: none;
        transition: opacity 0.4s;
    }

    .mascot-3d-loading[hidden] {
        display: none;
    }

    .mascot-3d-loading.is-error {
        color: #ff8392;
    }

    .mascot-3d-progress {
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #58d7ff, #7bf0be);
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform 0.3s;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.75rem;
        margin: 1.25rem 0;
    }

    .stats-row > div {
        padding: 0.9rem 0.75rem;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
    }

    .stats-row .num {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 1.25rem;
        font-weight: 700;
        color: #7bf0be;
    }

    .stats-row .lbl {
        margin-top: 0.25rem;
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        color: var(--muted, #8b949e);
    }

    .mascot-3d-hint {
        margin: 1.5rem 0 0;
        padding: 1rem 1.15rem;
        font-size: 0.9rem;
        line-height: 1.85;
        color: var(--text, #e9f0ec);
        border: 1px solid rgba(123, 240, 190, 0.22);
        border-radius: 12px;
        background: rgba(123, 240, 190, 0.05);
    }

    .mascot-3d-info {
        margin-top: 1.75rem;
        font-size: 0.92rem;
        line-height: 1.9;
        color: var(--text, #e9f0ec);
    }

    .mascot-3d-info h3 {
        margin: 0 0 0.75rem;
        font-size: 1.05rem;
        color: #58d7ff;
    }

    .mascot-3d-info ul {
        margin: 0 0 1rem;
        padding-left: 1.5em;
    }

    .mascot-3d-info code {
        padding: 0.1em 0.4em;
        border-radius: 5px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.85em;
        background: rgba(255, 255, 255, 0.07);
    }

    .mascot-3d-foot {
        font-size: 0.85em;
        opacity: 0.78;
    }
</style>