---
import Base from '../layouts/Base.astro';
const bodyHtml = "\r\n    <div data-site-nav></div>\r\n\r\n    <section class=\"ai-hero\">\r\n        <div class=\"eyebrow\">MINIMAX AI SERVICES</div>\r\n        <h1>AI 服務展示廳</h1>\r\n        <p>文字轉語音、智慧聊天、AI 音樂生成 — 全部透過 MiniMax API 驅動，API Key 完全藏在後端。</p>\r\n        <div id=\"api-status\" style=\"margin-top:16px;font-size:.85rem;color:var(--muted)\">偵測 API 路徑中...</div>\r\n        <div style=\"display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:12px\">\r\n            <span class=\"status-badge status-success\">✓ TTS</span>\r\n            <span class=\"status-badge status-success\">✓ Chat</span>\r\n            <span class=\"status-badge status-success\">✓ Music</span>\r\n        </div>\r\n    </section>\r\n\r\n    <div class=\"ai-grid\">\r\n        <!-- TTS Card -->\r\n        <div class=\"ai-card tts-card\">\r\n            <div class=\"ai-card-icon\">🔊</div>\r\n            <h3>文字轉語音 (TTS)</h3>\r\n            <p>輸入文字，即時轉換為自然語音。</p>\r\n            <div class=\"ai-field\">\r\n                <label for=\"tts-text\">要轉換的文字</label>\r\n                <textarea id=\"tts-text\">您好，這是 MiniMax 文字轉語音服務測試。</textarea>\r\n            </div>\r\n            <div class=\"ai-field\">\r\n                <label for=\"tts-speed\">速度 (0.5 - 2.0)</label>\r\n                <input type=\"range\" id=\"tts-speed\" min=\"0.5\" max=\"2.0\" step=\"0.1\" value=\"1.0\" style=\"width:100%\">\r\n                <span id=\"tts-speed-val\" style=\"font-size:.8rem;color:var(--muted)\">1.0x</span>\r\n            </div>\r\n            <button class=\"ai-btn tts-btn\" id=\"tts-generate\">\r\n                <span id=\"tts-spinner\" class=\"spinner\" style=\"display:none\"></span>\r\n                <span id=\"tts-btn-text\">生成語音</span>\r\n            </button>\r\n            <div class=\"ai-result\">\r\n                <div class=\"ai-result-label\">輸出結果</div>\r\n                <audio id=\"tts-audio\" class=\"audio-player\" controls style=\"display:none\"></audio>\r\n                <div id=\"tts-status\" style=\"color:var(--muted);font-size:.85rem\">點擊上方按鈕生成語音</div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Chat Card -->\r\n        <div class=\"ai-card chat-card\">\r\n            <div class=\"ai-card-icon\">💬</div>\r\n            <h3>智慧聊天 (Chat)</h3>\r\n            <p>基於 MiniMax-M2 模型的 AI 對話助手。</p>\r\n            <div class=\"chat-messages\" id=\"chat-messages\">\r\n                <div class=\"chat-msg chat-bot\">👋 你好！我是 AI 助手，有什麼可以幫您的嗎？</div>\r\n            </div>\r\n            <div class=\"ai-field\">\r\n                <label for=\"chat-input\">輸入訊息</label>\r\n                <div class=\"chat-input-row\">\r\n                    <input type=\"text\" id=\"chat-input\" placeholder=\"輸入您想問的問題...\"\r\n                        onkeypress=\"if(event.key==='Enter')sendChat()\">\r\n                    <button id=\"chat-generate\" onclick=\"sendChat()\">\r\n                        <span id=\"chat-spinner\" class=\"spinner\" style=\"display:none\"></span>\r\n                        <span id=\"chat-btn-text\">送出</span>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Music Card -->\r\n        <div class=\"ai-card music-card\">\r\n            <div class=\"ai-card-icon\">🎵</div>\r\n            <h3>AI 音樂生成</h3>\r\n            <p>用文字描述您想要的音樂風格，AI 即時生成。</p>\r\n            <div class=\"ai-field\">\r\n                <label for=\"music-prompt\">音樂描述</label>\r\n                <textarea id=\"music-prompt\">平靜的鋼琴曲，適合放鬆</textarea>\r\n            </div>\r\n            <div class=\"ai-field\">\r\n                <label for=\"music-duration\">時長（秒）</label>\r\n                <select id=\"music-duration\">\r\n                    <option value=\"15\">15 秒</option>\r\n                    <option value=\"30\" selected>30 秒</option>\r\n                </select>\r\n            </div>\r\n            <button class=\"ai-btn music-btn\" id=\"music-generate\">\r\n                <span id=\"music-spinner\" class=\"spinner\" style=\"display:none\"></span>\r\n                <span id=\"music-btn-text\">生成音樂</span>\r\n            </button>\r\n            <div class=\"ai-result\">\r\n                <div class=\"ai-result-label\">輸出結果</div>\r\n                <audio id=\"music-audio\" class=\"audio-player\" controls style=\"display:none\"></audio>\r\n                <div id=\"music-status\" style=\"color:var(--muted);font-size:.85rem\">點擊上方按鈕生成音樂</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <section class=\"arch-section\">\r\n        <h2 class=\"arch-title\">技術架構</h2>\r\n        <div class=\"arch-flow\">\r\n            <span class=\"arch-node\">🌐 前端</span>\r\n            <span class=\"arch-arrow\">→</span>\r\n            <span class=\"arch-node\">⚡ FastAPI /ai/*</span>\r\n            <span class=\"arch-arrow\">→</span>\r\n            <span class=\"arch-node\">🔐 MiniMax API</span>\r\n        </div>\r\n    </section>\r\n\r\n    <div data-site-footer></div>\r\n\r\n    <script>\r\n        // 直接使用後端 URL，不經過自動偵測\r\n        const API_BASE = 'https://donttalk-api.fly.dev';\r\n\r\n        async function initApiBase() {\r\n            const statusEl = document.getElementById('api-status');\r\n            if (statusEl) {\r\n                statusEl.textContent = 'API: ' + API_BASE + ' (直接連接)';\r\n            }\r\n            console.log('API Base:', API_BASE);\r\n        }\r\n\r\n        // 使用環境變數或預設值\r\n        function getApiBase() {\r\n            if (API_BASE) return API_BASE;\r\n            // 嘗試多個可能的 API 端點\r\n            const possibleUrls = [\r\n                window.API_BASE,\r\n                '/api',\r\n                'https://donttalk-api.fly.dev'\r\n            ];\r\n            for (const url of possibleUrls) {\r\n                if (url) return url;\r\n            }\r\n            return '';\r\n        }\r\n\r\n        function buildUrl(path) {\r\n            const base = getApiBase();\r\n            if (!base) return path;\r\n            return base.replace(/\\/$/, '') + path;\r\n        }\r\n\r\n        document.getElementById('tts-speed').addEventListener('input', function (e) {\r\n            document.getElementById('tts-speed-val').textContent = e.target.value + 'x';\r\n        });\r\n\r\n        document.getElementById('tts-generate').addEventListener('click', async function () {\r\n            const text = document.getElementById('tts-text').value.trim();\r\n            if (!text) { alert('請輸入文字'); return; }\r\n\r\n            const btn = this;\r\n            const spinner = document.getElementById('tts-spinner');\r\n            const btnText = document.getElementById('tts-btn-text');\r\n            const audio = document.getElementById('tts-audio');\r\n            const status = document.getElementById('tts-status');\r\n\r\n            btn.disabled = true;\r\n            spinner.style.display = 'inline-block';\r\n            btnText.textContent = '生成中...';\r\n            status.textContent = '正在生成語音...';\r\n            status.style.color = 'var(--accent-light)';\r\n\r\n            try {\r\n                const speed = parseFloat(document.getElementById('tts-speed').value);\r\n                const url = buildUrl('/ai/tts');\r\n                console.log('Calling TTS:', url);\r\n\r\n                const response = await fetch(url, {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({\r\n                        text: text,\r\n                        model: 'e2all-turbo',\r\n                        voice: 'default',\r\n                        speed: speed\r\n                    })\r\n                });\r\n\r\n                if (!response.ok) throw new Error('API 請求失敗 (' + response.status + ')');\r\n\r\n                const blob = await response.blob();\r\n                const audioUrl = URL.createObjectURL(blob);\r\n\r\n                audio.src = audioUrl;\r\n                audio.style.display = 'block';\r\n                status.textContent = '✓ 語音生成完成！';\r\n                status.style.color = '#10b981';\r\n                audio.play().catch(function () { });\r\n            } catch (error) {\r\n                status.textContent = '✗ 生成失敗：' + error.message;\r\n                status.style.color = '#ef4444';\r\n            } finally {\r\n                btn.disabled = false;\r\n                spinner.style.display = 'none';\r\n                btnText.textContent = '生成語音';\r\n            }\r\n        });\r\n\r\n        let chatHistory = [];\r\n\r\n        async function sendChat() {\r\n            const input = document.getElementById('chat-input');\r\n            const message = input.value.trim();\r\n            if (!message) return;\r\n\r\n            const messagesDiv = document.getElementById('chat-messages');\r\n            const btn = document.getElementById('chat-generate');\r\n            const spinner = document.getElementById('chat-spinner');\r\n            const btnText = document.getElementById('chat-btn-text');\r\n\r\n            messagesDiv.innerHTML += '<div class=\"chat-msg chat-msg-user\">' + escapeHtml(message) + '</div>';\r\n            input.value = '';\r\n\r\n            const loadingMsg = document.createElement('div');\r\n            loadingMsg.className = 'chat-msg chat-msg-bot';\r\n            loadingMsg.innerHTML = '<span class=\"spinner\" style=\"display:inline-block\"></span> 思考中...';\r\n            messagesDiv.appendChild(loadingMsg);\r\n            messagesDiv.scrollTop = messagesDiv.scrollHeight;\r\n\r\n            btn.disabled = true;\r\n            spinner.style.display = 'inline-block';\r\n            btnText.textContent = '處理中...';\r\n\r\n            try {\r\n                chatHistory.push({ role: 'user', content: message });\r\n\r\n                const url = buildUrl('/ai/chat');\r\n                console.log('Calling Chat:', url);\r\n\r\n                const response = await fetch(url, {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({\r\n                        messages: [\r\n                            { role: 'system', content: '你是專業的 AI 助手，請用繁體中文回答。' },\r\n                            ...chatHistory\r\n                        ],\r\n                        model: 'MiniMax-M2',\r\n                        temperature: 0.7,\r\n                        max_tokens: 2048\r\n                    })\r\n                });\r\n\r\n                if (!response.ok) throw new Error('API 請求失敗 (' + response.status + ')');\r\n\r\n                const data = await response.json();\r\n                const botResponse = data.content;\r\n\r\n                chatHistory.push({ role: 'assistant', content: botResponse });\r\n\r\n                loadingMsg.innerHTML = botResponse;\r\n                messagesDiv.scrollTop = messagesDiv.scrollHeight;\r\n            } catch (error) {\r\n                loadingMsg.innerHTML = '✗ 發生錯誤：' + error.message;\r\n                loadingMsg.style.color = '#ef4444';\r\n            } finally {\r\n                btn.disabled = false;\r\n                spinner.style.display = 'none';\r\n                btnText.textContent = '送出';\r\n            }\r\n        }\r\n\r\n        function escapeHtml(text) {\r\n            const div = document.createElement('div');\r\n            div.textContent = text;\r\n            return div.innerHTML;\r\n        }\r\n\r\n        document.getElementById('music-generate').addEventListener('click', async function () {\r\n            const prompt = document.getElementById('music-prompt').value.trim();\r\n            if (!prompt) { alert('請輸入音樂描述'); return; }\r\n\r\n            const btn = this;\r\n            const spinner = document.getElementById('music-spinner');\r\n            const btnText = document.getElementById('music-btn-text');\r\n            const audio = document.getElementById('music-audio');\r\n            const status = document.getElementById('music-status');\r\n\r\n            btn.disabled = true;\r\n            spinner.style.display = 'inline-block';\r\n            btnText.textContent = '生成中...';\r\n            status.textContent = '正在生成音樂...';\r\n            status.style.color = 'var(--accent-light)';\r\n\r\n            try {\r\n                const duration = parseInt(document.getElementById('music-duration').value);\r\n                const url = buildUrl('/ai/music');\r\n                console.log('Calling Music:', url);\r\n\r\n                const response = await fetch(url, {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({\r\n                        prompt: prompt,\r\n                        model: 'music-2.6',\r\n                        duration: duration,\r\n                        instrumental: false\r\n                    })\r\n                });\r\n\r\n                if (!response.ok) throw new Error('API 請求失敗 (' + response.status + ')');\r\n\r\n                const data = await response.json();\r\n\r\n                if (data.audio_url) {\r\n                    audio.src = data.audio_url;\r\n                    audio.style.display = 'block';\r\n                    status.textContent = '✓ 音樂生成完成！';\r\n                    status.style.color = '#10b981';\r\n                    audio.play().catch(function () { });\r\n                } else if (data.task_id) {\r\n                    status.textContent = '⏳ 任務已提交，ID: ' + data.task_id;\r\n                } else {\r\n                    throw new Error('未取得音訊 URL');\r\n                }\r\n            } catch (error) {\r\n                status.textContent = '✗ 生成失敗：' + error.message;\r\n                status.style.color = '#ef4444';\r\n            } finally {\r\n                btn.disabled = false;\r\n                spinner.style.display = 'none';\r\n                btnText.textContent = '生成音樂';\r\n            }\r\n        });\r\n\r\n        initApiBase();\r\n    </script>\r\n    <button class=\"scroll-top\" aria-label=\"返回頂部\">↑</button>\r\n";
const headInline = "";
---
<Base
    title="AI 服務展示 | MiniMax TTS + Chat + Music"
    description="MiniMax AI 服務實作展示：文字轉語音、智慧聊天、 AI 音樂生成"
    bodyPage="ai-demo"
    pageStyles={["/styles/shared.css","/styles/polish.css","/styles/dynamic.css"]}
    pageScripts={[]}
    headInline={headInline}
>
    <Fragment set:html={bodyHtml} />
</Base>
