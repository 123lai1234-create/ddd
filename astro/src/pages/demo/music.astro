---
const API_BASE = import.meta.env.PUBLIC_API_BASE || 'https://donttalk-api-production.up.railway.app';

const presetPrompts = [
  { label: 'Ambient Biotech', prompt: 'Ambient electronic music with soft synth pads, perfect for a lab documentary opening sequence' },
  { label: 'Drug Discovery', prompt: 'Cinematic orchestral with electronic elements, building tension like a critical experiment moment' },
  { label: 'Gene Sequence', prompt: 'Upbeat techno with bioinformatics-inspired rhythmic patterns, futuristic and energetic' },
  { label: 'Protein Folding', prompt: 'Dark ambient with evolving textures, mysterious and scientific atmosphere' },
  { label: 'Researchmontage', prompt: 'Energetic corporate electronic, perfect for research progress video background' },
];

let statusEl, audioPlayerEl, audioEl, downloadEl, promptEl, submitBtn;

function init() {
  statusEl = document.getElementById('statusMessage');
  audioPlayerEl = document.getElementById('audioPlayer');
  audioEl = document.getElementById('audioElement');
  downloadEl = document.getElementById('downloadLink');
  promptEl = document.getElementById('prompt');
  submitBtn = document.querySelector('button[type="submit"]');

  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.dataset.index);
      const preset = presetPrompts[idx];
      if (promptEl && preset) {
        promptEl.value = preset.prompt;
      }
    });
  });
}

function showStatus(msg, type) {
  if (statusEl) {
    statusEl.textContent = msg;
    statusEl.className = 'status-message ' + (type || 'warning');
    statusEl.style.display = 'block';
  }
}

function showAudio(url) {
  if (audioPlayerEl && audioEl && downloadEl) {
    audioEl.src = url;
    downloadEl.href = url;
    audioPlayerEl.style.display = 'block';
  }
}

async function generateMusic(event) {
  event.preventDefault();
  if (!promptEl || !promptEl.value.trim()) {
    showStatus('Please enter a music description.', 'error');
    return;
  }

  const durationInput = document.getElementById('duration');
  const instrumentalInput = document.getElementById('instrumental');

  if (submitBtn) submitBtn.disabled = true;
  showStatus('Generating music... (this may take up to 2 minutes for longer tracks)', 'warning');
  if (audioPlayerEl) audioPlayerEl.style.display = 'none';

  try {
    const response = await fetch(API_BASE + '/ai/music', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        prompt: promptEl.value.trim(),
        duration: parseInt(durationInput && durationInput.value) || 30,
        instrumental: (instrumentalInput && instrumentalInput.checked) || false,
        model: 'music-2.6'
      })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.detail || 'Generation failed');
    }

    const result = await response.json();
    
    if (result.audio_url) {
      showStatus('Music generated successfully!', 'info');
      showAudio(result.audio_url);
    } else if (result.task_id) {
      showStatus('Long generation started. Poll task: ' + result.task_id, 'warning');
    } else {
      showStatus('Generation completed but no audio URL returned.', 'warning');
    }
  } catch (error) {
    showStatus('Error: ' + error.message, 'error');
  } finally {
    if (submitBtn) submitBtn.disabled = false;
  }
}

document.addEventListener('DOMContentLoaded', init);
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Music Generation Demo | JT Lai Portfolio</title>
  <link rel="stylesheet" href="/styles/demo.css">
</head>
<body>
  <header class="demo-header">
    <nav>
      <a href="/">Back to Portfolio</a>
    </nav>
    <h1>AI Music Generation</h1>
    <p class="subtitle">Powered by MiniMax music-2.6 via LiteLLM Proxy</p>
  </header>

  <main class="demo-container">
    <section class="info-panel">
      <h2>About This Demo</h2>
      <p>This page demonstrates multi-modal AI integration on your portfolio. The FastAPI backend routes requests through LiteLLM Proxy to MiniMax music-2.6 model.</p>
      <div class="tech-stack">
        <span class="tag">FastAPI</span>
        <span class="tag">LiteLLM Proxy</span>
        <span class="tag">MiniMax API</span>
        <span class="tag">Cloudflare Tunnel</span>
      </div>
    </section>

    <section class="generator-panel">
      <h2>Generate Music</h2>
      <form id="musicForm">
        <div class="form-group">
          <label for="prompt">Music Description</label>
          <textarea id="prompt" name="prompt" rows="3" required></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="duration">Duration (seconds)</label>
            <input type="number" id="duration" name="duration" min="15" max="180" value="30">
          </div>
          <div class="form-group checkbox-group">
            <label>
              <input type="checkbox" id="instrumental" name="instrumental">
              Instrumental Only
            </label>
          </div>
        </div>

        <button type="submit">Generate Music</button>
      </form>

      <div id="statusMessage" class="status-message" style="display:none;"></div>
      <div id="audioPlayer" class="audio-player" style="display:none;">
        <h3>Generated Audio</h3>
        <audio id="audioElement" controls></audio>
        <a id="downloadLink" href="#" download class="download-link">Download Audio</a>
      </div>
    </section>

    <section class="presets-panel">
      <h2>Quick Presets</h2>
      <div class="preset-grid">
        <button type="button" class="preset-btn" data-index="0">Ambient Biotech</button>
        <button type="button" class="preset-btn" data-index="1">Drug Discovery</button>
        <button type="button" class="preset-btn" data-index="2">Gene Sequence</button>
        <button type="button" class="preset-btn" data-index="3">Protein Folding</button>
        <button type="button" class="preset-btn" data-index="4">Researchmontage</button>
      </div>
    </section>

    <section class="code-example">
      <h2>API Integration Example</h2>
      <pre><code>import httpx

async def generate_music(prompt, duration=30):
    response = await httpx.AsyncClient().post(
        "https://your-api.com/ai/music",
        json={"prompt": prompt, "duration": duration, "model": "music-2.6"}
    )
    return response.json()</code></pre>
      <p class="code-note">The FastAPI layer handles API key security - MiniMax key never touches the client.</p>
    </section>
  </main>

  <script is:inline>
    document.getElementById('musicForm').addEventListener('submit', async function(event) {
      event.preventDefault();
      var promptEl = document.getElementById('prompt');
      var statusEl = document.getElementById('statusMessage');
      var audioPlayerEl = document.getElementById('audioPlayer');
      var audioEl = document.getElementById('audioElement');
      var downloadEl = document.getElementById('downloadLink');
      var submitBtn = document.querySelector('button[type="submit"]');
      var durationInput = document.getElementById('duration');
      var instrumentalInput = document.getElementById('instrumental');

      if (!promptEl || !promptEl.value.trim()) {
        statusEl.textContent = 'Please enter a music description.';
        statusEl.className = 'status-message error';
        statusEl.style.display = 'block';
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      statusEl.textContent = 'Generating music... (this may take up to 2 minutes for longer tracks)';
      statusEl.className = 'status-message warning';
      statusEl.style.display = 'block';
      if (audioPlayerEl) audioPlayerEl.style.display = 'none';

      var API_BASE = 'https://donttalk-api-production.up.railway.app';

      try {
        var response = await fetch(API_BASE + '/ai/music', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            prompt: promptEl.value.trim(),
            duration: parseInt(durationInput && durationInput.value) || 30,
            instrumental: (instrumentalInput && instrumentalInput.checked) || false,
            model: 'music-2.6'
          })
        });

        if (!response.ok) {
          var error = await response.json();
          throw new Error(error.detail || 'Generation failed');
        }

        var result = await response.json();
        
        if (result.audio_url) {
          statusEl.textContent = 'Music generated successfully!';
          statusEl.className = 'status-message info';
          audioEl.src = result.audio_url;
          downloadEl.href = result.audio_url;
          audioPlayerEl.style.display = 'block';
        } else if (result.task_id) {
          statusEl.textContent = 'Long generation started. Poll task: ' + result.task_id;
        } else {
          statusEl.textContent = 'Generation completed but no audio URL returned.';
        }
      } catch (error) {
        statusEl.textContent = 'Error: ' + error.message;
        statusEl.className = 'status-message error';
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    document.querySelectorAll('.preset-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var prompts = [
          'Ambient electronic music with soft synth pads, perfect for a lab documentary opening sequence',
          'Cinematic orchestral with electronic elements, building tension like a critical experiment moment',
          'Upbeat techno with bioinformatics-inspired rhythmic patterns, futuristic and energetic',
          'Dark ambient with evolving textures, mysterious and scientific atmosphere',
          'Energetic corporate electronic, perfect for research progress video background'
        ];
        var idx = parseInt(btn.dataset.index);
        var promptEl = document.getElementById('prompt');
        if (promptEl && prompts[idx]) {
          promptEl.value = prompts[idx];
        }
      });
    });
  </script>
</body>
</html>

<style>
