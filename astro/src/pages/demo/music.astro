---
// Astro page: /demo/music — MiniMax Music Generation Demo
// This page showcases AI music generation as part of your biotech portfolio

const API_BASE = import.meta.env.PUBLIC_API_BASE || 'https://donttalk-api-production.up.railway.app';

let statusMessage = '';
let audioUrl = '';
let isGenerating = false;

// Predefined prompts for quick demos
const presetPrompts = [
  { label: 'Ambient Biotech', prompt: 'Ambient electronic music with soft synth pads, perfect for a lab documentary opening sequence' },
  { label: 'Drug Discovery', prompt: 'Cinematic orchestral with electronic elements, building tension like a critical experiment moment' },
  { label: 'Gene Sequence', prompt: 'Upbeat techno with bioinformatics-inspired rhythmic patterns, futuristic and energetic' },
  { label: 'Protein Folding', prompt: 'Dark ambient with evolving textures, mysterious and scientific atmosphere' },
  { label: 'Researchmontage', prompt: 'Energetic corporate electronic, perfect for research progress video background' },
];

async function generateMusic(event) {
  event.preventDefault();
  const form = event.target;
  const promptInput = form.querySelector('#prompt');
  const durationInput = form.querySelector('#duration');
  const instrumentalInput = form.querySelector('#instrumental');
  
  const prompt = promptInput.value.trim();
  if (!prompt) {
    statusMessage = 'Please enter a music description.';
    return;
  }

  isGenerating = true;
  statusMessage = 'Generating music... (this may take up to 2 minutes for longer tracks)';
  audioUrl = '';

  try {
    const response = await fetch(`${API_BASE}/ai/music`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        prompt: prompt,
        duration: parseInt(durationInput?.value || '30'),
        instrumental: instrumentalInput?.checked || false,
        model: 'music-2.6'
      })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.detail || 'Generation failed');
    }

    const result = await response.json();
    
    if (result.audio_url) {
      audioUrl = result.audio_url;
      statusMessage = 'Music generated successfully!';
    } else if (result.task_id) {
      statusMessage = 'Long generation started. Poll task: ' + result.task_id;
    } else {
      statusMessage = 'Generation completed but no audio URL returned.';
    }
  } catch (error) {
    statusMessage = `Error: ${error.message}`;
  } finally {
    isGenerating = false;
  }
}

function usePreset(index) {
  const preset = presetPrompts[index];
  document.getElementById('prompt').value = preset.prompt;
}
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Music Generation Demo | JT Lai Portfolio</title>
  <link rel="stylesheet" href="/styles/demo.css">
</head>
<body>
  <header class="demo-header">
    <nav>
      <a href="/">&larr; Back to Portfolio</a>
    </nav>
    <h1>AI Music Generation</h1>
    <p class="subtitle">Powered by MiniMax music-2.6 via LiteLLM Proxy</p>
  </header>

  <main class="demo-container">
    <section class="info-panel">
      <h2>About This Demo</h2>
      <p>
        This page demonstrates multi-modal AI integration on your portfolio. 
        The FastAPI backend routes requests through LiteLLM Proxy (deployed via Cloudflare Tunnel) 
        to MiniMax's music-2.6 model, enabling programmatic music generation.
      </p>
      <div class="tech-stack">
        <span class="tag">FastAPI</span>
        <span class="tag">LiteLLM Proxy</span>
        <span class="tag">MiniMax API</span>
        <span class="tag">Cloudflare Tunnel</span>
      </div>
    </section>

    <section class="generator-panel">
      <h2>Generate Music</h2>
      <form id="musicForm" onsubmit="generateMusic(event)">
        <div class="form-group">
          <label for="prompt">Music Description</label>
          <textarea 
            id="prompt" 
            name="prompt" 
            rows="3" 
            placeholder="Describe the music you want to generate..."
            required
          >Ambient electronic music with evolving textures, perfect for a biotech documentary</textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="duration">Duration (seconds)</label>
            <input type="number" id="duration" name="duration" min="15" max="180" value="30">
          </div>
          <div class="form-group checkbox-group">
            <label>
              <input type="checkbox" id="instrumental" name="instrumental">
              Instrumental Only
            </label>
          </div>
        </div>

        <button type="submit" disabled={isGenerating}>
          {isGenerating ? 'Generating...' : 'Generate Music'}
        </button>
      </form>

      {statusMessage && (
        <div class="status-message">{statusMessage}</div>
      )}

      {audioUrl && (
        <div class="audio-player">
          <h3>Generated Audio</h3>
          <audio controls src={audioUrl}>
            Your browser does not support audio playback.
          </audio>
          <a href={audioUrl} download class="download-link">Download Audio</a>
        </div>
      )}
    </section>

    <section class="presets-panel">
      <h2>Quick Presets</h2>
      <div class="preset-grid">
        {presetPrompts.map((preset, i) => (
          <button 
            type="button" 
            class="preset-btn"
            onclick={`usePreset(${i})`}
          >
            {preset.label}
          </button>
        ))}
      </div>
    </section>

    <section class="code-example">
      <h2>API Integration Example</h2>
      <pre><code>import httpx

async def generate_music(prompt: str, duration: int = 30):
    response = await httpx.AsyncClient().post(
        "https://your-api.com/ai/music",
        json={"prompt": prompt, "duration": duration, "model": "music-2.6"}
    )
    return response.json()  # {"audio_url": "...", "task_id": None}</code></pre>
      <p class="code-note">
        The FastAPI layer handles API key security — MiniMax key never touches the client.
      </p>
    </section>
  </main>
</body>
</html>

<style>
.demo-header {
  padding: 2rem;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: white;
}
.demo-header nav { margin-bottom: 1rem; }
.demo-header nav a { color: #8ab4f8; text-decoration: none; }
.demo-header h1 { margin: 0; font-size: 2rem; }
.subtitle { opacity: 0.8; margin-top: 0.5rem; }

.demo-container {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem;
}

.info-panel, .generator-panel, .presets-panel, .code-example {
  background: white;
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

h2 { margin-top: 0; color: #333; }
.tech-stack { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; }
.tag {
  background: #e8f0fe;
  color: #1a73e8;
  padding: 0.25rem 0.75rem;
  border-radius: 16px;
  font-size: 0.85rem;
}

.form-group { margin-bottom: 1rem; }
.form-group label { display: block; font-weight: 500; margin-bottom: 0.5rem; }
.form-group input[type="text"],
.form-group textarea {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 1rem;
}
.form-row { display: flex; gap: 1rem; }
.checkbox-group { display: flex; align-items: center; }

button[type="submit"] {
  background: #1a73e8;
  color: white;
  border: none;
  padding: 0.75rem 2rem;
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
}
button[type="submit"]:disabled { background: #ccc; cursor: not-allowed; }

.status-message {
  margin-top: 1rem;
  padding: 1rem;
  background: #fef7e0;
  border-radius: 4px;
  border-left: 4px solid #f9a825;
}

.audio-player { margin-top: 1rem; }
.audio-player audio { width: 100%; margin-top: 0.5rem; }
.download-link {
  display: inline-block;
  margin-top: 0.5rem;
  color: #1a73e8;
}

.preset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.5rem; }
.preset-btn {
  background: #f8f9fa;
  border: 1px solid #ddd;
  padding: 0.5rem;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.2s;
}
.preset-btn:hover { background: #e8f0fe; }

.code-example pre {
  background: #1a1a2e;
  color: #e8f0fe;
  padding: 1rem;
  border-radius: 4px;
  overflow-x: auto;
}
.code-note { margin-top: 0.5rem; color: #666; font-size: 0.9rem; }
</style>