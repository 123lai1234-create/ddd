  <script>
    var presets = [
      'Ambient electronic music with soft synth pads, perfect for a lab documentary opening sequence',
      'Cinematic orchestral with electronic elements, building tension like a critical experiment moment',
      'Upbeat techno with bioinformatics-inspired rhythmic patterns, futuristic and energetic',
      'Dark ambient with evolving textures, mysterious and scientific atmosphere',
      'Energetic corporate electronic, perfect for research progress video background'
    ];

    function applyPreset(idx) {
      var el = document.getElementById('prompt');
      if (el && presets[idx]) el.value = presets[idx];
    }

    var currentTrackIdx = -1;
    var isPlaying = false;
    var isShuffle = false;
    var repeatMode = 0;
    var volume = 0.7;
    var progressInterval = null;
    var elapsed = 0;

    var trackData = [
      { title: 'Ambient Biotech Journey', artist: 'MiniMax AI', album: '生物醫學Ambient', duration: '3:24', durationSec: 204 },
      { title: 'Protein Folding Symphony', artist: 'MiniMax AI', album: '蛋白質折疊電音', duration: '4:15', durationSec: 255 },
      { title: 'Gene Sequence Beats', artist: 'MiniMax AI', album: '基因序列節拍', duration: '2:58', durationSec: 178 },
      { title: 'Drug Discovery Ambient', artist: 'MiniMax AI', album: '科研紀錄片配樂', duration: '5:02', durationSec: 302 },
      { title: 'Researchmontage Theme', artist: 'MiniMax AI', album: '科研紀錄片配樂', duration: '3:47', durationSec: 227 },
      { title: 'Bioinformatics Rhythm', artist: 'MiniMax AI', album: '基因序列節拍', duration: '4:33', durationSec: 273 },
      { title: 'Scientific Discovery Theme', artist: 'MiniMax AI', album: '科研配樂精選', duration: '3:55', durationSec: 235 },
      { title: 'Lab Documentary Opening', artist: 'MiniMax AI', album: '科研配樂精選', duration: '4:20', durationSec: 260 },
      { title: 'Bioinformatics Epic', artist: 'MiniMax AI', album: '生物電音合集', duration: '5:10', durationSec: 310 },
      { title: 'Researchmontage Beat', artist: 'MiniMax AI', album: '科研配樂精選', duration: '3:30', durationSec: 210 },
    ];

    function playTrack(idx, row) {
      if (progressInterval) clearInterval(progressInterval);
      document.querySelectorAll('.track-row').forEach(function(r) { r.style.background = ''; });
      if (row) row.style.background = 'rgba(255,255,255,0.08)';
      currentTrackIdx = idx;
      var track = trackData[idx];
      document.getElementById('playerTrackName').textContent = track.title;
      document.getElementById('playerTrackArtist').textContent = track.artist;
      document.getElementById('progressFill').style.width = '0%';
      document.getElementById('progressThumb').style.left = '0%';
      document.getElementById('currentTime').textContent = '0:00';
      document.getElementById('totalTime').textContent = track.duration;
      elapsed = 0;
      isPlaying = true;
      document.getElementById('playIcon').innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
      progressInterval = setInterval(function() {
        elapsed++;
        var pct = (elapsed / track.durationSec) * 100;
        document.getElementById('progressFill').style.width = pct + '%';
        document.getElementById('progressThumb').style.left = pct + '%';
        var mins = Math.floor(elapsed / 60);
        var secs = elapsed % 60;
        document.getElementById('currentTime').textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
        if (elapsed >= track.durationSec) {
          clearInterval(progressInterval);
          nextTrack();
        }
      }, 1000);
    }

    function togglePlay() {
      if (isPlaying) {
        if (progressInterval) clearInterval(progressInterval);
        isPlaying = false;
        document.getElementById('playIcon').innerHTML = '<path d="M8 5v14l11-7z"/>';
      } else {
        if (currentTrackIdx < 0) playTrack(0);
        var track = trackData[currentTrackIdx];
        isPlaying = true;
        document.getElementById('playIcon').innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
        progressInterval = setInterval(function() {
          elapsed++;
          var pct = (elapsed / track.durationSec) * 100;
          document.getElementById('progressFill').style.width = pct + '%';
          document.getElementById('progressThumb').style.left = pct + '%';
          var mins = Math.floor(elapsed / 60);
          var secs = elapsed % 60;
          document.getElementById('currentTime').textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
          if (elapsed >= track.durationSec) {
            clearInterval(progressInterval);
            nextTrack();
          }
        }, 1000);
      }
    }

    function nextTrack() {
      var next = isShuffle ? Math.floor(Math.random() * trackData.length) : (currentTrackIdx + 1) % trackData.length;
      var rows = document.querySelectorAll('.track-row');
      playTrack(next, rows[next] || null);
    }

    function prevTrack() {
      var prev = (currentTrackIdx - 1 + trackData.length) % trackData.length;
      var rows = document.querySelectorAll('.track-row');
      playTrack(prev, rows[prev] || null);
    }

    function toggleShuffle() {
      isShuffle = !isShuffle;
      document.getElementById('shuffleBtn').style.color = isShuffle ? 'var(--accent)' : '';
    }

    function toggleRepeat() {
      repeatMode = (repeatMode + 1) % 3;
      var colors = ['', 'var(--accent)', 'var(--accent)'];
      document.getElementById('repeatBtn').style.color = colors[repeatMode];
    }

    function toggleLike() {
      document.getElementById('playerLikeBtn').classList.toggle('liked');
    }

    function seekTo(e) {
      var bar = document.getElementById('progressBar');
      var rect = bar.getBoundingClientRect();
      var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      document.getElementById('progressFill').style.width = (pct * 100) + '%';
      document.getElementById('progressThumb').style.left = (pct * 100) + '%';
      var track = trackData[currentTrackIdx] || trackData[0];
      elapsed = Math.floor(pct * track.durationSec);
      var mins = Math.floor(elapsed / 60);
      var secs = elapsed % 60;
      document.getElementById('currentTime').textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
    }

    function toggleMute() {
      var fill = document.getElementById('volumeFill');
      if (volume > 0) { volume = 0; fill.style.width = '0%'; }
      else { volume = 0.7; fill.style.width = '70%'; }
    }

    function setVolume(e) {
      var slider = e.currentTarget;
      var rect = slider.getBoundingClientRect();
      var pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      volume = pct;
      document.getElementById('volumeFill').style.width = (volume * 100) + '%';
    }

    // Music generation
    document.getElementById('musicForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      var promptEl = document.getElementById('prompt');
      var statusEl = document.getElementById('statusMessage');
      var btn = document.getElementById('generateBtn');
      var resultPlayer = document.getElementById('resultPlayer');

      if (!promptEl.value.trim()) {
        statusEl.textContent = '請輸入音樂描述';
        statusEl.className = 'status-message error';
        return;
      }

      btn.disabled = true;
      resultPlayer.classList.remove('active');
      statusEl.innerHTML = '<span class="spinner"></span>正在生成音樂…（較長曲目可能需要 2 分鐘）';
      statusEl.className = 'status-message loading';

      var API_BASE = 'https://donttalk-api-production.up.railway.app';

      try {
        var response = await fetch(API_BASE + '/ai/music', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            prompt: promptEl.value.trim(),
            duration: parseInt(document.getElementById('duration').value) || 30,
            instrumental: document.getElementById('instrumental').checked,
            model: 'music-2.6'
          })
        });

        if (!response.ok) {
          var err = await response.json();
          throw new Error(err.detail || 'Generation failed');
        }

        var result = await response.json();

        if (result.audio_url) {
          statusEl.textContent = '✅ 音樂生成成功！';
          statusEl.className = 'status-message success';
          var audioEl = document.getElementById('resultAudio');
          audioEl.src = result.audio_url;
          document.getElementById('downloadBtn').href = result.audio_url;
          var promptText = promptEl.value.trim().substring(0, 50);
          document.getElementById('resultTitle').textContent = promptText + (promptText.length >= 50 ? '…' : '');
          document.getElementById('resultSubtitle').textContent = 'MiniMax music-2.6 · ' + (document.getElementById('instrumental').checked ? '純器樂' : 'AI 生成');
          resultPlayer.classList.add('active');
        } else if (result.task_id) {
          statusEl.textContent = '⏳ 任務已建立：' + result.task_id + '，請稍後查詢進度';
          statusEl.className = 'status-message loading';
        }
      } catch (err) {
        statusEl.textContent = '❌ 錯誤：' + err.message;
        statusEl.className = 'status-message error';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>