---
import Base from '../layouts/Base.astro';

const PAGE_TITLE = '🤿 東北角潛水浪況速查';
const PAGE_DESC = '浪高、風向、流速、能見度 — 龍洞、鼻頭角、和平島、龜山島即時判斷 GO / CAUTION / NO-GO';
const OG_TAG = 'diving';

// 即時資料來源（外連 — Windguru / CWA 都會擋 iframe，直接新分頁開）
const WINDGURU_URL = 'https://www.windguru.cz/464009';   // 龍洞和美國小
const CWA_URL = 'https://www.cwa.gov.tw/V8/C/M/OBS_Marine_plot.html?MID=46694A';

// 東北角主要潛點（岸潛為主）
type Site = {
  name: string;
  en: string;
  level: string;
  expose: string;       // 主要面對方向（浪湧來向）
  note: string;
  drive: string;
};

const sites: Site[] = [
  {
    name: '龍洞（和美國小）',
    en: 'Longdong',
    level: '初階～進階',
    expose: '東/東北',
    note: '東北角最知名潛點，岸潛入門首選。潮間帶需走石階，水深 5–25m，珊瑚礁與魚群豐富。東北季風強時水況差。',
    drive: '國道 1 號 → 台 2 線，約 40 分'
  },
  {
    name: '鼻頭角',
    en: 'Bitou Cape',
    level: '中階以上',
    expose: '東北/東',
    note: '海階地形、峽谷與大礁。流較強，潛水經驗不足者易出事。需注意假日人潮與漁船活動。',
    drive: '台 2 線 84K 處，與龍洞相鄰'
  },
  {
    name: '和平島',
    en: 'Heping Island',
    level: '初階',
    expose: '北/東北',
    note: '有天然泳池（需漲潮進入）與豆腐岩區域。地形遮蔽好，東北季風期相對穩；夏季為休閒潛水熱門。',
    drive: '基隆市區 → 和平島，約 15 分'
  },
  {
    name: '龜山島',
    en: 'Guishan Island',
    level: '進階（船潛）',
    expose: '東/南',
    note: '需從烏石港搭船。溫差大、能見度變化劇烈；牛奶海、峽谷、花瓶嶼等著名潛點。每年 3–11 月開放。',
    drive: '宜蘭烏石港搭船，船程 30–40 分'
  },
  {
    name: '卯澳',
    en: 'Maoao',
    level: '中階',
    expose: '東北',
    note: '較冷門、人少。漁港旁小峽灣地形，能見度受降雨影響大。',
    drive: '台 2 線 113K 附近'
  },
  {
    name: '澳底',
    en: 'Aodi',
    level: '初階',
    expose: '東北/東',
    note: '小型漁港，岸潛點平緩，適合初學。秋冬有較強東北湧浪。',
    drive: '台 2 線 91K 附近'
  }
];

// 決策矩陣：閾值是「東北角休閒潛水」的經驗值
// 來源：綜合在地教練經驗 + BSAC / PADI 休閒潛水建議值
type Metric = {
  icon: string;
  name: string;
  en: string;
  unit: string;
  go: string;       // GO 條件
  caution: string;  // CAUTION 條件
  nogo: string;     // NO-GO 條件
  why: string;
};

const metrics: Metric[] = [
  {
    icon: '🌊',
    name: '浪高',
    en: 'Wave height',
    unit: 'm',
    go: '< 0.6',
    caution: '0.6 – 1.2',
    nogo: '> 1.2',
    why: '岸潛出入水最需要平靜海況。>1m 入水易失控打裝備，>1.5m 強烈建議改期。'
  },
  {
    icon: '🌬️',
    name: '風速',
    en: 'Wind speed',
    unit: 'm/s',
    go: '< 5',
    caution: '5 – 8',
    nogo: '> 8',
    why: '風決定表面波紋與體溫流失速度。>8m/s 配低水溫容易失溫，且水面浮力袋控管困難。'
  },
  {
    icon: '🧭',
    name: '風向',
    en: 'Wind direction',
    unit: '',
    go: '迎岸（S–W 對龍洞）',
    caution: '沿岸（沿海岸線）',
    nogo: '離岸（陸→海）',
    why: '離岸風把水面艇推離岸、潛水員漂向外海，是東北角溺水主因之一。龍洞口朝東，離岸風 ≈ 西風。'
  },
  {
    icon: '📏',
    name: '週期',
    en: 'Swell period',
    unit: 's',
    go: '> 9',
    caution: '7 – 9',
    nogo: '< 6',
    why: '長週期 = 整齊湧浪（可預測）；短週期 = 混亂碎浪（節奏亂、容易暈船）。'
  },
  {
    icon: '🌡️',
    name: '水溫',
    en: 'Water temp',
    unit: '°C',
    go: '24 – 28',
    caution: '21 – 24 / 28 – 30',
    nogo: '< 20 / > 31',
    why: '東北角水溫冬低夏高。冬季 <20°C 沒 5mm 防寒衣有失溫風險；夏季 >30°C 珊瑚白化、能見度下降。'
  },
  {
    icon: '👁️',
    name: '能見度',
    en: 'Visibility',
    unit: 'm',
    go: '> 8',
    caution: '3 – 8',
    nogo: '< 3',
    why: '<3m 等於瞎子摸象；3–8m 可潛但樂趣低；龍洞穩定期能到 15–20m。'
  },
  {
    icon: '🌀',
    name: '流速',
    en: 'Current',
    unit: 'kn',
    go: '< 0.5',
    caution: '0.5 – 1.0',
    nogo: '> 1.0',
    why: '東北角流最強在潮汐轉換前後 1–2 小時。岸潛流 >1kn 易回不了岸，需有船伴或負浮力準備。'
  },
  {
    icon: '🌙',
    name: '潮汐',
    en: 'Tide phase',
    unit: '',
    go: '平潮前後 1h',
    caution: '漲退潮中段',
    nogo: '大潮滿潮 / 乾潮',
    why: '平潮流最弱，潛水最舒適；大潮時段流速翻倍、潮間帶暴露區變化劇烈。'
  }
];
---

<Base
    title={PAGE_TITLE}
    description={PAGE_DESC}
    ogTag={OG_TAG}
    bodyPage="diving"
    pageStyles={["/styles/diving.css"]}
>
    <div data-site-nav></div>

    <main class="dive-main">
        <!-- ─────── Hero ─────── -->
        <header class="dive-hero">
            <div class="hero-eyebrow">🤿 Taiwan · Northeast Coast</div>
            <h1 class="hero-title">東北角潛水<br/>浪況速查</h1>
            <p class="hero-sub">
                Windguru 預報 + CWA 海況時序圖 + 在地潛點特性。<br/>
                出發前 30 分鐘掃一眼，決定今天 GO 還是窩沙發。
            </p>

            <div class="hero-cta">
                <a class="cta cta-primary" href={WINDGURU_URL} target="_blank" rel="noopener">
                    <span class="cta-icon">💨</span>
                    <span class="cta-text">
                        <span class="cta-label">開 Windguru 預報</span>
                        <span class="cta-sub">龍洞和美國小 · 未來 10 日</span>
                    </span>
                    <span class="cta-arrow">↗</span>
                </a>
                <a class="cta cta-secondary" href={CWA_URL} target="_blank" rel="noopener">
                    <span class="cta-icon">📊</span>
                    <span class="cta-text">
                        <span class="cta-label">開 CWA 時序圖</span>
                        <span class="cta-sub">MID 46694A · 觀測站即時</span>
                    </span>
                    <span class="cta-arrow">↗</span>
                </a>
            </div>

            <div class="hero-tip">
                <strong>怎麼看？</strong> Windguru 給你未來預報（出發前看），CWA 給你過去觀測（現場核對）。兩個交叉看最準。
            </div>
        </header>

        <!-- ─────── 決策矩陣 ─────── -->
        <section class="section reveal">
            <div class="section-head">
                <span class="section-tag">決策矩陣</span>
                <h2>GO / CAUTION / NO-GO 閾值</h2>
                <p>以下為東北角休閒潛水的經驗值。進階、技術潛水請自行加重標準。</p>
            </div>

            <div class="matrix-wrap">
                <table class="matrix">
                    <thead>
                        <tr>
                            <th class="col-icon"></th>
                            <th class="col-name">指標</th>
                            <th class="col-go">🟢 GO</th>
                            <th class="col-caution">🟡 CAUTION</th>
                            <th class="col-nogo">🔴 NO-GO</th>
                            <th class="col-why">說明</th>
                        </tr>
                    </thead>
                    <tbody>
                        {metrics.map((m) => (
                            <tr>
                                <td class="col-icon"><span class="m-icon">{m.icon}</span></td>
                                <td class="col-name">
                                    <div class="m-name">{m.name}</div>
                                    <div class="m-en">{m.en} <span class="m-unit">{m.unit && `(${m.unit})`}</span></div>
                                </td>
                                <td class="col-go"><code>{m.go}</code></td>
                                <td class="col-caution"><code>{m.caution}</code></td>
                                <td class="col-nogo"><code>{m.nogo}</code></td>
                                <td class="col-why">{m.why}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <div class="legend-row">
                <div class="legend-card go">
                    <div class="legend-emoji">🟢</div>
                    <div>
                        <div class="legend-title">GO · 出發</div>
                        <div class="legend-sub">所有指標都綠 → 帶著愉快心情下水</div>
                    </div>
                </div>
                <div class="legend-card caution">
                    <div class="legend-emoji">🟡</div>
                    <div>
                        <div class="legend-title">CAUTION · 評估</div>
                        <div class="legend-sub">任何一項黃 → 看潛點經驗、人數、後備方案</div>
                    </div>
                </div>
                <div class="legend-card nogo">
                    <div class="legend-emoji">🔴</div>
                    <div>
                        <div class="legend-title">NO-GO · 改期</div>
                        <div class="legend-sub">任何一項紅 → 直接放棄，潛水永遠有下一次</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────── 互動式預報（Open-Meteo 自動 fetch, 週末 verdict + 7日×13h 逐時表） ─────── -->
        <section class="section reveal" id="weekend-forecast">
            <div class="section-head">
                <span class="section-tag">互動式預報</span>
                <h2>本週末 + 未來 7 日 即時查</h2>
                <p>
                    三層資料: <strong>週末卡</strong> (Sat/Sun verdict) → <strong>CWA 即時觀測對照</strong> (過去 vs 預報 Δ) → <strong>7 日逐時表</strong>。
                    Open-Meteo (Marine ECMWF + WAVEWATCH III / Weather GFS) 免費 API, CWA 龍洞浮標 (MID 46694A) 過去 48 小時實況。
                </p>
            </div>

            <!-- 週末建議卡 (Sat + Sun) -->
            <div class="weekend-rec" id="weekend-rec">
                <div class="ww-loader">載入 Open-Meteo 預報中…</div>
            </div>

            <!-- CWA 龍洞浮標 即時觀測 + 對 Open-Meteo 預報同期對照 -->
            <div class="cwa-strip" id="cwa-strip">
                <div class="cwa-loader">載入 CWA 龍洞浮標觀測中…</div>
            </div>

            <!-- 7 日逐時表 -->
            <div class="forecast-grid" id="forecast-grid">
                <div class="fg-loader">載入中…</div>
            </div>

            <!-- 圖例 -->
            <div class="fg-legend">
                <span class="fg-legend-title">圖例:</span>
                <span class="fg-legend-row">
                    <span class="fg-legend-label">風速</span>
                    <span class="fg-legend-cell" style="background:#1a4d2e">&lt;2.5</span>
                    <span class="fg-legend-cell" style="background:#3fb950; color:#0d1d10">2.5-5</span>
                    <span class="fg-legend-cell" style="background:#d29922">5-8</span>
                    <span class="fg-legend-cell" style="background:#db6d28">8-11</span>
                    <span class="fg-legend-cell" style="background:#f85149">11+</span>
                    <span class="fg-legend-unit">m/s</span>
                </span>
                <span class="fg-legend-row">
                    <span class="fg-legend-label">浪高</span>
                    <span class="fg-legend-cell" style="background:#1a4d2e">&lt;0.6</span>
                    <span class="fg-legend-cell" style="background:#3fb950; color:#0d1d10">0.6-1.0</span>
                    <span class="fg-legend-cell" style="background:#d29922">1.0-1.4</span>
                    <span class="fg-legend-cell" style="background:#db6d28">1.4-1.8</span>
                    <span class="fg-legend-cell" style="background:#f85149">1.8+</span>
                    <span class="fg-legend-unit">m</span>
                </span>
                <span class="fg-legend-row">
                    <span class="fg-legend-label">週期</span>
                    <span class="fg-legend-cell" style="background:#f85149">&lt;5</span>
                    <span class="fg-legend-cell" style="background:#db6d28">5-7</span>
                    <span class="fg-legend-cell" style="background:#d29922">7-9</span>
                    <span class="fg-legend-cell" style="background:#3fb950; color:#0d1d10">9-12</span>
                    <span class="fg-legend-cell" style="background:#1a4d2e">12+</span>
                    <span class="fg-legend-unit">s · 越長越整齊</span>
                </span>
                <span class="fg-legend-row fg-legend-dir">
                    <span class="fg-legend-label">風向</span>
                    <span class="fg-legend-cell" style="background:#1a4d2e">迎岸 (60-130°)</span>
                    <span class="fg-legend-cell" style="background:#d29922">沿岸 (其他)</span>
                    <span class="fg-legend-cell" style="background:#f85149">離岸 (240-300°)</span>
                </span>
            </div>

            <details class="fg-help">
                <summary>如何使用這張表？</summary>
                <ol>
                    <li>先看 <strong>本週末 Sat/Sun</strong> 兩張卡，verdict 跟你想去的時段直接給你。</li>
                    <li>往下捲 <strong>CWA 龍洞浮標即時對照</strong> — 看過去 6 小時實況跟 Open-Meteo 預報同期的差 (Δ)。如果 Δ 都綠 (&lt;15%) 代表預報靠譜, 可以相信下面的週末卡; 如果很多紅 (&gt;30%) 代表預報跟實況偏離大, 改參考 CWA 實況判斷。</li>
                    <li>下面 7 日×13h 表格：<strong>每一格 = 一個小時</strong>的綜合值。背景色對應決策矩陣的 🟢🟡🔴 分級。</li>
                    <li><strong>Hover cell</strong> 看到風速/陣風/風向/浪高/週期/水溫的原始數值跟方向判定。</li>
                    <li>週末用淺藍色 header (週六日) — 跟你想去的時段對齊。</li>
                    <li>資料每小時自動 fetch 一次。要強制重抓，<code>Cmd/Ctrl+Shift+R</code> 跳過瀏覽器 cache。</li>
                    <li>要看 Windguru 對照驗證，繼續看下面「即時資料來源」雙站外連。CWA 完整 48hr 時序圖另開新分頁 (MID 46694A)。</li>
                </ol>
            </details>
        </section>

        <script>
            import '../scripts/diving-forecast.js';
        </script>

        <!-- ─────── 即時資料來源（直接外連 — 兩站 CSP frame-ancestors 擋 iframe） ─────── -->
        <section class="section reveal">
            <div class="section-head">
                <span class="section-tag">即時資料來源</span>
                <h2>Windguru + CWA 雙查</h2>
                <p>兩站都設了 CSP frame-ancestors（防止 iframe 嵌入），所以會在新分頁開啟 — 不是連結壞掉。</p>
            </div>

            <div class="source-grid">
                <article class="source-card">
                    <div class="source-head">
                        <div class="source-logo">💨</div>
                        <div>
                            <h3 class="source-title">Windguru · 龍洞和美國小</h3>
                            <div class="source-id">spot #464009</div>
                        </div>
                    </div>
                    <div class="source-look">
                        <strong>看什麼：</strong>未來 10 日的風速、風向、浪高、週期、氣溫。<br/>
                        <strong>主模型：</strong> GFS / ICON（每 6 小時更新）。<br/>
                        <strong>提示：</strong> 切到「風」圖層比「溫度」更能判斷能不能潛。
                    </div>
                    <a href={WINDGURU_URL} target="_blank" rel="noopener" class="source-btn">
                        <span>開啟 Windguru 預報</span>
                        <span class="source-arrow">↗</span>
                    </a>
                </article>

                <article class="source-card">
                    <div class="source-head">
                        <div class="source-logo">📊</div>
                        <div>
                            <h3 class="source-title">CWA · 海象時序圖</h3>
                            <div class="source-id">MID 46694A</div>
                        </div>
                    </div>
                    <div class="source-look">
                        <strong>看什麼：</strong>過去 24–48 小時實測浪高、風速、氣壓、水溫。<br/>
                        <strong>用途：</strong> 跟 Windguru 預報對照 — 預報 vs 實況有沒有落差。<br/>
                        <strong>提示：</strong> 圖可能需要點「重新載入畫圖」才更新。
                    </div>
                    <a href={CWA_URL} target="_blank" rel="noopener" class="source-btn">
                        <span>開啟 CWA 時序圖</span>
                        <span class="source-arrow">↗</span>
                    </a>
                </article>
            </div>

            <div class="source-note">
                💡 <strong>用兩個站的理由：</strong> Windguru 給「未來預報」、CWA 給「過去實況」。只看預報可能會誤判（模型有誤差），只看實況會錯過轉好的時機。兩個交叉看才準。
            </div>
        </section>

        <!-- ─────── 風向圖示 ─────── -->
        <section class="section reveal">
            <div class="section-head">
                <span class="section-tag">風向關鍵</span>
                <h2>龍洞潛點的風向判讀</h2>
                <p>東北角最大宗的事故原因：離岸風把人往外海吹。口訣背起來。</p>
            </div>

            <div class="compass-wrap">
                <div class="compass-stack">
                <!--
                  8-direction wind compass for 龍洞 (Longdong).
                  Diver sits at the centre, dive site faces EAST.
                  Wind blows FROM the labeled direction (meteorological convention).

                  Coloured zones:
                    🟢 E (onshore)  → safe, whitecaps but not pushed out to sea
                    🟡 N / S / SE / SW (cross-shore) → drift along coast, plan exit
                    🔴 W / NW / SW (offshore) → pushed out to sea, most dangerous
                -->
                <svg
                    class="compass-svg"
                    viewBox="-110 -110 220 220"
                    xmlns="http://www.w3.org/2000/svg"
                    role="img"
                    aria-label="龍洞潛點 8 方位風向安全分級 compass"
                >
                    <defs>
                        <clipPath id="compass-clip">
                            <circle r="100" />
                        </clipPath>
                        <radialGradient id="compass-bg" cx="50%" cy="50%" r="50%">
                            <stop offset="0%" stop-color="#1c2438" stop-opacity="0.95" />
                            <stop offset="100%" stop-color="#0a0d14" stop-opacity="0.6" />
                        </radialGradient>
                    </defs>

                    <!-- Background disc -->
                    <circle r="100" fill="url(#compass-bg)" />

                    <!-- Coloured safety sectors (8 wedges, 45° each, starting from N going clockwise) -->
                    <g clip-path="url(#compass-clip)">
                        <path d="M 0 0 L 38.3 -92.4 L 92.4 -38.3 Z" fill="rgba(210,153,34,0.22)" />  <!-- N   cross-shore -->
                        <path d="M 0 0 L 92.4 -38.3 L 92.4 38.3 Z"   fill="rgba(63,185,80,0.18)" />   <!-- NE  onshore-ish -->
                        <path d="M 0 0 L 92.4 38.3 L 38.3 92.4 Z"   fill="rgba(63,185,80,0.32)" />   <!-- E   SAFEST -->
                        <path d="M 0 0 L 38.3 92.4 L -38.3 92.4 Z"  fill="rgba(210,153,34,0.22)" />  <!-- SE  cross-shore -->
                        <path d="M 0 0 L -38.3 92.4 L -92.4 38.3 Z" fill="rgba(210,153,34,0.22)" />  <!-- S   cross-shore -->
                        <path d="M 0 0 L -92.4 38.3 L -92.4 -38.3 Z" fill="rgba(248,81,73,0.18)" /> <!-- SW  offshore-ish -->
                        <path d="M 0 0 L -92.4 -38.3 L -38.3 -92.4 Z" fill="rgba(248,81,73,0.32)" /><!-- W   MOST DANGEROUS -->
                        <path d="M 0 0 L -38.3 -92.4 L 38.3 -92.4 Z" fill="rgba(248,81,73,0.18)" />  <!-- NW  offshore-ish -->
                    </g>

                    <!-- Outer ring + inner ring -->
                    <circle r="100" fill="none" stroke="rgba(120,180,255,0.4)" stroke-width="1" />
                    <circle r="86"  fill="none" stroke="rgba(120,180,255,0.18)" stroke-width="1" />

                    <!-- Cardinal spokes -->
                    <g stroke="rgba(120,180,255,0.35)" stroke-width="1.2" stroke-linecap="round">
                        <line x1="0" y1="-100" x2="0" y2="100" />
                        <line x1="-100" y1="0" x2="100" y2="0" />
                    </g>
                    <!-- Intercardinal spokes (thinner) -->
                    <g stroke="rgba(120,180,255,0.18)" stroke-width="0.8" stroke-linecap="round">
                        <line x1="-70.7" y1="-70.7" x2="70.7" y2="70.7" />
                        <line x1="-70.7" y1="70.7" x2="70.7" y2="-70.7" />
                    </g>

                    <!-- Compass labels (cardinal, larger) -->
                    <g font-family="'JetBrains Mono', monospace" font-weight="700" text-anchor="middle">
                        <text x="0"    y="-105" font-size="16" fill="#e6edf3">N</text>
                        <text x="105"  y="0"    font-size="16" fill="#3fb950" dominant-baseline="middle">E</text>
                        <text x="0"    y="115"  font-size="16" fill="#e6edf3" dominant-baseline="middle">S</text>
                        <text x="-105" y="0"    font-size="16" fill="#f85149" dominant-baseline="middle">W</text>
                    </g>

                    <!-- Intercardinal labels (smaller, muted) -->
                    <g font-family="'JetBrains Mono', monospace" font-size="9" fill="#8b949e" text-anchor="middle">
                        <text x="74"  y="-71" dominant-baseline="middle">NE</text>
                        <text x="74"  y="71"  dominant-baseline="middle">SE</text>
                        <text x="-74" y="71"  dominant-baseline="middle">SW</text>
                        <text x="-74" y="-71" dominant-baseline="middle">NW</text>
                    </g>

                    <!-- East-pointing dive arrow (where the entry faces) -->
                    <g class="compass-arrow">
                        <path
                            d="M 18 0 L 86 0 M 86 0 L 76 -7 M 86 0 L 76 7"
                            stroke="#3fb950"
                            stroke-width="2.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            fill="none"
                        />
                        <text x="52" y="-9" text-anchor="middle" font-size="9" fill="#3fb950" font-weight="700">
                            入水方向 →
                        </text>
                    </g>

                    <!-- Live wind direction arrow (filled triangle pointing OUT toward the wind source) -->
                    <g class="compass-live" id="compass-live" data-wind-deg="0" data-wind-ms="0" data-loaded="false">
                        <g class="compass-live-arrow" id="compass-live-arrow">
                            <!-- arrow points to N by default; JS rotates the group via transform="rotate(X)" -->
                            <path
                                d="M 0 -78 L 8 -62 L -8 -62 Z"
                                fill="rgba(88,215,255,0.85)"
                                stroke="#58d7ff"
                                stroke-width="1.2"
                                stroke-linejoin="round"
                            />
                            <line x1="0" y1="-62" x2="0" y2="-30" stroke="#58d7ff" stroke-width="1.5" opacity="0.6"/>
                        </g>
                        <!-- speed label, also rotated to follow arrow -->
                        <g id="compass-live-label">
                            <rect x="-15" y="-58" width="30" height="14" rx="3" fill="rgba(8,12,22,0.85)" stroke="rgba(88,215,255,0.5)" stroke-width="0.8"/>
                            <text x="0" y="-48" text-anchor="middle" font-size="9" fill="#58d7ff" font-weight="700" font-family="'JetBrains Mono', monospace">-- m/s</text>
                        </g>
                    </g>

                    <!-- Centre: dive site icon + label -->
                    <g>
                        <circle r="14" fill="rgba(88,215,255,0.18)" stroke="rgba(88,215,255,0.5)" stroke-width="1" />
                        <text x="0" y="-1" text-anchor="middle" font-size="14">🤿</text>
                        <text x="0" y="14" text-anchor="middle" font-size="7" fill="#58d7ff" font-weight="600" letter-spacing="0.05em">
                            龍洞口
                        </text>
                    </g>

                    <!-- Minor tick marks every 22.5° -->
                    <g stroke="rgba(120,180,255,0.5)" stroke-width="1">
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(22.5)" />
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(67.5)" />
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(112.5)" />
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(157.5)" />
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(202.5)" />
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(247.5)" />
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(292.5)" />
                        <line x1="0" y1="-100" x2="0" y2="-93" transform="rotate(337.5)" />
                    </g>
                </svg>

                <!-- Live wind caption (filled by renderLiveCompass in diving-forecast.js) -->
                <div class="compass-current" id="compass-current">
                    <span>當下風向</span>
                    <span class="compass-current-dir">—</span>
                    <span>·</span>
                    <span class="compass-current-val">— m/s</span>
                </div>

                <!-- 7-day wind rose (filled by renderWindRose in diving-forecast.js) -->
                <div class="windrose-wrap">
                    <div class="windrose-title">未來 7 日 風向分布 <span class="windrose-sub">— 8 方位小時數</span></div>
                    <svg class="windrose-svg" id="windrose-svg" viewBox="-60 -60 120 120" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="未來 7 日 風向分布 8 方位 wind rose">
                        <g id="windrose-petals"></g>
                        <g id="windrose-rings"></g>
                        <g id="windrose-labels"></g>
                    </svg>
                    <div class="windrose-legend">
                        <span><span class="windrose-swatch" style="background:rgba(63,185,80,0.55);border-color:#3fb950"></span>迎岸</span>
                        <span><span class="windrose-swatch" style="background:rgba(210,153,34,0.55);border-color:#d29922"></span>沿岸</span>
                        <span><span class="windrose-swatch" style="background:rgba(248,81,73,0.55);border-color:#f85149"></span>離岸</span>
                    </div>
                </div>
                </div> <!-- /compass-stack -->

                <!-- Side legend (HTML for crisp typography + responsive wrap) -->
                <div class="compass-legend">
                    <div class="legend-item safe">
                        <div class="legend-swatch" style="background:rgba(63,185,80,0.32);border-color:#3fb950"></div>
                        <div class="legend-body">
                            <div class="legend-title">🟢 迎岸風 Onshore</div>
                            <div class="legend-sub">東風、東南東風 → 海面有白沫但不把人推走，最安全的潛水風</div>
                        </div>
                    </div>
                    <div class="legend-item caution">
                        <div class="legend-swatch" style="background:rgba(210,153,34,0.32);border-color:#d29922"></div>
                        <div class="legend-body">
                            <div class="legend-title">🟡 沿岸風 Cross-shore</div>
                            <div class="legend-sub">南、北、東北、東南 → 沿岸漂移，要先規劃出水點</div>
                        </div>
                    </div>
                    <div class="legend-item danger">
                        <div class="legend-swatch" style="background:rgba(248,81,73,0.32);border-color:#f85149"></div>
                        <div class="legend-body">
                            <div class="legend-title">🔴 離岸風 Offshore</div>
                            <div class="legend-sub">西、西北、西南風 → 推向外海，東北角溺水主因，請改期</div>
                        </div>
                    </div>
                    <div class="compass-note">
                        💡 <strong>口訣：</strong> 龍洞口朝東 → 看 Windguru 的風向箭頭，
                        「箭頭從哪個方向吹過來」就是哪邊的風。吹西風就是吹你出海。
                    </div>
                </div>
            </div>
        </section>

        <!-- ─────── 潛點速查 ─────── -->
        <section class="section reveal">
            <div class="section-head">
                <span class="section-tag">潛點速查</span>
                <h2>東北角六個主要潛點</h2>
                <p>從入門到船潛進階，依程度挑點。</p>
            </div>

            <div class="site-grid">
                {sites.map((s) => (
                    <article class="site-card">
                        <header class="site-head">
                            <h3 class="site-name">{s.name}</h3>
                            <span class="site-en">{s.en}</span>
                        </header>
                        <div class="site-meta">
                            <span class="site-tag tag-level">{s.level}</span>
                            <span class="site-tag tag-expose">面 {s.expose}</span>
                        </div>
                        <p class="site-note">{s.note}</p>
                        <div class="site-drive">🚗 {s.drive}</div>
                    </article>
                ))}
            </div>
        </section>

        <!-- ─────── 東北季風 vs 西南季風 ─────── -->
        <section class="section reveal">
            <div class="section-head">
                <span class="section-tag">季節特性</span>
                <h2>東北季風 vs 西南季風</h2>
                <p>東北角全年潛水可行，但季節差異極大。</p>
            </div>

            <div class="season-grid">
                <div class="season-card winter">
                    <div class="season-title">❄️ 東北季風期 · 10–3 月</div>
                    <ul class="season-list">
                        <li><strong>東北風</strong> 動輒 8–15m/s，常 6 級陣風</li>
                        <li><strong>浪高</strong> 經常 1.5–3m，能見度因風浪下降</li>
                        <li><strong>水溫</strong> 18–22°C，需 5mm 防寒衣 + hood</li>
                        <li><strong>潛點建議</strong>：和平島（遮蔽好）、龜山島船潛</li>
                        <li><strong>禁忌</strong>：龍洞東北面、鼻頭角、卯澳東北面岸潛</li>
                    </ul>
                </div>
                <div class="season-card summer">
                    <div class="season-title">☀️ 西南季風期 · 4–9 月</div>
                    <ul class="season-list">
                        <li><strong>西南風</strong> 通常 3–7m/s，較溫和</li>
                        <li><strong>浪高</strong> 多在 1m 以下，能見度最佳期 5–8 月</li>
                        <li><strong>水溫</strong> 26–29°C，3mm 防寒衣或 skin dive 即可</li>
                        <li><strong>潛點建議</strong>：龍洞全季最佳、鼻頭角放膽去</li>
                        <li><strong>注意</strong>：颱風季（7–9 月）需盯警報，颱風前 2 天通常最美也最危險</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- ─────── 裝備清單 ─────── -->
        <section class="section reveal">
            <div class="section-head">
                <span class="section-tag">出門前</span>
                <h2>東北角岸潛裝備 checklist</h2>
                <p>走石階、迎風面、出水點沒遮蔽 — 跟船潛差很多。</p>
            </div>

            <div class="gear-grid">
                <div class="gear-card">
                    <h3>🥶 防寒</h3>
                    <ul>
                        <li>3–5mm 濕式防寒衣（依水溫）</li>
                        <li>冬季加 hood + 5mm 手套</li>
                        <li>頭套內可加背心保暖</li>
                    </ul>
                </div>
                <div class="gear-card">
                    <h3>🦶 行走</h3>
                    <ul>
                        <li>防滑礁鞋（龍洞階梯超滑）</li>
                        <li>厚底潛水襪</li>
                        <li>手提桶裝裝備，避免全程背</li>
                    </ul>
                </div>
                <div class="gear-card">
                    <h3>🌊 水面</h3>
                    <ul>
                        <li>浮力袋 + 哨子（標位 + 求救）</li>
                        <li>SMB（延繩浮標）船潛必備</li>
                        <li>手電筒 / 信號燈（黃昏用）</li>
                    </ul>
                </div>
                <div class="gear-card">
                    <h3>🛟 安全</h3>
                    <ul>
                        <li>潛水電腦錶 + 備用深度計</li>
                        <li>指北針（東北角流強易迷向）</li>
                        <li>簡單急救包 + 氧氣</li>
                        <li>手機裝離線地圖（山區沒訊號）</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- ─────── 10 秒快速決策 ─────── -->
        <section class="section reveal">
            <div class="quick-check">
                <div class="qc-tag">10 秒快速決策</div>
                <h2>現在能不能下水？</h2>
                <ol class="qc-list">
                    <li><strong>看 Windguru</strong>：未來 3 小時浪高 + 風速 + 風向有沒有紅？</li>
                    <li><strong>對照 CWA</strong>：過去 6 小時實況是否與預報一致？（預報常報喜不報憂）</li>
                    <li><strong>查潮汐</strong>：現在離平潮多久？>2 小時流就會強。</li>
                    <li><strong>問自己</strong>：冷嗎？餓嗎？累嗎？有一個「是」就改天。</li>
                    <li><strong>有潛伴嗎？</strong>：岸潛永遠不單獨下水。</li>
                </ol>
                <p class="qc-rule">「潛水永遠有下一次」 — 沒有非今天不可的理由。</p>
            </div>
        </section>

        <footer class="dive-foot">
            <p>
                數據來源：<a href={WINDGURU_URL} target="_blank" rel="noopener">Windguru 464009</a> ·
                <a href={CWA_URL} target="_blank" rel="noopener">CWA 46694A</a> ·
                閾值為東北角休閒潛水經驗值，僅供參考。
            </p>
        </footer>
    </main>

    <div data-site-footer></div>
</Base>
