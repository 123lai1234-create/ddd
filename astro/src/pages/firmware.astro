---
import Base from '../layouts/Base.astro';
---
<Base
    title="Firmware Engineering · MCU Development · JT Lai"
    description="Nuvoton Nano130KE3BN Cortex-M0 firmware — EBI parallel bus driver, RGB565 TFT blit, Keil/J-Link toolchain. Includes interactive Flash budget calculator and EBI write-cycle timing viewer."
    bodyPage="firmware"
    pageStyles={["/styles/firmware.css"]}
>
    <div data-site-nav></div>

    <section class="fw-hero">
        <div class="fw-hero-inner">
            <div>
                <span class="fw-eyebrow">Firmware Engineering · MCU</span>
                <h1>Nuvoton Cortex-M0 韌體：從 datasheet 到 TFT 驅動</h1>
                <p class="sub">以 Nano130KE3BN 為平台，實作 EBI 並列匯流排 TFT 驅動、RGB565 圖像輸出、Flash 資源規劃與完整 Keil + J-Link 工作流。下方附互動式 Flash 預算計算器與 EBI 寫入時序觀察器。</p>
                <div class="fw-hero-tags">
                    <span class="fw-tag">Cortex-M0 · 42 MHz</span>
                    <span class="fw-tag">Nano130KE3BN</span>
                    <span class="fw-tag">Keil µVision 5</span>
                    <span class="fw-tag">J-Link SWD</span>
                    <span class="fw-tag">EBI / SPI / I²C / UART</span>
                    <span class="fw-tag">RGB565</span>
                </div>
            </div>
            <div class="fw-chip-viz">
                <svg viewBox="0 0 460 300" xmlns="http://www.w3.org/2000/svg" aria-label="Nano130 pinout diagram">
                    <g stroke="#7dd3fc" stroke-width="1" fill="none" opacity="0.35">
                        <path d="M20 60 L140 60 L150 80" />
                        <path d="M20 120 L130 120 L145 140" />
                        <path d="M20 180 L135 180" />
                        <path d="M20 240 L140 240 L150 220" />
                        <path d="M440 60 L320 60 L310 80" />
                        <path d="M440 120 L330 120 L315 140" />
                        <path d="M440 180 L325 180" />
                        <path d="M440 240 L320 240 L310 220" />
                    </g>
                    <rect x="150" y="80" width="160" height="140" rx="4" fill="#0d1220" stroke="#7dd3fc" stroke-width="1" />
                    <rect x="162" y="92" width="136" height="116" rx="2" fill="none" stroke="#7dd3fc" stroke-width="0.5" opacity="0.25" />
                    <text x="230" y="140" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="13" fill="#e6eaf2" font-weight="600">NANO130</text>
                    <text x="230" y="158" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" fill="#7dd3fc">KE3BN</text>
                    <text x="230" y="178" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="8" fill="#a8b0c2">Cortex-M0 · 42 MHz</text>
                    <text x="230" y="194" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="7" fill="#6b7488">128 KB Flash · 16 KB SRAM</text>
                    <g fill="#6b7488">
                        <rect x="140" y="95" width="10" height="3" /><rect x="140" y="110" width="10" height="3" />
                        <rect x="140" y="125" width="10" height="3" /><rect x="140" y="140" width="10" height="3" />
                        <rect x="140" y="155" width="10" height="3" /><rect x="140" y="170" width="10" height="3" />
                        <rect x="140" y="185" width="10" height="3" /><rect x="140" y="200" width="10" height="3" />
                        <rect x="310" y="95" width="10" height="3" /><rect x="310" y="110" width="10" height="3" />
                        <rect x="310" y="125" width="10" height="3" /><rect x="310" y="140" width="10" height="3" />
                        <rect x="310" y="155" width="10" height="3" /><rect x="310" y="170" width="10" height="3" />
                        <rect x="310" y="185" width="10" height="3" /><rect x="310" y="200" width="10" height="3" />
                    </g>
                    <text x="20" y="55" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488">EBI[0:15]</text>
                    <text x="20" y="115" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488">SPI0 MOSI</text>
                    <text x="20" y="175" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488">I²C SDA</text>
                    <text x="20" y="235" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488">UART TX</text>
                    <text x="440" y="55" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488" text-anchor="end">TFT RS</text>
                    <text x="440" y="115" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488" text-anchor="end">GPIO LED</text>
                    <text x="440" y="175" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488" text-anchor="end">PWM</text>
                    <text x="440" y="235" font-family="JetBrains Mono, monospace" font-size="8" fill="#6b7488" text-anchor="end">ADC</text>
                </svg>
            </div>
        </div>
    </section>

    <div class="fw">
        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">01</span>
                <h2>核心技術規格</h2>
                <span class="note">hardware target</span>
            </div>
            <div class="fw-specgrid">
                <div class="fw-spec"><div class="lbl">MCU Core</div><div class="val">Cortex-M0</div><div class="sub">42 MHz · Thumb-2 · NVIC</div></div>
                <div class="fw-spec"><div class="lbl">Flash / SRAM</div><div class="val">128 KB / 16 KB</div><div class="sub">on-chip ROM + RAM</div></div>
                <div class="fw-spec"><div class="lbl">Display Bus</div><div class="val">EBI Parallel</div><div class="sub">memory-mapped I/O</div></div>
                <div class="fw-spec"><div class="lbl">Pixel Format</div><div class="val">RGB565</div><div class="sub">16-bit · 2 B / px</div></div>
                <div class="fw-spec"><div class="lbl">Target Resolution</div><div class="val">200 × 220</div><div class="sub">~86 KB payload</div></div>
                <div class="fw-spec"><div class="lbl">Toolchain</div><div class="val">Keil + J-Link</div><div class="sub">ARMCC · ELF · SWD flash</div></div>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">02</span>
                <h2>Flash 預算計算器</h2>
                <span class="note">interactive · flash_bytes = W × H × bpp/8 × N</span>
            </div>
            <div class="fw-calc">
                <div class="fw-calc-grid">
                    <div class="fw-calc-inputs">
                        <div class="fw-calc-field">
                            <label>Width <b><span id="fwcW">200</span> px</b></label>
                            <input type="range" id="fwInW" min="64" max="320" step="8" value="200" />
                        </div>
                        <div class="fw-calc-field">
                            <label>Height <b><span id="fwcH">220</span> px</b></label>
                            <input type="range" id="fwInH" min="64" max="320" step="8" value="220" />
                        </div>
                        <div class="fw-calc-field">
                            <label>Pixel format</label>
                            <select id="fwInBpp">
                                <option value="16" selected>RGB565 · 16-bit (2 B / px)</option>
                                <option value="24">RGB888 · 24-bit (3 B / px)</option>
                                <option value="8">Indexed · 8-bit (1 B / px)</option>
                            </select>
                        </div>
                        <div class="fw-calc-field">
                            <label>Images <b><span id="fwcN">1</span></b></label>
                            <input type="range" id="fwInN" min="1" max="8" step="1" value="1" />
                        </div>
                        <div class="fw-calc-field">
                            <label>Code + data footprint <b><span id="fwcCode">30</span> KB</b></label>
                            <input type="range" id="fwInCode" min="10" max="60" step="2" value="30" />
                        </div>
                    </div>
                    <div class="fw-calc-output">
                        <div class="fw-calc-row">
                            <span class="name">Code / Data</span>
                            <div class="bar"><span class="fill" id="fwBarCode" style="width:23%"></span></div>
                            <span class="pct"><span id="fwValCode">30</span> / 128 KB</span>
                        </div>
                        <div class="fw-calc-row">
                            <span class="name">Image payload</span>
                            <div class="bar"><span class="fill" id="fwBarImg" style="width:67%"></span></div>
                            <span class="pct"><span id="fwValImg">86</span> / 128 KB</span>
                        </div>
                        <div class="fw-calc-row">
                            <span class="name">Total</span>
                            <div class="bar"><span class="fill" id="fwBarTotal" style="width:91%"></span></div>
                            <span class="pct"><span id="fwValTotal">116</span> / 128 KB</span>
                        </div>
                        <div class="fw-calc-row">
                            <span class="name">Headroom</span>
                            <div class="bar"><span class="fill" id="fwBarFree" style="width:9%;background:var(--fw-ok)"></span></div>
                            <span class="pct"><span id="fwValFree">12</span> KB</span>
                        </div>
                        <div id="fwVerdict" class="fw-calc-verdict ok">fits in on-chip Flash</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">03</span>
                <h2>Flash-resident 影像 + EBI blit 實作</h2>
                <span class="note">img2.c · main.c</span>
            </div>
            <div class="fw-code-wrap">
                <div class="fw-code-bar">img2.c — 200×220 RGB565 · Flash-resident</div>
                <pre class="fw-code"><span class="c-cm">/* Generated via Rinky-Dink RGB565 converter.
   const keyword pins the array into Flash —
   zero SRAM allocation at runtime. */</span>
<span class="c-key">const</span> <span class="c-type">unsigned short</span> img2[<span class="c-num">44000</span>] = &#123;
    <span class="c-num">0x0000</span>, <span class="c-num">0x0000</span>, <span class="c-num">0x1082</span>, <span class="c-num">0x2965</span>, <span class="c-num">0x41A7</span>, <span class="c-num">0x62AB</span>,
    <span class="c-num">0x832F</span>, <span class="c-num">0xA4B3</span>, <span class="c-num">0xC636</span>, <span class="c-num">0xE7BA</span>, <span class="c-num">0xFFFF</span>, <span class="c-num">0xFFDE</span>,
    <span class="c-cm">/* ... 44 000 entries — each a 16-bit RGB565 pixel ... */</span>
&#125;;</pre>
            </div>
            <div class="fw-code-wrap">
                <div class="fw-code-bar">main.c — EBI write loop</div>
                <pre class="fw-code"><span class="c-cm">/* Memory-mapped I/O: writing to an EBI-mapped
   address emits one pixel on the bus. */</span>
<span class="c-type">void</span> <span class="c-fn">tft_blit</span>(<span class="c-key">const</span> <span class="c-type">uint16_t</span> *buf, <span class="c-type">uint32_t</span> n) &#123;
    <span class="c-key">for</span> (<span class="c-type">uint32_t</span> i = <span class="c-num">0</span>; i &lt; n; i++) &#123;
        EBI_WRITE_DATA(buf[i]);    <span class="c-cm">// asserts CS/WR strobe</span>
    &#125;
&#125;

<span class="c-type">int</span> <span class="c-fn">main</span>(<span class="c-type">void</span>) &#123;
    <span class="c-fn">SYS_Init</span>();            <span class="c-cm">// clock tree + multifunction pins</span>
    <span class="c-fn">EBI_Open</span>(<span class="c-num">0</span>, <span class="c-num">16</span>);      <span class="c-cm">// 16-bit bus on bank 0</span>
    <span class="c-fn">TFT_Init</span>();            <span class="c-cm">// controller reset + init sequence</span>
    <span class="c-fn">tft_blit</span>(img2, <span class="c-num">44000</span>);
    <span class="c-key">while</span> (<span class="c-num">1</span>) &#123; <span class="c-fn">__WFI</span>(); &#125;    <span class="c-cm">// sleep, wake on interrupt</span>
&#125;</pre>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">04</span>
                <h2>EBI 寫入時序觀察器</h2>
                <span class="note">interactive · compare tAS / tWP margins</span>
            </div>
            <div class="fw-timing">
                <div class="fw-timing-head">
                    <span class="fw-timing-title">WR cycle: CS → WR → DATA latched</span>
                    <div class="fw-timing-toggle" role="tablist">
                        <button id="fwTimGood" class="active" data-mode="good">合格時序</button>
                        <button id="fwTimMarg" data-mode="marg">tAS 過短</button>
                    </div>
                </div>
                <svg id="fw-timing-svg" viewBox="0 0 600 220" xmlns="http://www.w3.org/2000/svg" aria-label="EBI write cycle timing waveform">
                    <g font-family="JetBrains Mono, monospace" font-size="10" fill="#a8b0c2">
                        <text x="8" y="38">CS</text>
                        <text x="8" y="98">WR</text>
                        <text x="8" y="158">DATA[15:0]</text>
                    </g>
                    <g stroke="#1a2030" stroke-width="1">
                        <line x1="40" y1="30" x2="580" y2="30" />
                        <line x1="40" y1="90" x2="580" y2="90" />
                        <line x1="40" y1="150" x2="580" y2="150" />
                    </g>
                    <path id="fwWavCS" d="" stroke="#7dd3fc" stroke-width="1.5" fill="none" />
                    <path id="fwWavWR" d="" stroke="#7dd3fc" stroke-width="1.5" fill="none" />
                    <path id="fwWavData" d="" stroke="#7dd3fc" stroke-width="1.5" fill="none" />
                    <g id="fwTimMarkers" font-family="JetBrains Mono, monospace" font-size="9" fill="#6b7488"></g>
                    <g id="fwLatchDot"></g>
                </svg>
                <div class="fw-timing-readout">
                    <div><span class="k">tAS (address setup)</span> <span class="v" id="fwTimTas">6 ns</span></div>
                    <div><span class="k">tWP (WR pulse width)</span> <span class="v" id="fwTimTwp">24 ns</span></div>
                    <div><span class="k">tAH (address hold)</span> <span class="v" id="fwTimTah">6 ns</span></div>
                    <div><span class="k">latched byte</span> <span class="v" id="fwTimLatch">0xA4B3 ✓</span></div>
                </div>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">05</span>
                <h2>PNG → MCU toolchain</h2>
                <span class="note">5-step build pipeline</span>
            </div>
            <div class="fw-pipe">
                <div class="fw-step"><div class="t">影像輸入</div><div class="d">PNG / JPG，建議 200 × 220 以下</div></div>
                <div class="fw-step"><div class="t">RGB565 轉換</div><div class="d">Rinky-Dink converter 輸出 C header</div></div>
                <div class="fw-step"><div class="t">加入專案</div><div class="d">替換 img2.c，以 const 鎖進 Flash</div></div>
                <div class="fw-step"><div class="t">EBI 時序對齊</div><div class="d">設 tAS / tAH 匹配 TFT setup/hold</div></div>
                <div class="fw-step"><div class="t">J-Link 燒錄</div><div class="d">SWD flash，以邏輯分析儀驗證波形</div></div>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">06</span>
                <h2>實作難點 &amp; 處置</h2>
                <span class="note">problem → mitigation</span>
            </div>
            <div class="fw-diff">
                <div class="fw-diff-card"><span class="tag">Issue</span><div class="title">Flash 容量不足</div><div class="desc">單張 200×220 RGB565 約 86 KB，加上 code 僅剩 12 KB 餘裕，無法容納第二張圖。</div></div>
                <div class="fw-diff-card solve"><span class="tag">Fix</span><div class="title">外掛 SPI Flash</div><div class="desc">影像移至 W25Q 系列，MCU 以 SPI DMA 逐行讀入 line buffer 後送 EBI。</div></div>
                <div class="fw-diff-card"><span class="tag">Issue</span><div class="title">EBI 時序不匹配</div><div class="desc">TFT 顯示亂碼或局部列遺失，根因通常為 setup / hold 未滿足控制器要求。</div></div>
                <div class="fw-diff-card solve"><span class="tag">Fix</span><div class="title">邏輯分析儀校正</div><div class="desc">量測 CS / WR / RD 波形反推 tAS / tAH 至穩定範圍，完成後鎖定設定。</div></div>
                <div class="fw-diff-card"><span class="tag">Issue</span><div class="title">Keil 32 KB 編譯上限</div><div class="desc">免費版本無法完整連結含大型 image 陣列的專案。</div></div>
                <div class="fw-diff-card solve"><span class="tag">Fix</span><div class="title">申請 PSN 教育授權</div><div class="desc">以學生身份取得免費教育版 license 解除限制。</div></div>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">07</span>
                <h2>教學系列</h2>
                <span class="note">YouTube · Nano MCU playlist</span>
            </div>
            <div class="fw-yt">
                <iframe src="https://www.youtube.com/embed/videoseries?list=PLUl_fzAL8tWIqU_zk0u1_18sf1LF-ym91" title="Nuvoton Firmware Playlist" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">08</span>
                <h2>技術文章</h2>
                <span class="note">blog</span>
            </div>
            <div class="fw-articles">
                <a href="https://jtlai0921.wixsite.com/mysite/post/%E7%8C%B4%E5%AD%90%E9%83%BD%E8%83%BD%E8%AE%80%E6%87%82%E7%9A%84%E7%94%A8tft%E9%A1%AF%E7%A4%BA%E5%9C%96%E7%89%87" target="_blank" rel="noopener">
                    <span class="bullet">01 →</span>
                    <span class="title">TFT 顯示圖片完整教學：EBI 並列匯流排與 RGB565 pipeline</span>
                    <span class="arrow">↗</span>
                </a>
                <a href="https://jtlai0921.wixsite.com/mysite" target="_blank" rel="noopener">
                    <span class="bullet">02 →</span>
                    <span class="title">更多韌體與工程筆記 · 個人部落格</span>
                    <span class="arrow">↗</span>
                </a>
            </div>
        </section>

        <section class="fw-section">
            <div class="fw-section-head">
                <span class="fw-section-num">09</span>
                <h2>跨域延伸</h2>
                <span class="note">DSP × biomed</span>
            </div>
            <div class="fw-callout">
                <div class="title">硬體 · 韌體 · 演算法 · 應用層整合</div>
                <p>以 MCU 韌體為基礎，延伸至 ECG / PPG 生理訊號 FIR / IIR 濾波與心率擷取，與站內的 <a href="report.html">蛋白質 AI</a>、<a href="ngs.html">NGS pipeline</a>、<a href="gene_ai.html">基因 AI</a> 共同構成從感測器到模型推論的完整工程鏈。</p>
            </div>
        </section>
    </div>

    <hr class="divider" style="margin-top:60px" />
    <div data-site-footer></div>
    <button class="scroll-top" aria-label="返回頂部">↑</button>

    <script is:inline>
        (function () {
            // ── Flash budget calculator ──
            const FLASH_KB = 128;
            const inW = document.getElementById('fwInW');
            const inH = document.getElementById('fwInH');
            const inBpp = document.getElementById('fwInBpp');
            const inN = document.getElementById('fwInN');
            const inCode = document.getElementById('fwInCode');

            const lblW = document.getElementById('fwcW');
            const lblH = document.getElementById('fwcH');
            const lblN = document.getElementById('fwcN');
            const lblCode = document.getElementById('fwcCode');

            const barCode = document.getElementById('fwBarCode');
            const barImg = document.getElementById('fwBarImg');
            const barTotal = document.getElementById('fwBarTotal');
            const barFree = document.getElementById('fwBarFree');
            const valCode = document.getElementById('fwValCode');
            const valImg = document.getElementById('fwValImg');
            const valTotal = document.getElementById('fwValTotal');
            const valFree = document.getElementById('fwValFree');
            const verdict = document.getElementById('fwVerdict');

            function updateCalc() {
                const w = +inW.value, h = +inH.value;
                const bpp = +inBpp.value, n = +inN.value;
                const codeKB = +inCode.value;
                const imgBytes = w * h * (bpp / 8) * n;
                const imgKB = imgBytes / 1024;
                const totalKB = codeKB + imgKB;
                const freeKB = FLASH_KB - totalKB;

                lblW.textContent = w;
                lblH.textContent = h;
                lblN.textContent = n;
                lblCode.textContent = codeKB;

                valCode.textContent = codeKB.toFixed(0);
                valImg.textContent = imgKB.toFixed(1);
                valTotal.textContent = totalKB.toFixed(1);
                valFree.textContent = freeKB.toFixed(1);

                const pct = (v) => Math.min(100, Math.max(0, (v / FLASH_KB) * 100));
                barCode.style.width = pct(codeKB) + '%';
                barImg.style.width = pct(imgKB) + '%';
                barTotal.style.width = pct(totalKB) + '%';
                barFree.style.width = pct(Math.max(0, freeKB)) + '%';

                if (totalKB > FLASH_KB) {
                    verdict.className = 'fw-calc-verdict bad';
                    verdict.textContent = 'overflow · exceeds 128 KB on-chip Flash by ' + (totalKB - FLASH_KB).toFixed(1) + ' KB — move images to external SPI Flash';
                    barTotal.style.background = 'var(--fw-bad)';
                } else if (totalKB > FLASH_KB * 0.9) {
                    verdict.className = 'fw-calc-verdict warn';
                    verdict.textContent = 'tight fit · ' + freeKB.toFixed(1) + ' KB headroom — consider downsizing or external Flash';
                    barTotal.style.background = 'var(--fw-warn)';
                } else {
                    verdict.className = 'fw-calc-verdict ok';
                    verdict.textContent = 'fits in on-chip Flash · ' + freeKB.toFixed(1) + ' KB headroom remaining';
                    barTotal.style.background = 'var(--fw-accent)';
                }
            }

            [inW, inH, inBpp, inN, inCode].forEach(el => el.addEventListener('input', updateCalc));
            updateCalc();

            // ── EBI timing viewer ──
            const svgWavCS = document.getElementById('fwWavCS');
            const svgWavWR = document.getElementById('fwWavWR');
            const svgWavData = document.getElementById('fwWavData');
            const markers = document.getElementById('fwTimMarkers');
            const latchDot = document.getElementById('fwLatchDot');
            const lblTas = document.getElementById('fwTimTas');
            const lblTwp = document.getElementById('fwTimTwp');
            const lblTah = document.getElementById('fwTimTah');
            const lblLatch = document.getElementById('fwTimLatch');
            const btnGood = document.getElementById('fwTimGood');
            const btnMarg = document.getElementById('fwTimMarg');

            // y-axis centers: CS=30, WR=90, DATA=150; high=low-20, low=line
            function waveform(mode) {
                // time axis: 40 → 560 px = 52 ns (1 px = 0.1 ns)
                // Events: data valid at t=0; CS low at t=tAS; WR low at t=tAS+2; WR high at end of tWP; data stable through tAH after WR high
                const GOOD = { tAS: 6, tWP: 24, tAH: 6 };
                const BAD = { tAS: 1, tWP: 12, tAH: 1 };
                const p = mode === 'good' ? GOOD : BAD;
                const t0 = 40;             // data becomes valid
                const tCSLow = t0 + p.tAS * 10 * 0.1 * 10; // scale: 1ns = 5px
                // Use simpler scale: 1 ns = 5 px
                const SCALE = 5;
                const tDataStart = 60;
                const tCSDn = tDataStart + p.tAS * SCALE;
                const tWRDn = tCSDn + 10;               // 2 ns after CS
                const tWRUp = tWRDn + p.tWP * SCALE;
                const tCSUp = tWRUp + p.tAH * SCALE;
                const tDataEnd = tWRUp + p.tAH * SCALE;

                const HI = { cs: 18, wr: 78, data: 138 };
                const LO = { cs: 38, wr: 98, data: 158 };

                // CS: starts high, goes low at tCSDn, back high at tCSUp
                svgWavCS.setAttribute('d',
                    `M40 ${HI.cs} L${tCSDn} ${HI.cs} L${tCSDn} ${LO.cs} L${tCSUp} ${LO.cs} L${tCSUp} ${HI.cs} L580 ${HI.cs}`);
                // WR: high, low between tWRDn and tWRUp
                svgWavWR.setAttribute('d',
                    `M40 ${HI.wr} L${tWRDn} ${HI.wr} L${tWRDn} ${LO.wr} L${tWRUp} ${LO.wr} L${tWRUp} ${HI.wr} L580 ${HI.wr}`);
                // DATA: shown as two crossing lines forming a bus "valid" region between tDataStart and tDataEnd
                svgWavData.setAttribute('d',
                    `M40 148 L${tDataStart - 6} 148 L${tDataStart} 138 L${tDataEnd} 138 L${tDataEnd + 6} 148 L580 148 M40 148 L${tDataStart - 6} 148 L${tDataStart} 158 L${tDataEnd} 158 L${tDataEnd + 6} 148 L580 148`);

                // Markers
                let mk = '';
                mk += `<line x1="${tDataStart}" y1="130" x2="${tDataStart}" y2="170" stroke="#6b7488" stroke-dasharray="2,3"/>`;
                mk += `<line x1="${tCSDn}" y1="10" x2="${tCSDn}" y2="170" stroke="#6b7488" stroke-dasharray="2,3"/>`;
                mk += `<line x1="${tWRDn}" y1="70" x2="${tWRDn}" y2="170" stroke="#6b7488" stroke-dasharray="2,3"/>`;
                mk += `<line x1="${tWRUp}" y1="70" x2="${tWRUp}" y2="170" stroke="#6b7488" stroke-dasharray="2,3"/>`;
                // tAS bracket
                mk += `<text x="${(tDataStart + tCSDn) / 2}" y="182" text-anchor="middle" fill="#a8b0c2">tAS</text>`;
                mk += `<text x="${(tWRDn + tWRUp) / 2}" y="112" text-anchor="middle" fill="#a8b0c2">tWP</text>`;
                mk += `<text x="${(tWRUp + tCSUp) / 2}" y="52" text-anchor="middle" fill="#a8b0c2">tAH</text>`;
                markers.innerHTML = mk;

                // Latch moment: rising edge of WR
                const dotColor = mode === 'good' ? '#4ade80' : '#f87171';
                latchDot.innerHTML = `<circle cx="${tWRUp}" cy="88" r="5" fill="${dotColor}"/><text x="${tWRUp + 8}" y="92" font-family="JetBrains Mono, monospace" font-size="9" fill="${dotColor}">latch</text>`;

                // Readout
                lblTas.textContent = p.tAS + ' ns';
                lblTwp.textContent = p.tWP + ' ns';
                lblTah.textContent = p.tAH + ' ns';
                lblTas.className = 'v ' + (mode === 'good' ? 'good' : 'bad');
                lblTwp.className = 'v ' + (mode === 'good' ? 'good' : 'bad');
                lblTah.className = 'v ' + (mode === 'good' ? 'good' : 'bad');
                if (mode === 'good') {
                    lblLatch.textContent = '0xA4B3 ✓';
                    lblLatch.className = 'v good';
                } else {
                    lblLatch.textContent = '0xA4?? ✕ metastable';
                    lblLatch.className = 'v bad';
                }

                // Waveform colour
                const col = mode === 'good' ? '#7dd3fc' : '#f87171';
                svgWavCS.setAttribute('stroke', col);
                svgWavWR.setAttribute('stroke', col);
                svgWavData.setAttribute('stroke', col);
            }

            btnGood.addEventListener('click', () => {
                btnGood.classList.add('active'); btnMarg.classList.remove('active');
                waveform('good');
            });
            btnMarg.addEventListener('click', () => {
                btnMarg.classList.add('active'); btnGood.classList.remove('active');
                waveform('marg');
            });
            waveform('good');
        })();
    </script>
</Base>
