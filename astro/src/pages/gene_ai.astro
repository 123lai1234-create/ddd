---
import Base from '../layouts/Base.astro';
const bodyHtml = "\r\n    <div data-site-nav></div>\r\n\r\n    <header class=\"hero\">\r\n        <div class=\"hero-grid\">\r\n            <div>\r\n                <div class=\"eyebrow\"><span class=\"live-dot\"></span>Genome Data Platform · Live Sequence + Knowledge + RAG</div>\r\n                <h1>把序列資料、知識檢索與 RAG 文件<br><span>收進同一個基因資料平台</span></h1>\r\n                <p class=\"hero-sub\">真接後端的基因資料平台：序列快取、知識庫與 RAG 文件，三層同步、全部可驗證。</p>\r\n                <div class=\"hero-note\">全 API-backed，無前端模擬介面。</div>\r\n                <div class=\"hero-cta-row\">\r\n                    <a href=\"#product-overview\" class=\"btn btn-primary\">查看產品能力</a>\r\n                    <a href=\"#sequence-vault\" class=\"btn btn-secondary\">進入 Sequence Vault</a>\r\n                    <a href=\"#rag-layer\" class=\"btn btn-secondary\">查看 RAG 輸出</a>\r\n                </div>\r\n                <div class=\"hero-stats\">\r\n                    <div class=\"hero-stat\">\r\n                        <div class=\"value\">2 Live APIs</div>\r\n                        <div class=\"label\">序列 + 知識 · FastAPI 後端</div>\r\n                    </div>\r\n                    <div class=\"hero-stat\">\r\n                        <div class=\"value\">DB-backed</div>\r\n                        <div class=\"label\">資料庫快取即時讀取</div>\r\n                    </div>\r\n                    <div class=\"hero-stat\">\r\n                        <div class=\"value\">RAG-ready</div>\r\n                        <div class=\"label\">chunks + metadata 直接輸出</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"signal-card\">\r\n                <div class=\"signal-top\">\r\n                    <div class=\"signal-title\">Product Runtime Snapshot</div>\r\n                    <div class=\"status-pill\">Live Data</div>\r\n                </div>\r\n                <div class=\"signal-matrix\">\r\n                    <div class=\"signal-block\">\r\n                        <div class=\"k\">Live Data Layer</div>\r\n                        <div class=\"v\">Sequence Cache · Knowledge Cache</div>\r\n                    </div>\r\n                    <div class=\"signal-block\">\r\n                        <div class=\"k\">Knowledge Retrieval</div>\r\n                        <div class=\"v\">Evidence Search · Source Metadata</div>\r\n                    </div>\r\n                    <div class=\"signal-block\">\r\n                        <div class=\"k\">RAG Output</div>\r\n                        <div class=\"v\">Chunk Preview · Retrieval-ready Docs</div>\r\n                    </div>\r\n                    <div class=\"signal-block\">\r\n                        <div class=\"k\">Operations</div>\r\n                        <div class=\"v\">Sync · Search · Filter · Delete</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"signal-list\">\r\n                    <div class=\"signal-item\">\r\n                        <div class=\"left\">Sequence sync</div>\r\n                        <div class=\"right\">UniProt / Ensembl → Render DB</div>\r\n                    </div>\r\n                    <div class=\"signal-item\">\r\n                        <div class=\"left\">Knowledge sync</div>\r\n                        <div class=\"right\">UniProt / PubMed → RAG-ready docs</div>\r\n                    </div>\r\n                    <div class=\"signal-item\">\r\n                        <div class=\"left\">RAG export</div>\r\n                        <div class=\"right\">Chunk + metadata preview from backend</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </header>\r\n\r\n    <main class=\"container\">\r\n        <section class="section plain-intro">
            <div style="background:rgba(88,215,255,0.04);border:1px solid rgba(88,215,255,0.15);border-radius:12px;padding:20px 24px">
                <div style="font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-bottom:12px">這個平台在做什麼？</div>
                <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:14px">
                    <div style="flex:1;min-width:180px;background:rgba(88,215,255,0.05);border:1px solid rgba(88,215,255,0.12);border-radius:10px;padding:14px 16px">
                        <div style="font-size:.82rem;font-weight:600;color:#58d7ff;margin-bottom:6px">① 輸入基因名稱</div>
                        <div style="font-size:.8rem;color:var(--muted);line-height:1.6">系統從 UniProt / NCBI 取得序列資料</div>
                    </div>
                    <div style="flex:1;min-width:180px;background:rgba(88,215,255,0.05);border:1px solid rgba(88,215,255,0.12);border-radius:10px;padding:14px 16px">
                        <div style="font-size:.82rem;font-weight:600;color:#58d7ff;margin-bottom:6px">② AI 建立知識庫</div>
                        <div style="font-size:.8rem;color:var(--muted);line-height:1.6">自動摘要文獻與功能，存入 Vault</div>
                    </div>
                    <div style="flex:1;min-width:180px;background:rgba(88,215,255,0.05);border:1px solid rgba(88,215,255,0.12);border-radius:10px;padding:14px 16px">
                        <div style="font-size:.82rem;font-weight:600;color:#58d7ff;margin-bottom:6px">③ RAG 問答</div>
                        <div style="font-size:.8rem;color:var(--muted);line-height:1.6">用自然語言詢問任何基因問題</div>
                    </div>
                </div>
                <div style="font-size:.8rem;color:var(--dim);border-top:1px solid rgba(88,215,255,0.1);padding-top:12px">以下功能區塊均已預載示範資料，訪客無需登入即可探索。</div>
            </div>
        </section>\r\n        <section id=\"product-overview\" class=\"section section-tight\">\r\n            <div class=\"section-head\">\r\n                <div>\r\n                    <div class=\"section-label\">Product Surfaces</div>\r\n                    <h2 class=\"section-title\">三個可驗證的核心模組</h2>\r\n                    <p class=\"section-sub\">每一個模組都能直接追到後端 API、DB 快取或 RAG 文件輸出。</p>\r\n                </div>\r\n                <div class=\"section-badge badge-architecture\">可驗證架構設計</div>\r\n            </div>\r\n\r\n            <div class=\"surface-grid\">\r\n                <article class=\"surface-card\">\r\n                    <div class=\"surface-head\">\r\n                        <span class=\"runtime-badge runtime-badge-live\">Live API</span>\r\n                        <h3>Sequence Operations</h3>\r\n                    </div>\r\n                    <p>從公開來源抓 protein / gene sequence，落到 Postgres 快取後，前端就能直接搜尋、篩選、檢視與刪除。</p>\r\n                    <div class=\"surface-points\">\r\n                        <div class=\"surface-point\">UniProt / Ensembl 同步</div>\r\n                        <div class=\"surface-point\">Render DB 快取</div>\r\n                        <div class=\"surface-point\">前端即時讀取</div>\r\n                    </div>\r\n                    <a href=\"#sequence-vault\" class=\"text-link\">查看 Sequence Vault</a>\r\n                </article>\r\n\r\n                <article class=\"surface-card\">\r\n                    <div class=\"surface-head\">\r\n                        <span class=\"runtime-badge runtime-badge-live\">Live API</span>\r\n                        <h3>Knowledge Vault</h3>\r\n                    </div>\r\n                    <p>把 UniProt annotation 與 PubMed 摘要整成 evidence feed，再輸出可直接送進向量資料庫的 RAG 文件片段。</p>\r\n                    <div class=\"surface-points\">\r\n                        <div class=\"surface-point\">Evidence Search</div>\r\n                        <div class=\"surface-point\">Document Chunking</div>\r\n                        <div class=\"surface-point\">Metadata-ready</div>\r\n                    </div>\r\n                    <a href=\"#knowledge-vault\" class=\"text-link\">查看 Knowledge Vault</a>\r\n                </article>\r\n\r\n                <article class=\"surface-card\">\r\n                    <div class=\"surface-head\">\r\n                        <span class=\"runtime-badge runtime-badge-live\">Live API</span>\r\n                        <h3>RAG Documents</h3>\r\n                    </div>\r\n                    <p>把知識庫中的 annotation 與 literature 整理成 chunk 與 metadata，前端可以直接預覽後端輸出的檢索文件格式。</p>\r\n                    <div class=\"surface-points\">\r\n                        <div class=\"surface-point\">Chunk Preview</div>\r\n                        <div class=\"surface-point\">Source Metadata</div>\r\n                        <div class=\"surface-point\">Retrieval-ready</div>\r\n                    </div>\r\n                    <a href=\"#rag-layer\" class=\"text-link\">查看 RAG Documents</a>\r\n                </article>\r\n            </div>\r\n        </section>\r\n\r\n        <section id=\"runtime-status\" class=\"section\">\r\n            <div class=\"section-head\">\r\n                <div>\r\n                    <div class=\"section-label\">Runtime Status</div>\r\n                    <h2 class=\"section-title\">全部 API-backed，即時可驗證</h2>\r\n                    <p class=\"section-sub\">序列同步、知識同步，以及 RAG 文件輸出，每一塊都能對應到真實端點與資料結構。</p>\r\n                </div>\r\n                <div class=\"section-badge badge-live\">真實資料驅動</div>\r\n            </div>\r\n\r\n            <div class=\"runtime-grid\">\r\n                <article class=\"runtime-card\">\r\n                    <div class=\"runtime-top\">\r\n                        <h3>Sequence Vault</h3>\r\n                        <span class=\"runtime-badge runtime-badge-live\">Live API-backed</span>\r\n                    </div>\r\n                    <p>真的會讀 `/healthz`、`/api/sequences/summary`、`/api/sequences`，也能同步與刪除 DB 紀錄。</p>\r\n                </article>\r\n\r\n                <article class=\"runtime-card\">\r\n                    <div class=\"runtime-top\">\r\n                        <h3>Knowledge Vault</h3>\r\n                        <span class=\"runtime-badge runtime-badge-live\">Live API-backed</span>\r\n                    </div>\r\n                    <p>真的會同步知識資料、讀取快取，並向 `/api/rag/documents` 產生 RAG 文件預覽。</p>\r\n                </article>\r\n\r\n                <article class=\"runtime-card\">\r\n                    <div class=\"runtime-top\">\r\n                        <h3>RAG Documents</h3>\r\n                        <span class=\"runtime-badge runtime-badge-live\">Live API-backed</span>\r\n                    </div>\r\n                    <p>會向 `/api/rag/documents` 讀取後端整理好的 chunk 與 metadata，直接預覽檢索文件輸出。</p>\r\n                </article>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"section interface-group\">\r\n            <div class=\"interface-group-card interface-group-card-live\">\r\n                <div>\r\n                    <div class=\"section-label\">Live Modules</div>\r\n                    <h2 class=\"section-title\">三個資料層總覽</h2>\r\n                    <p class=\"section-sub\">\r\n                        Sequence Vault 與 Knowledge Vault 負責建庫，RAG preview 負責把後端文件輸出直接攤在 UI 上檢查。\r\n                    </p>\r\n                </div>\r\n                <div class=\"group-chip-row\">\r\n                    <a href=\"#sequence-vault\" class=\"group-chip group-chip-live\">Sequence Vault</a>\r\n                    <a href=\"#knowledge-vault\" class=\"group-chip group-chip-live\">Knowledge Vault</a>\r\n                    <a href=\"#rag-layer\" class=\"group-chip group-chip-live\">RAG Documents</a>\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        <section id=\"sequence-vault\" class=\"section\">\r\n            <div class=\"section-head\">\r\n                <div>\r\n                    <div class=\"section-label\">Live Interface · Data Cache</div>\r\n                    <h2 class=\"section-title\">Sequence Vault · 序列資料庫快取</h2>\r\n                    <p class=\"section-sub\">\r\n                        這個模組會從 UniProt 與 Ensembl 抓取 protein / gene sequence，寫進 Render PostgreSQL，之後頁面就直接從 DB\r\n                        讀快取，不再只是靜態示範卡片。\r\n                    </p>\r\n                </div>\r\n                <div class=\"section-badge badge-live\">Live API · UniProt + Ensembl + Render Postgres</div>\r\n            </div>\r\n\r\n            <div class=\"sequence-grid\">\r\n                <aside class=\"panel control-panel\">\r\n                    <div>\r\n                        <div class=\"control-title\">同步設定</div>\r\n                        <div class=\"control-sub\">先抓公開資料，再把結果存進 Render DB 給互動介面讀取。</div>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"sequenceProteinQuery\">UniProt protein query</label>\r\n                        <input id=\"sequenceProteinQuery\" type=\"text\" value=\"kinase\"\r\n                               list=\"proteinQueryPresets\"\r\n                               placeholder=\"輸入關鍵字或從下拉選單挑選（可模糊搜尋）\"\r\n                               autocomplete=\"off\">\r\n                        <datalist id=\"proteinQueryPresets\">\r\n                            <option value=\"kinase\">kinase — 激酶（如 EGFR、MAPK）</option>\r\n                            <option value=\"phosphatase\">phosphatase — 磷酸酶</option>\r\n                            <option value=\"protease\">protease — 蛋白酶</option>\r\n                            <option value=\"polymerase\">polymerase — 聚合酶</option>\r\n                            <option value=\"helicase\">helicase — 解旋酶</option>\r\n                            <option value=\"ligase\">ligase — 連接酶</option>\r\n                            <option value=\"transferase\">transferase — 轉移酶</option>\r\n                            <option value=\"oxidoreductase\">oxidoreductase — 氧化還原酶</option>\r\n                            <option value=\"isomerase\">isomerase — 異構酶</option>\r\n                            <option value=\"hydrolase\">hydrolase — 水解酶</option>\r\n                            <option value=\"receptor\">receptor — 受體</option>\r\n                            <option value=\"G protein-coupled receptor\">G protein-coupled receptor — GPCR</option>\r\n                            <option value=\"ion channel\">ion channel — 離子通道</option>\r\n                            <option value=\"transporter\">transporter — 轉運蛋白</option>\r\n                            <option value=\"antibody\">antibody — 抗體</option>\r\n                            <option value=\"immunoglobulin\">immunoglobulin — 免疫球蛋白</option>\r\n                            <option value=\"cytokine\">cytokine — 細胞因子</option>\r\n                            <option value=\"hormone\">hormone — 激素</option>\r\n                            <option value=\"insulin\">insulin — 胰島素</option>\r\n                            <option value=\"hemoglobin\">hemoglobin — 血紅蛋白</option>\r\n                            <option value=\"albumin\">albumin — 白蛋白</option>\r\n                            <option value=\"collagen\">collagen — 膠原蛋白</option>\r\n                            <option value=\"actin\">actin — 肌動蛋白</option>\r\n                            <option value=\"myosin\">myosin — 肌球蛋白</option>\r\n                            <option value=\"tubulin\">tubulin — 微管蛋白</option>\r\n                            <option value=\"histone\">histone — 組蛋白</option>\r\n                            <option value=\"transcription factor\">transcription factor — 轉錄因子</option>\r\n                            <option value=\"tumor suppressor\">tumor suppressor — 腫瘤抑制因子</option>\r\n                            <option value=\"oncogene\">oncogene — 致癌基因產物</option>\r\n                            <option value=\"heat shock protein\">heat shock protein — 熱休克蛋白</option>\r\n                            <option value=\"ubiquitin ligase\">ubiquitin ligase — 泛素連接酶</option>\r\n                            <option value=\"caspase\">caspase — 凋亡蛋白酶</option>\r\n                            <option value=\"CRISPR\">CRISPR — 基因編輯相關蛋白</option>\r\n                            <option value=\"spike glycoprotein\">spike glycoprotein — 病毒刺突蛋白</option>\r\n                            <option value=\"viral capsid\">viral capsid — 病毒衣殼蛋白</option>\r\n                        </datalist>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"sequenceGeneSymbols\">Gene symbols</label>\r\n                        <textarea id=\"sequenceGeneSymbols\" rows=\"3\">TP53, BRCA1, EGFR, APOE</textarea>\r\n                        <div style=\"display:flex;gap:6px;margin-top:6px;align-items:center\">\r\n                            <input id=\"geneSymbolPicker\" type=\"text\"\r\n                                   list=\"geneSymbolPresets\"\r\n                                   placeholder=\"從下拉選單挑選基因加入清單（可模糊搜尋）\"\r\n                                   autocomplete=\"off\"\r\n                                   style=\"flex:1\">\r\n                            <button id=\"geneSymbolAdd\" type=\"button\" class=\"btn btn-secondary\">＋加入</button>\r\n                        </div>\r\n                        <datalist id=\"geneSymbolPresets\">\r\n                            <option value=\"TP53\">TP53 — 腫瘤抑制蛋白 p53</option>\r\n                            <option value=\"BRCA1\">BRCA1 — 乳癌易感基因 1</option>\r\n                            <option value=\"BRCA2\">BRCA2 — 乳癌易感基因 2</option>\r\n                            <option value=\"EGFR\">EGFR — 表皮生長因子受體</option>\r\n                            <option value=\"APOE\">APOE — 載脂蛋白 E</option>\r\n                            <option value=\"KRAS\">KRAS — 致癌基因 KRAS</option>\r\n                            <option value=\"HRAS\">HRAS — 致癌基因 HRAS</option>\r\n                            <option value=\"NRAS\">NRAS — 致癌基因 NRAS</option>\r\n                            <option value=\"MYC\">MYC — 轉錄因子 c-Myc</option>\r\n                            <option value=\"PTEN\">PTEN — 磷酸酶腫瘤抑制因子</option>\r\n                            <option value=\"RB1\">RB1 — 視網膜母細胞瘤基因</option>\r\n                            <option value=\"APC\">APC — 腺瘤性息肉病基因</option>\r\n                            <option value=\"VHL\">VHL — 希佩爾-林道症候群基因</option>\r\n                            <option value=\"MLH1\">MLH1 — DNA 錯配修復</option>\r\n                            <option value=\"MSH2\">MSH2 — DNA 錯配修復</option>\r\n                            <option value=\"BRAF\">BRAF — B-Raf 激酶</option>\r\n                            <option value=\"PIK3CA\">PIK3CA — PI3K 催化亞基</option>\r\n                            <option value=\"AKT1\">AKT1 — 蛋白激酶 B</option>\r\n                            <option value=\"MTOR\">MTOR — 雷帕黴素靶蛋白</option>\r\n                            <option value=\"ALK\">ALK — 間變性淋巴瘤激酶</option>\r\n                            <option value=\"ROS1\">ROS1 — 受體酪氨酸激酶</option>\r\n                            <option value=\"HER2\">HER2 — ERBB2 受體</option>\r\n                            <option value=\"ERBB2\">ERBB2 — HER2 受體</option>\r\n                            <option value=\"VEGFA\">VEGFA — 血管內皮生長因子 A</option>\r\n                            <option value=\"TNF\">TNF — 腫瘤壞死因子</option>\r\n                            <option value=\"IL6\">IL6 — 白細胞介素 6</option>\r\n                            <option value=\"IL2\">IL2 — 白細胞介素 2</option>\r\n                            <option value=\"INS\">INS — 胰島素</option>\r\n                            <option value=\"GCG\">GCG — 胰高血糖素</option>\r\n                            <option value=\"LEP\">LEP — 瘦素</option>\r\n                            <option value=\"ALB\">ALB — 血清白蛋白</option>\r\n                            <option value=\"HBB\">HBB — 血紅蛋白 β 亞基</option>\r\n                            <option value=\"HBA1\">HBA1 — 血紅蛋白 α 亞基 1</option>\r\n                            <option value=\"CFTR\">CFTR — 囊性纖維化跨膜調節因子</option>\r\n                            <option value=\"DMD\">DMD — 杜氏肌營養不良蛋白</option>\r\n                            <option value=\"HTT\">HTT — 亨丁頓蛋白</option>\r\n                            <option value=\"SNCA\">SNCA — α-突觸核蛋白</option>\r\n                            <option value=\"APP\">APP — 澱粉樣前體蛋白</option>\r\n                            <option value=\"MAPT\">MAPT — tau 蛋白</option>\r\n                            <option value=\"PSEN1\">PSEN1 — 早老素 1</option>\r\n                            <option value=\"SOD1\">SOD1 — 超氧化物歧化酶 1</option>\r\n                            <option value=\"ACE2\">ACE2 — 血管緊張素轉換酶 2</option>\r\n                            <option value=\"TMPRSS2\">TMPRSS2 — 跨膜絲氨酸蛋白酶 2</option>\r\n                            <option value=\"CD4\">CD4 — 輔助性 T 細胞標誌</option>\r\n                            <option value=\"CD8A\">CD8A — 細胞毒性 T 細胞標誌</option>\r\n                            <option value=\"PDCD1\">PDCD1 — PD-1 免疫檢查點</option>\r\n                            <option value=\"CD274\">CD274 — PD-L1 免疫檢查點</option>\r\n                            <option value=\"CTLA4\">CTLA4 — 細胞毒性 T 淋巴細胞相關蛋白 4</option>\r\n                            <option value=\"FOXP3\">FOXP3 — 調節性 T 細胞轉錄因子</option>\r\n                            <option value=\"GAPDH\">GAPDH — 甘油醛-3-磷酸脫氫酶（管家基因）</option>\r\n                            <option value=\"ACTB\">ACTB — β-肌動蛋白（管家基因）</option>\r\n                        </datalist>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"sequenceSpecies\">Ensembl species</label>\r\n                        <select id=\"sequenceSpecies\">\r\n                            <option value=\"homo_sapiens\">Homo sapiens</option>\r\n                            <option value=\"mus_musculus\">Mus musculus</option>\r\n                            <option value=\"danio_rerio\">Danio rerio</option>\r\n                        </select>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"sequenceLimit\">每次同步筆數</label>\r\n                        <select id=\"sequenceLimit\">\r\n                            <option value=\"4\">4</option>\r\n                            <option value=\"6\">6</option>\r\n                            <option value=\"8\">8</option>\r\n                        </select>\r\n                    </div>\r\n                    <button id=\"sequenceSync\" class=\"btn btn-primary admin-only\" type=\"button\">同步序列到 DB</button>\r\n                    <button id=\"sequenceReload\" class=\"btn btn-secondary\" type=\"button\">重新讀取 DB 快取</button>\r\n                    <div id=\"sequenceStatus\" class=\"status-banner admin-only\" data-state=\"info\">正在偵測可用 API 並載入序列快取...</div>\r\n                    <div class=\"small-note\">\r\n                        策略是先讀 DB，只有 DB 還是空的，或你手動按同步時，才會重新打公開來源。這樣前端展示會穩定很多。\r\n                    </div>\r\n                    <div class=\"small-note admin-only\">API base: <span id=\"sequenceApiLabel\" class=\"mono\">detecting...</span></div>\r\n                </aside>\r\n\r\n                <div class=\"panel result-panel\">\r\n                    <div class=\"result-top\">\r\n                        <div>\r\n                            <h3>Render Sequence Cache</h3>\r\n                            <p>切換 protein / gene cache，查看最新入庫紀錄與來源 metadata。</p>\r\n                        </div>\r\n                        <div class=\"section-badge\">DB-backed Interactive Feed</div>\r\n                    </div>\r\n\r\n                    <div id=\"sequenceSummary\" class=\"summary-strip\"></div>\r\n\r\n                    <div class=\"sequence-toolbar\">\r\n                        <div class=\"field\">\r\n                            <label for=\"sequenceSearch\">搜尋名稱 / accession / query</label>\r\n                            <input id=\"sequenceSearch\" type=\"text\" placeholder=\"例如 TP53, kinase, P24941\">\r\n                        </div>\r\n                        <div class=\"field\">\r\n                            <label for=\"sequenceOrganismFilter\">物種篩選</label>\r\n                            <select id=\"sequenceOrganismFilter\">\r\n                                <option value=\"\">全部物種</option>\r\n                            </select>\r\n                        </div>\r\n                        <button id=\"sequenceDelete\" class=\"btn btn-danger\" type=\"button\" disabled>刪除選取紀錄</button>\r\n                        <div id=\"sequenceFilterMeta\" class=\"sequence-filter-meta\">顯示 0 筆</div>\r\n                    </div>\r\n\r\n                    <div class=\"sequence-tabs\">\r\n                        <button class=\"sequence-tab active\" type=\"button\" data-sequence-type=\"protein\">Protein Cache\r\n                            <span>0</span></button>\r\n                        <button class=\"sequence-tab\" type=\"button\" data-sequence-type=\"gene\">Gene Cache\r\n                            <span>0</span></button>\r\n                    </div>\r\n\r\n                    <div id=\"sequenceFeed\" class=\"sequence-feed\"></div>\r\n\r\n                    <div class=\"detail-card sequence-detail-shell\">\r\n                        <div class=\"detail-head\">Sequence Detail</div>\r\n                        <div id=\"sequenceDetail\" class=\"sequence-empty\">尚未選取資料列。</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        <section id=\"sequencing-run-vault\" class=\"section\">\r\n            <div class=\"section-head\">\r\n                <div>\r\n                    <div class=\"section-label\">Live Interface · ENA Metadata Cache</div>\r\n                    <h2 class=\"section-title\">Sequencing Run Vault · ENA metadata</h2>\r\n                    <p class=\"section-sub\">\r\n                        這個模組會從 ENA Portal API 抓取 sequencing run metadata，寫進 Render PostgreSQL，之後頁面就能直接查詢 study accession、sample accession、library strategy、instrument model 與 FASTQ metadata。\r\n                    </p>\r\n                </div>\r\n                <div class=\"section-badge badge-live\">Live API · ENA Portal API + Render Postgres</div>\r\n            </div>\r\n\r\n            <div class=\"sequence-grid\">\r\n                <aside class=\"panel control-panel\">\r\n                    <div>\r\n                        <div class=\"control-title\">ENA run 同步設定</div>\r\n                        <div class=\"control-sub\">抓取 sequencing run metadata，寫進 sequencing_run_library 給前端直接檢索與摘要展示。</div>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"sequencingRunQuery\">ENA query</label>\r\n                        <textarea id=\"sequencingRunQuery\" rows=\"4\">tax_name(\"Homo sapiens\") AND library_strategy=\"RNA-Seq\"</textarea>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"sequencingRunLimit\">每次同步筆數</label>\r\n                        <select id=\"sequencingRunLimit\">\r\n                            <option value=\"4\">4</option>\r\n                            <option value=\"6\">6</option>\r\n                            <option value=\"8\">8</option>\r\n                            <option value=\"12\">12</option>\r\n                        </select>\r\n                    </div>\r\n                    <button id=\"sequencingRunSync\" class=\"btn btn-primary admin-only\" type=\"button\">同步 ENA run 到 DB</button>\r\n                    <button id=\"sequencingRunReload\" class=\"btn btn-secondary\" type=\"button\">重新讀取 run 快取</button>\r\n                    <div id=\"sequencingRunStatus\" class=\"status-banner admin-only\" data-state=\"info\">正在讀取 sequencing run metadata 快取...</div>\r\n                    <div class=\"small-note\">\r\n                        這裡適合接 NGS / multi-omics 的 metadata 層。前端先看 study 與 sample 分布，後端再把 record_url 與 ftp_url 串到後續分析流程。\r\n                    </div>\r\n                    <div class=\"small-note admin-only\">API base: <span id=\"sequencingRunApiLabel\" class=\"mono\">detecting...</span></div>\r\n                </aside>\r\n\r\n                <div class=\"panel result-panel\">\r\n                    <div class=\"result-top\">\r\n                        <div>\r\n                            <h3>Sequencing Run Cache</h3>\r\n                            <p>查看 ENA run metadata、library strategy 與 instrument 分布，直接驗證資料有沒有正確落進 DB。</p>\r\n                        </div>\r\n                        <div class=\"section-badge\">Study + Sample + Run Metadata</div>\r\n                    </div>\r\n\r\n                    <div id=\"sequencingRunSummary\" class=\"summary-strip summary-strip-4\"></div>\r\n\r\n                    <div class=\"sequence-toolbar\">\r\n                        <div class=\"field\">\r\n                            <label for=\"sequencingRunSearch\">搜尋 run / study / sample / organism</label>\r\n                            <input id=\"sequencingRunSearch\" type=\"text\" placeholder=\"例如 DRR000897, PRJNA, Homo sapiens\">\r\n                        </div>\r\n                        <div class=\"field\">\r\n                            <label for=\"sequencingRunStrategyFilter\">library strategy</label>\r\n                            <select id=\"sequencingRunStrategyFilter\">\r\n                                <option value=\"\">全部 strategy</option>\r\n                            </select>\r\n                        </div>\r\n                        <div id=\"sequencingRunFilterMeta\" class=\"sequence-filter-meta\">顯示 0 筆</div>\r\n                    </div>\r\n\r\n                    <div id=\"sequencingRunFeed\" class=\"knowledge-feed\"></div>\r\n\r\n                    <div class=\"detail-card knowledge-detail-shell\">\r\n                        <div class=\"detail-head\">Sequencing Run Detail</div>\r\n                        <div id=\"sequencingRunDetail\" class=\"knowledge-empty\">尚未選取 sequencing run 紀錄。</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        <section id=\"knowledge-vault\" class=\"section\">\r\n            <div class=\"section-head\">\r\n                <div>\r\n                    <div class=\"section-label\">Live Interface · Evidence Cache</div>\r\n                    <h2 class=\"section-title\">Knowledge Vault · UniProt + PubMed</h2>\r\n                    <p class=\"section-sub\">\r\n                        這個模組把蛋白質功能註釋和 NCBI 文獻摘要存進 Render PostgreSQL，再整理成 RAG-ready documents。前端可直接搜尋證據，後端可直接輸出 chunk 與\r\n                        metadata 給檢索流程。\r\n                    </p>\r\n                </div>\r\n                <div class=\"section-badge badge-live\">Live API · UniProt + NCBI E-utilities + RAG-ready</div>\r\n            </div>\r\n\r\n            <div class=\"sequence-grid\">\r\n                <aside class=\"panel control-panel\">\r\n                    <div>\r\n                        <div class=\"control-title\">知識同步設定</div>\r\n                        <div class=\"control-sub\">抓取蛋白質註釋與 PubMed 摘要，寫進 knowledge_library，並輸出可分塊 documents。</div>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"knowledgeProteinQuery\">UniProt annotation query</label>\r\n                        <input id=\"knowledgeProteinQuery\" type=\"text\" value=\"kinase\">\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"knowledgeLiteratureQuery\">PubMed literature query</label>\r\n                        <textarea id=\"knowledgeLiteratureQuery\" rows=\"3\">kinase AND cancer</textarea>\r\n                    </div>\r\n                    <div class=\"field\">\r\n                        <label for=\"knowledgeLimit\">每次同步筆數</label>\r\n                        <select id=\"knowledgeLimit\">\r\n                            <option value=\"1\">1</option>\r\n                            <option value=\"2\">2</option>\r\n                            <option value=\"4\">4</option>\r\n                            <option value=\"6\">6</option>\r\n                        </select>\r\n                    </div>\r\n                    <button id=\"knowledgeSync\" class=\"btn btn-primary admin-only\" type=\"button\">同步知識到 DB</button>\r\n                    <button id=\"knowledgeReload\" class=\"btn btn-secondary\" type=\"button\">重新讀取知識庫</button>\r\n                    <button id=\"knowledgeRagRefresh\" class=\"btn btn-secondary admin-only\" type=\"button\">更新 RAG 預覽</button>\r\n                    <div id=\"knowledgeStatus\" class=\"status-banner admin-only\" data-state=\"info\">正在讀取知識庫與 RAG 文件預覽...</div>\r\n                    <div class=\"small-note\">\r\n                        UniProt 比較適合做 protein annotation cache，PubMed 則補文獻語意層。這兩類內容合在一起，會比只有序列更適合做 RAG。\r\n                    </div>\r\n                    <div class=\"small-note admin-only\">API base: <span id=\"knowledgeApiLabel\" class=\"mono\">detecting...</span>\r\n                    </div>\r\n                </aside>\r\n\r\n                <div class=\"panel result-panel\">\r\n                    <div class=\"result-top\">\r\n                        <div>\r\n                            <h3>Knowledge Search Surface</h3>\r\n                            <p>切換 protein annotation / literature，查看 DB 快取與對應的 RAG chunk 預覽。</p>\r\n                        </div>\r\n                        <div class=\"section-badge\">Search + Evidence + Documents</div>\r\n                    </div>\r\n\r\n                    <div id=\"knowledgeSummary\" class=\"summary-strip\"></div>\r\n\r\n                    <div class=\"sequence-toolbar\">\r\n                        <div class=\"field\">\r\n                            <label for=\"knowledgeSearch\">搜尋 title / source / keyword / query</label>\r\n                            <input id=\"knowledgeSearch\" type=\"text\" placeholder=\"例如 kinase, TP53, cancer fusion\">\r\n                        </div>\r\n                        <div class=\"field\">\r\n                            <label for=\"knowledgeSourceFilter\">來源篩選</label>\r\n                            <select id=\"knowledgeSourceFilter\">\r\n                                <option value=\"\">全部來源</option>\r\n                            </select>\r\n                        </div>\r\n                        <div id=\"knowledgeFilterMeta\" class=\"sequence-filter-meta\">顯示 0 筆</div>\r\n                    </div>\r\n\r\n                    <div class=\"sequence-tabs\">\r\n                        <button class=\"sequence-tab knowledge-tab active\" type=\"button\"\r\n                            data-record-type=\"protein_annotation\">Protein Annotation <span>0</span></button>\r\n                        <button class=\"sequence-tab knowledge-tab\" type=\"button\"\r\n                            data-record-type=\"literature\">Literature <span>0</span></button>\r\n                    </div>\r\n\r\n                    <div id=\"knowledgeFeed\" class=\"knowledge-feed\"></div>\r\n\r\n                    <div class=\"detail-grid\">\r\n                        <div class=\"detail-card knowledge-detail-shell\">\r\n                            <div class=\"detail-head\">Knowledge Detail</div>\r\n                            <div id=\"knowledgeDetail\" class=\"knowledge-empty\">尚未選取知識紀錄。</div>\r\n                        </div>\r\n                        <div id=\"rag-layer\" class=\"detail-card knowledge-rag-shell\">\r\n                            <div class=\"detail-head\">RAG-ready Documents</div>\r\n                            <div class=\"detail-copy\">這裡顯示的是後端整理好的 chunk 與 metadata，可直接餵進向量資料庫或檢索流程。</div>\r\n                            <div id=\"knowledgeRagMeta\" class=\"sequence-link-row\" style=\"margin:14px 0\">尚未產生文件預覽。</div>\r\n                            <div id=\"knowledgeRagPreview\" class=\"rag-preview-list\">\r\n                                <div class=\"knowledge-empty\">目前還沒有 RAG 文件預覽。先同步知識資料或按「更新 RAG 預覽」。</div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n\r\n        <section class=\"section cta-band\">\r\n            <div>\r\n                <div class=\"section-label\">Current Scope</div>\r\n                <h2 class=\"section-title\">資料同步、證據檢索與 RAG 輸出</h2>\r\n                <p class=\"section-sub\">三個核心模組完整串接，序列、知識與文件層一起可用。</p>\r\n            </div>\r\n            <div class=\"section-actions\">\r\n                <a href=\"#sequence-vault\" class=\"btn btn-primary\">打開 Sequence Vault</a>\r\n                <a href=\"#sequencing-run-vault\" class=\"btn btn-secondary\">查看 Sequencing Runs</a>\r\n                <a href=\"#knowledge-vault\" class=\"btn btn-secondary\">查看 Knowledge Vault</a>\r\n                <a href=\"#rag-layer\" class=\"btn btn-secondary\">查看 RAG Documents</a>\r\n            </div>\r\n        </section>\r\n    </main>\r\n\r\n    <div data-site-footer></div>\r\n\r\n    <script src=\"scripts/app-config.js\"></script>\r\n    <script src=\"scripts/gene_ai.js\"></script>\r\n\r\n    <button class=\"scroll-top\" aria-label=\"返回頂部\">↑</button>\r\n\r\n    <!-- Chatbot widget -->\r\n    <button id=\"chatbot-toggle\" aria-label=\"AI 助手\">💬</button>\r\n    <div id=\"chatbot-panel\">\r\n        <div class=\"chatbot-header\"><h4>AI 助手</h4><button class=\"chatbot-close\" aria-label=\"關閉\">✕</button></div>\r\n        <div id=\"chatbot-messages\"><div class=\"chat-msg chat-bot\">你好！有什麼關於基因 AI 平台的問題嗎？</div></div>\r\n        <div class=\"chatbot-input-row\">\r\n            <input id=\"chatbot-input\" type=\"text\" placeholder=\"輸入訊息...\" autocomplete=\"off\">\r\n            <button id=\"chatbot-send\">送出</button>\r\n        </div>\r\n    </div>\r\n";
