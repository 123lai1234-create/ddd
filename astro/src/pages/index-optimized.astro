---
import Base from '../layouts/Base.astro';
const bodyHtml = "\n    <!-- ════════ NAV ════════ -->\n    <div data-site-nav></div>\n    \n    <!-- ════════ HERO ════════ -->\n    <section id=\"hero\" style=\"padding:0;max-width:none\">\n        <div class=\"hero-canvas\"></div>\n        <div class=\"grid-bg\"></div>\n        <canvas id=\"hero-sparkle\" aria-hidden=\"true\"></canvas>\n        <div class=\"hero-content\">\n            <div class=\"hero-eyebrow\"><span class=\"live-dot\"></span>Engineer · Biomedical · AI Platforms</div>\n            <h1 class=\"hero-title\">工程、生醫與<br><span class=\"grad\">AI 平台作品集</span></h1>\n            <p class=\"hero-sub\">雙碩士跨域背景，把生醫研究轉成可操作的 AI 系統。</p>\n            <div class=\"hero-tags\">\n                <span class=\"htag\">Python</span>\n                <span class=\"htag\">FastAPI</span>\n                <span class=\"htag htag-green\">Protein AI</span>\n                <span class=\"htag htag-green\">NGS</span>\n                <span class=\"htag htag-purple\">ESM-2</span>\n                <span class=\"htag\">React</span>\n            </div>\n            <div class=\"hero-ctas\">\n                <a href=\"about_me.html\" class=\"btn btn-primary\">認識我</a>\n                <a href=\"works.html\" class=\"btn btn-outline\">作品總覽</a>\n                <a href=\"gene_ai.html\" class=\"btn btn-ghost\">基因 AI 平台 →</a>\n            </div>\n            <div class=\"hero-stats\">\n                <div class=\"hero-stat\">\n                    <div class=\"val\">雙碩士</div>\n                    <div class=\"lbl\">電資 × 生醫</div>\n                </div>\n                <div class=\"hero-stat\">\n                    <div class=\"val\">3 AI 平台</div>\n                    <div class=\"lbl\">Protein · Gene · NGS</div>\n                </div>\n                <div class=\"hero-stat\">\n                    <div class=\"val\">全端輸出</div>\n                    <div class=\"lbl\">研究 → 介面 → 系統</div>\n                </div>\n            </div>\n        </div>\n        <div class=\"scroll-hint\"><span>向下滑動</span>\n            <div class=\"scroll-arrow\"></div>\n        </div>\n    </section>\n    \n    <hr class=\"divider\">\n    \n    <!-- ════════ CREATOR ════════ -->\n    <section id=\"creator\">\n        <div class=\"reveal\">\n            <div class=\"section-label\">關於我</div>\n            <h2 class=\"section-title\">工程與生醫的跨域能力線</h2>\n            <p class=\"section-sub\">電資工程與生物醫學的雙碩士訓練，加上研究與產品實作的第一線經驗，讓這裡展示的每個作品都有真實意義的背景支撐。</p>\n        </div>\n        <div class=\"metrics-grid reveal\">\n            <div class=\"metric-card\">\n                <div class=\"mval\">雙碩士</div>\n                <div class=\"mlabel\">電資 × 生醫跨域背景</div>\n                <div class=\"mdetail\">同時具備工程設計與生物醫學研究的訓練，站在研究與產品交界上進行有深度的跨域設計。</div>\n            </div>\n            <div class=\"metric-card\">\n                <div class=\"mval\">2020–Now</div>\n                <div class=\"mlabel\">前後端介面與應用開發</div>\n                <div class=\"mdetail\">持續投入網站、應用程式與互動介面開發，能把研究模型轉成可操作的平台。</div>\n            </div>\n            <div class=\"metric-card\">\n                <div class=\"mval\">AI/ML</div>\n                <div class=\"mlabel\">深度學習與生物資訊</div>\n                <div class=\"mdetail\">從蛋白質序列設計、基因組分析到機器學習模型優化，涵蓋生物計算的多個層面。</div>\n            </div>\n        </div>\n    </section>\n    \n    <!-- ════════ FEATURED WORKS ════════ -->\n    <section id=\"featured\">\n        <div class=\"reveal\">\n            <div class=\"section-label\">作品展示</div>\n            <h2 class=\"section-title\">核心 AI 平台與研究</h2>\n        </div>\n        <div class=\"works-grid reveal\">\n            <a href=\"gene_ai.html\" class=\"work-card\">\n                <h3>基因 AI 分析平台</h3>\n                <p>序列資料庫、RAG 文件搜尋、啟動子設計、CRISPR 導引排序、變異效應評估一站整合。</p>\n                <span class=\"arrow\">→</span>\n            </a>\n            <a href=\"protein_mpnn.html\" class=\"work-card\">\n                <h3>蛋白質 AI 設計系統</h3>\n                <p>端到端 Pipeline：ESM-2 嵌入、Bayesian Optimization、ProteinMPNN 序列設計、REINFORCE RL 微調。</p>\n                <span class=\"arrow\">→</span>\n            </a>\n            <a href=\"ngs.html\" class=\"work-card\">\n                <h3>NGS 次世代定序工作站</h3>\n                <p>實驗設計計算器、定序深度估算、QC 到功能分析的完整結果圖表集。</p>\n                <span class=\"arrow\">→</span>\n            </a>\n        </div>\n    </section>\n    \n    <!-- ════════ ESM SIMILARITY CALCULATOR ════════ -->\n    <section id=\"esm-calc\">\n        <div class=\"reveal\">\n            <div class=\"section-label\">互動工具</div>\n            <h2 class=\"section-title\">ESM-2 蛋白質相似度計算</h2>\n            <p class=\"section-sub\">輸入兩個蛋白質序列，使用 ESM-2 模型計算其相似度。</p>\n        </div>\n        <div class=\"esm-container reveal\">\n            <input id=\"esm-seq-a\" placeholder=\"MKTIIALSYIFCLVFA\" type=\"text\">\n            <input id=\"esm-seq-b\" placeholder=\"MKTIIALSYIFCLVFAFF\" type=\"text\">\n            <button id=\"esm-run-btn\">計算相似度</button>\n            <div id=\"esm-result\" style=\"display:none; margin-top: 1rem; padding: 1rem; background: rgba(88, 215, 255, 0.1); border-radius: 8px;\">\n                <p id=\"esm-result-text\"></p>\n            </div>\n        </div>\n    </section>\n    \n    <!-- ════════ CTA ════════ -->\n    <section id=\"cta\" class=\"reveal\">\n        <h2>準備好了解更多？</h2>\n        <p>探索完整的作品集與技術細節。</p>\n        <a href=\"works.html\" class=\"btn btn-primary\">查看所有作品</a>\n        <a href=\"about_me.html\" class=\"btn btn-outline\">了解背景</a>\n    </section>\n    \n    <!-- Footer -->\n    <footer>\n        <p>&copy; 2026 JT Lai. All rights reserved.</p>\n        <p>Built with ❤️ using HTML, CSS, JavaScript & AI.</p>\n    </footer>\n";
const headInline = "<script is:inline>if ('serviceWorker' in navigator) {\n            navigator.serviceWorker.register('/sw.js').catch(() => {});\n        }</script>\n<script is:inline>{\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Person\",\n      \"name\": \"JT Lai\",\n      \"url\": \"https://donttalk.vercel.app/\",\n      \"image\": \"https://donttalk.vercel.app/og-image.svg\",\n      \"description\": \"工程與生醫雙碩士背景，整合蛋白質 AI 設計、基因分析、NGS 流程與互動平台開發的全端跨域作品集。\",\n      \"sameAs\": [\n        \"https://github.com/onlyforwork2026\"\n      ],\n      \"knowsAbout\": [\"Protein Design\", \"Gene Analysis\", \"NGS\", \"AI/ML\", \"Python\", \"FastAPI\", \"React\"],\n      \"jobTitle\": \"AI Research Engineer\"\n    }</script>";
---
<Base
    title="工程 × 生醫 × AI 平台作品集 | JT Lai"
    description="工程與生醫雙碩士背景，整合蛋白質 AI 設計、基因分析、NGS 流程與互動平台開發的全端跨域作品集。"
    bodyPage="index"
    pageStyles={["/styles/shared.css","/styles/polish.css","/styles/dynamic.css","/styles/loading-indicator.css","/styles/index.css","/styles/index-live.css","/styles/index-content.css"]}
    pageScripts={[]}
    headInline={headInline}
>
    <Fragment set:html={bodyHtml} />
</Base>
