---
import Base from '../layouts/Base.astro';
const bodyHtml = "\r\n    <!-- ════════ NAV ════════ -->\r\n    <div data-site-nav></div>\r\n    \r\n    <!-- ════════ HERO ════════ -->\r\n    <section id=\"hero\" style=\"padding:0;max-width:none\">\r\n        <div class=\"hero-canvas\"></div>\r\n        <div class=\"grid-bg\"></div>\r\n        <canvas id=\"hero-sparkle\" aria-hidden=\"true\"></canvas>\r\n        <div class=\"hero-content\">\r\n            <div class=\"hero-eyebrow\"><span class=\"live-dot\"></span>Engineer · Biomedical · AI Platforms</div>\r\n            <h1 class=\"hero-title\">工程、生醫與<br><span class=\"grad\">AI 平台作品集</span></h1>\r\n            <p class=\"hero-sub\">雙碩士跨域背景，把生醫研究轉成可操作的 AI 系統。</p>\r\n            <div class=\"hero-tags\">\r\n                <span class=\"htag\">Python</span>\r\n                <span class=\"htag\">FastAPI</span>\r\n                <span class=\"htag htag-green\">Protein AI</span>\r\n                <span class=\"htag htag-green\">NGS</span>\r\n                <span class=\"htag htag-purple\">ESM-2</span>\r\n                <span class=\"htag\">React</span>\r\n            </div>\r\n            <div class=\"hero-ctas\">\r\n                <a href=\"about_me.html\" class=\"btn btn-primary\">認識我</a>\r\n                <a href=\"works.html\" class=\"btn btn-outline\">作品總覽</a>\r\n                <a href=\"gene_ai.html\" class=\"btn btn-ghost\">基因 AI 平台 →</a>\r\n            </div>\r\n            <div class=\"hero-stats\">\r\n                <div class=\"hero-stat\">\r\n                    <div class=\"val\">雙碩士</div>\r\n                    <div class=\"lbl\">電資 × 生醫</div>\r\n                </div>\r\n                <div class=\"hero-stat\">\r\n                    <div class=\"val\">3 AI 平台</div>\r\n                    <div class=\"lbl\">Protein · Gene · NGS</div>\r\n                </div>\r\n                <div class=\"hero-stat\">\r\n                    <div class=\"val\">全端輸出</div>\r\n                    <div class=\"lbl\">研究 → 介面 → 系統</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"scroll-hint\"><span>向下滑動</span>\r\n            <div class=\"scroll-arrow\"></div>\r\n        </div>\r\n    </section>\r\n    \r\n    <hr class=\"divider\">\r\n    \r\n    <!-- ════════ CREATOR ════════ -->\r\n    <section id=\"creator\">\r\n        <div class=\"reveal\">\r\n            <div class=\"section-label\">關於我</div>\r\n            <h2 class=\"section-title\">工程與生醫的跨域能力線</h2>\r\n            <p class=\"section-sub\">電資工程與生物醫學的雙碩士訓練，加上研究與產品實作的第一線經驗，讓這裡展示的每個作品都有真實意義的背景支撐。</p>\r\n        </div>\r\n        <div class=\"metrics-grid reveal\">\r\n            <div class=\"metric-card\">\r\n                <div class=\"mval\">雙碩士</div>\r\n                <div class=\"mlabel\">電資 × 生醫跨域背景</div>\r\n                <div class=\"mdetail\">同時具備工程設計與生物醫學研究的訓練，站在研究與產品交界上進行有深度的跨域設計。</div>\r\n            </div>\r\n            <div class=\"metric-card\">\r\n                <div class=\"mval\">2020–Now</div>\r\n                <div class=\"mlabel\">前後端介面與應用開發</div>\r\n                <div class=\"mdetail\">持續投入網站、應用程式與互動介面開發，能把研究模型轉成可操作的平台。</div>\r\n            </div>\r\n            <div class=\"metric-card\">\r\n                <div class=\"mval\">AI/ML</div>\r\n                <div class=\"mlabel\">深度學習與生物資訊</div>\r\n                <div class=\"mdetail\">從蛋白質序列設計、基因組分析到機器學習模型優化，涵蓋生物計算的多個層面。</div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n    \r\n    <!-- ════════ FEATURED WORKS ════════ -->\r\n    <section id=\"featured\">\r\n        <div class=\"reveal\">\r\n            <div class=\"section-label\">作品展示</div>\r\n            <h2 class=\"section-title\">核心 AI 平台與研究</h2>\r\n        </div>\r\n        <div class=\"works-grid reveal\">\r\n            <a href=\"gene_ai.html\" class=\"work-card\">\r\n                <h3>基因 AI 分析平台</h3>\r\n                <p>序列資料庫、RAG 文件搜尋、啟動子設計、CRISPR 導引排序、變異效應評估一站整合。</p>\r\n                <span class=\"arrow\">→</span>\r\n            </a>\r\n            <a href=\"protein_mpnn.html\" class=\"work-card\">\r\n                <h3>蛋白質 AI 設計系統</h3>\r\n                <p>端到端 Pipeline：ESM-2 嵌入、Bayesian Optimization、ProteinMPNN 序列設計、REINFORCE RL 微調。</p>\r\n                <span class=\"arrow\">→</span>\r\n            </a>\r\n            <a href=\"ngs.html\" class=\"work-card\">\r\n                <h3>NGS 次世代定序工作站</h3>\r\n                <p>實驗設計計算器、定序深度估算、QC 到功能分析的完整結果圖表集。</p>\r\n                <span class=\"arrow\">→</span>\r\n            </a>\r\n        </div>\r\n    </section>\r\n    \r\n    <!-- ════════ ESM SIMILARITY CALCULATOR ════════ -->\r\n    <section id=\"esm-calc\">\r\n        <div class=\"reveal\">\r\n            <div class=\"section-label\">互動工具</div>\r\n            <h2 class=\"section-title\">ESM-2 蛋白質相似度計算</h2>\r\n            <p class=\"section-sub\">輸入兩個蛋白質序列，使用 ESM-2 模型計算其相似度。</p>\r\n        </div>\r\n        <div class=\"esm-container reveal\">\r\n            <input id=\"esm-seq-a\" placeholder=\"MKTIIALSYIFCLVFA\" type=\"text\">\r\n            <input id=\"esm-seq-b\" placeholder=\"MKTIIALSYIFCLVFAFF\" type=\"text\">\r\n            <button id=\"esm-run-btn\">計算相似度</button>\r\n            <div id=\"esm-result\" style=\"display:none; margin-top: 1rem; padding: 1rem; background: rgba(88, 215, 255, 0.1); border-radius: 8px;\">\r\n                <p id=\"esm-result-text\"></p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n    \r\n    <!-- ════════ CTA ════════ -->\r\n    <section id=\"cta\" class=\"reveal\">\r\n        <h2>準備好了解更多？</h2>\r\n        <p>探索完整的作品集與技術細節。</p>\r\n        <a href=\"works.html\" class=\"btn btn-primary\">查看所有作品</a>\r\n        <a href=\"about_me.html\" class=\"btn btn-outline\">了解背景</a>\r\n    </section>\r\n    \r\n    <!-- Footer -->\r\n    <footer>\r\n        <p>&copy; 2026 JT Lai. All rights reserved.</p>\r\n        <p>Built with ❤️ using HTML, CSS, JavaScript & AI.</p>\r\n    </footer>\r\n";
const headInline = "<script is:inline>if ('serviceWorker' in navigator) {\r\n            navigator.serviceWorker.register('/sw.js').catch(() => {});\r\n        }</script>\n<script is:inline>{\r\n      \"@context\": \"https://schema.org\",\r\n      \"@type\": \"Person\",\r\n      \"name\": \"JT Lai\",\r\n      \"url\": \"https://donttalk.vercel.app/\",\r\n      \"image\": \"https://donttalk.vercel.app/og-image.svg\",\r\n      \"description\": \"工程與生醫雙碩士背景，整合蛋白質 AI 設計、基因分析、NGS 流程與互動平台開發的全端跨域作品集。\",\r\n      \"sameAs\": [\r\n        \"https://github.com/onlyforwork2026\"\r\n      ],\r\n      \"knowsAbout\": [\"Protein Design\", \"Gene Analysis\", \"NGS\", \"AI/ML\", \"Python\", \"FastAPI\", \"React\"],\r\n      \"jobTitle\": \"AI Research Engineer\"\r\n    }</script>";
---
<Base
    title="工程 × 生醫 × AI 平台作品集 | JT Lai"
    description="工程與生醫雙碩士背景，整合蛋白質 AI 設計、基因分析、NGS 流程與互動平台開發的全端跨域作品集。"
    bodyPage="index"
    pageStyles={["/styles/shared.css","/styles/polish.css","/styles/dynamic.css","/styles/loading-indicator.css","/styles/index.css","/styles/index-live.css","/styles/index-content.css"]}
    pageScripts={[]}
    headInline={headInline}
>
    <Fragment set:html={bodyHtml} />
</Base>
