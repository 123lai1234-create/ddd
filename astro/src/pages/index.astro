        function findLocalReply(q) {
            const lower = q.toLowerCase();
            for (const item of KB) {
                if (item.keys.some((k) => lower.includes(k.toLowerCase()))) {
                    return item.reply;
                }
            }
            return null;
        }

        let history = [];
        let busy = false;

        const toggle = document.getElementById('chatbot-toggle');
        const panel  = document.getElementById('chatbot-panel');
        const close  = document.querySelector('.chatbot-close');
        const reset  = document.querySelector('.chatbot-reset');
        const msgs   = document.getElementById('chatbot-messages');
        const input  = document.getElementById('chatbot-input');
        const send   = document.getElementById('chatbot-send');
        const chips  = document.querySelectorAll('.chat-chip');

        toggle.addEventListener('click', () => {
            panel.classList.toggle('open');
            if (panel.classList.contains('open')) setTimeout(() => input.focus(), 200);
        });
        close.addEventListener('click', () => panel.classList.remove('open'));
        reset?.addEventListener('click', () => {
            history = [];
            msgs.innerHTML = '';
            addMsg('bot', '對話已重置。問我任何問題吧！');
            showChips();
        });
        send.addEventListener('click', submit);
        input.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(); }
        });

        // Quick-suggestion chips
        chips.forEach((c) => {
            c.addEventListener('click', () => {
                input.value = c.dataset.q;
                submit();
            });
        });

        async function submit() {
            const text = input.value.trim();
            if (!text || busy) return;
            input.value = '';
            addMsg('user', text);
            history.push({ role: 'user', content: text });
            hideChips();
            setBusy(true);

            // Try backend /api/chat proxy first (supports multiple API base candidates)
            let reply = null;
            try {
                const apiBase = (typeof window.APP_CONFIG_UTILS?.resolveApiBase === 'function')
                    ? await window.APP_CONFIG_UTILS.resolveApiBase({ cacheKey: 'chatbot' })
                    : '';
                const endpoint = apiBase ? `${apiBase}/api/chat` : '/api/chat';
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        system: SYSTEM,
                        messages: history.slice(-10),
                    }),
                    signal: AbortSignal.timeout(20000),
                });
                if (res.ok) {
                    const data = await res.json();
                    reply = data.reply ?? data.content?.[0]?.text ?? null;
                    if (reply) history.push({ role: 'assistant', content: reply });
                }
            } catch (_) { /* fall through to local KB */ }

            // Fallback: local knowledge base
            if (!reply) {
                const local = findLocalReply(text);
                if (local) {
                    reply = local + '\n\n_(本機離線回覆，AI 模型目前未連線)_';
                } else {
                    reply = `目前 AI 模型暫時無法連線，也沒有對應到本機知識庫。\n\n你問的「${text}」可以試著換個關鍵字（例如：背景、技術、作品、聯絡）。`;
                }
            }

            addMsg('bot', reply, true);
            setBusy(false);
        }

        function hideChips() {
            const wrap = document.getElementById('chat-suggestions');
            if (wrap) wrap.style.display = 'none';
        }

        function showChips() {
            const wrap = document.getElementById('chat-suggestions');
            if (wrap) wrap.style.display = '';
        }

        function addMsg(role, text, allowMarkdown = false) {
            const d = document.createElement('div');
            d.className = `chat-msg chat-${role}`;
            if (allowMarkdown) {
                d.innerHTML = escapeHtml(text)
                    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
                    .replace(/\n/g, '<br/>');
            } else {
                d.textContent = text;
            }
            msgs.appendChild(d);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function escapeHtml(s) {
            return String(s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function setBusy(v) {
            busy = v; send.disabled = v; input.disabled = v;
            document.getElementById('chat-typing')?.remove();
            if (v) {
                const t = document.createElement('div');
                t.id = 'chat-typing';
                t.className = 'chat-msg chat-bot chat-typing';
                t.innerHTML = '<span></span><span></span><span></span>';
                msgs.appendChild(t);
                msgs.scrollTop = msgs.scrollHeight;
            }
        }

        // ESC closes panel
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && panel.classList.contains('open')) {
                panel.classList.remove('open');
            }
        });
    })();
    </script>
