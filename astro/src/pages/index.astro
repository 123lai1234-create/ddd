---
import Base from '../layouts/Base.astro';

/**
 * 不說樂園 — App 入口網站
 * 8 個遊樂設施，每個對應一個 app
 */
const rides = [
    {
        id: 'ferris',
        name: '股票摩天輪',
        tag: 'Stock',
        url: '/stock',
        color: '#e07a5f',
        softColor: '#f4a261',
        sub: 'K 線 · 訊號 · 自選股',
    },
    {
        id: 'balloon',
        name: '音樂熱氣球',
        tag: 'Music',
        url: '/music',
        color: '#81b29a',
        softColor: '#a8dadc',
        sub: 'LRC · 播放清單',
    },
    {
        id: 'carousel',
        name: '部落格旋轉木馬',
        tag: 'Blog',
        url: '/blog',
        color: '#d4a5a5',
        softColor: '#f1a7c0',
        sub: '技術筆記 · 研究',
    },
    {
        id: 'coaster',
        name: '蛋白質雲霄飛車',
        tag: 'Protein AI',
        url: '/protein-mpnn',
        color: '#c44536',
        softColor: '#e76f51',
        sub: 'ESM-2 · MPNN',
    },
    {
        id: 'tower',
        name: '面試鐘塔',
        tag: 'Interview',
        url: '/interview',
        color: '#5b8ca8',
        softColor: '#a3b5d9',
        sub: '六週衝刺 · Q&A',
    },
    {
        id: 'castle',
        name: '基因城堡',
        tag: 'Gene AI',
        url: '/gene-ai',
        color: '#8b6f9c',
        softColor: '#b58ecc',
        sub: '序列 · RAG · 變異',
    },
    {
        id: 'lab',
        name: 'NGS 實驗小屋',
        tag: 'NGS',
        url: '/ngs',
        color: '#6a8c4f',
        softColor: '#7fb069',
        sub: '定序 · QC · 圖表',
    },
    {
        id: 'game',
        name: '互動遊戲攤',
        tag: 'Interactive',
        url: '/interactive-showcase',
        color: '#c89b3c',
        softColor: '#f9c74f',
        sub: '展示 · 試玩',
    },
];

// Daily pick: 一年中的第幾天 % 8 = 今日推薦
const now = new Date();
const yearStart = new Date(now.getFullYear(), 0, 0);
const dayOfYear = Math.floor((now.getTime() - yearStart.getTime()) / 86400000);
const pickIndex = dayOfYear % rides.length;
---

<Base
    title="不說樂園 — App 入口"
    description="不說的 8 個 app 入口：股票、音樂、部落格、Protein AI、Gene AI、NGS、面試準備、互動展示一站直達。"
    ogTag="App Portal"
    bodyPage="index"
    schemaType="WebPage"
>
    <div data-site-nav></div>

    <main class="minion-park">
        <!-- Decorative dots layer -->
        <div class="paper-dots" aria-hidden="true"></div>

        <!-- Header -->
        <header class="park-header">
            <div class="park-titles">
                <p class="park-eyebrow">MINION SYSTEM</p>
                <h1 class="park-title">不說樂園</h1>
                <p class="park-subtitle">BuShuo Park · App 入口網站</p>
            </div>
            <div class="park-greeting-block">
                <p class="park-greeting" data-park-greeting>早安，今天想先去哪一區？</p>
                <p class="park-motto">先完成，再完美；先出發，再調整。</p>
            </div>
            <div class="park-date-block">
                <span class="park-day" data-park-day>WED</span>
                <span class="park-dot">·</span>
                <span class="park-date-num" data-park-date>10.07</span>
            </div>
        </header>

        <!-- Theme Park Map -->
        <section class="park-map" aria-label="8 個 app 入口設施">
            <div class="park-sky">
                <div class="park-sun" aria-hidden="true">
                    <svg viewBox="0 0 60 60" width="60" height="60">
                        <g class="sun-spin">
                            {Array.from({ length: 8 }).map((_, k) => {
                                const a = (k * Math.PI) / 4;
                                const x1 = 30 + 12 * Math.cos(a);
                                const y1 = 30 + 12 * Math.sin(a);
                                const x2 = 30 + 22 * Math.cos(a);
                                const y2 = 30 + 22 * Math.sin(a);
                                return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#c44536" stroke-width="2" stroke-linecap="round" />;
                            })}
                        </g>
                        <circle cx="30" cy="30" r="10" fill="#f9c74f" stroke="#c44536" stroke-width="2" />
                    </svg>
                </div>
                <div class="cloud cloud-1" aria-hidden="true"></div>
                <div class="cloud cloud-2" aria-hidden="true"></div>
                <div class="cloud cloud-3" aria-hidden="true"></div>
            </div>

            {/* Park decoration: trees */}
            <div class="park-tree park-tree-left" aria-hidden="true">
                <svg viewBox="0 0 40 80" width="40" height="80">
                    <rect x="17" y="50" width="6" height="28" fill="#8b5a3c" stroke="#3a2f2a" stroke-width="1.4" />
                    <path d="M 20 10 Q 6 30 8 50 Q 14 56 20 50 Q 26 56 32 50 Q 34 30 20 10 Z"
                          fill="#6a8c4f" stroke="#3a2f2a" stroke-width="1.4" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="park-tree park-tree-right" aria-hidden="true">
                <svg viewBox="0 0 40 80" width="40" height="80">
                    <rect x="17" y="50" width="6" height="28" fill="#8b5a3c" stroke="#3a2f2a" stroke-width="1.4" />
                    <path d="M 20 10 Q 6 30 8 50 Q 14 56 20 50 Q 26 56 32 50 Q 34 30 20 10 Z"
                          fill="#6a8c4f" stroke="#3a2f2a" stroke-width="1.4" stroke-linejoin="round" />
                </svg>
            </div>

            <div class="park-rides">
                {rides.map((ride, i) => (
                    <a
                        href={ride.url}
                        class={`ride ride-${ride.id}${i === pickIndex ? ' ride-pick' : ''}`}
                        style={`--ride-color:${ride.color};--ride-soft:${ride.softColor};--ride-i:${i};`}
                        data-ride-id={ride.id}
                        data-pick={i === pickIndex ? 'true' : 'false'}
                        aria-label={`${ride.name} — ${ride.tag}。${i === pickIndex ? '今日推薦。' : ''} ${ride.sub}`}
                    >
                        <span class="ride-facility-tag">設施</span>
                        <div class="ride-art" aria-hidden="true">
                            {ride.id === 'ferris' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    {/* base ground */}
                                    <line x1="20" y1="135" x2="100" y2="135" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    {/* A-frame support legs */}
                                    <line x1="40" y1="135" x2="60" y2="55" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    <line x1="80" y1="135" x2="60" y2="55" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    {/* cross brace */}
                                    <line x1="48" y1="105" x2="72" y2="105" stroke="currentColor" stroke-width="0.8" />
                                    {/* central post (visible behind the wheel) */}
                                    <line x1="60" y1="55" x2="60" y2="135" stroke="currentColor" stroke-width="1.4" />
                                    {/* wheel — rotating */}
                                    <g class="ferris-spin" style="transform-origin: 60px 60px;">
                                        {/* outer rim */}
                                        <circle cx="60" cy="60" r="32" fill="none" stroke="currentColor" stroke-width="2" />
                                        <circle cx="60" cy="60" r="30" fill="none" stroke="currentColor" stroke-width="0.6" />
                                        {/* hub */}
                                        <circle cx="60" cy="60" r="3.5" fill="currentColor" />
                                        {/* 6 spokes */}
                                        <line x1="60" y1="28" x2="60" y2="92" stroke="currentColor" stroke-width="1" />
                                        <line x1="28" y1="60" x2="92" y2="60" stroke="currentColor" stroke-width="1" />
                                        <line x1="38" y1="38" x2="82" y2="82" stroke="currentColor" stroke-width="1" />
                                        <line x1="38" y1="82" x2="82" y2="38" stroke="currentColor" stroke-width="1" />
                                        {/* 6 cabins on the outside of the rim (12, 2, 4, 6, 8, 10 o'clock) */}
                                        {Array.from({ length: 6 }).map((_, k) => {
                                            const a = (k * Math.PI) / 3 - Math.PI / 2;
                                            const cx = 60 + 38 * Math.cos(a);
                                            const cy = 60 + 38 * Math.sin(a);
                                            return <rect x={cx - 5} y={cy - 5} width="10" height="10" fill={ride.softColor} stroke="currentColor" stroke-width="1.2" rx="1.5" />;
                                        })}
                                    </g>
                                </svg>
                            )}
                            {ride.id === 'balloon' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    <line x1="60" y1="2" x2="60" y2="14" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2" />
                                    <g class="balloon-float">
                                        <path d="M 40 60 Q 30 30 60 20 Q 90 30 80 60 Q 75 80 60 80 Q 45 80 40 60 Z"
                                              fill={ride.softColor} stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                        <line x1="60" y1="20" x2="60" y2="80" stroke="currentColor" stroke-width="0.8" />
                                        <path d="M 45 32 Q 60 24 75 32" fill="none" stroke="currentColor" stroke-width="0.8" />
                                        <path d="M 42 46 Q 60 38 78 46" fill="none" stroke="currentColor" stroke-width="0.8" />
                                        <path d="M 44 60 Q 60 54 76 60" fill="none" stroke="currentColor" stroke-width="0.8" />
                                        <line x1="55" y1="80" x2="52" y2="100" stroke="currentColor" stroke-width="1" />
                                        <line x1="65" y1="80" x2="68" y2="100" stroke="currentColor" stroke-width="1" />
                                        <rect x="50" y="100" width="20" height="14" fill="none" stroke="currentColor" stroke-width="1.4" rx="1" />
                                        <line x1="50" y1="106" x2="70" y2="106" stroke="currentColor" stroke-width="0.8" />
                                    </g>
                                </svg>
                            )}
                            {ride.id === 'carousel' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    {/* ground */}
                                    <line x1="14" y1="130" x2="106" y2="130" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                                    {/* static support frame (does NOT rotate) */}
                                    <line x1="22" y1="130" x2="22" y2="116" stroke="currentColor" stroke-width="1.4" />
                                    <line x1="98" y1="130" x2="98" y2="116" stroke="currentColor" stroke-width="1.4" />
                                    <line x1="14" y1="116" x2="106" y2="116" stroke="currentColor" stroke-width="1.4" />
                                    {/* base platform (static) */}
                                    <ellipse cx="60" cy="116" rx="38" ry="4" fill={ride.softColor} stroke="currentColor" stroke-width="1.4" />
                                    {/* central pole (static) */}
                                    <line x1="60" y1="38" x2="60" y2="116" stroke="currentColor" stroke-width="1.6" />
                                    {/* canopy (static — conical, looks the same from any angle) */}
                                    <path d="M 22 58 Q 60 24 98 58 Z" fill={ride.color} stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                    <path d="M 22 58 Q 60 70 98 58" fill="none" stroke="currentColor" stroke-width="1.2" />
                                    {/* flag (static position, wave in place) */}
                                    <line x1="60" y1="24" x2="60" y2="14" stroke="currentColor" stroke-width="1.4" />
                                    <g class="carousel-flag" style="transform-origin: 60px 16px;">
                                        <path d="M 60 14 L 72 16 L 60 19 Z" fill={ride.softColor} stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                                    </g>
                                    {/* horse 1 - left (bobs up and down) */}
                                    <g class="carousel-horse carousel-horse-1">
                                        <line x1="38" y1="58" x2="38" y2="78" stroke="currentColor" stroke-width="1.2" />
                                        <path d="M 28 92 L 28 84 Q 28 78 34 78 L 42 78 Q 48 78 48 84 L 48 92 L 44 92 L 44 86 L 38 86 L 38 92 L 34 92 L 34 86 L 28 86 Z M 48 81 L 52 78 L 48 78 Z" fill={ride.softColor} stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                                    </g>
                                    {/* horse 2 - center (bobs with offset phase) */}
                                    <g class="carousel-horse carousel-horse-2">
                                        <line x1="60" y1="58" x2="60" y2="78" stroke="currentColor" stroke-width="1.2" />
                                        <path d="M 50 92 L 50 84 Q 50 78 56 78 L 64 78 Q 70 78 70 84 L 70 92 L 66 92 L 66 86 L 60 86 L 60 92 L 56 92 L 56 86 L 50 86 Z M 70 81 L 74 78 L 70 78 Z" fill={ride.softColor} stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                                    </g>
                                    {/* horse 3 - right (bobs with another offset) */}
                                    <g class="carousel-horse carousel-horse-3">
                                        <line x1="82" y1="58" x2="82" y2="78" stroke="currentColor" stroke-width="1.2" />
                                        <path d="M 72 92 L 72 84 Q 72 78 78 78 L 86 78 Q 92 78 92 84 L 92 92 L 88 92 L 88 86 L 82 86 L 82 92 L 78 92 L 78 86 L 72 86 Z M 92 81 L 96 78 L 92 78 Z" fill={ride.softColor} stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                                    </g>
                                </svg>
                            )}
                            {ride.id === 'coaster' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    {/* ground */}
                                    <line x1="10" y1="135" x2="110" y2="135" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                    {/* support pillars (2 trestles, simple) */}
                                    <line x1="30" y1="135" x2="30" y2="100" stroke="currentColor" stroke-width="1.2" />
                                    <line x1="22" y1="100" x2="38" y2="100" stroke="currentColor" stroke-width="1.2" />
                                    <line x1="90" y1="135" x2="90" y2="100" stroke="currentColor" stroke-width="1.2" />
                                    <line x1="82" y1="100" x2="98" y2="100" stroke="currentColor" stroke-width="1.2" />
                                    {/* main track - clear hill shape */}
                                    <path d="M 10 130 L 30 100 L 60 50 L 90 100 L 110 130" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
                                    {/* car — drawn at origin, animated to follow the track */}
                                    <g class="coaster-car">
                                        {/* main body */}
                                        <rect x="-10" y="-4" width="20" height="9" rx="2" fill={ride.softColor} stroke="currentColor" stroke-width="1.6" />
                                        {/* window strip */}
                                        <rect x="-7" y="-2" width="14" height="4" rx="0.8" fill={ride.color} stroke="currentColor" stroke-width="0.8" />
                                        {/* two small passengers (head silhouettes) */}
                                        <circle cx="-3" cy="-0.5" r="1.2" fill="#faf6ec" />
                                        <circle cx="3" cy="-0.5" r="1.2" fill="#faf6ec" />
                                        {/* wheels (clearly visible under the body) */}
                                        <circle cx="-6" cy="5" r="2.2" fill="#faf6ec" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="6" cy="5" r="2.2" fill="#faf6ec" stroke="currentColor" stroke-width="1.2" />
                                    </g>
                                </svg>
                            )}
                            {ride.id === 'tower' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    <line x1="20" y1="135" x2="100" y2="135" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                    <path d="M 50 135 L 50 30 L 70 30 L 70 135 Z" fill={ride.softColor} stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <path d="M 46 30 L 60 12 L 74 30 Z" fill={ride.color} stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    <line x1="60" y1="6" x2="60" y2="12" stroke="currentColor" stroke-width="1.2" />
                                    <circle cx="60" cy="50" r="13" fill="#f0ebe0" stroke="currentColor" stroke-width="1.6" />
                                    <line x1="60" y1="50" x2="60" y2="40" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" class="clock-hand-min" />
                                    <line x1="60" y1="50" x2="68" y2="50" stroke="currentColor" stroke-width="1" stroke-linecap="round" class="clock-hand-hour" />
                                    <circle cx="60" cy="50" r="1.5" fill="currentColor" />
                                    <rect x="55" y="78" width="10" height="8" fill="currentColor" opacity="0.85" />
                                    <rect x="55" y="92" width="10" height="8" fill="currentColor" opacity="0.6" />
                                    <rect x="55" y="106" width="10" height="8" fill="currentColor" opacity="0.4" />
                                </svg>
                            )}
                            {ride.id === 'castle' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    <line x1="10" y1="135" x2="110" y2="135" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                    <rect x="30" y="80" width="60" height="55" fill={ride.softColor} stroke="currentColor" stroke-width="1.6" />
                                    <path d="M 25 80 L 25 50 L 30 45 L 35 50 L 35 80 Z" fill={ride.color} stroke="currentColor" stroke-width="1.4" />
                                    <path d="M 85 80 L 85 50 L 90 45 L 95 50 L 95 80 Z" fill={ride.color} stroke="currentColor" stroke-width="1.4" />
                                    <path d="M 50 80 L 50 35 L 60 28 L 70 35 L 70 80 Z" fill={ride.color} stroke="currentColor" stroke-width="1.4" />
                                    <line x1="60" y1="14" x2="60" y2="28" stroke="currentColor" stroke-width="1.2" class="flag-pole" />
                                    <path d="M 60 14 L 72 18 L 60 22 Z" fill={ride.softColor} stroke="currentColor" stroke-width="1" class="flag" />
                                    <rect x="52" y="100" width="16" height="35" fill={ride.color} stroke="currentColor" stroke-width="1.4" />
                                    <path d="M 56 100 Q 60 96 64 100" fill="none" stroke="currentColor" stroke-width="1" />
                                    <rect x="42" y="92" width="8" height="8" fill="#f0ebe0" stroke="currentColor" stroke-width="1" />
                                    <rect x="74" y="92" width="8" height="8" fill="#f0ebe0" stroke="currentColor" stroke-width="1" />
                                </svg>
                            )}
                            {ride.id === 'lab' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    <line x1="10" y1="135" x2="110" y2="135" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                    <rect x="20" y="90" width="80" height="45" fill={ride.softColor} stroke="currentColor" stroke-width="1.6" />
                                    <path d="M 20 90 L 100 90 L 100 78 L 20 78 Z" fill={ride.color} stroke="currentColor" stroke-width="1.6" />
                                    <rect x="55" y="40" width="10" height="38" fill="none" stroke="currentColor" stroke-width="1.6" />
                                    <rect x="50" y="38" width="20" height="6" fill={ride.color} stroke="currentColor" stroke-width="1.4" />
                                    <g class="lab-smoke">
                                        <circle cx="60" cy="30" r="4" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.5" />
                                        <circle cx="65" cy="22" r="5" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.4" />
                                        <circle cx="58" cy="16" r="3" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3" />
                                    </g>
                                    <rect x="30" y="100" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" />
                                    <line x1="37" y1="100" x2="37" y2="114" stroke="currentColor" stroke-width="1" />
                                    <line x1="30" y1="107" x2="44" y2="107" stroke="currentColor" stroke-width="1" />
                                    <rect x="78" y="100" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" />
                                    <line x1="85" y1="100" x2="85" y2="114" stroke="currentColor" stroke-width="1" />
                                    <line x1="78" y1="107" x2="92" y2="107" stroke="currentColor" stroke-width="1" />
                                </svg>
                            )}
                            {ride.id === 'game' && (
                                <svg viewBox="0 0 120 140" class="ride-svg">
                                    <line x1="10" y1="135" x2="110" y2="135" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                                    <path d="M 25 60 L 95 60 L 95 130 L 25 130 Z" fill={ride.softColor} stroke="currentColor" stroke-width="1.6" />
                                    <path d="M 25 60 Q 60 35 95 60" fill={ride.color} stroke="currentColor" stroke-width="1.6" />
                                    <line x1="30" y1="40" x2="30" y2="60" stroke="currentColor" stroke-width="1" />
                                    <line x1="90" y1="40" x2="90" y2="60" stroke="currentColor" stroke-width="1" />
                                    <line x1="30" y1="40" x2="90" y2="40" stroke="currentColor" stroke-width="1" />
                                    <g class="prize-hang">
                                        <circle cx="42" cy="80" r="5" fill={ride.color} stroke="currentColor" stroke-width="1" />
                                        <circle cx="58" cy="80" r="5" fill="#e07a5f" stroke="currentColor" stroke-width="1" />
                                        <circle cx="74" cy="80" r="5" fill="#8b6f9c" stroke="currentColor" stroke-width="1" />
                                    </g>
                                    <rect x="40" y="100" width="40" height="6" fill="currentColor" />
                                    <circle cx="60" cy="120" r="4" fill="none" stroke="currentColor" stroke-width="1.2" />
                                    <line x1="60" y1="106" x2="60" y2="116" stroke="currentColor" stroke-width="1" />
                                </svg>
                            )}
                        </div>
                        <div class="ride-info">
                            <span class="ride-tag">{ride.tag}</span>
                            <span class="ride-name">{ride.name}</span>
                            <span class="ride-sub">{ride.sub}</span>
                        </div>
                        <span class="ride-arrow" aria-hidden="true">→</span>
                    </a>
                ))}
            </div>

            <div class="park-ground" aria-hidden="true">
                <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
                    <path d="M 0 30 Q 100 10 200 30 T 400 30 T 600 30 T 800 30 T 1000 30 T 1200 30" fill="none" stroke="#3a2f2a" stroke-width="1.4" stroke-linecap="round" />
                </svg>
            </div>
        </section>

        <!-- Footer info -->
        <footer class="park-footer">
            <div class="park-footer-row">
                <span class="park-footer-label">GAME 賣場</span>
                <span class="park-footer-text">點任一設施 → 直達 app</span>
            </div>
            <div class="park-footer-row">
                <span class="park-footer-label">每日儀式</span>
                <span class="park-footer-text">先完成，再完美；先出發，再調整</span>
            </div>
            <div class="park-footer-row">
                <a href="/works" class="park-footer-link">查看全部作品 →</a>
                <a href="/about" class="park-footer-link">關於不說 →</a>
            </div>
        </footer>
    </main>

    <div data-site-footer></div>
    <button class="scroll-top" aria-label="返回頂部">↑</button>
</Base>

<style is:global>
