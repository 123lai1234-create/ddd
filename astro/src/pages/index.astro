<script is:inline>
    (function () {
        // Time-based greeting
        var g = document.querySelector('[data-park-greeting]');
        var dayEl = document.querySelector('[data-park-day]');
        var dateEl = document.querySelector('[data-park-date]');
        if (g) {
            var h = new Date().getHours();
            var msg = '早安';
            if (h >= 5  && h < 11) msg = '早安';
            else if (h >= 11 && h < 13) msg = '午安';
            else if (h >= 13 && h < 17) msg = '下午安';
            else if (h >= 17 && h < 22) msg = '晚安';
            else msg = '夜深了';
            g.textContent = msg + '，今天想先去哪一區？';
        }
        if (dayEl || dateEl) {
            var d = new Date();
            var days = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
            var day = days[d.getDay()];
            var mm = String(d.getMonth() + 1).padStart(2, '0');
            var dd = String(d.getDate()).padStart(2, '0');
            if (dayEl) dayEl.textContent = day;
            if (dateEl) dateEl.textContent = mm + '.' + dd;
        }
    })();
</script>
