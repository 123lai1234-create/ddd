/* ════════ Animations (SVG groups) ════════ */
/* Note: 用 transform-box: view-box + SVG user units 當 transform-origin
   避免 fill-box 把座標系鎖在元素 bbox 內造成「轉歪」*/
.ferris-spin {
    animation: ferris-rotate 24s linear infinite;
    transform-box: view-box;
    transform-origin: 60px 60px;
}

@keyframes ferris-rotate {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
}

.balloon-float {
    animation: balloon-bob 4.5s ease-in-out infinite;
    transform-box: view-box;
    transform-origin: 60px 50px;
}

@keyframes balloon-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
}

.carousel-spin {
    /* v6: carousel 不再整個旋轉，改成馬各自 bob + 旗子擺動
       真實旋轉木馬的馬不會跟著轉，只會上下 */
    animation: none;
}

/* 旗子擺動（固定位置，繞旗桿轉一點點） */
.carousel-flag {
    animation: flag-wave 2.4s ease-in-out infinite;
    transform-box: view-box;
    transform-origin: 60px 16px;
}

@keyframes flag-wave {
    0%, 100% { transform: rotate(0deg); }
    50%      { transform: rotate(10deg); }
}

/* 馬上下 bob — 3 隻不同 phase 模擬「在繞圈」 */
.carousel-horse {
    animation: horse-bob 2.4s ease-in-out infinite;
    transform-box: view-box;
    transform-origin: center bottom;
}

.carousel-horse-1 { animation-delay: 0s; }
.carousel-horse-2 { animation-delay: -0.8s; }  /* 1/3 週期前移 */
.carousel-horse-3 { animation-delay: -1.6s; }  /* 2/3 週期前移 */

@keyframes horse-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3.5px); }
}

/* Coaster car — 跟著軌道跑（不是原地抖動）
   軌道是 M 10 130 L 30 100 L 60 50 L 90 100 L 110 130
   用 5 個 keyframe 模擬上坡→下坡，rotate 跟著坡度 */
.coaster-car {
    animation: coaster-glide 5s ease-in-out infinite;
    transform-box: view-box;
    transform-origin: 0 0;
}

@keyframes coaster-glide {
    0%   { transform: translate(10px, 130px) rotate(0deg); }
    25%  { transform: translate(30px, 100px) rotate(35deg); }
    50%  { transform: translate(60px, 50px)  rotate(0deg); }
    75%  { transform: translate(90px, 100px) rotate(-35deg); }
    100% { transform: translate(110px, 130px) rotate(0deg); }
}

