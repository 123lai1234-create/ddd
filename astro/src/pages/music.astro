---
import Base from '../layouts/Base.astro';
const bodyHtml = `
    <!-- Immersive Background -->
    <div class="immersive-bg"></div>

    <!-- ════════ NAV ════════ -->
    <div data-site-nav></div>

    <!-- ════════ MAIN LAYOUT (ChillKara 風) ════════ -->
    <main class="ck-stage" role="main" aria-label="音樂混音台">

        <!-- ── Top Bar ────────────────────────────────────────── -->
        <header class="ck-topbar" role="banner">
            <div class="ck-topbar-left">
                <span class="ck-brand">🎤 <span class="ck-brand-name">ChillKara</span> <span class="ck-brand-sub">/ 不說</span></span>
                <span class="ck-pipe">|</span>
                <span class="ck-project-label">作品混音</span>
                <button class="ck-btn-orange ck-btn-sm" id="open-playlist-btn" title="開啟播放清單">切換曲目</button>
                <span class="ck-version">版本編號 <b>0</b></span>
            </div>
            <div class="ck-topbar-right">
                <label class="ck-toggle">
                    <input type="checkbox" id="show-track-num"> 顯示軌道編號
                </label>
                <button class="ck-btn-orange ck-btn-sm" id="export-btn" title="輸出作品">輸出作品區</button>
                <button class="ck-icon-btn" id="mv-toggle" title="MV 模式" aria-label="MV 模式" aria-pressed="false">🎬</button>
                <button class="ck-icon-btn" id="add-music-btn" title="新增音樂" aria-label="新增音樂">➕</button>
            </div>
        </header>

        <!-- ── Track Info Bar ──────────────────────────────────── -->
        <section class="ck-trackbar">
            <div class="ck-tb-controls">
                <button class="ck-ctrl-btn" id="shuffle-btn" title="隨機">🔀</button>
                <button class="ck-ctrl-btn" id="prev-btn" title="上一首">⏮</button>
                <button class="ck-play-btn" id="play-btn" title="播放 (Space)" aria-label="播放/暫停" aria-pressed="false">▶</button>
                <button class="ck-ctrl-btn" id="next-btn" title="下一首">⏭</button>
                <button class="ck-ctrl-btn" id="repeat-btn" title="重複：關閉 (R)">🔁</button>
            </div>
            <div class="ck-tb-meta">
                <div class="ck-tb-title" id="track-title">選擇一首音樂開始</div>
                <div class="ck-tb-artist" id="track-artist">—</div>
            </div>
            <div class="ck-tb-progress">
                <span class="ck-time" id="time-current">0:00</span>
                <div class="ck-progress" id="progress-bar" role="slider" aria-label="播放進度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
                    <div class="ck-progress-fill" id="progress-fill"></div>
                    <div class="ck-progress-handle" id="progress-handle"></div>
                </div>
                <span class="ck-time" id="time-total">0:00</span>
            </div>
            <div class="ck-tb-right">
                <div class="ck-vol-group">
                    <span class="ck-vol-label">音量</span>
                    <input type="range" id="volume-slider" min="0" max="100" value="75" class="ck-vol-slider" aria-label="音量">
                    <span class="ck-vol-val" id="volume-value">75%</span>
                </div>
                <div class="ck-peak">
                    <span class="ck-peak-label">輸出基準</span>
                    <span class="ck-peak-val" id="mixer-level-val">-9.0 dBFS</span>
                </div>
                <div class="ck-peak">
                    <span class="ck-peak-label">峰值</span>
                    <span class="ck-peak-val">-0.9 dBFS</span>
                </div>
            </div>
        </section>

        <!-- ── Main 2-column Grid ─────────────────────────────── -->
        <div class="ck-grid">

            <!-- ════ Left column: vocal correction modules ════ -->
            <div class="ck-col" id="ck-col-left">

                <!-- 人聲對位 -->
                <article class="ck-card" style="--ck-i:1">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">人聲對位</h3>
                        <span class="ck-card-sub">Vocal Alignment · 校正人聲時間軸</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row">
                        <div class="ck-slider-row">
                            <span class="ck-slider-label">偏移</span>
                            <input type="range" min="-200" max="200" value="-45" class="ck-slider" aria-label="人聲對位偏移">
                            <span class="ck-slider-val">-45 ms</span>
                        </div>
                        <button class="ck-btn-orange ck-btn-sm">對位偏移</button>
                    </div>
                </article>

                <!-- 降噪 - 語音 -->
                <article class="ck-card" style="--ck-i:2">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">降噪 - 語音</h3>
                        <span class="ck-card-sub">Noise Reduction · 降低語音噪音</span>
                    </header>
                    <div class="ck-card-body">
                        <div class="ck-segmented-row">
                            <span class="ck-body-label">強度</span>
                            <div class="ck-segmented" data-group="denoise">
                                <button class="ck-seg" data-val="off">關閉</button>
                                <button class="ck-seg" data-val="low">輕度</button>
                                <button class="ck-seg active" data-val="mid">適中</button>
                                <button class="ck-seg" data-val="high">高度</button>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- 人聲速度 -->
                <article class="ck-card" style="--ck-i:3">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">人聲速度</h3>
                        <span class="ck-card-sub">Vocal Speed · 加快或放慢人聲</span>
                    </header>
                    <div class="ck-card-body">
                        <div class="ck-segmented-row">
                            <span class="ck-body-label">強度</span>
                            <div class="ck-segmented" data-group="vocal-speed">
                                <button class="ck-seg" data-val="off">關閉</button>
                                <button class="ck-seg" data-val="low">輕度</button>
                                <button class="ck-seg active" data-val="mid">適中</button>
                                <button class="ck-seg" data-val="high">高度</button>
                            </div>
                            <button class="ck-btn-orange ck-btn-sm ck-btn-right">聲音偏移</button>
                        </div>
                    </div>
                </article>

                <!-- 音準修正 -->
                <article class="ck-card" style="--ck-i:4">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">音準修正</h3>
                        <span class="ck-card-sub">Pitch Correction · 自動修正音高</span>
                    </header>
                    <div class="ck-card-body">
                        <div class="ck-segmented-row">
                            <span class="ck-body-label">強度</span>
                            <div class="ck-segmented" data-group="pitch">
                                <button class="ck-seg" data-val="off">關閉</button>
                                <button class="ck-seg" data-val="low">輕度</button>
                                <button class="ck-seg active" data-val="mid">適中</button>
                                <button class="ck-seg" data-val="high">高度</button>
                            </div>
                            <button class="ck-btn-orange ck-btn-sm ck-btn-right">音準偏移</button>
                        </div>
                    </div>
                    <div class="ck-waveform" aria-label="音準波形">
                        <div class="ck-waveform-bar" style="--h:30%"></div>
                        <div class="ck-waveform-bar" style="--h:55%"></div>
                        <div class="ck-waveform-bar" style="--h:40%"></div>
                        <div class="ck-waveform-bar" style="--h:70%"></div>
                        <div class="ck-waveform-bar" style="--h:50%"></div>
                        <div class="ck-waveform-bar" style="--h:85%"></div>
                        <div class="ck-waveform-bar" style="--h:60%"></div>
                        <div class="ck-waveform-bar" style="--h:45%"></div>
                        <div class="ck-waveform-bar" style="--h:75%"></div>
                        <div class="ck-waveform-bar" style="--h:35%"></div>
                        <div class="ck-waveform-bar" style="--h:90%"></div>
                        <div class="ck-waveform-bar" style="--h:55%"></div>
                        <div class="ck-waveform-bar" style="--h:70%"></div>
                        <div class="ck-waveform-bar" style="--h:40%"></div>
                        <div class="ck-waveform-bar" style="--h:80%"></div>
                        <div class="ck-waveform-bar" style="--h:60%"></div>
                        <div class="ck-waveform-bar" style="--h:50%"></div>
                        <div class="ck-waveform-bar" style="--h:65%"></div>
                        <div class="ck-waveform-bar" style="--h:35%"></div>
                        <div class="ck-waveform-bar" style="--h:78%"></div>
                        <div class="ck-waveform-bar" style="--h:45%"></div>
                        <div class="ck-waveform-bar" style="--h:60%"></div>
                        <div class="ck-waveform-bar" style="--h:30%"></div>
                        <div class="ck-waveform-bar" style="--h:70%"></div>
                        <div class="ck-waveform-bar" style="--h:50%"></div>
                        <div class="ck-waveform-bar" style="--h:88%"></div>
                        <div class="ck-waveform-bar" style="--h:42%"></div>
                        <div class="ck-waveform-bar" style="--h:65%"></div>
                        <div class="ck-waveform-bar" style="--h:55%"></div>
                    </div>
                </article>

                <!-- 音量穩定 -->
                <article class="ck-card" style="--ck-i:5">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">音量穩定</h3>
                        <span class="ck-card-sub">Volume Stabilization · 動態壓縮</span>
                    </header>
                    <div class="ck-card-body">
                        <div class="ck-segmented-row">
                            <span class="ck-body-label">強度</span>
                            <div class="ck-segmented" data-group="volstab">
                                <button class="ck-seg" data-val="off">關閉</button>
                                <button class="ck-seg" data-val="low">輕度</button>
                                <button class="ck-seg active" data-val="mid">適中</button>
                                <button class="ck-seg" data-val="high">高度</button>
                            </div>
                            <button class="ck-btn-orange ck-btn-sm ck-btn-right">音量偏移</button>
                        </div>
                    </div>
                    <div class="ck-waveform" aria-label="音量波形">
                        <div class="ck-waveform-bar" style="--h:45%"></div>
                        <div class="ck-waveform-bar" style="--h:60%"></div>
                        <div class="ck-waveform-bar" style="--h:50%"></div>
                        <div class="ck-waveform-bar" style="--h:75%"></div>
                        <div class="ck-waveform-bar" style="--h:65%"></div>
                        <div class="ck-waveform-bar" style="--h:80%"></div>
                        <div class="ck-waveform-bar" style="--h:70%"></div>
                        <div class="ck-waveform-bar" style="--h:55%"></div>
                        <div class="ck-waveform-bar" style="--h:90%"></div>
                        <div class="ck-waveform-bar" style="--h:60%"></div>
                        <div class="ck-waveform-bar" style="--h:50%"></div>
                        <div class="ck-waveform-bar" style="--h:75%"></div>
                        <div class="ck-waveform-bar" style="--h:80%"></div>
                        <div class="ck-waveform-bar" style="--h:65%"></div>
                        <div class="ck-waveform-bar" style="--h:70%"></div>
                        <div class="ck-waveform-bar" style="--h:55%"></div>
                        <div class="ck-waveform-bar" style="--h:85%"></div>
                        <div class="ck-waveform-bar" style="--h:60%"></div>
                        <div class="ck-waveform-bar" style="--h:75%"></div>
                        <div class="ck-waveform-bar" style="--h:50%"></div>
                        <div class="ck-waveform-bar" style="--h:65%"></div>
                        <div class="ck-waveform-bar" style="--h:80%"></div>
                        <div class="ck-waveform-bar" style="--h:70%"></div>
                        <div class="ck-waveform-bar" style="--h:60%"></div>
                        <div class="ck-waveform-bar" style="--h:75%"></div>
                        <div class="ck-waveform-bar" style="--h:55%"></div>
                        <div class="ck-waveform-bar" style="--h:85%"></div>
                        <div class="ck-waveform-bar" style="--h:65%"></div>
                        <div class="ck-waveform-bar" style="--h:70%"></div>
                    </div>
                </article>

                <!-- 試聽與音量 -->
                <article class="ck-card" style="--ck-i:6">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">試聽與音量</h3>
                        <span class="ck-card-sub">Preview &amp; Volume</span>
                    </header>
                    <div class="ck-card-body">
                        <div class="ck-visualizer-wrap" data-active="false" id="ck-spectrum-wrap">
                            <canvas id="canvas-spectrum" class="ck-canvas ck-canvas-spec" aria-label="即時頻譜分析"></canvas>
                            <canvas id="canvas-waveform" class="ck-canvas ck-canvas-wave" aria-label="即時波形" hidden></canvas>
                            <div class="ck-visualizer-idle" aria-hidden="true">
                                <span style="--ck-d:0ms"></span>
                                <span style="--ck-d:80ms"></span>
                                <span style="--ck-d:160ms"></span>
                                <span style="--ck-d:240ms"></span>
                                <span style="--ck-d:320ms"></span>
                                <span style="--ck-d:400ms"></span>
                                <span style="--ck-d:480ms"></span>
                                <span style="--ck-d:560ms"></span>
                                <span style="--ck-d:480ms"></span>
                                <span style="--ck-d:400ms"></span>
                                <span style="--ck-d:320ms"></span>
                                <span style="--ck-d:240ms"></span>
                                <span style="--ck-d:160ms"></span>
                                <span style="--ck-d:80ms"></span>
                                <span style="--ck-d:0ms"></span>
                                <span style="--ck-d:80ms"></span>
                            </div>
                        </div>
                        <div class="ck-slider-row">
                            <span class="ck-slider-label">主音量</span>
                            <input type="range" id="mixer-volume" min="0" max="100" value="75" class="ck-slider" aria-label="主音量">
                            <span class="ck-slider-val" id="mixer-volume-val">75%</span>
                        </div>
                        <div class="ck-level-meter">
                            <div class="ck-level-fill" id="mixer-level-fill"></div>
                        </div>
                    </div>
                </article>

                <!-- 音色細節 (6 段 timbre 滑桿 — mixing-console.js 動態注入) -->
                <article class="ck-card" style="--ck-i:7">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">音色細節</h3>
                        <span class="ck-card-sub">Timbre · 6 段人聲濾波</span>
                    </header>
                    <div class="ck-card-body">
                        <div id="timbre-grid" class="ck-timbre-grid">
                            <!-- 由 mixing-console.js 動態生成 6 條 timbre slider -->
                        </div>
                    </div>
                </article>
            </div>

            <!-- ════ Right column: timbre / space / balance ════ -->
            <div class="ck-col" id="mixer-console">

                <!-- 作品混音 (track summary) -->
                <article class="ck-card ck-card-track" style="--ck-i:0">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">作品混音</h3>
                        <span class="ck-card-sub">Track Mix · <span id="total-songs">0</span> 首</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row">
                        <div class="ck-track-cover" id="now-playing-cover">🎵</div>
                        <div class="ck-track-meta">
                            <div class="ck-track-title" id="mixer-track-title">—</div>
                            <div class="ck-track-artist" id="mixer-track-artist">—</div>
                        </div>
                        <div class="ck-track-actions">
                            <button class="ck-icon-btn" id="open-playlist-btn-2" title="開啟播放清單">📋</button>
                        </div>
                    </div>
                    <div id="mv-container" class="ck-mv-container" hidden></div>
                </article>





                <!-- SMART 人聲修正 -->
                <article class="ck-card" style="--ck-i:8">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">SMART 人聲修正</h3>
                        <span class="ck-card-sub">SMART Vocal · 自動偵測聲音模型</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row-3">
                        <select class="ck-select" aria-label="人聲 ID">
                            <option>Audient ID</option>
                            <option>Rode NT1</option>
                            <option>Shure SM7B</option>
                        </select>
                        <button class="ck-btn-orange ck-btn-sm">修正韻腹</button>
                        <div class="ck-knob-wrap">
                            <div class="ck-knob" style="--val:100" data-knob="smart">
                                <div class="ck-knob-arc"></div>
                                <div class="ck-knob-val">100%</div>
                            </div>
                            <span class="ck-knob-label">原音強度</span>
                        </div>
                    </div>
                </article>

                <!-- 人聲音色 (8-band EQ) -->
                <article class="ck-card" style="--ck-i:9">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">人聲音色</h3>
                        <span class="ck-card-sub">Vocal Timbre · 8 段等化器</span>
                    </header>
                    <div class="ck-card-body">
                        <div id="eq-grid" class="ck-eq-grid">
                            <!-- 由 mixing-console.js 動態生成 -->
                        </div>
                    </div>
                    <footer class="ck-card-foot">
                        <button id="mixer-eq-flat" class="ck-btn-orange ck-btn-sm" title="全部歸零">FLAT 歸零</button>
                    </footer>
                </article>

                <!-- 人聲風格 (timbre preset) -->
                <article class="ck-card" style="--ck-i:10">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">人聲風格</h3>
                        <span class="ck-card-sub">Vocal Style · Master Pop 等音色</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row-3">
                        <div class="ck-segmented ck-segmented-mini" data-group="style">
                            <button class="ck-seg active">單設定</button>
                            <button class="ck-seg">自動設置匹配</button>
                        </div>
                        <select id="mixer-timbre-preset" class="ck-select" aria-label="音色預設">
                            <option value="flat">原聲 (Flat)</option>
                            <option value="air" selected>Master Pop (流行)</option>
                            <option value="warm">暖度 (Warm)</option>
                            <option value="thick">厚度 (Thick)</option>
                            <option value="bright">明亮 (Bright)</option>
                            <option value="vocal">人聲 (Vocal)</option>
                        </select>
                        <div class="ck-knob-wrap">
                            <div class="ck-knob" style="--val:75">
                                <div class="ck-knob-arc"></div>
                                <input type="range" id="mixer-timbre-wet" min="0" max="100" value="75" class="ck-knob-input" aria-label="音色濕度">
                                <div class="ck-knob-val">75%</div>
                            </div>
                            <span class="ck-knob-label" id="mixer-timbre-wet-val-wrap">音色濕度 <span id="mixer-timbre-wet-val">75%</span></span>
                        </div>
                    </div>
                </article>

                <!-- 空間聲響 (reverb type) -->
                <article class="ck-card" style="--ck-i:11">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">空間聲響</h3>
                        <span class="ck-card-sub">Spatial Sound · 環境音場</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row-3">
                        <select id="mixer-reverb-type" class="ck-select" aria-label="Reverb 類型">
                            <option value="off">關閉</option>
                            <option value="room">FMII 小房間</option>
                            <option value="hall" selected>演藝廳 (27th 高)</option>
                            <option value="plate">金屬板</option>
                            <option value="spring">彈簧</option>
                        </select>
                        <select class="ck-select" aria-label="空間預設">
                            <option>27th(高)</option>
                            <option>低頻強化</option>
                            <option>中性</option>
                        </select>
                        <div class="ck-knob-wrap">
                            <div class="ck-knob" style="--val:22" data-knob="reverb-intensity">
                                <div class="ck-knob-arc"></div>
                                <div class="ck-knob-val">22%</div>
                            </div>
                            <span class="ck-knob-label">空間強度</span>
                        </div>
                    </div>
                </article>

                <!-- 空間效果 (reverb wet) -->
                <article class="ck-card" style="--ck-i:12">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">空間效果</h3>
                        <span class="ck-card-sub">Space Effect · 殘響濕度</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row-3">
                        <div class="ck-segmented ck-segmented-mini" data-group="spacestyle">
                            <button class="ck-seg active">單設定</button>
                            <button class="ck-seg">自動設置匹配</button>
                        </div>
                        <select class="ck-select" aria-label="空間類型">
                            <option>預設 27th</option>
                            <option>房間</option>
                            <option>客廳</option>
                        </select>
                        <div class="ck-slider-row">
                            <span class="ck-slider-label">濕度</span>
                            <input type="range" id="mixer-reverb-wet" min="0" max="100" value="22" class="ck-slider" aria-label="Reverb 濕度">
                            <span class="ck-slider-val" id="mixer-reverb-wet-val">22%</span>
                        </div>
                    </div>
                </article>

                <!-- 人聲物件平衡 -->
                <article class="ck-card" style="--ck-i:13">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">人聲物件平衡</h3>
                        <span class="ck-card-sub">Vocal Balance · 伴奏 vs 人聲</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row-3">
                        <div class="ck-knob-wrap">
                            <div class="ck-knob" style="--val:100" data-knob="balance-accomp">
                                <div class="ck-knob-arc"></div>
                                <div class="ck-knob-val">100%</div>
                            </div>
                            <span class="ck-knob-label">伴奏音量</span>
                        </div>
                        <div class="ck-knob-wrap">
                            <div class="ck-knob" style="--val:100" data-knob="balance-vocal">
                                <div class="ck-knob-arc"></div>
                                <div class="ck-knob-val">100%</div>
                            </div>
                            <span class="ck-knob-label">人聲音量</span>
                        </div>
                        <button class="ck-btn-orange" id="auto-balance-btn">自動平衡</button>
                    </div>
                </article>

                <!-- Preset 儲存 -->
                <article class="ck-card" style="--ck-i:14">
                    <header class="ck-card-head">
                        <span class="ck-dot"></span>
                        <h3 class="ck-card-title">Preset 儲存</h3>
                        <span class="ck-card-sub">混音設定儲存 / 載入</span>
                    </header>
                    <div class="ck-card-body ck-card-body-row-3">
                        <button class="ck-btn-orange" id="mixer-preset-save" title="儲存當前混音">儲存</button>
                        <select class="ck-select" id="mixer-preset-list" aria-label="載入 preset">
                            <option value="">載入 preset...</option>
                        </select>
                        <button class="ck-btn-orange" id="mixer-preset-delete" title="刪除選擇的 preset">刪除</button>
                        <button class="ck-icon-btn" id="reset-mixer-btn" title="重置混音">↺</button>
                    </div>
                </article>

            </div>
        </div>

        <!-- ── Lyrics Strip ─────────────────────────────────────── -->
        <section class="ck-lyrics-strip" aria-label="歌詞區">
            <header class="ck-lyrics-head">
                <span class="ck-lyrics-title">🎤 歌詞</span>
                <div class="ck-lyrics-actions">
                    <button class="ck-icon-btn" id="karaoke-toggle" title="卡拉OK逐字（開/關）" aria-label="卡拉OK">🎤</button>
                    <button class="ck-icon-btn" id="fullscreen-lyrics-btn" title="全螢幕歌詞 (F 或雙擊歌詞)">⛶</button>
                    <button class="ck-icon-btn" id="mini-player-toggle" title="迷你播放器">⇲</button>
                    <div class="ck-sleep-group">
                        <span class="ck-sleep-label">睡眠</span>
                        <button class="ck-icon-btn sleep-btn active" data-sleep="0" title="關閉睡眠定時器">⏰</button>
                        <button class="ck-icon-btn sleep-btn" data-sleep="5" title="5 分鐘後暫停">5m</button>
                        <button class="ck-icon-btn sleep-btn" data-sleep="15" title="15 分鐘後暫停">15m</button>
                        <button class="ck-icon-btn sleep-btn" data-sleep="30" title="30 分鐘後暫停">30m</button>
                        <button class="ck-icon-btn sleep-btn" data-sleep="60" title="60 分鐘後暫停">60m</button>
                        <button class="ck-icon-btn sleep-btn" data-sleep="endOfTrack" title="播完這首後暫停">曲末</button>
                    </div>
                    <select id="quality-select" class="ck-select ck-select-mini" title="音質" aria-label="音質">
                        <option value="low">低音質</option>
                        <option value="medium" selected>標準</option>
                        <option value="high">高品質</option>
                        <option value="lossless">無損</option>
                    </select>
                </div>
            </header>
            <section class="now-playing-lyrics" id="lyrics-container" aria-live="polite" aria-atomic="false">
                <div class="lyrics" id="lyrics">
                    <p class="lyric-line">歌詞將在播放時顯示</p>
                </div>
            </section>
        </section>

        <!-- ── Bottom Footer ────────────────────────────────────── -->
        <footer class="ck-footer" role="contentinfo">
            <button class="ck-link-btn" id="rules-btn">調用規則</button>
            <span class="ck-footer-sep">|</span>
            <button class="ck-link-btn" id="shortcut-btn">鍵盤操作說明</button>
            <span class="ck-footer-sep">|</span>
            <button class="ck-link-btn" id="settings-btn">偏好設定</button>
            <div class="ck-footer-spacer"></div>
            <button class="ck-btn-red" id="continue-edit-btn" title="儲存並繼續">繼續編輯</button>
        </footer>

    </main>

    <!-- ════════ Playlist Drawer ════════ -->
    <aside class="ck-drawer" id="playlist-drawer" aria-hidden="true">
        <header class="ck-drawer-head">
            <h2 class="ck-drawer-title">📋 播放清單</h2>
            <button class="ck-icon-btn" id="drawer-close" title="關閉">✕</button>
        </header>
        <div class="ck-drawer-search">
            <input type="text" id="search-input" placeholder="搜尋音樂..." aria-label="搜尋音樂">
        </div>
        <div class="ck-drawer-tabs">
            <button class="ck-tab-btn tab-btn active" data-tab="all">全部</button>
            <button class="ck-tab-btn tab-btn" data-tab="favorites">❤️ 最愛</button>
        </div>
        <div class="ck-drawer-playlist">
            <div class="playlist" id="playlist">
                <!-- 動態生成歌曲列表 -->
            </div>
        </div>
        <footer class="ck-drawer-stats">
            <span id="total-songs">0</span> 首歌曲 · <span id="total-duration">0:00</span>
        </footer>
    </aside>
    <div class="ck-drawer-backdrop" id="drawer-backdrop"></div>

    <!-- ════════ Mini Player (可拖動) ════════ -->
    <div class="mini-player" id="mini-player" aria-hidden="true">
        <div class="mini-player-handle" id="mini-player-handle" title="拖動">⇲</div>
        <div class="mini-player-cover" id="mini-player-cover">🎵</div>
        <div class="mini-player-info">
            <div class="mini-player-title" id="mini-player-title">—</div>
            <div class="mini-player-artist" id="mini-player-artist">—</div>
        </div>
        <button class="stage-icon-btn mini-player-play" id="mini-player-play" title="播放/暫停">▶</button>
        <button class="stage-icon-btn mini-player-close" id="mini-player-close" title="關閉">✕</button>
    </div>

    <!-- Hidden Audio Element -->
    <audio id="audio-player" crossorigin="anonymous"></audio>

    <!-- Add Music Modal -->
    <div class="modal" id="add-music-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>新增音樂</h3>
                <button class="modal-close" id="modal-close">✕</button>
            </div>
            <div class="modal-body">
                <div class="input-group">
                    <label>標題</label>
                    <input type="text" id="new-title" placeholder="歌曲標題">
                </div>
                <div class="input-group">
                    <label>藝術家</label>
                    <input type="text" id="new-artist" placeholder="藝術家名稱">
                </div>
                <div class="input-group">
                    <label>專輯</label>
                    <input type="text" id="new-album" placeholder="專輯名稱">
                </div>
                <div class="input-group">
                    <label>音樂 URL</label>
                    <input type="text" id="new-url" placeholder="https://example.com/music.mp3">
                </div>
                <div class="input-group">
                    <label>專輯圖片 URL</label>
                    <input type="text" id="new-cover" placeholder="https://example.com/cover.jpg">
                </div>
                <div class="input-group">
                    <label>時長（秒）</label>
                    <input type="number" id="new-duration" placeholder="180">
                </div>
                <div class="input-group">
                    <label>歌詞（可選）</label>
                    <textarea id="new-lyrics" placeholder="一行一行歌詞"></textarea>
                </div>
                <button class="btn btn-primary" id="add-music-confirm">新增</button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div data-site-footer></div>
`;
const headInline = "<script is:inline>if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => { });</script>";
---
<Base
    title="🎵 音樂混音台"
    description="ChillKara 風格音樂混音台：人聲對位、降噪、速度、音準、音量穩定，內建 8 段 EQ、Reverb、人聲風格、即時頻譜"
    bodyPage="music"
    pageStyles={["/styles/music.css?v=20261007a"]}
    pageScripts={[
        "/scripts/app-config.js?v=20260910b",
        "/scripts/reverb-irs.js?v=20260910b",
        "/scripts/audio-engine.js?v=20260910b",
        "/scripts/visualizer.js?v=20261007a",
        "/scripts/music-player.js?v=20260910b",
        "/scripts/music-mv.js?v=20260918b",
        "/scripts/mixing-console.js?v=20260910b",
        "/scripts/music-shortcuts.js?v=20261007a"
    ]}
    headInline={headInline}
>
    <Fragment set:html={bodyHtml} />
</Base>
