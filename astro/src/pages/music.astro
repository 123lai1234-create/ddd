---
import Base from '../layouts/Base.astro';
const bodyHtml = `
    <!-- Immersive Background -->
    <div class="immersive-bg"></div>

    <!-- ════════ NAV ════════ -->
    <div data-site-nav></div>

    <!-- ════════ MUSIC STAGE (單欄主舞台) ════════ -->
    <main class="music-stage">
        <!-- 頂部工具列 -->
        <header class="stage-top">
            <div class="stage-top-left">
                <button class="stage-icon-btn" id="open-playlist-btn" title="播放清單" aria-label="播放清單">📋</button>
                <button class="stage-icon-btn" id="add-music-btn" title="上傳音樂" aria-label="上傳音樂">➕</button>
                <button class="stage-icon-btn" id="karaoke-toggle" title="卡拉OK逐字" aria-label="卡拉OK">🎤</button>
            </div>
            <div class="stage-top-right">
                <button class="stage-icon-btn" id="prev-btn" title="上一首" aria-label="上一首">⏮</button>
                <button class="stage-icon-btn" id="next-btn" title="下一首" aria-label="下一首">⏭</button>
            </div>
        </header>

        <!-- 曲目資訊 -->
        <div class="stage-track-info">
            <h1 class="stage-track-title" id="track-title">選擇一首音樂開始</h1>
            <p class="stage-track-artist" id="track-artist">-</p>
        </div>

        <!-- 大型歌詞區（主角） -->
        <section class="stage-lyrics" id="lyrics-container">
            <div class="lyrics" id="lyrics">
                <p class="lyric-line">歌詞將在播放時顯示</p>
            </div>
        </section>

        <!-- 底部播放列 -->
        <footer class="stage-bottom">
            <!-- 進度 -->
            <div class="stage-progress">
                <span class="time-current" id="time-current">0:00</span>
                <div class="progress-bar" id="progress-bar">
                    <div class="progress-fill" id="progress-fill"></div>
                    <div class="progress-handle" id="progress-handle"></div>
                </div>
                <span class="time-total" id="time-total">0:00</span>
            </div>

            <!-- 控制 -->
            <div class="stage-controls">
                <button class="stage-ctrl" id="shuffle-btn" title="隨機">🔀</button>
                <button class="stage-ctrl stage-ctrl-play" id="play-btn" title="播放">▶️</button>
                <button class="stage-ctrl" id="repeat-btn" title="重複">🔁</button>
            </div>

            <!-- 音量 + 音質 -->
            <div class="stage-extras">
                <button class="stage-icon-btn" id="volume-btn" title="靜音">🔊</button>
                <input type="range" class="volume-slider" id="volume-slider" min="0" max="100" value="75" aria-label="音量">
                <span class="volume-value" id="volume-value">75%</span>
                <select id="quality-select" class="quality-select" title="音質" aria-label="音質">
                    <option value="low">低音質</option>
                    <option value="medium" selected>標準</option>
                    <option value="high">高品質</option>
                    <option value="lossless">無損</option>
                </select>
            </div>
        </footer>
    </main>

    <!-- ════════ 側邊播放清單抽屜 ════════ -->
    <aside class="playlist-drawer" id="playlist-drawer" aria-hidden="true">
        <div class="drawer-backdrop" id="drawer-backdrop"></div>
        <div class="drawer-panel">
            <header class="drawer-header">
                <h2>📋 播放清單</h2>
                <button class="stage-icon-btn drawer-close" id="drawer-close" aria-label="關閉">✕</button>
            </header>
            <div class="drawer-search">
                <input type="text" id="search-input" placeholder="搜尋音樂..." aria-label="搜尋音樂">
            </div>
            <div class="drawer-tabs">
                <button class="tab-btn active" data-tab="all">全部</button>
                <button class="tab-btn" data-tab="favorites">❤️ 最愛</button>
            </div>
            <div class="drawer-playlist">
                <div class="playlist" id="playlist">
                    <!-- 動態生成歌曲列表 -->
                </div>
            </div>
            <div class="drawer-stats">
                <span id="total-songs">0</span> 首歌曲 · <span id="total-duration">0:00</span>
            </div>
        </div>
    </aside>

    <!-- Hidden Audio Element -->
    <audio id="audio-player"></audio>

    <!-- Add Music Modal -->
    <div class="modal" id="add-music-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>新增音樂</h3>
                <button class="modal-close" id="modal-close">✕</button>
            </div>
            <div class="modal-body">
                <div class="input-group">
                    <label>標題</label>
                    <input type="text" id="new-title" placeholder="歌曲標題">
                </div>
                <div class="input-group">
                    <label>藝術家</label>
                    <input type="text" id="new-artist" placeholder="藝術家名稱">
                </div>
                <div class="input-group">
                    <label>專輯</label>
                    <input type="text" id="new-album" placeholder="專輯名稱">
                </div>
                <div class="input-group">
                    <label>音樂 URL</label>
                    <input type="text" id="new-url" placeholder="https://example.com/music.mp3">
                </div>
                <div class="input-group">
                    <label>專輯圖片 URL</label>
                    <input type="text" id="new-cover" placeholder="https://example.com/cover.jpg">
                </div>
                <div class="input-group">
                    <label>時長（秒）</label>
                    <input type="number" id="new-duration" placeholder="180">
                </div>
                <div class="input-group">
                    <label>歌詞（可選）</label>
                    <textarea id="new-lyrics" placeholder="一行一行歌詞"></textarea>
                </div>
                <button class="btn btn-primary" id="add-music-confirm">新增</button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div data-site-footer></div>
`;
const headInline = "<script is:inline>if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => { });</script>";
---
<Base
    title="🎵 音樂播放平台"
    description="現代化音樂播放平台，支援播放清單、音質控制與視覺化效果"
    bodyPage="music"
    pageStyles={["/styles/music.css?v=20260827e"]}
    pageScripts={["/scripts/app-config.js?v=20260827e","/scripts/music-player.js?v=20260827e"]}
    headInline={headInline}
>
    <Fragment set:html={bodyHtml} />
</Base>