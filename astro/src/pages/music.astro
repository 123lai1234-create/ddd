---
import Base from '../layouts/Base.astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

const SITE = 'https://donttalk.vercel.app';
const PAGE_TITLE = '🎵 音樂播放器';
const PAGE_DESC = '一個優質的音樂播放器，支援歌詞同步、佇列管理、波形視覺化，打造流暢的音樂體驗。';
const OG_TAG = 'music';

// 直接讀取 playlist.json 避免部署保護問題
let tracksData = { tracks: [] };
try {
  const playlistPath = join(process.cwd(), 'public/music/playlist.json');
  const playlistContent = await readFile(playlistPath, 'utf-8');
  tracksData = JSON.parse(playlistContent);
} catch (err) {
  console.error('Failed to load playlist:', err);
}
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESC}
  bodyPage="music"
  pageStyles={["/styles/music.css"]}
  pageScripts={["/scripts/music-player.js", "/scripts/music-upload.js"]}
>
  <div class="bg-gradient"></div>

  <nav class="top-nav">
    <div class="nav-logo">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
      </svg>
      Music
    </div>

    <div class="nav-search">
      <span class="nav-search-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </span>
      <input type="text" id="track-search" class="nav-search-box" placeholder="搜尋歌曲、藝人或專輯...">
    </div>

    <div class="stats-row">
      <span class="stats-badge" id="stats-total">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        <span id="total-tracks">0</span> 首歌
      </span>
      <span class="stats-badge" id="stats-liked">
        <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span id="liked-count">0</span> 喜歡
      </span>
    </div>

    <div class="nav-actions">
      <button class="nav-btn" id="admin-btn" title="管理（刪除上傳歌曲）">🔒</button>
      <button class="nav-btn nav-btn-primary" id="upload-btn">📤 上傳歌曲</button>
    </div>
  </nav>

  <section class="main-content">
    <div style="display: grid; grid-template-columns: 1fr 380px; gap: 24px;">

      <div>
        <div class="hero-banner">
          <div class="hero-content">
            <span class="hero-tag">線上音樂</span>
            <h1 class="hero-title">探索音樂世界</h1>
            <p class="hero-subtitle">盡情播放、分享你喜愛的音樂</p>
          </div>
          <div class="hero-waveform">
            <div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div><div class="hero-wave-bar"></div>
          </div>
        </div>

        <div class="filter-row">
          <select id="lang-filter">
            <option value="all">🌐 全部語言</option>
            <option value="TW">🇹🇼 台灣</option>
            <option value="EN">🇺🇸 英文</option>
            <option value="JP">🇯🇵 日文</option>
            <option value="KR">🇰🇷 韓文</option>
          </select>
          <select id="style-filter">
            <option value="all">🎵 全部曲風</option>
            <option value="流行">流行</option>
            <option value="抒情">抒情</option>
            <option value="嘻哈">嘻哈</option>
            <option value="搖滾">搖滾</option>
            <option value="Lo-fi">Lo-fi</option>
            <option value="電子">電子</option>
            <option value="R&B">R&B</option>
          </select>
          <select id="gender-filter">
            <option value="all">👤 全部歌手</option>
            <option value="M">♂ 男歌手</option>
            <option value="F">♀ 女歌手</option>
          </select>
        </div>

        <div class="track-list-container">
          <div class="track-list-header">
            <span>🎵</span>
            <span>標題</span>
            <span>🎤 歌手</span>
            <span>💿 專輯</span>
            <span>⏱ 時長</span>
            <span>操作</span>
          </div>
          <div class="track-scroll">
            <div id="track-list">
              <p style="color: var(--text-tertiary); text-align: center; padding: 50px;">載入中...</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lyrics-panel">
        <button class="mobile-lyrics-close" id="mobile-lyrics-close">✕ 關閉</button>
        <div class="lyrics-header">
          <div class="lyrics-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
            歌詞
          </div>
          <span class="lyrics-badge" id="lyrics-count">0 句</span>
        </div>
        
        <!-- 歌詞偏移控制 UI -->
        <div class="lyrics-offset-controls">
          <button class="lyrics-offset-btn" id="lyrics-offset-minus" title="歌詞提前 0.5s">−</button>
          <span class="lyrics-offset-value" id="lyrics-offset-value">0s</span>
          <button class="lyrics-offset-btn" id="lyrics-offset-plus" title="歌詞延後 0.5s">+</button>
          <button class="lyrics-offset-btn" id="lyrics-offset-reset" title="重置偏移" style="font-size: 0.7rem;">↺</button>
          <button class="lyrics-offset-btn" id="lyrics-offset-auto" title="自動對齊歌詞時間" style="font-size: 0.65rem; padding: 3px 7px;">🔧</button>
        </div>
        
        <div class="lyrics-translate-toggle">
          <button class="translate-tab active" data-mode="original">原文</button>
          <button class="translate-tab" data-mode="roman">羅馬拼音</button>
        </div>
        <div class="lyrics-cc-hint" title="點瀏覽器播放器右下 CC 按鈕開啟/關閉原生字幕">
          💬 SRT 字幕已掛載 → 點播放器右下 <b>CC</b> 開啟原生字幕
        </div>
        <div class="lyrics-container" id="lyrics-container">
          <p style="color: var(--text-tertiary); text-align: center; padding: 50px;">選擇歌曲以顯示歌詞<br><span style="font-size: 0.75rem;">按 J/K 鍵調整歌詞時間偏移</span></p>
        </div>
      </div>
    </div>
  </section>

  <button class="mobile-lyrics-toggle" id="mobile-lyrics-toggle">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
  </button>

  <!-- 上傳歌曲 Modal -->
  <div class="upload-modal" id="upload-modal">
    <div class="upload-modal-content">
      <button class="upload-modal-close" id="upload-modal-close">✕</button>
      <div class="upload-modal-header" id="modal-header">
        <h2 id="modal-header-title">📤 上傳歌曲</h2>
        <p id="modal-header-desc">選一個 MP3 跟歌詞檔（.txt / .srt / .lrc），就能直接加到播放清單</p>
      </div>

      <!-- 密碼驗證 -->
      <div class="upload-gate" id="upload-gate">
        <div class="ai-form-group">
          <label for="upload-password">🔒 密碼</label>
          <input type="password" id="upload-password" placeholder="輸入上傳密碼" autocomplete="off">
        </div>
        <button class="ai-analyze-btn" id="upload-unlock-btn">解鎖</button>
        <p class="upload-gate-hint">這頁是私人空間，不對外開放上傳</p>
      </div>

      <!-- 上傳表單（解鎖後才顯示） -->
      <div class="upload-form" id="upload-form" style="display: none;">
        <div class="ai-form-group">
          <label for="upload-track-name">🎵 歌曲名稱</label>
          <input type="text" id="upload-track-name" placeholder="例：我的新歌">
        </div>
        <div class="ai-form-group">
          <label for="upload-artist">🎤 歌手（可選）</label>
          <input type="text" id="upload-artist" placeholder="例：獨立歌手">
        </div>

        <div class="ai-form-group">
          <label>🎧 MP3 音訊</label>
          <div class="ai-dropzone" id="upload-audio-drop">
            <div class="ai-dropzone-icon">🎵</div>
            <p class="ai-dropzone-text">拖放 MP3 到此處</p>
            <p class="ai-dropzone-subtext">或點擊選擇檔案</p>
            <input type="file" id="upload-audio-input" accept="audio/mpeg,audio/mp3,audio/*" hidden>
          </div>
          <div class="ai-file-preview" id="upload-audio-preview" style="display: none;">
            <span class="ai-file-name" id="upload-audio-name"></span>
            <button class="ai-remove-file" id="upload-audio-remove">✕</button>
          </div>
        </div>

        <div class="ai-form-group">
          <label>📝 歌詞（.txt / .srt / .lrc）</label>
          <div class="ai-dropzone" id="upload-lyrics-drop">
            <div class="ai-dropzone-icon">📝</div>
            <p class="ai-dropzone-text">拖放歌詞到此處</p>
            <p class="ai-dropzone-subtext">或點擊選擇檔案</p>
            <input type="file" id="upload-lyrics-input" accept=".txt,.srt,.lrc,text/plain" hidden>
          </div>
          <div class="ai-file-preview" id="upload-lyrics-preview" style="display: none;">
            <span class="ai-file-name" id="upload-lyrics-name"></span>
            <button class="ai-remove-file" id="upload-lyrics-remove">✕</button>
          </div>
          <label class="upload-no-id3-label">
            <input type="checkbox" id="upload-no-id3" checked>
            <span>不使用 MP3 內嵌歌詞（推薦勾選，避免抓到別的歌詞）</span>
          </label>
          <details class="upload-lyrics-hint">
            <summary>歌詞格式說明</summary>
            <div class="upload-lyrics-help">
              <p><b>.txt</b>：每行一句，按行數順序播放</p>
              <p><b>.srt / .lrc</b>：帶時間碼的字幕格式（推薦）</p>
              <p>範例 LRC：</p>
              <pre>[00:00.00] 這是第一句歌詞
[00:05.30] 這是第二句歌詞</pre>
            </div>
          </details>
        </div>

        <button class="ai-analyze-btn" id="upload-submit-btn" disabled>
          <span class="ai-btn-text">✅ 加到播放清單</span>
          <span class="ai-btn-loading" style="display: none;">處理中...</span>
        </button>
        <div class="upload-progress-bar-wrap" id="upload-progress-wrap" style="display: none;">
          <div class="upload-progress-bar" id="upload-progress-bar"></div>
          <span class="upload-progress-text" id="upload-progress-text"></span>
        </div>
      </div>

      <!-- 管理面板（管理模式） -->
      <div class="upload-form" id="admin-panel" style="display: none;">
        <div class="admin-track-list" id="admin-track-list">
          <p style="color: var(--text-tertiary); text-align: center; padding: 24px;">載入中...</p>
        </div>
      </div>
    </div>
  </div>

  <div class="bottom-bar">
    <div class="bar-left">
      <div class="bar-album" id="bar-album" title="點擊展開播放器">
        <img id="album-img" src="" alt="" style="display: none;">
        <svg id="album-fallback" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </div>
      <div class="bar-track-info">
        <p class="bar-track-name" id="bar-track-name">未播放</p>
        <p class="bar-track-artist" id="bar-track-artist">--</p>
      </div>
      <button class="bar-like-btn" id="bar-like-btn" title="喜歡">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </button>
      <button class="bar-icon-btn" id="bar-share-btn" title="分享">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>

    <div class="bar-center">
      <div class="bar-controls">
        <button class="bar-ctrl-btn mode-btn" id="bar-mode" title="播放模式">
          <svg id="mode-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
          <div class="mode-dropdown">
            <div class="mode-option active" data-mode="sequence">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              順序播放
            </div>
            <div class="mode-option" data-mode="shuffle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
              隨機播放
            </div>
            <div class="mode-option" data-mode="repeat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
              全部循環
            </div>
            <div class="mode-option" data-mode="repeat-one">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
              單曲循環
            </div>
          </div>
        </button>

        <button class="bar-ctrl-btn" id="bar-prev" title="上一首">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="19 20 9 12 19 4 19 20"/><line x1="5" y1="19" x2="5" y2="5"/></svg>
        </button>

        <button class="bar-play-btn" id="bar-play" title="播放">
          <svg id="play-icon" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <svg id="pause-icon" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        </button>

        <button class="bar-ctrl-btn" id="bar-next" title="下一首">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19"/></svg>
        </button>

        <button class="bar-ctrl-btn speed-btn" id="bar-speed" title="播放速度">
          <span id="speed-label">1x</span>
          <div class="speed-dropdown">
            <div class="speed-option" data-speed="0.5">0.5x</div>
            <div class="speed-option" data-speed="0.75">0.75x</div>
            <div class="speed-option active" data-speed="1">1x</div>
            <div class="speed-option" data-speed="1.25">1.25x</div>
            <div class="speed-option" data-speed="1.5">1.5x</div>
            <div class="speed-option" data-speed="2">2x</div>
          </div>
        </button>
      </div>

      <div class="bar-progress">
        <span class="bar-time" id="bar-current-time">0:00</span>
        <input type="range" class="bar-progress-slider" id="bar-progress" min="0" max="100" value="0" style="--progress: 0%">
        <span class="bar-time" id="bar-duration">0:00</span>
      </div>
    </div>

    <div class="bar-right">
      <button class="shortcuts-btn" id="shortcuts-btn" title="快捷鍵">?</button>
      <button class="bar-icon-btn" id="bar-eq-btn" title="等化器">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
      </button>
      <button class="bar-icon-btn" id="bar-vol-btn" title="靜音">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="vol-icon"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="vol-mute-icon" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
      </button>
      <input type="range" class="bar-volume-slider" id="bar-volume" min="0" max="100" value="80">
    </div>
  </div>

  <div class="eq-panel" id="eq-panel">
    <div class="eq-title">
      等化器
      <button class="eq-close" id="eq-close">✕</button>
    </div>
    <div class="eq-slider-row">
      <span class="eq-label">低音</span>
      <input type="range" class="eq-slider" id="eq-bass" min="-10" max="10" value="0">
      <span class="eq-value" id="eq-bass-val">0</span>
    </div>
    <div class="eq-slider-row">
      <span class="eq-label">中音</span>
      <input type="range" class="eq-slider" id="eq-mid" min="-10" max="10" value="0">
      <span class="eq-value" id="eq-mid-val">0</span>
    </div>
    <div class="eq-slider-row">
      <span class="eq-label">高音</span>
      <input type="range" class="eq-slider" id="eq-treble" min="-10" max="10" value="0">
      <span class="eq-value" id="eq-treble-val">0</span>
    </div>
    <div class="eq-slider-row">
      <span class="eq-label">音量</span>
      <input type="range" class="eq-slider" id="eq-gain" min="-10" max="10" value="0">
      <span class="eq-value" id="eq-gain-val">0</span>
    </div>
  </div>

  <div class="shortcuts-overlay" id="shortcuts-overlay"></div>
  <div class="shortcuts-panel" id="shortcuts-panel">
    <button class="close-shortcuts" id="close-shortcuts">✕</button>
    <div class="shortcuts-title">⌨️ 快捷鍵</div>
    <div class="shortcuts-grid">
      <div class="shortcut-item"><span class="shortcut-key">Space</span><span class="shortcut-desc">播放/暫停</span></div>
      <div class="shortcut-item"><span class="shortcut-key">←</span><span class="shortcut-desc">倒回 10 秒</span></div>
      <div class="shortcut-item"><span class="shortcut-key">→</span><span class="shortcut-desc">快轉 10 秒</span></div>
      <div class="shortcut-item"><span class="shortcut-key">↑</span><span class="shortcut-desc">音量 +10</span></div>
      <div class="shortcut-item"><span class="shortcut-key">↓</span><span class="shortcut-desc">音量 -10</span></div>
      <div class="shortcut-item"><span class="shortcut-key">M</span><span class="shortcut-desc">靜音切換</span></div>
      <div class="shortcut-item"><span class="shortcut-key">S</span><span class="shortcut-desc">隨機播放</span></div>
      <div class="shortcut-item"><span class="shortcut-key">L</span><span class="shortcut-desc">喜歡/取消</span></div>
      <div class="shortcut-item"><span class="shortcut-key">J</span><span class="shortcut-desc">歌詞提前 0.5s</span></div>
