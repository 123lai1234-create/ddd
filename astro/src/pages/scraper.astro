---
import Base from '../layouts/Base.astro';
const bodyHtml = "\n    <div data-site-nav></div>\n\n    <section class=\"sc-hero\">\n        <h1>Web Scraper Demo</h1>\n        <p>輸入任何 URL，後端用 <code>httpx</code> 抓取並解析出 title、meta、OG 標籤、H1、連結與文字預覽。含 SSRF 防護、8s 超時、2 MB 大小上限。</p>\n        <div class=\"sc-tech\">\n            <span>FastAPI</span>\n            <span>httpx</span>\n            <span>regex parse</span>\n            <span>SSRF guard</span>\n            <span>slowapi rate-limit</span>\n        </div>\n    </section>\n\n    <div class=\"sc-wrap\">\n        <div class=\"sc-input-row\">\n            <input id=\"scUrl\" class=\"sc-input\" type=\"url\" placeholder=\"https://example.com\" value=\"\">\n            <button id=\"scBtn\" class=\"sc-btn\" onclick=\"doScrape()\">▶ 抓取解析</button>\n        </div>\n        <div class=\"sc-samples\">\n            <span class=\"sc-sample\" data-url=\"https://en.wikipedia.org/wiki/Cortex-M\">en.wikipedia.org/wiki/Cortex-M</span>\n            <span class=\"sc-sample\" data-url=\"https://www.nuvoton.com/products/microcontrollers/arm-cortex-m0-mcus/nano130-advanced-series/nano130ke3bn/?__locale=zh_TW\">Nuvoton Nano130</span>\n            <span class=\"sc-sample\" data-url=\"https://news.ycombinator.com/\">Hacker News</span>\n            <span class=\"sc-sample\" data-url=\"https://astro.build/\">astro.build</span>\n            <span class=\"sc-sample\" data-url=\"https://example.com\">example.com</span>\n        </div>\n\n        <div id=\"scResult\"></div>\n    </div>\n\n    <div data-site-footer></div>\n    <button class=\"scroll-top\" aria-label=\"返回頂部\">↑</button>\n\n    <script>\n        document.querySelectorAll('.sc-sample').forEach(el => {\n            el.addEventListener('click', () => {\n                document.getElementById('scUrl').value = el.dataset.url;\n                doScrape();\n            });\n        });\n\n        function esc(s) {\n            return String(s || '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n        }\n\n        async function doScrape() {\n            const url = document.getElementById('scUrl').value.trim();\n            const btn = document.getElementById('scBtn');\n            const out = document.getElementById('scResult');\n            if (!url) { out.innerHTML = '<div class=\"sc-err\">請輸入 URL</div>'; return; }\n            btn.disabled = true; btn.textContent = '抓取中…';\n            out.innerHTML = '<div class=\"sc-card\"><div class=\"sc-spec\">⏳ 正在解析 ' + esc(url) + ' …</div></div>';\n\n            let apiBase = '';\n            try {\n                if (typeof resolvePortfolioApiBase === 'function') {\n                    apiBase = await resolvePortfolioApiBase() || '';\n                } else if (window.APP_CONFIG?.API_BASE_URL) {\n                    apiBase = window.APP_CONFIG.API_BASE_URL.replace(/\\/+$/, '');\n                }\n            } catch(e) {}\n            const endpoint = (apiBase || '') + '/api/scrape';\n\n            try {\n                const res = await fetch(endpoint, {\n                    method: 'POST',\n                    headers: {'Content-Type': 'application/json'},\n                    body: JSON.stringify({url})\n                });\n                const data = await res.json();\n                if (!res.ok) throw new Error(data.detail || res.statusText);\n                render(data);\n            } catch(err) {\n                out.innerHTML = '<div class=\"sc-err\">失敗：' + esc(err.message) + '</div>';\n            } finally {\n                btn.disabled = false; btn.textContent = '▶ 抓取解析';\n            }\n        }\n\n        function render(d) {\n            const out = document.getElementById('scResult');\n            const parts = [];\n\n            parts.push(`<div class=\"sc-card\">\n                <h3>📋 Metadata</h3>\n                <div class=\"sc-meta\">\n                    <div><div class=\"lbl\">Title</div><div class=\"val\">${esc(d.title) || '<em style=\"color:var(--dim)\">(none)</em>'}</div></div>\n                    <div><div class=\"lbl\">Description</div><div class=\"val\">${esc(d.description) || '<em style=\"color:var(--dim)\">(none)</em>'}</div></div>\n                    <div><div class=\"lbl\">OG Title</div><div class=\"val\">${esc(d.og_title) || '<em style=\"color:var(--dim)\">(none)</em>'}</div></div>\n                    <div><div class=\"lbl\">Status</div><div class=\"val\">${d.status_code} · ${(d.size_bytes/1024).toFixed(1)} KB</div></div>\n                    <div><div class=\"lbl\">Final URL</div><div class=\"val\">${esc(d.url)}</div></div>\n                    <div><div class=\"lbl\">Text Length</div><div class=\"val\">${d.text_length.toLocaleString()} chars</div></div>\n                </div>\n                ${d.og_image ? `<img src=\"${esc(d.og_image)}\" class=\"sc-og\" alt=\"OG Image\" onerror=\"this.style.display='none'\">` : ''}\n            </div>`);\n\n            if (d.h1 && d.h1.length) {\n                parts.push(`<div class=\"sc-card\">\n                    <h3>🔤 H1 Headings (${d.h1.length})</h3>\n                    <ul class=\"sc-h1-list\">${d.h1.map(h => `<li>${esc(h)}</li>`).join('')}</ul>\n                </div>`);\n            }\n\n            if (d.links && d.links.length) {\n                parts.push(`<div class=\"sc-card\">\n                    <h3>🔗 Links (top ${d.links.length})</h3>\n                    <div class=\"sc-links\">${d.links.map(l => `\n                        <a href=\"${esc(l.href)}\" target=\"_blank\" rel=\"noopener\">\n                            <span>${esc(l.text)}</span>\n                            <span class=\"href\">${esc(l.href)}</span>\n                        </a>`).join('')}</div>\n                </div>`);\n            }\n\n            if (d.text_preview) {\n                parts.push(`<div class=\"sc-card\">\n                    <h3>📝 Text Preview (first 800 chars)</h3>\n                    <div class=\"sc-text\">${esc(d.text_preview)}</div>\n                </div>`);\n            }\n\n            out.innerHTML = parts.join('');\n        }\n\n        document.getElementById('scUrl').addEventListener('keydown', e => {\n            if (e.key === 'Enter') doScrape();\n        });\n    </script>\n";
---
<Base
    title="Web Scraper Demo · 網頁爬蟲互動"
    description="輸入 URL 即時解析網頁：標題、描述、OG 標籤、H1、連結清單、純文字預覽。後端有 SSRF 防護、超時、rate limit。"
    bodyPage="scraper"
    pageStyles={[]}
    pageScripts={[]}
>
    <Fragment set:html={bodyHtml} />
</Base>
