---
import Base from '../layouts/Base.astro';
---
<Base
    title="搜尋 | Portfolio"
    description="搜尋 DontTalk 全部頁面內容"
    ogTag="Search"
    bodyPage="search"
>
    <div data-site-nav></div>
    <main style="max-width:720px;margin:0 auto;padding:60px 24px">
        <div class="section-label">Search</div>
        <h1 style="font-size:clamp(1.6rem,4vw,2.4rem);font-weight:700;margin:8px 0 16px;color:var(--text)">站內搜尋</h1>
        <p style="color:var(--muted);margin-bottom:24px">在右下角按 🔍 也可開啟搜尋面板，或按 <kbd>Ctrl/⌘ + K</kbd>。</p>

        <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;border:1px solid var(--border,rgba(255,255,255,.12));border-radius:14px;background:var(--surface,rgba(255,255,255,.04));margin-bottom:16px">
            <span style="color:var(--muted,#8b949e);font-size:1.1rem">🔍</span>
            <input id="search-page-input" placeholder="搜尋標題、內文…" autocomplete="off" spellcheck="false"
                style="flex:1;background:none;border:none;outline:none;font-size:1rem;color:var(--text,#e6edf3);font-family:inherit" />
            <kbd style="font-size:.75rem;color:var(--muted,#8b949e);border:1px solid var(--border,rgba(255,255,255,.12));border-radius:4px;padding:2px 6px">Esc</kbd>
        </div>
        <div id="search-page-results" style="display:flex;flex-direction:column;gap:0"></div>
    </main>
    <div data-site-footer></div>

    <script is:inline>
    (function() {
        const input = document.getElementById('search-page-input');
        const results = document.getElementById('search-page-results');
        let pf = null, debounce = null;

        async function init() {
            if (pf) return;
            try {
                pf = await import('/pagefind/pagefind.js');
                await pf.init();
            } catch (e) {
                results.innerHTML = '<p style="color:var(--muted);font-size:.9rem;padding:24px 0">搜尋索引尚未建立（需要先 build）。</p>';
            }
        }

        async function run(q) {
            if (!pf || !q.trim()) { results.innerHTML = ''; return; }
            const sr = await pf.search(q);
            const items = await Promise.all(sr.results.slice(0, 12).map(r => r.data()));
            results.innerHTML = items.length
                ? items.map(d => `<a href="${d.url}" style="display:block;padding:16px 0;border-bottom:1px solid var(--border,rgba(255,255,255,.05));text-decoration:none;color:inherit">
                    <div style="font-size:1rem;font-weight:600;margin-bottom:4px;color:var(--text,#e6edf3)">${d.meta?.title || d.url}</div>
                    <div style="font-size:.82rem;color:var(--muted,#8b949e)">${d.excerpt}</div>
                  </a>`).join('')
                : '<p style="color:var(--muted);font-size:.9rem;padding:24px 0">找不到結果。</p>';
        }

        input.addEventListener('input', () => {
            clearTimeout(debounce);
            debounce = setTimeout(() => run(input.value), 250);
        });

        // Auto-focus the input on load
        input.focus();
        // Lazy-init pagefind on first interaction
        input.addEventListener('focus', init, { once: true });
    })();
    </script>
</Base>