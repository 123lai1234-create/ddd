<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>台股均線買賣訊號系統 · 站內小工具</title>
<meta name="description" content="台股 K 線 + 均線訊號 + 法人買賣超 + 盤中監控 + 自選股（同步 replit 系統）">
<style>
  *,*::before,*::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; height: 100%; background: #0d1117; color: #e6edf3; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft JhengHei", sans-serif; }
  .frame-shell { position: fixed; inset: 0; display: flex; flex-direction: column; background: #0d1117; }
  .frame-bar { flex: 0 0 auto; display: flex; align-items: center; gap: 12px; padding: 10px 16px; background: #161b22; border-bottom: 1px solid #30363d; font-size: 13px; }
  .frame-bar .dot { width: 10px; height: 10px; border-radius: 50%; background: #ff5f56; box-shadow: 0 0 6px rgba(255,95,86,0.6); }
  .frame-bar .label { color: #e6edf3; font-weight: 600; }
  .frame-bar .sub { color: #8b949e; }
  .frame-bar .spacer { flex: 1; }
  .frame-bar a { color: #58a6ff; text-decoration: none; }
  .frame-bar a:hover { text-decoration: underline; }
  .frame-host { flex: 1 1 auto; position: relative; min-height: 0; }
  .frame-host iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #0d1117; }
  .frame-fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 24px; text-align: center; color: #8b949e; }
  .frame-fallback code { color: #e6edf3; }
  @media (max-width: 600px) {
    .frame-bar { flex-wrap: wrap; }
    .frame-bar .sub { display: none; }
  }
</style>
</head>
<body>
  <div class="frame-shell">
    <div class="frame-bar">
      <span class="dot"></span>
      <span class="label">📊 台股均線買賣訊號系統</span>
      <span class="sub">資料即時同步自 replit 後端</span>
      <span class="spacer"></span>
      <a href="https://ddd--8888uhiuh.replit.app/stock-app/index.html" target="_blank" rel="noopener">在新分頁開啟 ↗</a>
    </div>
    <div class="frame-host">
      <iframe
        src="https://ddd--8888uhiuh.replit.app/stock-app/index.html"
        title="台股均線買賣訊號系統"
        loading="eager"
        referrerpolicy="no-referrer-when-downgrade"
        allow="fullscreen; clipboard-read; clipboard-write"
      ></iframe>
      <noscript class="frame-fallback">
        <div>
          <p>此頁面需要 JavaScript 才能載入 iframe。</p>
          <p>請改用 <a href="https://ddd--8888uhiuh.replit.app/stock-app/index.html" target="_blank" rel="noopener">replit 直接連結</a>。</p>
        </div>
      </noscript>
    </div>
  </div>
  <script>
    // iframe 載入失敗偵測：若 replit 掛了，顯示提示
    (function() {
      const iframe = document.querySelector('.frame-host iframe');
      const host = document.querySelector('.frame-host');
      let loaded = false;
      iframe.addEventListener('load', () => { loaded = true; });
      // replit 一般 5s 內會有回應，10s 沒 load 視為失敗
      setTimeout(() => {
        if (!loaded) {
          const fb = document.createElement('div');
          fb.className = 'frame-fallback';
          fb.innerHTML = '<div><p>⚠️ replit 系統目前無回應。</p><p>請稍後再試，或<a href="https://ddd--8888uhiuh.replit.app/stock-app/index.html" target="_blank" rel="noopener">直接前往 replit ↗</a></p></div>';
          host.appendChild(fb);
        }
      }, 10000);
    })();
  </script>
</body>
</html>
