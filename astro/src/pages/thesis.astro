---
import Base from '../layouts/Base.astro';
const bodyHtml = "\r\n    <div data-site-nav></div>\r\n\r\n    <header class=\"hero\">\r\n        <div class=\"hero-inner\">\r\n            <div class=\"eyebrow\"><span class=\"live-dot\"></span>碩士論文 · 電資工程研究所 · PPTS × GAPPTS</div>\r\n            <h1>遺傳演算法於<span>利潤價格分布</span>為基礎的<br>交易策略最佳化技術之研究</h1>\r\n            <p class=\"hero-sub\">\r\n                依論文方法重建的互動展示頁，核心流程是先用 PPTS 將歷史價格切成等距區間，計算各區間的平均利潤與達標機率，再用 GAPPTS 在 48 檔元大台灣 50 股票樣本上搜尋最佳參數組合。\r\n            </p>\r\n            <div class=\"hero-badges\">\r\n                <span class=\"badge\">48 檔股票樣本</span>\r\n                <span class=\"badge\">2019–2023 訓練</span>\r\n                <span class=\"badge\">2024 測試</span>\r\n                <span class=\"badge\">PPTS</span>\r\n                <span class=\"badge\">GAPPTS</span>\r\n                <span class=\"badge\">價格區間利潤分析</span>\r\n            </div>\r\n            <div class=\"stats-strip\">\r\n                <div class=\"stat-cell\">\r\n                    <div class=\"stat-val\" id=\"statSharpe\">—</div>\r\n                    <div class=\"stat-lbl\">正報酬覆蓋率</div>\r\n                </div>\r\n                <div class=\"stat-cell\">\r\n                    <div class=\"stat-val\" id=\"statReturn\">—</div>\r\n                    <div class=\"stat-lbl\">股票樣本數</div>\r\n                </div>\r\n                <div class=\"stat-cell\">\r\n                    <div class=\"stat-val\" id=\"statWin\">—</div>\r\n                    <div class=\"stat-lbl\">訓練期間</div>\r\n                </div>\r\n                <div class=\"stat-cell\">\r\n                    <div class=\"stat-val\" id=\"statTest\">—</div>\r\n                    <div class=\"stat-lbl\">測試期間</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </header>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">研究方法</div>\r\n            <h2 class=\"section-title\">PPTS × GAPPTS 研究流程</h2>\r\n            <p class=\"section-sub\">論文把歷史價格資料拆成價格區間統計問題，再用遺傳演算法搜尋最佳區間數、持有天數、目標利潤與進場門檻，避免固定參數策略在不同個股與產業上失靈。</p>\r\n            <div class=\"algo-flow\" style=\"margin-bottom:28px\">\r\n                <div class=\"algo-step\">\r\n                    <div class=\"icon\">🗃</div>\r\n                    <div class=\"lbl\">資料整理</div>\r\n                    <div class=\"sub\">48 檔個股 · 2019–2024</div>\r\n                </div>\r\n                <div class=\"algo-arrow\">→</div>\r\n                <div class=\"algo-step\">\r\n                    <div class=\"icon\">📏</div>\r\n                    <div class=\"lbl\">PPTS 區間切分</div>\r\n                    <div class=\"sub\">將價格切成 m 個等距區間</div>\r\n                </div>\r\n                <div class=\"algo-arrow\">→</div>\r\n                <div class=\"algo-step\">\r\n                    <div class=\"icon\">📈</div>\r\n                    <div class=\"lbl\">利潤機率分析</div>\r\n                    <div class=\"sub\">平均利潤 + 達標機率</div>\r\n                </div>\r\n                <div class=\"algo-arrow\">→</div>\r\n                <div class=\"algo-step\">\r\n                    <div class=\"icon\">🎯</div>\r\n                    <div class=\"lbl\">輪盤選擇</div>\r\n                    <div class=\"sub\">保留高適應度參數組</div>\r\n                </div>\r\n                <div class=\"algo-arrow\">→</div>\r\n                <div class=\"algo-step\">\r\n                    <div class=\"icon\">🔀</div>\r\n                    <div class=\"lbl\">交叉 / 突變</div>\r\n                    <div class=\"sub\">CR 0.8 · MR 0.1</div>\r\n                </div>\r\n                <div class=\"algo-arrow\">→</div>\r\n                <div class=\"algo-step\">\r\n                    <div class=\"icon\">✅</div>\r\n                    <div class=\"lbl\">最佳策略</div>\r\n                    <div class=\"sub\">輸出逐檔最佳參數</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"grid-3\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">染色體結構（29 bit）</div>\r\n                    <div id=\"chromTable\"></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">適應度與評估指標</div>\r\n                    <div id=\"fitnessTable\"></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">研究資料設計</div>\r\n                    <div style=\"font-size:.82rem;line-height:1.8;color:var(--muted)\">\r\n                        <span style=\"color:var(--green);font-weight:600\">母體：</span>元大台灣 50 成分股中的 48 檔股票<br>\r\n                        <span style=\"color:var(--green);font-weight:600\">訓練集：</span>2019–2023 歷史資料<br>\r\n                        <span style=\"color:var(--green);font-weight:600\">測試集：</span>2024 外樣本回測<br>\r\n                        <span style=\"color:var(--green);font-weight:600\">系統：</span>Python、SQL Server、Gradio 介面<br>\r\n                        <span style=\"color:var(--green);font-weight:600\">目標：</span>比較 GAPPTS、固定參數 PPTS 與 Buy &amp; Hold\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">論文核心</div>\r\n            <h2 class=\"section-title\">PPTS 價格區間利潤邏輯</h2>\r\n            <p class=\"section-sub\">PPTS 先依買入價把歷史交易切進不同價格區間，統計每個區間的平均利潤與達標機率，再用 α 門檻判斷該區間屬於買入訊號還是保守區間。</p>\r\n            <div class=\"grid-2\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">所選個股的價格區間平均利潤 / 達標機率</div>\r\n                    <div class=\"card-note\">每個柱狀代表該價格區間的平均利潤，折線代表達成目標利潤的機率。綠色區間表示通過 α 門檻的買入候選。</div>\r\n                    <div class=\"chart-box\"><canvas id=\"returnDistChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">48 檔樣本績效分級</div>\r\n                    <div class=\"card-note\">論文把樣本分成「有效果」「一般」「無效果」三類。互動頁保留同一個分級框架，方便直接對照研究結果。</div>\r\n                    <div class=\"chart-box\"><canvas id=\"profitDistChart\"></canvas></div>\r\n                </div>\r\n            </div>\r\n            <div class=\"grid-3\" style=\"margin-top:14px\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">所選個股最佳化參數</div>\r\n                    <div id=\"gen0Stats\" style=\"margin-top:6px\"></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">所選個股測試績效</div>\r\n                    <div id=\"finalStats\" style=\"margin-top:6px\"></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">論文整體觀察</div>\r\n                    <div id=\"impStats\" style=\"margin-top:6px\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">互動體驗</div>\r\n            <h2 class=\"section-title\">選股與 GAPPTS 參數產生 GAPPTS 策略</h2>\r\n            <p class=\"section-sub\">你可以切換不同 ETF50 個股，重新執行 GAPPTS，觀察相同方法在不同產業與價格結構上會如何收斂到不同的參數組合。</p>\r\n            <div class=\"ga-cfg-panel\">\r\n                <div class=\"ga-cfg-grid\">\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"industryFilter\">產業篩選</label>\r\n                        <select class=\"ga-cfg-input\" id=\"industryFilter\"></select>\r\n                        <div class=\"ga-cfg-hint\">依論文的跨產業比較方式切換股票池</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"stockSelect\">個股</label>\r\n                        <select class=\"ga-cfg-input\" id=\"stockSelect\"></select>\r\n                        <div class=\"ga-cfg-hint\">逐檔查看 PPTS / GAPPTS 的參數與績效差異</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"cfgPop\">族群規模 (POP)</label>\r\n                        <input class=\"ga-cfg-input\" id=\"cfgPop\" type=\"number\" value=\"50\" min=\"20\" max=\"120\" step=\"10\">\r\n                        <div class=\"ga-cfg-hint\">論文建議值：50</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"cfgGens\">最大世代數 (GENS)</label>\r\n                        <input class=\"ga-cfg-input\" id=\"cfgGens\" type=\"number\" value=\"50\" min=\"10\" max=\"80\" step=\"5\">\r\n                        <div class=\"ga-cfg-hint\">論文系統預設：50</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"cfgCR\">交配率 (CR)</label>\r\n                        <input class=\"ga-cfg-input\" id=\"cfgCR\" type=\"number\" value=\"0.80\" min=\"0.30\" max=\"1.00\"\r\n                            step=\"0.05\">\r\n                        <div class=\"ga-cfg-hint\">輪盤選擇後的單點交叉機率</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"cfgMR\">突變率 (MR)</label>\r\n                        <input class=\"ga-cfg-input\" id=\"cfgMR\" type=\"number\" value=\"0.10\" min=\"0.01\" max=\"0.30\"\r\n                            step=\"0.01\">\r\n                        <div class=\"ga-cfg-hint\">論文系統預設：0.10</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"strat-m\">價格區間數 m</label>\r\n                        <input class=\"ga-cfg-input\" id=\"strat-m\" type=\"number\" value=\"8\" min=\"2\" max=\"20\" step=\"1\">\r\n                        <div class=\"ga-cfg-hint\">PPTS 將價格切成 m 個等距區間</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"strat-hold\">持有天數</label>\r\n                        <input class=\"ga-cfg-input\" id=\"strat-hold\" type=\"number\" value=\"5\" min=\"1\" max=\"30\" step=\"1\">\r\n                        <div class=\"ga-cfg-hint\">買入後持有天數</div>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"strat-target\">目標利潤 (%)</label>\r\n                        <input class=\"ga-cfg-input\" id=\"strat-target\" type=\"number\" value=\"3.0\" min=\"0.5\" max=\"20\"\r\n                            step=\"0.5\">\r\n                        <div class=\"ga-cfg-hint\">區間達標機率的門檻</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"stock-meta\" id=\"selectedStockMeta\"></div>\r\n                <div class=\"ga-cfg-actions\">\r\n                    <button class=\"btn btn-primary\" id=\"btnRerun\" onclick=\"rerunGA()\">▶ 產生 GAPPTS 策略</button>\r\n                    <button class=\"btn btn-ghost\" onclick=\"resetGaCfg()\">↩ 重置論文預設</button>\r\n                    <button class=\"btn btn-ghost\" id=\"btnSyncStocks\"\r\n                        style=\"color:var(--teal);border-color:rgba(88,215,255,0.2)\">📡 同步真實股價</button>\r\n                    <span class=\"ga-cfg-status\" id=\"cfgStatus\"></span>\r\n                </div>\r\n            </div>            </div>\r\n        </div>\r\n    </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">回測結果</div>\r\n            <h2 class=\"section-title\">最佳策略的測試集表現與交易明細</h2>\r\n            <p class=\"section-sub\">依 GA 搜尋得到的最佳參數（m / hold / target）回到 2024+ 測試集重跑，疊上買賣訊號、淨值曲線、績效統計與最近 8 筆交易。</p>\r\n            <div class=\"grid-2\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">測試集價格 + 買賣訊號</div>\r\n                    <div class=\"chart-box\"><canvas id=\"priceChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">策略淨值曲線</div>\r\n                    <div class=\"chart-box\"><canvas id=\"equityChart\"></canvas></div>\r\n                </div>\r\n            </div>\r\n            <div class=\"grid-2\" style=\"margin-top:18px\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">績效統計</div>\r\n                    <div id=\"perfStats\" class=\"kv-rows\"></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">近 8 筆交易</div>\r\n                    <div id=\"tradeList\" class=\"trade-list\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">演算法模擬</div>\r\n            <h2 class=\"section-title\">GAPPTS 互動模擬器</h2>\r\n            <p class=\"section-sub\">逐代觀察族群適應度如何收斂，以及最優染色體如何在 4 維參數空間中逼近所選個股的最佳策略設定。</p>\r\n            <div class=\"ga-controls\">\r\n                <button class=\"btn btn-ghost\" id=\"btnFirst\" onclick=\"gotoGen(0)\">⏮ 第一代</button>\r\n                <button class=\"btn btn-ghost\" id=\"btnPrev\" onclick=\"gotoGen(curGen-1)\">← 前一代</button>\r\n                <div class=\"gen-display\" id=\"genDisplay\">第 1 代 / 50</div>\r\n                <button class=\"btn btn-ghost\" id=\"btnNext\" onclick=\"gotoGen(curGen+1)\">下一代 →</button>\r\n                <button class=\"btn btn-ghost\" id=\"btnLast\" onclick=\"gotoGen(lastGenIndex())\">⏭ 最終代</button>\r\n                <button class=\"btn btn-primary\" id=\"btnPlay\" onclick=\"togglePlay()\">▶ 自動播放</button>\r\n                <div class=\"fitness-badge\" id=\"fitBadge\">Fitness —</div>\r\n            </div>\r\n            <div class=\"ga-grid\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">族群適應度收斂曲線</div>\r\n                    <div class=\"chart-box\"><canvas id=\"convChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">第 <span id=\"popGenLabel\">1</span> 代族群 fitness 分布</div>\r\n                    <div class=\"chart-box\"><canvas id=\"popDistChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\" style=\"grid-column:1/-1\">\r\n                    <div class=\"card-title\" style=\"margin-bottom:16px\">當代最佳染色體 → PPTS 參數</div>\r\n                    <div class=\"param-grid\" id=\"paramGrid\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">方法比較</div>\r\n            <h2 class=\"section-title\">GAPPTS vs 固定參數 PPTS vs Buy &amp; Hold</h2>\r\n            <p class=\"section-sub\">論文指出 GAPPTS 相較固定參數策略與 Buy &amp; Hold 能更有效提升報酬與風險控制。這裡用所選個股的互動重跑結果做同一視角比較。</p>\r\n            <div class=\"grid-2\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">所選個股報酬比較</div>\r\n                    <div class=\"chart-box\"><canvas id=\"compareChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">同評估預算下的搜尋效率</div>\r\n                    <div class=\"chart-box\"><canvas id=\"efficiencyChart\"></canvas></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">實證發現</div>\r\n            <h2 class=\"section-title\">股票分類與最佳訓練期間</h2>\r\n            <p class=\"section-sub\">論文第四章實證結果顯示，不同產業與公司特性對應不同的最佳訓練期間與參數組合。統一的預測模型在台股不適用，差異化策略才能發揮 GAPPTS 的優勢。</p>\r\n\r\n            <div class=\"grid-3\" style=\"margin-bottom:18px\">\r\n                <div class=\"card\" style=\"border-top:3px solid var(--blue)\">\r\n                    <div class=\"card-title\" style=\"color:var(--blue)\">長期穩定型 · 5–8 年</div>\r\n                    <div style=\"font-size:.82rem;line-height:1.9;color:var(--muted);margin-top:6px\">\r\n                        中華電 (2412) · 台塑 (1301) · 合庫金 (5880)<br>\r\n                        <span style=\"color:var(--dim)\">產業特性穩定、現金流可預期</span><br>\r\n                        <span style=\"color:var(--green);font-weight:600\">建議：</span>年度重新訓練\r\n                    </div>\r\n                </div>\r\n                <div class=\"card\" style=\"border-top:3px solid var(--green)\">\r\n                    <div class=\"card-title\" style=\"color:var(--green)\">中期轉型型 · 4–6 年</div>\r\n                    <div style=\"font-size:.82rem;line-height:1.9;color:var(--muted);margin-top:6px\">\r\n                        聯電 (2303) · 富邦金 (2881) · 廣達 (2382)<br>\r\n                        <span style=\"color:var(--dim)\">產業週期明顯、有轉型需求</span><br>\r\n                        <span style=\"color:var(--green);font-weight:600\">建議：</span>半年重新訓練\r\n                    </div>\r\n                </div>\r\n                <div class=\"card\" style=\"border-top:3px solid var(--orange)\">\r\n                    <div class=\"card-title\" style=\"color:var(--orange)\">短期動態型 · 3–5 年</div>\r\n                    <div style=\"font-size:.82rem;line-height:1.9;color:var(--muted);margin-top:6px\">\r\n                        聯發科 (2454) · 鴻海 (2317) · 日月光 (3711)<br>\r\n                        <span style=\"color:var(--dim)\">國際供應鏈高度敏感、波動大</span><br>\r\n                        <span style=\"color:var(--green);font-weight:600\">建議：</span>3–4 個月重新訓練\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"grid-2\" style=\"margin-bottom:18px\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">代表性個股 fitness 排名（論文第四章）</div>\r\n                    <div class=\"card-note\">聯電在中期轉型型中取得最高 fitness 0.7058，聯發科次之。長期穩定型股票整體 fitness 相對較低。</div>\r\n                    <div class=\"chart-box\"><canvas id=\"fitnessRankChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">各產業最佳訓練期間範圍</div>\r\n                    <div class=\"card-note\">科技類（半導體、電子製造）偏短，金融適中，電信/石化等傳統產業偏長。</div>\r\n                    <div class=\"chart-box\"><canvas id=\"industryPeriodChart\"></canvas></div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"card\">\r\n                <div class=\"card-title\">高適應度股票的共通參數特徵</div>\r\n                <div\r\n                    style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-top:12px\">\r\n                    <div\r\n                        style=\"padding:14px;background:rgba(123,240,190,0.06);border-radius:12px;border:1px solid rgba(123,240,190,0.15)\">\r\n                        <div style=\"color:var(--green);font-size:.75rem;letter-spacing:.08em;font-weight:600\">目標獲利率\r\n                        </div>\r\n                        <div style=\"font-size:1.4rem;font-weight:700;margin:4px 0\">低水位</div>\r\n                        <div style=\"color:var(--muted);font-size:.78rem;line-height:1.6\">避免過度貪婪 · 做頻繁但小額獲利</div>\r\n                    </div>\r\n                    <div\r\n                        style=\"padding:14px;background:rgba(88,215,255,0.06);border-radius:12px;border:1px solid rgba(88,215,255,0.15)\">\r\n                        <div style=\"color:var(--teal);font-size:.75rem;letter-spacing:.08em;font-weight:600\">持有天數</div>\r\n                        <div style=\"font-size:1.4rem;font-weight:700;margin:4px 0\">18–29 天</div>\r\n                        <div style=\"color:var(--muted);font-size:.78rem;line-height:1.6\">中短期策略在台股較為有效</div>\r\n                    </div>\r\n                    <div\r\n                        style=\"padding:14px;background:rgba(181,156,255,0.06);border-radius:12px;border:1px solid rgba(181,156,255,0.15)\">\r\n                        <div style=\"color:var(--purple);font-size:.75rem;letter-spacing:.08em;font-weight:600\">α 進場係數\r\n                        </div>\r\n                        <div style=\"font-size:1.4rem;font-weight:700;margin:4px 0\">0.4–0.8</div>\r\n                        <div style=\"color:var(--muted);font-size:.78rem;line-height:1.6\">中等門檻平衡機會與品質</div>\r\n                    </div>\r\n                    <div\r\n                        style=\"padding:14px;background:rgba(255,188,114,0.06);border-radius:12px;border:1px solid rgba(255,188,114,0.15)\">\r\n                        <div style=\"color:var(--orange);font-size:.75rem;letter-spacing:.08em;font-weight:600\">染色體結構\r\n                        </div>\r\n                        <div style=\"font-size:1.4rem;font-weight:700;margin:4px 0\">29 bit</div>\r\n                        <div style=\"color:var(--muted);font-size:.78rem;line-height:1.6\">區間 5 · 週期 6 · 目標 10 · α 8</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">文獻對照</div>\r\n            <h2 class=\"section-title\">GAPPTS 相對其他演算法的定位</h2>\r\n            <p class=\"section-sub\">論文第二章系統性比較了多種股價預測方法。GAPPTS 的優勢在於不需要問題的嚴格數學模型、能避開局部最優、同時保留可解釋的交易規則輸出。</p>\r\n            <div class=\"card\">\r\n                <div class=\"card-title\">主流預測演算法比較表（論文表 4.4）</div>\r\n                <div style=\"overflow-x:auto;margin-top:12px\">\r\n                    <table style=\"width:100%;border-collapse:collapse;font-size:.84rem\">\r\n                        <thead>\r\n                            <tr style=\"border-bottom:2px solid var(--border);color:var(--muted);text-align:left\">\r\n                                <th style=\"padding:10px 12px\">演算法類別</th>\r\n                                <th style=\"padding:10px 12px\">預測精度</th>\r\n                                <th style=\"padding:10px 12px\">計算複雜度</th>\r\n                                <th style=\"padding:10px 12px\">適用資料規模</th>\r\n                                <th style=\"padding:10px 12px\">解釋性</th>\r\n                                <th style=\"padding:10px 12px\">非線性捕捉</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody id=\"algoCompareTable\"></tbody>\r\n                    </table>\r\n                </div>\r\n                <div class=\"card-note\" style=\"margin-top:14px;line-height:1.8\">\r\n                    <span style=\"color:var(--green);font-weight:600\">GAPPTS 定位：</span>\r\n                    結合基因演算法的全域搜索能力與 PPTS 的可解釋交易規則，在中型資料規模下取得高解釋性與高非線性捕捉的平衡 — 相較 LSTM/Transformer 不需海量資料，相較 ARIMA\r\n                    能處理非線性區間結構。\r\n                </div>\r\n                <div id=\"algoStrategyPanel\"\r\n                    style=\"display:none;margin-top:20px;padding:18px;border-radius:12px;border:1px solid rgba(123,240,190,0.2);background:rgba(123,240,190,0.04)\">\r\n                    <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:14px\">\r\n                        <div style=\"font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)\">\r\n                            選取演算法的交易策略</div>\r\n                        <button onclick=\"closeAlgoStrategy()\"\r\n                            style=\"background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:0 4px\">✕</button>\r\n                    </div>\r\n                    <div id=\"algoStrategyContent\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">技術指標補充</div>\r\n            <h2 class=\"section-title\">布林通道 · MACD · KD · 籌碼面 — 輔助進場確認</h2>\r\n            <p class=\"section-sub\">PPTS 以統計利潤分布識別買入區間，搭配技術面與籌碼面訊號可進一步提升進場品質。台股量化實戰案例顯示，「BBand 收斂 + KD 低檔回升 + MACD\r\n                動能翻正」三重共振型態，對應 PPTS 買入區間時，能有效過濾假突破、提升勝率。</p>\r\n            <div class=\"indicator-grid\">\r\n                <div class=\"ind-card\">\r\n                    <div class=\"ind-icon\">📊</div>\r\n                    <div>\r\n                        <div class=\"ind-title\">布林通道 Bollinger Bands</div>\r\n                        <div class=\"ind-body\">上下軌 = MA20 ± 2σ，通道寬度代表市場波動程度。通道收斂（Width ≤ 70% 均寬）是即將變盤的預警訊號，收斂後突破方向往往延續。\r\n                        </div>\r\n                        <div class=\"ind-signal\">收斂訊號：Width ≤ 均寬 × 0.70</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"ind-card\">\r\n                    <div class=\"ind-icon\">📉</div>\r\n                    <div>\r\n                        <div class=\"ind-title\">MACD 動能指標</div>\r\n                        <div class=\"ind-body\">DIF = EMA12 − EMA26，Signal = EMA9(DIF)，OSC = DIF − Signal。OSC\r\n                            直方圖由紅轉綠（負翻正）代表短期動能開始回升，是早期多方確認。</div>\r\n                        <div class=\"ind-signal\">確認訊號：OSC 由負轉正（柱狀翻綠）</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"ind-card\">\r\n                    <div class=\"ind-icon\">🎯</div>\r\n                    <div>\r\n                        <div class=\"ind-title\">KD 隨機指標</div>\r\n                        <div class=\"ind-body\">RSV 計算最近 9 日相對位置，K = 2/3 × K_prev + 1/3 × RSV，D = 2/3 × D_prev + 1/3 × K。K\r\n                            值從低檔向上穿越 D 值為黃金交叉，代表超賣後動能反轉。</div>\r\n                        <div class=\"ind-signal\">黃金交叉：K 由低檔上穿 D（K &lt; 50）</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"ind-card\">\r\n                    <div class=\"ind-icon\">🏦</div>\r\n                    <div>\r\n                        <div class=\"ind-title\">籌碼面 — 法人動向</div>\r\n                        <div class=\"ind-body\">外資 + 投信 + 自營商連續買超為多方籌碼訊號。主力買超千張以上且散戶同步賣超，代表聰明錢在低檔積累，是底部反轉候選股的關鍵條件之一。</div>\r\n                        <div class=\"ind-signal\">多方籌碼：法人連 3 日淨買超</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"grid-2\" style=\"margin-top:18px\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">所選個股 · 布林通道（測試集）</div>\r\n                    <div class=\"card-note\">實線為收盤價，橙色虛線為布林上下軌，半透明帶為通道範圍。通道收窄時即將面臨方向性突破。</div>\r\n                    <div class=\"chart-box\"><canvas id=\"bbandChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">KD 隨機指標 + MACD OSC（測試集）</div>\r\n                    <div class=\"card-note\">藍/橙線為 K/D 值（左軸 0–100），綠/紅直方圖為 MACD OSC（右軸）。</div>\r\n                    <div class=\"chart-box\"><canvas id=\"macdKdChart\"></canvas></div>\r\n                </div>\r\n            </div>\r\n            <div class=\"card\" style=\"margin-top:14px\">\r\n                <div class=\"card-title\">三重共振訊號偵測 — 同時滿足 ≥ 2 項技術條件</div>\r\n                <div class=\"card-note\">偵測測試集中同時達到「BBand 收斂 + KD 黃金交叉 + MACD OSC 翻正」中至少兩項的訊號點，為 PPTS 買入區間提供技術面輔助確認。</div>\r\n                <div id=\"tripleSignalPanel\" class=\"triple-signal-grid\"></div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">衍生性商品延伸</div>\r\n            <h2 class=\"section-title\">權證 vs 選擇權 — GAPPTS 策略延伸討論</h2>\r\n            <p class=\"section-sub\">GAPPTS 以價格區間識別方向性進場機會，除現股之外可搭配衍生性商品放大槓桿。台灣市場中，選擇權（台指選\r\n                TXO）在定價透明度與流動性上遠優於個股權證，更適合量化策略重複執行與歷史回測驗證。</p>\r\n            <div class=\"card\">\r\n                <div class=\"card-title\">量化策略適用性比較：權證 vs 選擇權</div>\r\n                <div style=\"overflow-x:auto;margin-top:12px\">\r\n                    <table style=\"width:100%;border-collapse:collapse;font-size:.84rem\">\r\n                        <thead>\r\n                            <tr style=\"border-bottom:2px solid var(--border);color:var(--muted);text-align:left\">\r\n                                <th style=\"padding:10px 12px\">特性</th>\r\n                                <th style=\"padding:10px 12px\">權證 (Warrant)</th>\r\n                                <th style=\"padding:10px 12px\">選擇權 (Option)</th>\r\n                                <th style=\"padding:10px 12px\">量化適用</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody id=\"derivativesTable\"></tbody>\r\n                    </table>\r\n                </div>\r\n            </div>\r\n            <div class=\"grid-2\" style=\"margin-top:14px\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">台積電假設情境損益比較（買方）</div>\r\n                    <div class=\"card-note\">現價 1000 元，履約價 1050，比較三種到期情境下的損益比。選擇權因 IV 公平定價，漲幅情境報酬明顯優於權證。</div>\r\n                    <div class=\"chart-box\"><canvas id=\"derivativesPayoffChart\"></canvas></div>\r\n                </div>\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">GAPPTS 延伸至衍生商品的操作建議</div>\r\n                    <div id=\"derivativesAdvicePanel\" style=\"margin-top:8px\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"section reveal\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">資源整理</div>\r\n            <h2 class=\"section-title\">投資研究工具全覽 · 今日重點複習</h2>\r\n            <p class=\"section-sub\">從總體經濟到個股分析，面對龐雜的財經資訊，善用對的工具能大幅提升研究效率。以下整理今日介紹的實用工具，建議依據自己的需求組合搭配使用。</p>\r\n            <div class=\"macro-notice\">\r\n                <div class=\"macro-notice-icon\">🌐</div>\r\n                <div>\r\n                    <strong\r\n                        style=\"color:var(--teal)\">總經局勢複習</strong>：掌握大環境方向是個股分析的基礎。總體經濟數據（GDP、通膨、利率、PMI）的趨勢變化，會直接影響資金流向與產業輪動節奏。建議定期追蹤總經指標，由上而下選股，並搭配今日附上的圖卡一起回顧總經重點。\r\n                </div>\r\n            </div>\r\n            <div class=\"tools-category\">\r\n                <div class=\"tools-category-label\">📊 投資與數據分析工具</div>\r\n                <div class=\"tools-grid\">\r\n                    <div class=\"tool-card\">\r\n                        <div class=\"tool-card-icon\">📈</div>\r\n                        <div class=\"tool-card-name\">財經 M 平方</div>\r\n                        <div class=\"tool-card-desc\">專注於「總體經濟」數據與趨勢分析，提供全球 GDP、通膨、利率、PMI 等關鍵指標視覺化，掌握大方向的必備工具。</div>\r\n                        <span class=\"tool-card-tag\">總體經濟</span>\r\n                    </div>\r\n                    <div class=\"tool-card\">\r\n                        <div class=\"tool-card-icon\">🐕</div>\r\n                        <div class=\"tool-card-name\">財報狗</div>\r\n                        <div class=\"tool-card-desc\">專精於「企業財報分析」，提供台股個股損益表、資產負債表、現金流量表整理，研究基本面、檢視公司體質的好幫手。</div>\r\n                        <span class=\"tool-card-tag\">基本面分析</span>\r\n                    </div>\r\n                    <div class=\"tool-card\">\r\n                        <div class=\"tool-card-icon\">💻</div>\r\n                        <div class=\"tool-card-name\">XQ 全球贏家</div>\r\n                        <div class=\"tool-card-desc\">強大的「股票分析」軟體，涵蓋即時看盤、技術指標、籌碼動向與程式交易，電腦版與手機版皆有。</div>\r\n                        <span class=\"tool-card-tag\">技術分析 · 籌碼</span>\r\n                    </div>\r\n                    <div class=\"tool-card\">\r\n                        <div class=\"tool-card-icon\">⚡</div>\r\n                        <div class=\"tool-card-name\">金十數據 APP</div>\r\n                        <div class=\"tool-card-desc\">提供即時且快速的全球財經新聞與數據庫，消息面追蹤效率高，適合需要即時掌握市場動態的投資人。</div>\r\n                        <span class=\"tool-card-tag\">即時財經新聞</span>\r\n                        <div class=\"tool-card-warning\">⚠ 中國大陸開發軟體，對資安或隱私有疑慮者請審慎評估後再決定是否下載使用。</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"tools-category\">\r\n                <div class=\"tools-category-label\">💡 補充與輔助工具</div>\r\n                <div class=\"tools-grid\">\r\n                    <div class=\"tool-card\">\r\n                        <div class=\"tool-card-icon\">🚦</div>\r\n                        <div class=\"tool-card-name\">處置王 APP</div>\r\n                        <div class=\"tool-card-desc\">專門查詢股票「何時被列入處置」的工具，避免在處置期間發生非預期的交易限制，對留意個股流動性風險非常實用。</div>\r\n                        <span class=\"tool-card-tag\">處置股票查詢</span>\r\n                    </div>\r\n                    <div class=\"tool-card\" style=\"border-color:rgba(123,240,190,0.22)\">\r\n                        <div class=\"tool-card-icon\">🤖</div>\r\n                        <div class=\"tool-card-name\">Claude · Gemini · Notebook LM</div>\r\n                        <div class=\"tool-card-desc\">強大的 AI 生產力助手。可快速整理龐雜財經資訊、總結長篇報告重點、梳理投資邏輯，善用 AI\r\n                            能大幅提升研究效率，打破舊有思考框架，看見更多投資機會。</div>\r\n                        <span class=\"tool-card-tag\"\r\n                            style=\"background:rgba(123,240,190,.1);color:var(--green);border-color:rgba(123,240,190,.25)\">AI\r\n                            輔助工具</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"market-ops\" class=\"section reveal admin-only\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">Live Market Ops</div>\r\n            <h2 class=\"section-title\">市場資料同步、TAIFEX 合約月與日線快取檢視</h2>\r\n            <p class=\"section-sub\">這一區直接讀取後端 market layer。你可以手動同步 TWSE 現貨、TAIFEX 期貨與 Yahoo fallback 資料，並直接檢查 instrument\r\n                cache、contract month 與最近日線 bars。</p>\r\n\r\n            <div class=\"ops-shell\">\r\n                <aside class=\"ops-panel ops-controls\">\r\n                    <div>\r\n                        <div class=\"card-title\">同步設定</div>\r\n                        <div class=\"card-note\">預設會同步台股、ETF、台指期 / 台股期，以及海外期貨 fallback。TAIFEX 合約月會保留在 bar cache 內。</div>\r\n                    </div>\r\n\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"marketStockSymbols\">TWSE stock symbols</label>\r\n                        <textarea class=\"ga-cfg-input\" id=\"marketStockSymbols\" rows=\"2\">2330, 2317</textarea>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"marketEtfSymbols\">TWSE ETF symbols</label>\r\n                        <textarea class=\"ga-cfg-input\" id=\"marketEtfSymbols\" rows=\"2\">0050, 0056</textarea>\r\n                    </div>\r\n                    <div class=\"ga-cfg-field\">\r\n                        <label class=\"ga-cfg-label\" for=\"marketFuturesSymbols\">Futures symbols</label>\r\n                        <textarea class=\"ga-cfg-input\" id=\"marketFuturesSymbols\"\r\n                            rows=\"3\">TX, MTX, 2330, 0050, ES=F</textarea>\r\n                    </div>\r\n\r\n                    <div class=\"ga-cfg-grid\" style=\"margin-bottom:0\">\r\n                        <div class=\"ga-cfg-field\">\r\n                            <label class=\"ga-cfg-label\" for=\"marketTwseMonths\">抓取月數</label>\r\n                            <select class=\"ga-cfg-input\" id=\"marketTwseMonths\">\r\n                                <option value=\"1\">1</option>\r\n                                <option value=\"2\">2</option>\r\n                                <option value=\"3\" selected>3</option>\r\n                            </select>\r\n                        </div>\r\n                        <div class=\"ga-cfg-field\">\r\n                            <label class=\"ga-cfg-label\" for=\"marketYahooRange\">Yahoo range</label>\r\n                            <select class=\"ga-cfg-input\" id=\"marketYahooRange\">\r\n                                <option value=\"1mo\">1mo</option>\r\n                                <option value=\"3mo\" selected>3mo</option>\r\n                                <option value=\"6mo\">6mo</option>\r\n                                <option value=\"1y\">1y</option>\r\n                            </select>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"ga-cfg-actions\">\r\n                        <button class=\"btn btn-primary\" id=\"marketSyncBtn\" type=\"button\">同步市場資料</button>\r\n                        <button class=\"btn btn-ghost\" id=\"marketReloadBtn\" type=\"button\">重新讀取快取</button>\r\n                    </div>\r\n\r\n                    <div id=\"marketStatus\" class=\"ops-status\">正在讀取市場資料快取...</div>\r\n                    <div class=\"ga-cfg-hint\">API base: <span id=\"marketApiLabel\">detecting...</span></div>\r\n                </aside>\r\n\r\n                <div class=\"ops-panel ops-results\">\r\n                    <div class=\"ops-top\">\r\n                        <div>\r\n                            <div class=\"card-title\">Market Cache</div>\r\n                            <div class=\"card-note\">點選 instrument 後，右側 bars 會重新查詢對應 symbol；若是 TAIFEX 來源，contract month\r\n                                會一起顯示。</div>\r\n                        </div>\r\n                        <span class=\"badge\">TWSE + TAIFEX + Yahoo</span>\r\n                    </div>\r\n\r\n                    <div id=\"marketSummary\" class=\"ops-summary\"></div>\r\n\r\n                    <div class=\"ops-toolbar\">\r\n                        <div class=\"ga-cfg-field\">\r\n                            <label class=\"ga-cfg-label\" for=\"marketAssetTypeFilter\">資產類型</label>\r\n                            <select class=\"ga-cfg-input\" id=\"marketAssetTypeFilter\">\r\n                                <option value=\"\">全部</option>\r\n                                <option value=\"stock\">Stock</option>\r\n                                <option value=\"etf\">ETF</option>\r\n                                <option value=\"futures\">Futures</option>\r\n                            </select>\r\n                        </div>\r\n                        <div class=\"ga-cfg-field\">\r\n                            <label class=\"ga-cfg-label\" for=\"marketInstrumentQuery\">搜尋 instrument</label>\r\n                            <input class=\"ga-cfg-input\" id=\"marketInstrumentQuery\" type=\"text\"\r\n                                placeholder=\"例如 TX, 2330, 0050, 台積電期貨\">\r\n                        </div>\r\n                        <div class=\"ga-cfg-field\">\r\n                            <label class=\"ga-cfg-label\" for=\"marketContractMonthFilter\">合約月篩選</label>\r\n                            <input class=\"ga-cfg-input\" id=\"marketContractMonthFilter\" type=\"text\"\r\n                                placeholder=\"例如 202404\">\r\n                        </div>\r\n                        <div id=\"marketFilterMeta\" class=\"ga-cfg-hint ops-toolbar-meta\">尚未載入資料</div>\r\n                    </div>\r\n\r\n                    <div id=\"marketInstrumentList\" class=\"ops-list\"></div>\r\n\r\n                    <div class=\"card\" style=\"margin-top:18px\">\r\n                        <div class=\"card-title\">Recent Daily Bars</div>\r\n                        <div id=\"marketBarsMeta\" class=\"card-note\">尚未選取 instrument。</div>\r\n                        <div id=\"marketBarsList\" class=\"ops-bar-list\"></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ═══ AI 估值計算器 ═══ -->\r\n    <div class=\"section reveal\" id=\"valuation-calc\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">AI 輔助估值</div>\r\n            <h2 class=\"section-title\">PE × PB 情境矩陣計算器</h2>\r\n            <p class=\"section-sub\">輸入個股的 EPS / BPS 與同業本益比範圍，即時產生悲觀 / 基本 / 樂觀三情境估值矩陣，並與真實市價比對。</p>\r\n\r\n            <div class=\"val-layout\">\r\n                <div class=\"val-inputs card\">\r\n                    <div class=\"card-title\">估值輸入</div>\r\n                    <div class=\"val-form\">\r\n                        <div class=\"val-field\">\r\n                            <label>股票代號</label>\r\n                            <div style=\"display:flex;gap:8px\">\r\n                                <input class=\"ga-cfg-input\" id=\"valCode\" type=\"text\" value=\"2330\" placeholder=\"例：2330\"\r\n                                    style=\"flex:1\">\r\n                                <button class=\"btn btn-ghost\" id=\"valFetchBtn\" onclick=\"valFetchPrice()\">抓現價</button>\r\n                            </div>\r\n                            <div class=\"ga-cfg-hint\" id=\"valPriceHint\">—</div>\r\n                        </div>\r\n                        <div class=\"val-field-group\">\r\n                            <div class=\"val-field\">\r\n                                <label>預估 EPS 悲觀 ($)</label>\r\n                                <input class=\"ga-cfg-input\" id=\"valEpsBear\" type=\"number\" value=\"32\" step=\"0.5\">\r\n                            </div>\r\n                            <div class=\"val-field\">\r\n                                <label>預估 EPS 基本 ($)</label>\r\n                                <input class=\"ga-cfg-input\" id=\"valEpsBase\" type=\"number\" value=\"38\" step=\"0.5\">\r\n                            </div>\r\n                            <div class=\"val-field\">\r\n                                <label>預估 EPS 樂觀 ($)</label>\r\n                                <input class=\"ga-cfg-input\" id=\"valEpsBull\" type=\"number\" value=\"45\" step=\"0.5\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"val-field-group\">\r\n                            <div class=\"val-field\">\r\n                                <label>PE 悲觀 (倍)</label>\r\n                                <input class=\"ga-cfg-input\" id=\"valPeBear\" type=\"number\" value=\"18\" step=\"1\">\r\n                            </div>\r\n                            <div class=\"val-field\">\r\n                                <label>PE 基本 (倍)</label>\r\n                                <input class=\"ga-cfg-input\" id=\"valPeBase\" type=\"number\" value=\"22\" step=\"1\">\r\n                            </div>\r\n                            <div class=\"val-field\">\r\n                                <label>PE 樂觀 (倍)</label>\r\n                                <input class=\"ga-cfg-input\" id=\"valPeBull\" type=\"number\" value=\"25\" step=\"1\">\r\n                            </div>\r\n                        </div>\r\n                        <div style=\"border-top:1px solid var(--border);margin:10px 0;padding-top:10px\">\r\n                            <div class=\"val-field-group\">\r\n                                <div class=\"val-field\">\r\n                                    <label>預估 BPS ($)</label>\r\n                                    <input class=\"ga-cfg-input\" id=\"valBps\" type=\"number\" value=\"120\" step=\"1\">\r\n                                </div>\r\n                                <div class=\"val-field\">\r\n                                    <label>PB 悲觀 (倍)</label>\r\n                                    <input class=\"ga-cfg-input\" id=\"valPbBear\" type=\"number\" value=\"2.0\" step=\"0.1\">\r\n                                </div>\r\n                                <div class=\"val-field\">\r\n                                    <label>PB 基本 (倍)</label>\r\n                                    <input class=\"ga-cfg-input\" id=\"valPbBase\" type=\"number\" value=\"2.5\" step=\"0.1\">\r\n                                </div>\r\n                                <div class=\"val-field\">\r\n                                    <label>PB 樂觀 (倍)</label>\r\n                                    <input class=\"ga-cfg-input\" id=\"valPbBull\" type=\"number\" value=\"3.0\" step=\"0.1\">\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <button class=\"btn btn-primary\" style=\"width:100%;margin-top:6px\"\r\n                            onclick=\"calcValuation()\">計算估值矩陣</button>\r\n                    </div>\r\n                </div>\r\n                <div class=\"val-results\">\r\n                    <div class=\"card\" id=\"valPeCard\" style=\"display:none\">\r\n                        <div class=\"card-title\">PE 法估值矩陣 <span class=\"badge\" style=\"font-size:.7rem\">悲 / 基 / 樂</span>\r\n                        </div>\r\n                        <div class=\"card-note\">單位：元。星號 ⭐ 為基本情境交叉點。</div>\r\n                        <div id=\"valPeTable\" style=\"overflow-x:auto;margin-top:10px\"></div>\r\n                    </div>\r\n                    <div class=\"card\" id=\"valPbCard\" style=\"display:none\">\r\n                        <div class=\"card-title\">PB 法估值矩陣</div>\r\n                        <div id=\"valPbTable\" style=\"overflow-x:auto;margin-top:10px\"></div>\r\n                    </div>\r\n                    <div class=\"card\" id=\"valSummaryCard\" style=\"display:none\">\r\n                        <div class=\"card-title\">重疊區間分析</div>\r\n                        <div id=\"valSummary\"></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ═══ 技術分析看板 ═══ -->\r\n    <div class=\"section reveal\" id=\"tech-analysis\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">技術分析</div>\r\n            <h2 class=\"section-title\">均線 × 支撐壓力即時看板</h2>\r\n            <p class=\"section-sub\">選擇個股後自動載入真實價格，計算 MA5 / MA20 / MA60、RSI(14) 與關鍵支撐壓力位，並標示多頭排列 / 黃金交叉等訊號。</p>\r\n\r\n            <div class=\"ta-controls\">\r\n                <div class=\"ga-cfg-field\">\r\n                    <label class=\"ga-cfg-label\" for=\"taStockSelect\">個股</label>\r\n                    <select class=\"ga-cfg-input\" id=\"taStockSelect\"></select>\r\n                </div>\r\n                <div class=\"ga-cfg-field\">\r\n                    <label class=\"ga-cfg-label\" for=\"taCustomCode\">或自行輸入代號</label>\r\n                    <input class=\"ga-cfg-input\" id=\"taCustomCode\" type=\"text\" placeholder=\"例：2454\">\r\n                </div>\r\n                <button class=\"btn btn-primary\" onclick=\"loadTechAnalysis()\">載入分析</button>\r\n                <span class=\"ga-cfg-hint\" id=\"taStatus\" style=\"align-self:center\"></span>\r\n            </div>\r\n\r\n            <div id=\"taResultArea\" style=\"display:none\">\r\n                <div class=\"ta-signal-strip\" id=\"taSignals\"></div>\r\n                <div class=\"grid-2\" style=\"margin-top:14px\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">價格 + 均線 <span id=\"taPriceLabel\"\r\n                                style=\"color:var(--muted);font-size:.78rem\"></span></div>\r\n                        <div class=\"chart-box\" style=\"height:240px\"><canvas id=\"taChart\"></canvas></div>\r\n                    </div>\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">RSI(14)</div>\r\n                        <div class=\"chart-box\" style=\"height:240px\"><canvas id=\"taRsiChart\"></canvas></div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"grid-3\" style=\"margin-top:14px\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">均線數值</div>\r\n                        <div id=\"taMaTable\" class=\"kv-rows\" style=\"margin-top:8px\"></div>\r\n                    </div>\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">關鍵支撐壓力</div>\r\n                        <div id=\"taSRTable\" style=\"margin-top:8px\"></div>\r\n                    </div>\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">技術訊號判讀</div>\r\n                        <div id=\"taSignalDetail\" style=\"margin-top:8px;font-size:.82rem;line-height:1.9\"></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ═══ 詳細技術分析 ═══ -->\r\n    <div class=\"section reveal\" id=\"detailed-ta\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">技術分析加強版</div>\r\n            <h2 class=\"section-title\">完整技術指標儀表板</h2>\r\n            <p class=\"section-sub\">整合 MACD、KD 隨機指標、布林通道與成交量分析，透過多重指標確認趨勢方向，提升進場訊號的可靠性。</p>\r\n\r\n            <div class=\"ta-controls\" style=\"margin-bottom:20px\">\r\n                <div class=\"ga-cfg-field\">\r\n                    <label class=\"ga-cfg-label\" for=\"dtaStockSelect\">個股</label>\r\n                    <select class=\"ga-cfg-input\" id=\"dtaStockSelect\"></select>\r\n                </div>\r\n                <div class=\"ga-cfg-field\">\r\n                    <label class=\"ga-cfg-label\" for=\"dtaCustomCode\">自行輸入代號</label>\r\n                    <input class=\"ga-cfg-input\" id=\"dtaCustomCode\" type=\"text\" placeholder=\"例：2330\">\r\n                </div>\r\n                <button class=\"btn btn-primary\" onclick=\"loadDetailedTA()\">載入詳細分析</button>\r\n                <span class=\"ga-cfg-hint\" id=\"dtaStatus\" style=\"align-self:center\"></span>\r\n            </div>\r\n\r\n            <div id=\"dtaResultArea\" style=\"display:none\">\r\n                <div class=\"ta-signal-strip\" id=\"dtaSignals\"></div>\r\n\r\n                <div class=\"grid-2\" style=\"margin-top:16px\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">價格走勢 + 布林通道</div>\r\n                        <div class=\"card-note\">中軌為 MA20，上下軌為 MA20 ± 2σ。通道寬度反映市場波動程度。</div>\r\n                        <div class=\"chart-box\" style=\"height:260px\"><canvas id=\"dtaBbandChart\"></canvas></div>\r\n                    </div>\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">MACD 指標</div>\r\n                        <div class=\"card-note\">DIF = EMA12 - EMA26，Signal = EMA9(DIF)，OSC = DIF - Signal</div>\r\n                        <div class=\"chart-box\" style=\"height:260px\"><canvas id=\"dtaMacdChart\"></canvas></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"grid-2\" style=\"margin-top:16px\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">KD 隨機指標</div>\r\n                        <div class=\"card-note\">K 值從低檔向上穿越 D 值為黃金交叉，代表超賣後動能反轉</div>\r\n                        <div class=\"chart-box\" style=\"height:200px\"><canvas id=\"dtaKdChart\"></canvas></div>\r\n                    </div>\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">成交量 + MA5</div>\r\n                        <div class=\"card-note\">量先價行：成交量放大且價格上漲為多頭確認訊號</div>\r\n                        <div class=\"chart-box\" style=\"height:200px\"><canvas id=\"dtaVolChart\"></canvas></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"dta-analysis-grid\" style=\"margin-top:16px\">\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">指標數值摘要</div>\r\n                        <div id=\"dtaIndicatorSummary\" style=\"margin-top:10px\"></div>\r\n                    </div>\r\n                    <div class=\"card\">\r\n                        <div class=\"card-title\">綜合進場評估</div>\r\n                        <div id=\"dtaEntryAssessment\" style=\"margin-top:10px\"></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"card\" style=\"margin-top:16px\">\r\n                    <div class=\"card-title\">訊號檢查清單</div>\r\n                    <div id=\"dtaSignalChecklist\" style=\"margin-top:10px\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ═══ 量化工具速查 ═══ -->\r\n    <div class=\"section reveal\" id=\"quant-ref\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">量化工具速查</div>\r\n            <h2 class=\"section-title\">市場結構 × VIX × 籌碼 × 策略參考</h2>\r\n            <p class=\"section-sub\">整合課程精華：四大市場連動、VIX 恐慌指數解讀、量比籌碼判讀、個股期 vs 融資券比較，以及台指期日內均值回歸策略模板。</p>\r\n\r\n            <div class=\"grid-2\" style=\"margin-bottom:18px\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">VIX 恐慌指數速查</div>\r\n                    <div class=\"card-note\">VIX 越高，未來 1 個月報酬統計上越好（均值回歸）</div>\r\n                    <table class=\"ref-table\" style=\"margin-top:10px\">\r\n                        <thead>\r\n                            <tr>\r\n                                <th>VIX 區間</th>\r\n                                <th>狀態</th>\r\n                                <th>統計預期報酬</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody>\r\n                            <tr>\r\n                                <td class=\"ref-val\">&lt; 12</td>\r\n                                <td><span class=\"ref-tag\" style=\"color:var(--green)\">極度平靜</span></td>\r\n                                <td>正常水位</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">12–20</td>\r\n                                <td><span class=\"ref-tag\">正常</span></td>\r\n                                <td>正常水位</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">20–30</td>\r\n                                <td><span class=\"ref-tag\" style=\"color:var(--orange)\">緊張</span></td>\r\n                                <td>↑ 略有正偏</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">30–40</td>\r\n                                <td><span class=\"ref-tag\" style=\"color:var(--red)\">恐慌</span></td>\r\n                                <td class=\"ref-val\" style=\"color:var(--green)\">+3% / 月</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">&gt; 40</td>\r\n                                <td><span class=\"ref-tag\" style=\"color:var(--red);font-weight:700\">崩盤級</span></td>\r\n                                <td class=\"ref-val\" style=\"color:var(--green);font-weight:700\">+6% / 月</td>\r\n                            </tr>\r\n                        </tbody>\r\n                    </table>\r\n                    <div style=\"margin-top:12px;font-size:.78rem;color:var(--muted)\">\r\n                        Contango（正價差）= 遠月 > 近月 = 平靜（80% 時間）<br>\r\n                        Backwardation（逆價差）= 近月 > 遠月 = 危機爆發\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">量比籌碼判讀</div>\r\n                    <div class=\"card-note\">量先價行 — 量比 = 當前成交量 / N 日平均成交量</div>\r\n                    <table class=\"ref-table\" style=\"margin-top:10px\">\r\n                        <thead>\r\n                            <tr>\r\n                                <th>量比</th>\r\n                                <th>成交量</th>\r\n                                <th>價格</th>\r\n                                <th>解讀</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody>\r\n                            <tr>\r\n                                <td class=\"ref-val\">&gt; 2</td>\r\n                                <td>量增</td>\r\n                                <td style=\"color:var(--green)\">價漲</td>\r\n                                <td>主力買進 ✅</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">&gt; 2</td>\r\n                                <td>量增</td>\r\n                                <td style=\"color:var(--red)\">價跌</td>\r\n                                <td style=\"color:var(--red)\">主力出貨 ⚠️</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">1–1.5</td>\r\n                                <td>正常</td>\r\n                                <td>—</td>\r\n                                <td>正常市況</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">&lt; 0.5</td>\r\n                                <td>量縮</td>\r\n                                <td style=\"color:var(--green)\">價漲</td>\r\n                                <td>力道不足</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td class=\"ref-val\">&lt; 0.5</td>\r\n                                <td>量縮</td>\r\n                                <td style=\"color:var(--red)\">價跌</td>\r\n                                <td style=\"color:var(--green)\">跌勢將盡</td>\r\n                            </tr>\r\n                        </tbody>\r\n                    </table>\r\n                    <div class=\"quant-golden-box\" style=\"margin-top:12px\">\r\n                        黃金組合：量比 &gt; 2 + 法人連續買超 + 融資餘額下降 = 強烈做多訊號\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"card\" style=\"margin-bottom:18px\">\r\n                <div class=\"card-title\">商品工具箱比較：個股期 vs 融資 vs 融券</div>\r\n                <div style=\"overflow-x:auto;margin-top:12px\">\r\n                    <table class=\"ref-table\" style=\"width:100%\">\r\n                        <thead>\r\n                            <tr>\r\n                                <th>項目</th>\r\n                                <th style=\"color:var(--green)\">個股期貨 ✅</th>\r\n                                <th>融資</th>\r\n                                <th>融券</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody>\r\n                            <tr>\r\n                                <td>槓桿</td>\r\n                                <td class=\"ref-val\" style=\"color:var(--green);font-weight:700\">7.4 倍</td>\r\n                                <td class=\"ref-val\">2.5 倍</td>\r\n                                <td class=\"ref-val\">1.1 倍</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td>做空</td>\r\n                                <td style=\"color:var(--green)\">✅ 可</td>\r\n                                <td style=\"color:var(--red)\">❌ 不可</td>\r\n                                <td style=\"color:var(--green)\">✅ 可</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td>持有成本</td>\r\n                                <td style=\"color:var(--green)\">幾乎零</td>\r\n                                <td style=\"color:var(--red)\">6–7%/年利息</td>\r\n                                <td>借券費+回補</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td>強制回補</td>\r\n                                <td style=\"color:var(--green)\">❌ 無</td>\r\n                                <td style=\"color:var(--green)\">❌ 無</td>\r\n                                <td style=\"color:var(--red)\">✅ 有</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td>交易稅</td>\r\n                                <td style=\"color:var(--green)\">十萬分之 2</td>\r\n                                <td>千分之 3</td>\r\n                                <td>千分之 3</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td>一口規格</td>\r\n                                <td>2,000 股</td>\r\n                                <td>—</td>\r\n                                <td>—</td>\r\n                            </tr>\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"grid-2\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">台指期規格速查</div>\r\n                    <table class=\"ref-table\" style=\"margin-top:10px\">\r\n                        <thead>\r\n                            <tr>\r\n                                <th>商品</th>\r\n                                <th>每點</th>\r\n                                <th>保證金</th>\r\n                                <th>槓桿</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody>\r\n                            <tr>\r\n                                <td>大台 (TX)</td>\r\n                                <td class=\"ref-val\">200 元</td>\r\n                                <td class=\"ref-val\">~18 萬</td>\r\n                                <td class=\"ref-val\">15–20×</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td>小台 (MTX)</td>\r\n                                <td class=\"ref-val\">50 元</td>\r\n                                <td class=\"ref-val\">~4.5 萬</td>\r\n                                <td class=\"ref-val\">15–20×</td>\r\n                            </tr>\r\n                            <tr>\r\n                                <td>微台</td>\r\n                                <td class=\"ref-val\">12.5 元</td>\r\n                                <td class=\"ref-val\">~1.1 萬</td>\r\n                                <td class=\"ref-val\">15–20×</td>\r\n                            </tr>\r\n                        </tbody>\r\n                    </table>\r\n                    <div style=\"margin-top:10px;font-size:.78rem;color:var(--muted);line-height:1.8\">\r\n                        結算：每月第三個禮拜三<br>\r\n                        日盤：08:45–13:45 ／ 夜盤：15:00–翌日 05:00\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"card\">\r\n                    <div class=\"card-title\">台指期日內均值回歸策略模板</div>\r\n                    <div class=\"strategy-recipe\">\r\n                        <div class=\"recipe-row\"><span class=\"recipe-key\">進場</span><span>09:00 前累計漲跌幅 &gt;\r\n                                0.5%，逆勢進場</span></div>\r\n                        <div class=\"recipe-row\"><span class=\"recipe-key\">止盈</span><span>跳空缺口 50% 回補</span></div>\r\n                        <div class=\"recipe-row\"><span class=\"recipe-key\">止損</span><span>−30 點</span></div>\r\n                        <div class=\"recipe-row\"><span class=\"recipe-key\">工具</span><span>小台 1 口（保證金 ~4.5 萬）</span></div>\r\n                        <div class=\"recipe-row\"><span class=\"recipe-key\">風控</span><span>單日最多 2 次 · 連虧 3 天暫停</span></div>\r\n                    </div>\r\n                    <div class=\"quant-golden-box\" style=\"margin-top:10px\">\r\n                        均值回歸適用盤整行情；勝率 60–70%，賺賠比偏小\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ═══ AI Prompt 模板庫 ═══ -->\r\n    <div class=\"section reveal\" id=\"prompt-lib\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">AI 分析工具</div>\r\n            <h2 class=\"section-title\">Prompt 模板庫</h2>\r\n            <p class=\"section-sub\">7 個經過實戰驗證的金融分析 Prompt 模板，點「複製」即可貼入 ChatGPT / Claude 使用。合規鐵律：不薦股 · 不保證 · 標時效。</p>\r\n\r\n            <div class=\"prompt-tabs\" id=\"promptTabs\"></div>\r\n            <div class=\"prompt-body card\" id=\"promptBody\"></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ═══ 課程複習 & 工具箱 ═══ -->\r\n    <div class=\"section reveal\" id=\"course-recap\">\r\n        <div class=\"section-inner\">\r\n            <div class=\"section-label\">課程複習</div>\r\n            <h2 class=\"section-title\">今日重點 × 工具箱整理</h2>\r\n            <p class=\"section-sub\">搭配圖卡回顧總經局勢，並善用以下工具提升研究效率。面對瞬息萬變的市場，勇敢走出舒適圈，將 AI 融入日常學習！</p>\r\n\r\n            <!-- 總經局勢提示卡 -->\r\n            <div class=\"recap-macro-banner\">\r\n                <div class=\"recap-macro-icon\">🌐</div>\r\n                <div>\r\n                    <div class=\"recap-macro-title\">總體經濟局勢</div>\r\n                    <div class=\"recap-macro-sub\">請搭配課程圖卡一起回顧當前總經環境，掌握大方向才能做出更好的投資判斷。</div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- 工具分類 -->\r\n            <div class=\"recap-category-label\">\r\n                <span class=\"recap-cat-icon\">📊</span> 投資與數據分析工具\r\n            </div>\r\n            <div class=\"recap-tools-grid\">\r\n                <div class=\"recap-tool-card\">\r\n                    <div class=\"recap-tool-header\">\r\n                        <div class=\"recap-tool-tag recap-tag-macro\">總體經濟</div>\r\n                    </div>\r\n                    <div class=\"recap-tool-name\">財經 M 平方</div>\r\n                    <div class=\"recap-tool-desc\">專注於總體經濟數據與趨勢分析，掌握大方向必備。可追蹤 GDP、PMI、CPI、Fed 利率等全球關鍵指標。</div>\r\n                    <div class=\"recap-tool-use\">\r\n                        <span class=\"recap-use-key\">最佳用法</span>結合 FOMC 決策週期，每月固定查看一次總經儀表板\r\n                    </div>\r\n                </div>\r\n                <div class=\"recap-tool-card\">\r\n                    <div class=\"recap-tool-header\">\r\n                        <div class=\"recap-tool-tag recap-tag-fundamental\">基本面</div>\r\n                    </div>\r\n                    <div class=\"recap-tool-name\">財報狗</div>\r\n                    <div class=\"recap-tool-desc\">專精企業財報分析，研究基本面、檢視公司體質的好幫手。EPS 趨勢、毛利率、ROE 一目了然。</div>\r\n                    <div class=\"recap-tool-use\">\r\n                        <span class=\"recap-use-key\">最佳用法</span>法說會前後用財報狗確認 EPS / 毛利率長期趨勢\r\n                    </div>\r\n                </div>\r\n                <div class=\"recap-tool-card\">\r\n                    <div class=\"recap-tool-header\">\r\n                        <div class=\"recap-tool-tag recap-tag-tech\">技術 / 籌碼</div>\r\n                    </div>\r\n                    <div class=\"recap-tool-name\">XQ 全球贏家</div>\r\n                    <div class=\"recap-tool-desc\">強大的股票分析軟體（電腦版 + 手機版），涵蓋看盤、技術分析與籌碼動向，專業交易者首選。</div>\r\n                    <div class=\"recap-tool-use\">\r\n                        <span class=\"recap-use-key\">最佳用法</span>盤中監看籌碼異動 + 法人買超，搭配 GAPPTS 訊號進出場\r\n                    </div>\r\n                </div>\r\n                <div class=\"recap-tool-card\">\r\n                    <div class=\"recap-tool-header\">\r\n                        <div class=\"recap-tool-tag recap-tag-news\">即時資訊</div>\r\n                        <div class=\"recap-tool-warning\">⚠ 請評估資安疑慮</div>\r\n                    </div>\r\n                    <div class=\"recap-tool-name\">金十數據 APP</div>\r\n                    <div class=\"recap-tool-desc\">提供即時且快速的全球財經新聞與數據庫。<span\r\n                            style=\"color:var(--orange)\">注意：此為中國大陸開發之軟體，若對資安或隱私有疑慮，請審慎評估後再決定是否下載使用。</span></div>\r\n                    <div class=\"recap-tool-use\">\r\n                        <span class=\"recap-use-key\">最佳用法</span>需要極速掌握國際突發事件時使用，建議用隔離裝置\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"recap-category-label\" style=\"margin-top:28px\">\r\n                <span class=\"recap-cat-icon\">💡</span> 額外補充與輔助工具\r\n            </div>\r\n            <div class=\"recap-tools-grid\">\r\n                <div class=\"recap-tool-card\">\r\n                    <div class=\"recap-tool-header\">\r\n                        <div class=\"recap-tool-tag recap-tag-risk\">風險管理</div>\r\n                    </div>\r\n                    <div class=\"recap-tool-name\">處置王 APP</div>\r\n                    <div class=\"recap-tool-desc\">專門查詢股票何時被列入處置。對於留意個股流動性與交易限制非常實用，避免在無法正常交易時被套牢。</div>\r\n                    <div class=\"recap-tool-use\">\r\n                        <span class=\"recap-use-key\">最佳用法</span>買進前先查是否為處置股，避免流動性陷阱\r\n                    </div>\r\n                </div>\r\n                <div class=\"recap-tool-card recap-tool-card-ai\">\r\n                    <div class=\"recap-tool-header\">\r\n                        <div class=\"recap-tool-tag recap-tag-ai\">AI 助手</div>\r\n                        <div class=\"recap-tool-badge-ai\">推薦</div>\r\n                    </div>\r\n                    <div class=\"recap-tool-name\">Claude · Gemini · NotebookLM</div>\r\n                    <div class=\"recap-tool-desc\">強大的生產力助手，可快速整理龐雜財經資訊、總結長篇報告重點，或協助梳理投資邏輯。善用科技大幅提升效率！</div>\r\n                    <div class=\"recap-ai-chips\">\r\n                        <span class=\"recap-ai-chip\">Claude — 長文分析、繁中優化、邏輯推論</span>\r\n                        <span class=\"recap-ai-chip\">Gemini — 聯網搜尋、多模態、Google 整合</span>\r\n                        <span class=\"recap-ai-chip\">NotebookLM — 上傳報告 PDF，AI 幫你摘要問答</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- 行動建議 -->\r\n            <div class=\"recap-action-box\">\r\n                <div class=\"recap-action-title\">本週行動建議</div>\r\n                <div class=\"recap-action-grid\">\r\n                    <div class=\"recap-action-item\">\r\n                        <div class=\"recap-action-num\">01</div>\r\n                        <div class=\"recap-action-text\">用<strong>財經M平方</strong>查一次 PMI 與 Fed 利率點陣圖，了解目前總經週期位置</div>\r\n                    </div>\r\n                    <div class=\"recap-action-item\">\r\n                        <div class=\"recap-action-num\">02</div>\r\n                        <div class=\"recap-action-text\">對持有的個股，用<strong>財報狗</strong>確認最近 4 季 EPS 趨勢與毛利率變化</div>\r\n                    </div>\r\n                    <div class=\"recap-action-item\">\r\n                        <div class=\"recap-action-num\">03</div>\r\n                        <div class=\"recap-action-text\">把上方<strong>Prompt 模板庫</strong>的「財報摘要」模板存起來，下次法說會直接用</div>\r\n                    </div>\r\n                    <div class=\"recap-action-item\">\r\n                        <div class=\"recap-action-num\">04</div>\r\n                        <div class=\"recap-action-text\">試著用<strong>PE × PB 估值計算器</strong>對一支你熟悉的股票跑一次三情境估值</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- 合規提醒 -->\r\n            <div class=\"recap-compliance\">\r\n                <span style=\"color:var(--orange);font-weight:700\">合規鐵律</span>\r\n                &ensp;🚫 不薦股 &ensp; 🚫 不保證報酬 &ensp; ✅ 標明資料時效 &ensp; ✅ 所有數字回原始來源驗證 &ensp; ✅ AI 輔助須人工審閱\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div data-site-footer></div>\r\n\r\n    <button class=\"scroll-top\" aria-label=\"返回頂部\">↑</button>\r\n";
