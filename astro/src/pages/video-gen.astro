---
import Base from '../layouts/Base.astro';
const bodyHtml = "\r\n    <div data-site-nav></div>\r\n    <header class=\"hero\">\r\n        <div class=\"eyebrow\"><span class=\"live-dot\"></span>AI Video Generation &middot; Seedance 2.0 &middot; fal.ai Proxy</div>\r\n        <h1>文字生成影片<br><span>Seedance 2.0 via FastAPI</span></h1>\r\n        <p class=\"hero-sub\">輸入 prompt，FastAPI（Railway）作為安全代理送到 fal.ai，非同步輪詢完成後直接播放。API key 全程藏後端。</p>\r\n        <div class=\"hero-stats\">\r\n            <div class=\"hero-stat\"><div class=\"value\">Seedance 2.0</div><div class=\"label\">ByteDance &middot; fal.ai queue</div></div>\r\n            <div class=\"hero-stat\"><div class=\"value\">Async Poll</div><div class=\"label\">submit &rarr; 5s poll &rarr; 播放</div></div>\r\n            <div class=\"hero-stat\"><div class=\"value\">Rate Limited</div><div class=\"label\">3 次 / IP / 天</div></div>\r\n        </div>\r\n    </header>\r\n    <main class=\"container\">\r\n        <div class=\"video-grid\">\r\n            <aside class=\"panel\">\r\n                <div class=\"panel-title\">影片設定</div>\r\n                <div class=\"panel-sub\">填入 prompt 後按生成影片，等待約 30-120 秒。</div>\r\n                <div class=\"field\">\r\n                    <label for=\"videoPrompt\">Prompt（英文效果最佳）</label>\r\n                    <textarea id=\"videoPrompt\" rows=\"5\" placeholder=\"A glowing DNA helix rotating in space, cinematic...\"></textarea>\r\n                    <div class=\"field-hint\">3-500 字元，建議英文</div>\r\n                </div>\r\n                <div class=\"field\">\r\n                    <label for=\"videoResolution\">解析度</label>\r\n                    <select id=\"videoResolution\">\r\n                        <option value=\"480p\">480p（快速測試）</option>\r\n                        <option value=\"720p\" selected>720p（建議）</option>\r\n                        <option value=\"1080p\">1080p（較慢）</option>\r\n                    </select>\r\n                </div>\r\n                <div class=\"field\">\r\n                    <label for=\"videoDuration\">時長（秒）</label>\r\n                    <select id=\"videoDuration\">\r\n                        <option value=\"3\">3 秒</option>\r\n                        <option value=\"5\" selected>5 秒</option>\r\n                        <option value=\"8\">8 秒</option>\r\n                        <option value=\"10\">10 秒</option>\r\n                    </select>\r\n                </div>\r\n                <button id=\"videoGenBtn\" class=\"btn btn-primary\" type=\"button\">\r\n                    <span id=\"videoSpinner\" hidden></span>生成影片\r\n                </button>\r\n                <div id=\"videoStatus\" class=\"status-banner\" data-state=\"info\">尚未送出請求。</div>\r\n                <div class=\"small-note\">API: <span id=\"videoApiLabel\" class=\"mono\">detecting...</span></div>\r\n                <div style=\"margin-top:24px\">\r\n                    <div class=\"panel-title\" style=\"font-size:.82rem;margin-bottom:10px\">範例 Prompts</div>\r\n                    <div class=\"example-list\">\r\n                        <button class=\"example-btn\" type=\"button\" data-example-prompt=\"A glowing DNA double helix rotating slowly in deep blue space, cinematic lighting\">DNA double helix rotating in space</button>\r\n                        <button class=\"example-btn\" type=\"button\" data-example-prompt=\"Timelapse of a protein folding from a disordered chain into a structured 3D form, bioluminescent glow\">Protein folding timelapse</button>\r\n                        <button class=\"example-btn\" type=\"button\" data-example-prompt=\"Aerial drone shot of Taiwan mountains at sunrise with golden rays, cinematic 4K\">Taiwan mountain sunrise aerial</button>\r\n                        <button class=\"example-btn\" type=\"button\" data-example-prompt=\"A futuristic biotech lab with holographic displays showing gene sequences, photorealistic\">Futuristic biotech lab</button>\r\n                    </div>\r\n                </div>\r\n            </aside>\r\n            <div class=\"panel\">\r\n                <div class=\"result-top\">\r\n                    <div><h3>影片輸出</h3><p>生成完成後可在此播放與下載。</p></div>\r\n                    <div class=\"section-badge\">Seedance 2.0 Output</div>\r\n                </div>\r\n                <div class=\"video-wrap\">\r\n                    <div id=\"videoPlaceholder\" class=\"video-placeholder\">\r\n                        <div class=\"icon\">&#127916;</div>\r\n                        <p>送出 prompt 後，影片將在此處顯示。生成通常需要 30-120 秒。</p>\r\n                    </div>\r\n                    <video id=\"videoResult\" controls hidden preload=\"metadata\"></video>\r\n                </div>\r\n                <div class=\"arch-note\">\r\n                    <div class=\"arch-note-title\">架構說明</div>\r\n                    <div class=\"arch-flow\">\r\n                        <span class=\"arch-node\">Astro (Vercel)</span>\r\n                        <span class=\"arch-arrow\">&rarr;</span>\r\n                        <span class=\"arch-node\">FastAPI (Railway)</span>\r\n                        <span class=\"arch-arrow\">&rarr;</span>\r\n                        <span class=\"arch-node\">fal.ai &rarr; Seedance 2.0</span>\r\n                    </div>\r\n                    <div style=\"margin-top:12px;font-size:.8rem;color:var(--dim)\">FAL_KEY 僅存在 Railway 環境變數。</div>\r\n                </div>\r\n                <div class=\"faq-list\">\r\n                    <div class=\"faq-item\">\r\n                        <div class=\"faq-header\"><span>為什麼要用 FastAPI 當 proxy？</span><span class=\"faq-arrow\">&#9660;</span></div>\r\n                        <div class=\"faq-body\" hidden>API key 放後端環境變數，前端只拿到 request_id 和影片 URL，避免 key 洩漏。</div>\r\n                    </div>\r\n                    <div class=\"faq-item\">\r\n                        <div class=\"faq-header\"><span>為什麼不同步等待回應？</span><span class=\"faq-arrow\">&#9660;</span></div>\r\n                        <div class=\"faq-body\" hidden>生成時間 30-120 秒，Railway HTTP timeout 遠小於此。非同步 submit/poll 避免 timeout。</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </main>\r\n    <div data-site-footer></div>\r\n    <script src=\"scripts/video_gen.js\"></script>\r\n    <button class=\"scroll-top\" aria-label=\"返回頂部\">&uarr;</button>\r\n";
const headInline = "";
---
<Base
    title="AI Video Generation | Seedance 2.0 + FastAPI Proxy"
    description="文字生成影片示範：Seedance 2.0 via fal.ai，FastAPI proxy，submit/poll 架構。"
    bodyPage="video_gen"
    pageStyles={["/styles/video_gen.css"]}
    pageScripts={["/scripts/video_gen.js"]}
    headInline={headInline}
>
    <Fragment set:html={bodyHtml} />
</Base>
