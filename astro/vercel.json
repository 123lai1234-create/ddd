{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefer-offline --no-audit",
  "buildCommand": "git lfs install --local && git lfs pull && npx --no-install astro build && npx --no-install pagefind --site dist --output-path dist/pagefind",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "env": {
    "API_PROXY_TARGET": "https://vercel-edge-function"
  },
  "headers": [
    {
      "source": "/games/xian-godot/(.*)?",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/xian-godot",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/catchall"
    }
  ]
}
