{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "astro/dist",
  "buildCommand": "cd astro && npm install --ignore-scripts && npm run build",
  "installCommand": "cd astro && npm install --ignore-scripts",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[[...slug]]" }
  ],
  "crons": [
    { "path": "/api/admin/load/all", "schedule": "30 7 * * 1-5" },
    { "path": "/api/admin/load/institutional", "schedule": "0 14 * * 1-5" },
    { "path": "/api/admin/load/exdiv", "schedule": "0 15 * * 1-5" },
    { "path": "/api/admin/load/revenue?typeks=sii", "schedule": "0 14 12 * *" },
    { "path": "/api/admin/load/revenue?typeks=otc", "schedule": "30 14 12 * *" },
    { "path": "/api/admin/load/futures", "schedule": "15 14 * * 1-5" },
    { "path": "/api/admin/load/overseas", "schedule": "30 14 * * 1-5" },
    { "path": "/api/admin/load/ai_capex", "schedule": "0 1 * * *" },
    { "path": "/api/admin/load/market_prices", "schedule": "30 6 * * 1-5" },
    { "path": "/api/admin/load/macro_yields", "schedule": "30 7 * * 1-5" },
    { "path": "/api/admin/load/macro_news", "schedule": "0 8 * * *" },
    { "path": "/api/admin/load/index_institutional", "schedule": "15 16 * * 1-5" },
    { "path": "/api/admin/load/markers", "schedule": "30 18 * * 1-5" },
    { "path": "/api/admin/load/sectors", "schedule": "0 7 * * 1" },
    { "path": "/api/admin/load/big_holders/finmind", "schedule": "0 9 1 * *" },
    { "path": "/api/admin/load/financial_reports/finmind", "schedule": "0 10 1 * *" }
  ]
}

