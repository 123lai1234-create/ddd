{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "outputDirectory": "astro/dist",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)/", "destination": "/$1/index.html" },
    { "source": "/og", "destination": "/api/og/" },
    { "source": "/api/:path*", "destination": "https://donttalk-api-production.up.railway.app/api/:path*" }
  ],
  "headers": [
    {
      "source": "/music/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}