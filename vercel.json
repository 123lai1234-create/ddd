{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/about_me.html",
      "destination": "/frontend/about_me.html"
    },
    {
      "source": "/works.html",
      "destination": "/frontend/works.html"
    },
    {
      "source": "/gene_ai.html",
      "destination": "/frontend/gene_ai.html"
    },
    {
      "source": "/ngs.html",
      "destination": "/frontend/ngs.html"
    },
    {
      "source": "/report.html",
      "destination": "/frontend/report.html"
    },
    {
      "source": "/thesis.html",
      "destination": "/frontend/thesis.html"
    },
    {
      "source": "/interview_prep.html",
      "destination": "/frontend/interview_prep.html"
    },
    {
      "source": "/styles/:path*",
      "destination": "/frontend/styles/:path*"
    },
    {
      "source": "/scripts/:path*",
      "destination": "/frontend/scripts/:path*"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/about_me.html",
      "permanent": true
    },
    {
      "source": "/works",
      "destination": "/works.html",
      "permanent": true
    },
    {
      "source": "/gene-ai",
      "destination": "/gene_ai.html",
      "permanent": true
    },
    {
      "source": "/ngs",
      "destination": "/ngs.html",
      "permanent": true
    },
    {
      "source": "/report",
      "destination": "/report.html",
      "permanent": true
    },
    {
      "source": "/interview",
      "destination": "/interview_prep.html",
      "permanent": true
    }
  ]
}
