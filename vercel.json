{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npm run build",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "astro/dist",
  "cleanUrls": true,
  "routes": [
    { "src": "/_assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/about"          , "dest": "/about/index.html" },
    { "src": "/about_me"       , "dest": "/about_me/index.html" },
    { "src": "/blog"           , "dest": "/blog/index.html" },
    { "src": "/firmware"       , "dest": "/firmware/index.html" },
    { "src": "/games"          , "dest": "/games/index.html" },
    { "src": "/gene-ai"        , "dest": "/gene-ai/index.html" },
    { "src": "/ingest"         , "dest": "/ingest/index.html" },
    { "src": "/interactive-showcase", "dest": "/interactive-showcase/index.html" },
    { "src": "/interview"      , "dest": "/interview/index.html" },
    { "src": "/interview_prep" , "dest": "/interview_prep/index.html" },
    { "src": "/music"          , "dest": "/music/index.html" },
    { "src": "/ngs"            , "dest": "/ngs/index.html" },
    { "src": "/protein-mpnn"   , "dest": "/protein-mpnn/index.html" },
    { "src": "/report"         , "dest": "/report/index.html" },
    { "src": "/seo-accessibility", "dest": "/seo-accessibility/index.html" },
    { "src": "/stem-cell"      , "dest": "/stem-cell/index.html" },
    { "src": "/stock"          , "dest": "/stock/index.html" },
    { "src": "/templates"      , "dest": "/templates/index.html" },
    { "src": "/thesis"         , "dest": "/thesis/index.html" },
    { "src": "/video-gen"      , "dest": "/video-gen/index.html" },
    { "src": "/works"          , "dest": "/works/index.html" },
    { "src": "/xian-godot"     , "dest": "/xian-godot/index.html" },
    { "src": "/(.*)", "dest": "/$1/index.html" }
  ],
  "headers": [
    {
      "source": "/music/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/og",
      "destination": "/api/og/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://donttalk-api-production.up.railway.app/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}