{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd astro && npm ci",
  "buildCommand": "cd astro && npm run build",
  "outputDirectory": "astro/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "env": {
    "API_PROXY_TARGET": "https://donttalk-api-production.up.railway.app"
  },
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/xian-godot/(.*)?",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=31536000, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/og",
      "destination": "/api/og"
    },
    {
      "source": "/about",
      "destination": "/about/"
    },
    {
      "source": "/works",
      "destination": "/works/"
    },
    {
      "source": "/gene-ai",
      "destination": "/gene-ai/"
    },
    {
      "source": "/ngs",
      "destination": "/ngs/"
    },
    {
      "source": "/report",
      "destination": "/report/"
    },
    {
      "source": "/thesis",
      "destination": "/thesis/"
    },
    {
      "source": "/protein-mpnn",
      "destination": "/protein-mpnn/"
    },
    {
      "source": "/interview",
      "destination": "/interview/"
    },
    {
      "source": "/blog",
      "destination": "/blog/"
    },
    {
      "source": "/about_me",
      "destination": "/about_me/"
    },
    {
      "source": "/firmware",
      "destination": "/firmware/"
    },
    {
      "source": "/index-optimized",
      "destination": "/index-optimized/"
    },
    {
      "source": "/ingest",
      "destination": "/ingest/"
    },
    {
      "source": "/interactive-showcase",
      "destination": "/interactive-showcase/"
    },
    {
      "source": "/offline",
      "destination": "/offline/"
    },
    {
      "source": "/seo-accessibility",
      "destination": "/seo-accessibility/"
    },
    {
      "source": "/stem-cell",
      "destination": "/stem-cell/"
    },
    {
      "source": "/video-gen",
      "destination": "/video-gen/"
    },
    {
      "source": "/xian-godot",
      "destination": "/xian-godot/"
    },
    {
      "source": "/music",
      "destination": "/music/"
    },
    {
      "source": "/music-test",
      "destination": "/music-test/"
    },
    {
      "source": "/healthz",
      "destination": "https://donttalk-api-production.up.railway.app/healthz"
    },
    {
      "source": "/api/:path*",
      "destination": "https://donttalk-api-production.up.railway.app/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/about_me.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/works.html",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/gene_ai.html",
      "destination": "/gene-ai",
      "permanent": true
    },
    {
      "source": "/ngs.html",
      "destination": "/ngs",
      "permanent": true
    },
    {
      "source": "/report.html",
      "destination": "/report",
      "permanent": true
    },
    {
      "source": "/thesis.html",
      "destination": "/thesis",
      "permanent": true
    },
    {
      "source": "/protein_mpnn.html",
      "destination": "/protein-mpnn",
      "permanent": true
    },
    {
      "source": "/interview_prep.html",
      "destination": "/interview",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stem_cell.html",
      "destination": "/stem-cell",
      "permanent": true
    }
  ]
}