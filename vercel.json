
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rootDirectory": "astro",
  "outputDirectory": "dist",
  "env": {
    "API_PROXY_TARGET": "https://donttalk-api-production.up.railway.app"
  },
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "https://donttalk-api-production.up.railway.app/healthz"
    },
    {
      "source": "/api/:path*",
      "destination": "https://donttalk-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/interview",
      "destination": "/interview_prep"
    }
  ],
  "redirects": [
    { "source": "/about_me.html",       "destination": "/about",        "permanent": true },
    { "source": "/about_me",            "destination": "/about",        "permanent": true },
    { "source": "/works.html",          "destination": "/works",        "permanent": true },
    { "source": "/gene_ai.html",        "destination": "/gene-ai",      "permanent": true },
    { "source": "/gene_ai",             "destination": "/gene-ai",      "permanent": true },
    { "source": "/ngs.html",            "destination": "/ngs",          "permanent": true },
    { "source": "/report.html",         "destination": "/report",       "permanent": true },
    { "source": "/thesis.html",         "destination": "/thesis",       "permanent": true },
    { "source": "/protein_mpnn.html",   "destination": "/protein-mpnn", "permanent": true },
    { "source": "/protein_mpnn",        "destination": "/protein-mpnn", "permanent": true },
    { "source": "/interview_prep.html", "destination": "/interview",    "permanent": true },
    { "source": "/interview_prep",      "destination": "/interview",    "permanent": true },
    { "source": "/index.html",          "destination": "/",             "permanent": true },
    { "source": "/game.html",           "destination": "/games/breakout.html", "permanent": true },
    { "source": "/games",               "destination": "/games/",       "permanent": false }
  ]
}

