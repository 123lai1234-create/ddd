{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'no build needed — prebuilt _backend.mjs in root'",
  "installCommand": "echo 'no install needed — api/ functions are self-contained'",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?p=:path*" }
  ],
  "functions": {
    "api/[...slug].mjs": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/lyrics.jsx": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/og.jsx": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
